---
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** html에 줄 테마 클래스 (styles/retrievo-theme.css). 예: "soft pastel" */
  theme?: string;
}
const { title, description, theme } = Astro.props;
---
<!doctype html>
<html lang="ko" class={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap" />
    <slot name="head" />
    <!-- 앱 안 화면: Retrievo 앱이 주소 끝에 ?embed=1을 붙여 iframe으로 연다. 앱이 닫기와 제목을 보여 주므로 사이트 이동 링크를 숨긴다 -->
    <script is:inline>
      if (/[?&]embed=1(&|$)/.test(location.search)) document.documentElement.classList.add('embed');
    </script>
    <style is:global>
      html.embed .back { display: none; }
      html.embed body { padding-top: 20px; }
      /* 앱의 하단 바가 본문 끝을 가리지 않도록 아래를 비워 둔다 */
      html.embed body { padding-bottom: 88px; }
    </style>
  </head>
  <body>
    <slot />
    <script is:inline>
      /* 앱 안 화면에서 다른 페이지로 가는 링크는 새 탭으로 연다. 안 그러면 앱의 레슨 화면 안에서 다른 페이지가 열린다 */
      if (document.documentElement.classList.contains('embed')) {
        document.querySelectorAll('a[href]').forEach(function (a) {
          if (a.getAttribute('href').charAt(0) !== '#') { a.target = '_blank'; a.rel = 'noopener'; }
        });

        /*
         * 앱에 스크롤 상태를 알린다. 앱은 아래로 읽는 동안 하단 바를 숨기고, 위로 올리거나 끝에 닿으면 다시 보여 준다.
         * 본문은 다른 사이트라 앱이 스크롤을 직접 볼 수 없어서 postMessage로 보낸다. 보내는 값은 방향과 위치뿐이다.
         */
        (function () {
          if (window.parent === window) return;
          var lastY = window.scrollY, state = '';
          function send() {
            var y = window.scrollY, max = document.documentElement.scrollHeight - window.innerHeight;
            var atTop = y < 40, atEnd = max - y < 160;
            var dir = y > lastY + 6 ? 'down' : y < lastY - 6 ? 'up' : '';
            if (dir) lastY = y;
            var hide = atTop || atEnd ? false : dir === 'down' ? true : dir === 'up' ? false : null;
            if (hide === null) return;
            var next = hide ? 'hide' : 'show';
            if (next === state) return;
            state = next;
            window.parent.postMessage({ source: 'dev-lessons', type: 'bar', hide: hide }, '*');
          }
          window.addEventListener('scroll', send, { passive: true });
          window.addEventListener('resize', send);
        })();
      }
    </script>
  </body>
</html>
