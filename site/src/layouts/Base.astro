---
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** html에 줄 테마 클래스 (styles/retrievo-theme.css). 예: "soft pastel" */
  theme?: string;
}
const { title, description, theme } = Astro.props;
---
<!doctype html>
<html lang="ko" class={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap" />
    <slot name="head" />
    <!-- 앱 안 화면: Retrievo 앱이 주소 끝에 ?embed=1을 붙여 iframe으로 연다. 앱이 닫기와 제목을 보여 주므로 사이트 이동 링크를 숨긴다 -->
    <script is:inline>
      if (/[?&]embed=1(&|$)/.test(location.search)) document.documentElement.classList.add('embed');
    </script>
    <style is:global>
      html.embed .back { display: none; }
      html.embed body { padding-top: 20px; }
      /* 앱의 하단 바가 본문 끝을 가리지 않도록 아래를 비워 둔다 */
      html.embed body { padding-bottom: 88px; }
      /* 앱이 iframe을 본문 높이에 맞췄을 때: 이 페이지는 스크롤되지 않으므로 진행 표시를 앱이 그린다 */
      html.embed-fit .progress, html.embed-fit .where { display: none; }
    </style>
  </head>
  <body>
    <slot />
    <script is:inline>
      /* 앱 안 화면에서 다른 페이지로 가는 링크는 새 탭으로 연다. 안 그러면 앱의 레슨 화면 안에서 다른 페이지가 열린다 */
      if (document.documentElement.classList.contains('embed')) {
        document.querySelectorAll('a[href]').forEach(function (a) {
          if (a.getAttribute('href').charAt(0) !== '#') { a.target = '_blank'; a.rel = 'noopener'; }
        });

        /*
         * 앱에 스크롤 상태를 알린다. 앱은 아래로 읽는 동안 하단 바를 숨기고, 위로 올리거나 끝에 닿으면 다시 보여 준다.
         * 본문은 다른 사이트라 앱이 스크롤을 직접 볼 수 없어서 postMessage로 보낸다. 보내는 값은 방향과 위치뿐이다.
         */
        (function () {
          if (window.parent === window) return;
          var lastY = window.scrollY, state = '';
          function send() {
            var y = window.scrollY, max = document.documentElement.scrollHeight - window.innerHeight;
            var atTop = y < 40, atEnd = max - y < 160;
            var dir = y > lastY + 6 ? 'down' : y < lastY - 6 ? 'up' : '';
            if (dir) lastY = y;
            var hide = atTop || atEnd ? false : dir === 'down' ? true : dir === 'up' ? false : null;
            if (hide === null) return;
            var next = hide ? 'hide' : 'show';
            if (next === state) return;
            state = next;
            window.parent.postMessage({ source: 'dev-lessons', type: 'bar', hide: hide }, '*');
          }
          window.addEventListener('scroll', send, { passive: true });
          window.addEventListener('resize', send);
        })();

        /*
         * 앱에 본문의 높이를 알린다. 앱이 iframe을 그 높이로 맞추면 본문이 iframe 안에서 따로 스크롤되지 않고
         * 앱의 페이지 전체가 스크롤된다. 그래야 모바일 브라우저의 주소창이 접힌다.
         * 높이가 맞춰진 것을 확인하면 html에 embed-fit을 붙인다. 그때는 진행 표시를 앱이 대신 그린다.
         */
        (function () {
          if (window.parent === window) return;
          var last = 0;
          function height() {
            var cs = getComputedStyle(document.body);
            return Math.ceil(document.body.getBoundingClientRect().height + parseFloat(cs.marginTop) + parseFloat(cs.marginBottom));
          }
          function fitted() { return window.innerHeight >= height() - 2; }
          function send() {
            document.documentElement.classList.toggle('embed-fit', fitted());
            var h = height();
            if (h === last) return;
            last = h;
            window.parent.postMessage({ source: 'dev-lessons', type: 'height', height: h }, '*');
          }
          /*
           * 주소에 #q3처럼 구역이 있으면(찾아보기에서 온 경우) 높이가 맞춰진 뒤 한 번 앱에 그 위치를 알린다.
           * 높이가 맞춰지면 이 페이지는 스크롤되지 않아서 브라우저가 #앵커로 가 주지 못한다
           */
          var target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
          var sentTarget = false;
          function scrollToTarget() {
            if (!target || sentTarget || !fitted()) return;
            sentTarget = true;
            setTimeout(function () {
              window.parent.postMessage({ source: 'dev-lessons', type: 'scroll', top: Math.round(target.getBoundingClientRect().top + window.scrollY) }, '*');
            }, 120);
          }
          new ResizeObserver(function () { send(); scrollToTarget(); }).observe(document.body);
          window.addEventListener('resize', scrollToTarget);
          window.addEventListener('load', send);
          window.addEventListener('resize', send);
          send();

          /* 높이가 맞춰지면 이 페이지는 스크롤되지 않는다. 페이지 안의 #링크는 앱이 대신 그 자리로 스크롤한다 */
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="#"]');
            if (!a || !fitted()) return;
            var el = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
            if (!el) return;
            e.preventDefault();
            window.parent.postMessage({ source: 'dev-lessons', type: 'scroll', top: Math.round(el.getBoundingClientRect().top + window.scrollY) }, '*');
          });
        })();
      }
    </script>
  </body>
</html>
