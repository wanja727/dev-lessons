---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';
import CiOutput from '../../components/CiOutput.astro';
import RunLocally from '../../components/RunLocally.astro';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/beans/SpringBeansTest.java`;
const mainDir = `${repo}/blob/main/verification/src/main/java/lab/devlessons/beans`;

const codePredict = `@Service
public class CoffeeService {
    private int orderCount;              // 주문 수

    public String order(String user, String coffee) {
        orderCount++;
        ...
    }
}
// kim과 lee가 각자 휴대폰으로 커피를 한 잔씩 주문했다`;

const codeManual = `// 스프링 없이 직접 조립하면
CoffeeMenuRepository menu = new CoffeeMenuRepository();
NoticeSender sender = new SmsNoticeSender();
CoffeeService service = new CoffeeService(menu, sender);
CoffeeController controller = new CoffeeController(service);
// 클래스가 100개면? 만드는 순서, 누구와 누구를 연결할지 전부 내가 챙겨야 한다`;

const codeService = `@Service                                   // "이 클래스로 빈을 만들어 주세요"
public class CoffeeService {

    private final CoffeeMenuRepository menu;
    private final NoticeSender sender;     // 인터페이스만 안다

    public CoffeeService(CoffeeMenuRepository menu, NoticeSender sender) {  // 생성자 주입
        this.menu = menu;
        this.sender = sender;
    }

    public String order(String user, String coffee) {
        int price = menu.priceOf(coffee);
        return sender.send(user, coffee + " " + price + "원 주문 완료");
    }
}`;

const codeFake = `// 테스트에서는 스프링 없이 가짜를 넣을 수 있다
NoticeSender fake = (to, message) -> "가짜:" + to + ":" + message;
CoffeeService service = new CoffeeService(new CoffeeMenuRepository(), fake);
service.order("kim", "latte");   // "가짜:kim:latte 5000원 주문 완료"`;

const codeField = `@Service
public class FieldInjectedService {
    @Autowired
    private NoticeSender sender;    // 필드 주입: 컨테이너가 만든 객체에만 들어간다
}

new FieldInjectedService().sender();      // null
context.getBean(FieldInjectedService.class).sender();   // SmsNoticeSender`;
---
<Base title="스프링 빈과 의존성 주입 · Dev Lessons" description="스프링 빈, 컨테이너, 생성자 주입, 싱글톤을 커피 주문 앱을 조립하는 과정으로 따라가며 배워요. @Transactional과 JPA 레슨의 출발점.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Spring · 기초 · 약 25분 · 선수 레슨 없음</p>
    <h1>스프링 빈과 의존성 주입</h1>
    <p class="lede">스프링 코드를 처음 보면 이상한 점이 있어요. 서비스를 쓰는데 <code>new</code>가 없어요. 그럼 객체는 누가 만들고, 어떻게 서로 연결될까요? 커피 주문 앱이 조립되는 과정을 따라가며 <strong>빈</strong>, <strong>컨테이너</strong>, <strong>의존성 주입</strong>을 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 자바의 클래스, 생성자, 인터페이스, new. 웹 요청(HTTP GET)이 무엇인지 대략.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#why"><span>1</span>직접 조립의 문제</a>
      <a href="#container"><span>2</span>컨테이너가 조립하기</a>
      <a href="#di"><span>3</span>의존성 주입</a>
      <a href="#singleton"><span>4</span>싱글톤</a>
      <a href="#flow"><span>5</span>요청이 지나가는 길</a>
      <a href="#traps"><span>6</span>함정</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>주문 수는 몇이 될까요?</h2>
    <p>서비스가 자기 필드에 주문 수를 세요. 처음 값은 0이에요.</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">두 주문이 끝난 뒤 orderCount는</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="1" aria-pressed="false">각자 1 (사람마다 따로)</button>
          <button class="chip" type="button" data-v="2" aria-pressed="false">2 (함께 셈)</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 4장에서 이유를 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="why" class="read">
    <p class="eyebrow">1 · 직접 조립의 문제</p>
    <h2>객체가 다른 객체를 필요로 해요</h2>
    <p>커피 주문 앱은 네 객체로 이뤄져요. 요청을 받는 <strong>컨트롤러</strong>, 주문 규칙을 담은 <strong>서비스</strong>, 가격을 꺼내 오는 <strong>리포지토리</strong>(저장소), 알림을 보내는 <strong>NoticeSender</strong>예요. 서비스는 리포지토리와 NoticeSender가 있어야 일할 수 있어요. 이렇게 "일하려면 필요한 다른 객체"를 <strong>의존성</strong>이라고 해요.</p>
    <pre set:text={codeManual} />
    <p>작은 앱은 이걸로 충분해요. 하지만 클래스가 많아지면 만드는 순서와 연결을 사람이 다 챙겨야 하고, 알림을 SMS에서 카카오톡으로 바꾸려면 new 하는 곳을 전부 찾아 고쳐야 해요.</p>
  </section>

  <section id="container">
    <div class="read stack">
      <p class="eyebrow">2 · 컨테이너가 조립하기</p>
      <h2>스프링이 대신 만들고 연결해요</h2>
      <p>스프링은 앱이 시작할 때 <code>@Component</code>, <code>@Service</code>, <code>@Repository</code>, <code>@RestController</code>가 붙은 클래스를 찾아 객체를 만들어 보관해요. 이 보관함을 <strong>스프링 컨테이너</strong>, 컨테이너가 만들고 관리하는 객체를 <strong>빈</strong>(bean)이라고 해요. "다음"을 눌러 조립 순서를 보세요.</p>
    </div>
    <div class="panel">
      <div class="beans" id="beans">
        <div class="bean" data-b="controller"><b>CoffeeController</b><span>@RestController · CoffeeService가 필요</span></div>
        <div class="bean" data-b="service"><b>CoffeeService</b><span>@Service · 리포지토리, NoticeSender가 필요</span></div>
        <div class="bean" data-b="repo"><b>CoffeeMenuRepository</b><span>@Repository · 필요한 것 없음</span></div>
        <div class="bean" data-b="sender"><b>SmsNoticeSender</b><span>@Component · NoticeSender 구현</span></div>
      </div>
      <ol class="steps" id="steps"></ol>
      <div class="step-nav">
        <button class="btn" type="button" id="prev">이전</button>
        <button class="btn primary" type="button" id="next">다음</button>
      </div>
    </div>
    <div class="read stack">
      <p>실제 스프링이 테스트에서 객체를 만든 순서예요. 필요한 것부터 만들어졌는지 보세요.</p>
      <CiOutput lesson="spring-beans" key="creation" label="실제 생성 순서 보기" source="SpringBeansTest.creationOrder" />
      <CiOutput lesson="spring-beans" key="beans" label="컨테이너에 들어 있는 빈 목록 보기" source="SpringBeansTest.beanList" />
    </div>
  </section>

  <section id="di" class="read">
    <p class="eyebrow">3 · 의존성 주입</p>
    <h2>필요한 건 생성자로 받아요</h2>
    <p>서비스는 필요한 객체를 직접 new 하지 않고 <strong>생성자의 매개변수로 받기만</strong> 해요. 컨테이너가 알맞은 빈을 찾아 넣어 줘요. 이걸 <strong>의존성 주입</strong>(DI, Dependency Injection), 생성자로 받는 방식을 <strong>생성자 주입</strong>이라고 해요.</p>
    <pre set:text={codeService} />
    <ul>
      <li>서비스는 <code>NoticeSender</code> 인터페이스만 알아요. 컨테이너가 구현(SmsNoticeSender)을 넣어 줘요. 카카오톡으로 바꾸려면 구현 클래스만 바꾸면 되고 서비스 코드는 그대로예요.</li>
      <li>테스트에서는 스프링 없이 가짜를 넣을 수 있어요. 검증 테스트도 이렇게 확인해요.</li>
    </ul>
    <pre set:text={codeFake} />
    <p>생성자가 하나면 <code>@Autowired</code>를 붙이지 않아도 돼요. 필드에 <code>@Autowired</code>를 붙이는 <strong>필드 주입</strong>도 있지만, 아래 함정 때문에 생성자 주입을 권해요.</p>
  </section>

  <section id="singleton" class="read">
    <p class="eyebrow">4 · 싱글톤</p>
    <h2>빈은 하나만 만들어 모두가 함께 써요</h2>
    <p>스프링 빈은 기본적으로 <strong>싱글톤</strong>이에요. 클래스마다 객체를 딱 하나 만들고, 요청이 천 개 와도 그 하나를 함께 써요. 객체를 매번 만들지 않아서 빠르고 메모리도 아껴요.</p>
    <p>그래서 0장의 답은 <strong>2</strong>예요. kim의 요청과 lee의 요청이 같은 CoffeeService 객체의 같은 orderCount 필드를 올렸어요. 검증 테스트에서 요청 두 번 뒤 주문 수가 2 늘어난 걸 확인해요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>스코프</th><th>객체 수</th><th>쓰임</th></tr></thead>
        <tbody>
          <tr><td><strong>singleton</strong> (기본)</td><td>앱 전체에 하나</td><td>컨트롤러, 서비스, 리포지토리. 상태(필드 값)를 두지 않는 객체</td></tr>
          <tr><td>prototype</td><td>꺼낼 때마다 새로</td><td>상태를 가진 객체가 꼭 필요할 때 (드묾)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="callout warn"><strong>싱글톤 빈에는 요청마다 바뀌는 값을 필드로 두지 않아요.</strong> 동시에 들어온 요청 스레드들이 같은 필드를 함께 쓰면 값이 틀어질 수 있어요(<a href="/dev-lessons/lessons/process-and-thread/">프로세스와 스레드</a>의 경쟁 상태). 요청마다 다른 값은 메서드의 지역 변수나 매개변수로, 함께 세야 하는 값은 DB에 둬요.</p>
  </section>

  <section id="flow" class="read">
    <p class="eyebrow">5 · 요청이 지나가는 길</p>
    <h2>컨트롤러 → 서비스 → 리포지토리</h2>
    <p>스프링 웹 앱은 보통 세 층으로 나눠요. 이 구조를 알면 다른 레슨의 예제 코드가 어디에 있는 코드인지 보여요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>층</th><th>하는 일</th><th>이 레슨에서</th></tr></thead>
        <tbody>
          <tr><td>컨트롤러 (<code>@RestController</code>)</td><td>HTTP 요청을 받아 값을 꺼내고, 응답을 돌려줘요</td><td><code>GET /beans/coffee?user=kim&amp;menu=latte</code></td></tr>
          <tr><td>서비스 (<code>@Service</code>)</td><td>업무 규칙. 트랜잭션도 보통 여기서 시작해요</td><td>가격을 찾아 알림 문구를 만들어요</td></tr>
          <tr><td>리포지토리 (<code>@Repository</code>)</td><td>데이터를 저장하고 꺼내요. 실제 앱에서는 DB</td><td>메뉴 가격(이 레슨은 메모리의 Map)</td></tr>
        </tbody>
      </table>
    </div>
    <p>실제로 요청을 보내 받은 응답이에요. 먼저 어떤 문장이 나올지 예측해 보세요.</p>
    <CiOutput lesson="spring-beans" key="request" label="실제 요청과 응답 보기" source="SpringBeansTest.requestFlow" />
    <p>웹 서버(톰캣)는 요청마다 스레드를 하나 배정해 이 길을 따라가게 해요. 요청이 동시에 많이 오면 스레드 여러 개가 같은 싱글톤 빈을 동시에 지나가요. 4장의 주의가 중요한 이유예요.</p>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">6 · 함정</p>
    <h2>컨테이너 밖의 객체에는 아무 일도 안 일어나요</h2>
    <pre set:text={codeField} />
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>결과</th><th>대응</th></tr></thead>
        <tbody>
          <tr><td>빈 클래스를 직접 new</td><td>컨테이너가 모르는 객체라 주입도, @Transactional 같은 기능도 적용 안 됨</td><td>주입받아서 쓰기</td></tr>
          <tr><td>필드 주입</td><td>new로 만들면 null, 테스트에서 가짜를 넣기 어려움, final로 못 둠</td><td>생성자 주입</td></tr>
          <tr><td>싱글톤 빈에 요청별 상태</td><td>요청끼리 값이 섞임</td><td>지역 변수, 매개변수, DB</td></tr>
          <tr><td>같은 인터페이스의 구현이 둘</td><td>어느 것을 넣을지 몰라 앱이 시작되지 않음</td><td>@Primary나 @Qualifier로 지정</td></tr>
        </tbody>
      </table>
    </div>
    <p>"빈이어야 기능이 적용된다"는 점은 <a href="/dev-lessons/lessons/transactional-proxy/">@Transactional 동작 원리</a>에서 다시 나와요. 스프링은 빈을 만들 때 기능을 덧붙인 대리 객체(프록시)를 대신 넣기도 하는데, new로 만든 객체에는 그럴 기회가 없어요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "의존성 주입이 무엇이고 왜 쓰나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 의존성 주입은 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>의존성 주입은 객체가 필요한 다른 객체를 직접 만들지 않고 외부(스프링 컨테이너)에서 받아 쓰는 방식입니다. 컨테이너가 만들고 관리하는 객체를 빈이라고 합니다.</dd>
        <dt>원리</dt><dd>스프링은 시작할 때 @Component 계열 어노테이션이 붙은 클래스를 찾아 빈으로 만들고, 생성자 매개변수에 맞는 빈을 찾아 넣으며 필요한 것부터 순서대로 조립합니다. 빈은 기본적으로 싱글톤이라 앱 전체에서 하나를 함께 씁니다.</dd>
        <dt>트레이드오프</dt><dd>구현을 바꾸거나 테스트에서 가짜를 넣기 쉬워지고 생성 순서를 신경 쓰지 않아도 되지만, 싱글톤 빈에 요청별 상태를 두면 값이 섞이고, new로 만든 객체에는 주입과 프록시 기능이 적용되지 않습니다. 그래서 상태 없는 빈과 생성자 주입을 씁니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 알림 발송을 인터페이스로 두고 생성자 주입해서, 테스트에서는 가짜 발송기를 넣어 외부 호출 없이 검증했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 빈과 컨테이너, 생성자 주입, 싱글톤과 그 주의점을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 스프링 부트 컨테이너로 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>같은 빈을 두 번 꺼내면 같은 객체(싱글톤), 프로토타입은 매번 새 객체</li>
      <li>생성자로 받은 객체는 컨테이너의 바로 그 빈, 인터페이스 자리에 구현이 들어옴</li>
      <li>필요한 객체(리포지토리, 알림)가 먼저 만들어지고, 서비스, 컨트롤러 순</li>
      <li>new로 만든 객체는 필드 주입이 안 되어 null</li>
      <li>생성자 주입이면 스프링 없이 가짜를 넣어 테스트 가능</li>
      <li>요청 두 번이면 싱글톤 서비스의 주문 수가 2 증가, 요청은 컨트롤러 → 서비스 → 리포지토리를 거쳐 응답</li>
    </ul>
    <p><a href={test}>SpringBeansTest</a> · <a href={`${mainDir}/CoffeeService.java`}>CoffeeService</a></p>
    <RunLocally tests={['lab.devlessons.beans.SpringBeansTest']} docker={true} />
  </section>

  <footer>
    근거: Spring Framework 참조 문서의 The IoC Container, Dependency Injection, Bean Scopes. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .assume { font-size: 15px; border-left: 3px solid var(--accent); padding-left: 10px; }
  .beans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .bean { border: 1.5px dashed var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; opacity: 0.5; transition: all 0.2s; }
  .bean span { font-size: 13px; color: var(--muted); }
  .bean.found { opacity: 1; }
  .bean.made { opacity: 1; border-style: solid; border-color: var(--ok); background: var(--ok-soft); }
  .bean.now { border-color: var(--accent); background: var(--accent-soft); opacity: 1; border-style: solid; }
  .steps { margin: 0; padding-left: 22px; font-size: 14px; display: flex; flex-direction: column; gap: 4px; }
  .steps li { color: var(--muted); }
  .steps li.done { color: var(--ink); }
  .steps li.now { color: var(--accent); font-weight: 700; }
  .step-nav { display: flex; gap: 8px; }
  @media (max-width: 760px) { .beans { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { '1': '각자 1', '2': '2' };
  var pred = { p1: store('sb-p1') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + '. 정답은 2예요. 스프링 빈은 기본이 싱글톤이라 두 사람의 요청이 같은 객체를 써요. 4장에서 이유를 보세요.';
  }
  ['p1'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('sb-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 조립 단계: 각 단계에서 이미 만든 빈(made), 지금 만드는 빈(now), 찾기만 한 빈(found) */
  var steps = [
    { t: '앱 시작. 스프링이 클래스를 훑어 @Component 계열 어노테이션이 붙은 클래스 네 개를 찾아요. 아직 객체는 없어요.', found: ['controller', 'service', 'repo', 'sender'], made: [] },
    { t: 'CoffeeController를 만들려면 CoffeeService가 필요해요. CoffeeService를 만들려면 리포지토리와 NoticeSender가 필요해요. 필요한 것부터 만들어야겠네요.', found: ['controller', 'service', 'repo', 'sender'], made: [] },
    { t: 'CoffeeMenuRepository 생성. 필요한 게 없어서 바로 만들 수 있어요.', made: ['repo'], now: 'repo' },
    { t: 'SmsNoticeSender 생성. NoticeSender 자리에 넣을 빈이에요.', made: ['repo', 'sender'], now: 'sender' },
    { t: 'CoffeeService 생성. new CoffeeService(리포지토리 빈, SmsNoticeSender 빈)처럼 생성자에 넣어 줘요. 이게 의존성 주입이에요.', made: ['repo', 'sender', 'service'], now: 'service' },
    { t: 'CoffeeController 생성. CoffeeService 빈을 넣어 줘요. 조립 끝. 이제 요청을 받을 준비가 됐어요.', made: ['repo', 'sender', 'service', 'controller'], now: 'controller' },
    { t: '요청이 천 번 와도 이 네 객체를 그대로 써요. 다시 만들지 않아요(싱글톤).', made: ['repo', 'sender', 'service', 'controller'] }
  ];
  var i = 0;
  function render() {
    var s = steps[i];
    document.querySelectorAll('.bean').forEach(function (el) {
      var b = el.dataset.b;
      el.className = 'bean' + (s.now === b ? ' now' : (s.made || []).indexOf(b) >= 0 ? ' made' : (s.found || []).indexOf(b) >= 0 || i > 0 ? ' found' : '');
    });
    document.getElementById('steps').innerHTML = steps.map(function (x, k) {
      return '<li class="' + (k < i ? 'done' : k === i ? 'now' : '') + '">' + esc(k <= i ? x.t : '…') + '</li>';
    }).join('');
    document.getElementById('prev').disabled = i === 0;
    document.getElementById('next').disabled = i === steps.length - 1;
  }
  document.getElementById('next').addEventListener('click', function () { if (i < steps.length - 1) { i++; render(); } });
  document.getElementById('prev').addEventListener('click', function () { if (i > 0) { i--; render(); } });
  render();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '@Service가 붙은 클래스의 빈을 컨테이너에서 두 번 꺼내면?', o: ['같은 객체', '서로 다른 객체'], a: 0, e: '빈은 기본이 싱글톤이라 하나를 함께 써요.' },
    { q: '@Autowired 필드가 있는 서비스를 new로 직접 만들면 그 필드는?', o: ['컨테이너가 채워 준다', 'null이다'], a: 1, e: '컨테이너가 만든 객체에만 주입이 일어나요.' },
    { q: '싱글톤 서비스에 요청마다 바뀌는 사용자 이름을 필드로 저장하면?', o: ['요청마다 따로 저장된다', '동시에 온 요청끼리 값이 섞일 수 있다'], a: 1, e: '모든 요청이 같은 객체의 같은 필드를 써요. 요청별 값은 지역 변수나 매개변수로 다뤄요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('sb-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('sb-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
