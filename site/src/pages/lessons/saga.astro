---
import Base from '../../layouts/Base.astro';
import CiOutput from '../../components/CiOutput.astro';
import RunLocally from '../../components/RunLocally.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/saga/SagaTest.java`;
const impl = `${repo}/tree/main/verification/src/main/java/lab/devlessons/saga`;

const codePredict = `// 주문 서비스, 결제 서비스, 재고 서비스는 서로 다른 서버와 DB
public void placeOrder(String item, long amount) {
    long orderId = orderClient.create(item, amount);   // 주문 DB에 커밋
    paymentClient.charge(orderId, amount);              // 결제 DB에 커밋
    stockClient.reserve(item);                          // 재고 부족 예외!
}`;

const codeOrchestrator = `// 오케스트레이터: 순서를 정하고, 실패하면 보상을 역순으로 부른다
public long placeOrder(String item, long amount) {
    long orderId = orders.create(item, amount);    // 1. 주문 (PENDING)
    payments.charge(orderId, amount);              // 2. 결제 승인
    try {
        stock.reserve(item);                       // 3. 재고 차감
    } catch (OutOfStockException e) {
        payments.refund(orderId);                  // 2의 보상: 환불
        orders.cancel(orderId);                    // 1의 보상: 주문 취소
        return orderId;
    }
    orders.confirm(orderId);                       // 4. 주문 확정
    return orderId;
}`;

const codeChoreography = `// 코레오그래피: 각 서비스가 이벤트를 듣고 자기 일을 한 뒤 다음 이벤트를 낸다
결제 서비스   OrderCreated     → 결제 승인 → PaymentCompleted 발행
재고 서비스   PaymentCompleted → 재고 차감 → StockReserved 또는 StockFailed 발행
결제 서비스   StockFailed      → 환불     → PaymentRefunded 발행
주문 서비스   StockReserved    → 주문 확정
주문 서비스   PaymentRefunded  → 주문 취소`;

const codeRefund = `-- 환불 보상: CHARGED일 때만 바꾼다. 두 번 불려도 두 번째는 0행이 바뀐다
UPDATE saga_payment
   SET status = 'REFUNDED'
 WHERE order_id = ? AND status = 'CHARGED';`;
---
<Base title="분산 트랜잭션과 사가 · Dev Lessons" description="서비스마다 DB가 따로일 때 여러 단계를 하나처럼 묶는 법. 2PC의 한계와, 로컬 트랜잭션 + 보상 트랜잭션으로 이루어진 사가(오케스트레이션, 코레오그래피)를 직접 실패시키며 배워요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">동시성·분산 · 개념 학습 · 약 35분 · 선수 레슨: <a href="/dev-lessons/lessons/transactional-outbox/">트랜잭셔널 아웃박스</a></p>
    <h1>분산 트랜잭션과 사가</h1>
    <p class="lede">주문, 결제, 재고가 서로 다른 서비스라면 "결제는 됐는데 재고가 없다"는 상황을 어떻게 되돌릴까요? 하나의 @Transactional로는 묶을 수 없어요. 커머스와 핀테크 면접에서 자주 나오는 사가 패턴을 직접 실패시키며 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 커밋과 롤백(<a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>), 이벤트와 메시지 브로커, 최소 한 번 전달(<a href="/dev-lessons/lessons/transactional-outbox/">트랜잭셔널 아웃박스</a>), 멱등성(<a href="/dev-lessons/lessons/idempotency/">멱등성과 중복 요청 방지</a>).</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#background"><span>1</span>분산 트랜잭션과 2PC</a>
      <a href="#saga"><span>2</span>사가와 보상</a>
      <a href="#sim"><span>3</span>직접 실패시키기</a>
      <a href="#styles"><span>4</span>오케스트레이션과 코레오그래피</a>
      <a href="#traps"><span>5</span>함정</a>
      <a href="#choose"><span>6</span>선택 기준</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>재고가 없으면 결제는 어떻게 될까요?</h2>
    <p>주문, 결제, 재고는 각자 서버와 DB를 가진 별도 서비스예요. 주문과 결제가 각자 커밋된 뒤 재고 차감에서 예외가 났어요.</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">내 예측</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="auto" aria-pressed="false">예외가 나면 결제도 자동으로 롤백된다</button>
          <button class="chip" type="button" data-v="manual" aria-pressed="false">누군가 환불을 따로 해야 한다</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 2장에서 답을 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="background" class="read">
    <p class="eyebrow">1 · 분산 트랜잭션과 2PC</p>
    <h2>DB가 여럿이면 커밋도 여럿이에요</h2>
    <p>서비스를 기능별로 나눠 각자 서버와 DB를 갖게 하는 구조를 <strong>마이크로서비스</strong>라고 해요. 이때 각 서비스가 자기 DB에서 하는 트랜잭션을 <strong>로컬 트랜잭션</strong>이라고 해요. 여러 DB에 걸친 작업을 하나처럼 묶으려는 것이 <strong>분산 트랜잭션</strong>이에요.</p>
    <p>고전적인 방법은 <strong>2PC</strong>(two-phase commit, 두 단계 커밋)예요. 조정자(coordinator) 하나가 모든 참여 DB에 두 번 물어요.</p>
    <div class="diagram" role="img" aria-label="2PC: 1단계에서 조정자가 모든 DB에 준비를 묻고, 모두 준비되면 2단계에서 커밋을 지시한다. 그 사이 각 DB는 락을 잡고 기다린다.">
      <svg viewBox="0 0 640 220" xmlns="http://www.w3.org/2000/svg">
        <rect class="svg-box" x="20" y="85" width="130" height="50" rx="10" />
        <text class="svg-tb" x="85" y="115" text-anchor="middle">조정자</text>
        <rect class="svg-box" x="470" y="20" width="150" height="44" rx="8" />
        <text class="svg-tb" x="545" y="47" text-anchor="middle">주문 DB</text>
        <rect class="svg-box" x="470" y="88" width="150" height="44" rx="8" />
        <text class="svg-tb" x="545" y="115" text-anchor="middle">결제 DB</text>
        <rect class="svg-box" x="470" y="156" width="150" height="44" rx="8" />
        <text class="svg-tb" x="545" y="183" text-anchor="middle">재고 DB</text>
        <path class="svg-line" d="M150 100 L467 42" /><path class="svg-line" d="M150 110 L467 110" /><path class="svg-line" d="M150 120 L467 178" />
        <text class="svg-t" x="200" y="62">① 준비됐나요? (PREPARE)</text>
        <text class="svg-t" x="215" y="104">모두 "예" → ② 커밋 (COMMIT)</text>
        <text class="svg-m" x="215" y="196">①과 ② 사이: 각 DB는 락을 잡은 채 기다림</text>
      </svg>
    </div>
    <p>2PC는 모든 DB가 함께 커밋하거나 함께 롤백하게 해 주지만, 마이크로서비스에서는 잘 쓰지 않아요.</p>
    <ul>
      <li><strong>기다림:</strong> 1단계와 2단계 사이 모든 참여자가 락을 잡고 기다려요. 조정자가 그 사이에 죽으면 참여자는 커밋할지 롤백할지 모른 채 락을 계속 잡고 있어요.</li>
      <li><strong>지원 범위:</strong> 모든 참여자가 2PC 규약(XA 등)을 지원해야 해요. 메시지 브로커나 외부 결제 API(PG사)는 대개 지원하지 않아요.</li>
      <li><strong>기본값:</strong> PostgreSQL도 2PC용 <code>PREPARE TRANSACTION</code>이 기본 설정에서 꺼져 있어요(<code>max_prepared_transactions = 0</code>).</li>
    </ul>
  </section>

  <section id="saga" class="read">
    <p class="eyebrow">2 · 사가와 보상</p>
    <h2>되돌리기 대신 "반대 동작"을 실행해요</h2>
    <p>예측의 답은 <strong>"누군가 환불을 따로 해야 한다"</strong>예요. 결제 서비스는 이미 자기 DB에 커밋했어요. 다른 서버에서 난 예외는 이 커밋을 되돌릴 수 없어요.</p>
    <p><strong>사가</strong>(saga)는 큰 작업을 <strong>로컬 트랜잭션 여러 개</strong>로 나눠 차례로 실행하고, 중간에 실패하면 이미 성공한 단계마다 <strong>보상 트랜잭션</strong>(compensating transaction, 그 단계의 효과를 상쇄하는 반대 동작)을 역순으로 실행하는 방법이에요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>단계 (로컬 트랜잭션)</th><th>보상</th></tr></thead>
        <tbody>
          <tr><td>1. 주문 생성 (PENDING)</td><td>주문 취소 (CANCELLED)</td></tr>
          <tr><td>2. 결제 승인 (CHARGED)</td><td>환불 (REFUNDED)</td></tr>
          <tr><td>3. 재고 차감</td><td>재고 복원</td></tr>
          <tr><td>4. 주문 확정 (CONFIRMED)</td><td>(마지막 단계라 보상 없음)</td></tr>
        </tbody>
      </table>
    </div>
    <p>보상은 롤백이 아니에요. 롤백은 아무 일도 없었던 것처럼 지우지만, 보상은 <strong>새로운 동작을 하나 더</strong> 해요. 그래서 결제 행은 사라지지 않고 "환불됨"으로 남아요. 돈이 오간 기록은 남아야 하니 오히려 맞는 동작이에요.</p>
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">3 · 직접 실패시키기</p>
      <h2>어느 단계에서 실패할지 골라 보세요</h2>
      <p>방식과 실패 지점을 고르고 "다음"을 눌러요. 각 서비스의 DB 상태가 어떻게 바뀌는지 보세요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">방식</span>
        <div class="seg" id="style">
          <button type="button" data-v="orch" aria-pressed="true">오케스트레이션</button>
          <button type="button" data-v="chor" aria-pressed="false">코레오그래피</button>
        </div>
      </div>
      <div class="field">
        <span class="label">실패 지점</span>
        <div class="seg" id="fail">
          <button type="button" data-v="none" aria-pressed="true">실패 없음</button>
          <button type="button" data-v="pay" aria-pressed="false">결제 실패 (한도 초과)</button>
          <button type="button" data-v="stock" aria-pressed="false">재고 차감 실패</button>
        </div>
      </div>
      <div class="sg-grid">
        <div class="pane">
          <span class="label">진행</span>
          <ol class="path-steps" id="steps"></ol>
        </div>
        <div class="pane">
          <span class="label">각 서비스의 DB</span>
          <div class="svc-list">
            <div class="svc"><span class="svc-name">주문</span><span class="svc-state" id="st-order">-</span></div>
            <div class="svc"><span class="svc-name">결제</span><span class="svc-state" id="st-pay">-</span></div>
            <div class="svc"><span class="svc-name">재고 (케이크)</span><span class="svc-state" id="st-stock">1개</span></div>
          </div>
          <p class="verdict" id="sim-verdict"></p>
        </div>
      </div>
      <div class="step-nav">
        <button class="btn" type="button" id="s-reset">처음으로</button>
        <button class="btn primary" type="button" id="s-next">다음</button>
        <button class="btn" type="button" id="s-all">끝까지</button>
      </div>
    </div>
    <div class="read stack">
      <p>실제 PostgreSQL에서 재고가 0인 케이크를 주문한 결과예요. 각 단계는 따로 커밋돼요.</p>
      <CiOutput lesson="saga" key="compensate" label="실제 결과 보기: 재고 차감 실패와 보상" source="SagaTest.orchestrationCompensatesInReverse" />
    </div>
  </section>

  <section id="styles" class="read">
    <p class="eyebrow">4 · 오케스트레이션과 코레오그래피</p>
    <h2>누가 순서를 정하나요?</h2>
    <p><strong>오케스트레이션</strong>(orchestration)은 지휘자(오케스트레이터) 하나가 순서를 정해 각 서비스를 부르고, 실패하면 보상을 불러요.</p>
    <pre set:text={codeOrchestrator} />
    <p><strong>코레오그래피</strong>(choreography, 안무)는 지휘자가 없어요. 각 서비스가 이벤트를 듣고 자기 일을 한 뒤 다음 이벤트를 내요.</p>
    <pre set:text={codeChoreography} />
    <CiOutput lesson="saga" key="choreography" label="실제 결과 보기: 코레오그래피에서 오간 이벤트" source="SagaTest.choreographyReachesSameState" />
    <div class="pc">
      <div class="pro"><h4>오케스트레이션</h4><ul><li>흐름이 한 곳에 있어 읽기 쉽고 단계가 많아도 관리돼요</li><li>지휘자가 상태를 저장해 두면 중간에 죽어도 이어서 할 수 있어요</li><li>지휘자에 로직이 몰려요</li></ul></div>
      <div class="con"><h4>코레오그래피</h4><ul><li>서비스끼리 직접 몰라도 돼서 결합이 느슨해요</li><li>단계가 2~3개로 적을 때 단순해요</li><li>흐름이 여러 서비스에 흩어져 전체를 보기 어렵고, 이벤트가 꼬리를 물면 디버깅이 힘들어요</li></ul></div>
    </div>
    <p>실무에서는 각 단계 요청이나 이벤트를 메시지 브로커로 주고받고, 보내는 쪽은 <a href="/dev-lessons/lessons/transactional-outbox/">아웃박스</a>를 써서 "커밋했는데 다음 단계로 못 넘어감"을 막아요. 이 레슨의 검증 코드는 흐름에 집중하려고 같은 프로세스 안에서 바로 호출해요.</p>
    <p class="muted">전체 코드: <a href={impl}>saga 패키지</a></p>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">5 · 함정</p>
    <h2>사가는 트랜잭션이 아니에요</h2>
    <h3>격리가 없어요</h3>
    <p>각 단계가 바로 커밋되니, 보상 전까지 다른 요청은 <strong>중간 상태</strong>를 봐요. 고객이 결제 내역을 열면 곧 환불될 결제가 "승인"으로 보일 수 있어요.</p>
    <CiOutput lesson="saga" key="no-isolation" label="실제 결과 보기: 결제 뒤 다른 요청이 본 상태" source="SagaTest.sagaHasNoIsolation" />
    <p>그래서 주문을 처음부터 CONFIRMED가 아니라 <strong>PENDING</strong>으로 만들어요. "아직 확정 아님"을 상태로 드러내서, 다른 기능(배송, 정산)이 PENDING 주문은 건드리지 않게 하는 거예요.</p>
    <h3>보상은 멱등해야 해요</h3>
    <p>보상 요청도 메시지로 오가니 두 번 올 수 있어요(최소 한 번 전달). 환불이 두 번 되면 큰일이에요. 상태 조건을 걸어 두 번째 요청은 아무것도 바꾸지 않게 해요.</p>
    <pre set:text={codeRefund} />
    <h3>보상도 실패할 수 있어요</h3>
    <p>환불 API가 장애 중이면 보상이 실패해요. 보상은 성공할 때까지 재시도하고, 끝내 실패하면 사람이 처리하도록 알림을 남겨요. 메일 발송처럼 <strong>되돌릴 수 없는 단계</strong>는 실패할 수 있는 단계들 뒤, 사가의 마지막에 둬요.</p>
  </section>

  <section id="choose" class="read">
    <p class="eyebrow">6 · 선택 기준</p>
    <h2>상황별 추천</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>추천</th></tr></thead>
        <tbody>
          <tr><td>모든 데이터가 한 DB에 있음</td><td>사가가 필요 없어요. @Transactional 하나로 묶어요</td></tr>
          <tr><td>DB가 여럿이지만 모두 같은 팀의 DB이고 XA를 지원</td><td>2PC도 가능하지만 락 대기와 조정자 장애를 감수해야 해요</td></tr>
          <tr><td>서비스·외부 API에 걸친 주문, 결제 흐름</td><td>사가. 단계가 많거나 흐름이 자주 바뀌면 오케스트레이션</td></tr>
          <tr><td>서비스 2~3개가 이벤트로 느슨하게 이어짐</td><td>코레오그래피</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "주문, 결제, 재고 서비스가 나뉘어 있을 때 데이터 정합성을 어떻게 맞추나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 서비스마다 DB가 달라서 하나의 트랜잭션으로 묶을 수 없으니 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>서비스마다 DB가 달라 하나의 로컬 트랜잭션으로 묶을 수 없으므로 사가 패턴을 씁니다. 사가는 로컬 트랜잭션을 차례로 실행하고, 실패하면 이미 성공한 단계의 보상 트랜잭션을 역순으로 실행해 정합성을 맞춥니다.</dd>
        <dt>원리</dt><dd>주문 생성, 결제 승인, 재고 차감을 각자 커밋하고, 재고 차감이 실패하면 환불과 주문 취소를 실행합니다. 흐름은 오케스트레이터가 지휘하거나(오케스트레이션), 서비스들이 이벤트를 주고받으며 이어갑니다(코레오그래피). 단계 사이 메시지는 아웃박스로 유실을 막습니다.</dd>
        <dt>트레이드오프</dt><dd>2PC는 원자성을 주지만 락을 잡고 기다리고 조정자 장애에 약하며, 브로커나 외부 API가 지원하지 않습니다. 사가는 가용성이 높지만 격리가 없어 중간 상태가 보이므로 PENDING 같은 상태로 드러내고, 보상은 재시도될 수 있어 멱등하게 만들어야 하며, 보상 실패 시 재시도와 수동 처리가 필요합니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 재고 0인 상품 주문으로 보상 흐름을 테스트해 결제가 REFUNDED, 주문이 CANCELLED로 남고, 환불 보상을 두 번 불러도 한 번만 환불되는 것을 확인했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 보상 트랜잭션, 2PC를 쓰지 않는 이유, 격리 없음과 PENDING 상태, 보상 멱등성을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 스프링 부트와 PostgreSQL에서, 단계마다 따로 커밋하는 서비스 셋으로 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>오케스트레이션: 모든 단계가 성공하면 주문 확정, 결제 승인, 재고 차감</li>
      <li>재고 차감이 실패하면 결제 환불 → 주문 취소 순서로 보상이 실행되고, 결제 행은 지워지지 않고 REFUNDED로 남는다</li>
      <li>결제 뒤 재고 차감 전에 다른 요청은 CHARGED를 본다 (격리 없음)</li>
      <li>환불 보상이 두 번 불려도 한 번만 환불된다</li>
      <li>코레오그래피도 같은 보상 흐름과 최종 상태가 된다</li>
      <li>PostgreSQL 16 기본 설정의 max_prepared_transactions는 0이다</li>
    </ul>
    <p class="muted">시뮬레이터의 "결제 실패" 경우는 같은 규칙(성공한 단계만 역순 보상)을 적용한 것이고, 테스트는 재고 차감 실패 경우를 확인해요.</p>
    <p><a href={test}>SagaTest</a></p>
    <RunLocally tests={['lab.devlessons.saga.SagaTest']} docker />
  </section>

  <footer>
    근거: PostgreSQL 16 문서(PREPARE TRANSACTION, max_prepared_transactions), Microsoft Azure 아키텍처 센터의 Saga 패턴 문서. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .sg-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 16px; }
  .pane { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .svc-list { display: flex; flex-direction: column; gap: 8px; }
  .svc { display: flex; justify-content: space-between; gap: 8px; border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; font-size: 14px; }
  .svc-name { color: var(--muted); }
  .svc-state { font-family: var(--font-mono); font-weight: 700; text-align: right; }
  .svc-state.comp { color: var(--warn); }
  .svc-state.ok { color: var(--ok); }
  .path-steps { margin: 0; padding-left: 22px; font-size: 14px; display: flex; flex-direction: column; gap: 6px; }
  .path-steps li { color: var(--muted); }
  .path-steps li.done { color: var(--ink); }
  .path-steps li.now { color: var(--accent); font-weight: 700; }
  .path-steps .who { font-family: var(--font-mono); font-size: 12px; padding: 1px 6px; border-radius: 4px; background: var(--code-bg); margin-right: 4px; }
  .step-nav { display: flex; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 760px) { .sg-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var pred = { p1: store('sg-p1') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 === 'manual' ? '누군가 환불을 따로 해야 한다' : '자동으로 롤백된다') + '. 정답은 "누군가 환불을 따로 해야 한다"예요. 이유는 2장에 있어요.';
  }
  ['p1'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('sg-' + k, v); showPred(); });
  });
  showPred();

  /* 3. 시뮬레이터: 단계 = [누가, 설명, {바뀌는 상태}] */
  function script(style, fail) {
    var o = style === 'orch';
    var s = [];
    function who(svc) { return o ? '지휘자→' + svc : svc; }
    s.push([who('주문'), '주문 생성, 커밋' + (o ? '' : ' → OrderCreated 발행'), { order: 'PENDING' }]);
    if (fail === 'pay') {
      s.push([who('결제'), '결제 실패 (한도 초과). 결제 DB는 바뀌지 않음' + (o ? '' : ' → PaymentFailed 발행'), { pay: '실패 (기록 없음)' }]);
      s.push([who('주문'), '보상: 주문 취소, 커밋', { order: 'CANCELLED', comp: 'order' }]);
      return s;
    }
    s.push([who('결제'), '결제 승인, 커밋' + (o ? '' : ' → PaymentCompleted 발행'), { pay: 'CHARGED' }]);
    if (fail === 'stock') {
      s.push([who('재고'), '재고 차감 실패 (0개)' + (o ? '' : ' → StockFailed 발행'), {}]);
      s.push([who('결제'), '보상: 환불, 커밋' + (o ? '' : ' → PaymentRefunded 발행'), { pay: 'REFUNDED', comp: 'pay' }]);
      s.push([who('주문'), '보상: 주문 취소, 커밋', { order: 'CANCELLED', comp: 'order' }]);
      return s;
    }
    s.push([who('재고'), '재고 차감, 커밋' + (o ? '' : ' → StockReserved 발행'), { stock: '0개' }]);
    s.push([who('주문'), '주문 확정, 커밋', { order: 'CONFIRMED' }]);
    return s;
  }
  var style = 'orch', fail = 'none', idx = -1;
  function render() {
    var st = script(style, fail);
    var state = { order: '-', pay: '-', stock: '1개' }, comp = {};
    for (var i = 0; i <= idx; i++) {
      var ch = st[i][2];
      ['order', 'pay', 'stock'].forEach(function (k) { if (ch[k]) state[k] = ch[k]; });
      if (ch.comp) comp[ch.comp] = true;
    }
    document.getElementById('steps').innerHTML = st.map(function (s, i) {
      return '<li class="' + (i < idx ? 'done' : i === idx ? 'now' : '') + '">' + (i <= idx ? '<span class="who">' + esc(s[0]) + '</span>' + esc(s[1]) : '…') + '</li>';
    }).join('');
    [['order', 'st-order'], ['pay', 'st-pay'], ['stock', 'st-stock']].forEach(function (p) {
      var el = document.getElementById(p[1]);
      el.textContent = state[p[0]];
      el.className = 'svc-state' + (comp[p[0]] ? ' comp' : state[p[0]] === 'CONFIRMED' ? ' ok' : '');
    });
    var v = '';
    if (idx === st.length - 1) {
      if (fail === 'none') v = '모든 단계 성공. 각 단계가 따로 커밋됐지만 결과는 하나의 주문처럼 맞아요.';
      else if (fail === 'pay') v = '결제는 커밋된 적이 없으니 보상할 필요가 없어요. 성공한 단계(주문)만 보상해요.';
      else v = '성공한 단계(결제, 주문)를 역순으로 보상했어요. 결제는 지워지지 않고 REFUNDED로 남아요.';
    }
    document.getElementById('sim-verdict').textContent = v;
    document.getElementById('s-next').disabled = idx >= st.length - 1;
  }
  function reset() { idx = -1; render(); }
  document.getElementById('s-next').addEventListener('click', function () { if (idx < script(style, fail).length - 1) { idx++; render(); } });
  document.getElementById('s-all').addEventListener('click', function () { idx = script(style, fail).length - 1; render(); });
  document.getElementById('s-reset').addEventListener('click', reset);
  pressGroup(document.getElementById('style'), function (v) { style = v; reset(); });
  pressGroup(document.getElementById('fail'), function (v) { fail = v; reset(); });
  reset();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '사가에서 3단계(재고 차감)가 실패했다. 보상은 어떤 순서로 실행하나?', o: ['1단계 → 2단계 보상', '2단계 → 1단계 보상', '3단계만 보상'], a: 1, e: '이미 성공한 단계를 역순으로 보상해요. 실패한 3단계는 커밋되지 않았으니 보상할 게 없어요.' },
    { q: '보상 트랜잭션과 롤백의 차이로 맞는 것은?', o: ['보상은 기록을 지운다', '보상은 반대 동작을 새로 실행해 기록이 남는다', '둘은 같다'], a: 1, e: '결제는 지워지지 않고 REFUNDED 상태로 남아요. 돈이 오간 기록은 남아야 하니 맞는 동작이에요.' },
    { q: '2PC를 마이크로서비스에서 잘 쓰지 않는 이유가 아닌 것은?', o: ['준비와 커밋 사이에 락을 잡고 기다린다', '메시지 브로커·외부 API가 대개 지원하지 않는다', '원자성을 보장하지 못한다'], a: 2, e: '2PC는 원자성을 보장해요. 문제는 기다림, 조정자 장애, 지원 범위예요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('sg-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('sg-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
