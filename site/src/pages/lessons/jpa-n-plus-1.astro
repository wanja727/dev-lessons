---
import Base from '../../layouts/Base.astro';
---
<Base title="JPA N+1 문제 · Dev Lessons" description="JPA를 처음 보는 사람도 따라올 수 있는 N+1 문제 대화형 레슨. 쿼리 수 시뮬레이터, EAGER의 함정, fetch join과 배치 페치, 페이징 함정.">
<style is:global>
/* Layout: 한 줄 읽기 칼럼(720px) + 실습 위젯만 넓게(960px). 쿼리 = 주황 눈금으로 일관되게 표시 */
:root {
  --bg: #f4f6f8;
  --surface: #ffffff;
  --ink: #17212c;
  --muted: #5a6775;
  --line: #d9dfe6;
  --accent: #1f5bb8;
  --accent-soft: #e4ecf8;
  --query: #c94a12;
  --query-soft: #fbe9df;
  --ok: #2a7d3c;
  --ok-soft: #e2f2e5;
  --warn: #9a6a00;
  --warn-soft: #fbf1d9;
  --code-bg: #eef1f5;
  --team-a: #3a6fd1; --team-b: #2a8a63; --team-c: #b5552b; --team-d: #8a4fb5;
  --font-body: "IBM Plex Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f141a; --surface: #161d26; --ink: #e5ecf3; --muted: #94a2b1; --line: #2a3441;
    --accent: #7ea6ff; --accent-soft: #1c2b45; --query: #ff8d52; --query-soft: #3a2116;
    --ok: #63c47f; --ok-soft: #173123; --warn: #e3b341; --warn-soft: #34290f; --code-bg: #1b2430;
    --team-a: #7ea6ff; --team-b: #5fcf9e; --team-c: #ff9d6e; --team-d: #c79bf0;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0f141a; --surface: #161d26; --ink: #e5ecf3; --muted: #94a2b1; --line: #2a3441;
  --accent: #7ea6ff; --accent-soft: #1c2b45; --query: #ff8d52; --query-soft: #3a2116;
  --ok: #63c47f; --ok-soft: #173123; --warn: #e3b341; --warn-soft: #34290f; --code-bg: #1b2430;
  --team-a: #7ea6ff; --team-b: #5fcf9e; --team-c: #ff9d6e; --team-d: #c79bf0;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink); font-family: var(--font-body);
  font-size: 16px; line-height: 1.75; word-break: keep-all; overflow-wrap: anywhere;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 32px 80px;
}
main { max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 56px; }
.read { max-width: 720px; }
h1, h2, h3 { text-wrap: balance; line-height: 1.3; margin: 0; }
h1 { font-size: clamp(30px, 5vw, 42px); font-weight: 700; letter-spacing: -0.02em; }
h2 { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; }
h3 { font-size: 18px; font-weight: 700; }
p { margin: 0; }
section { display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 16px; }
.eyebrow { font-family: var(--font-mono); font-size: 13px; color: var(--accent); letter-spacing: 0.04em; }
.muted { color: var(--muted); }
.assume { font-size: 15px; border-left: 3px solid var(--accent); padding-left: 10px; }
code, .mono { font-family: var(--font-mono); font-size: 0.9em; }
:not(pre) > code { background: var(--code-bg); padding: 1px 6px; border-radius: 4px; }
pre {
  margin: 0; background: var(--code-bg); border-radius: 8px; padding: 14px 16px;
  font-family: var(--font-mono); font-size: 13.5px; line-height: 1.6; overflow-x: auto;
}
.c-key { color: var(--accent); } .c-com { color: var(--muted); } .c-q { color: var(--query); font-weight: 500; }
a { color: var(--accent); }
button, select, input, textarea { font: inherit; color: inherit; }
button:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 2px;
}
.btn {
  border: 1px solid var(--line); background: var(--surface); border-radius: 8px;
  padding: 8px 14px; cursor: pointer; font-size: 15px;
}
.btn:hover { border-color: var(--accent); }
.btn.primary { background: var(--accent); color: var(--surface); border-color: var(--accent); }
.btn[disabled] { opacity: 0.45; cursor: default; }

/* 머리말 */
header.top { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
.lede { font-size: 18px; color: var(--muted); }
.toc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
.toc a {
  text-decoration: none; font-size: 14px; color: var(--ink); background: var(--surface);
  border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px;
}
.toc a span { font-family: var(--font-mono); color: var(--muted); margin-right: 6px; }

/* 상자 */
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
.callout { border-radius: 8px; padding: 14px 16px; background: var(--accent-soft); }
.callout.warn { background: var(--warn-soft); }
.callout.ok { background: var(--ok-soft); }
.callout strong { font-weight: 700; }
.choice-row { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 6px 14px;
  cursor: pointer; font-size: 15px;
}
.chip[aria-pressed="true"] { background: var(--accent); color: var(--surface); border-color: var(--accent); }
.label { font-size: 13px; color: var(--muted); letter-spacing: 0.03em; }

/* 다이어그램 */
.diagram { overflow-x: auto; }
.diagram svg { display: block; min-width: 620px; width: 100%; height: auto; }
.svg-box { fill: var(--surface); stroke: var(--line); stroke-width: 1.5; }
.svg-head { fill: var(--accent-soft); }
.svg-t { fill: var(--ink); font-family: var(--font-mono); font-size: 13px; }
.svg-tb { fill: var(--ink); font-family: var(--font-body); font-size: 14px; font-weight: 700; }
.svg-m { fill: var(--muted); font-family: var(--font-body); font-size: 12.5px; }
.svg-line { stroke: var(--muted); stroke-width: 1.5; fill: none; }
.svg-acc { stroke: var(--accent); stroke-width: 2; fill: none; }

/* 지연 로딩 미니 실습 */
.lazy-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.team-card { border: 1px solid var(--line); border-radius: 10px; padding: 14px; display: flex; flex-direction: column; gap: 10px; background: var(--surface); }
.team-card h4 { margin: 0; font-size: 16px; }
.box {
  border: 1.5px dashed var(--muted); border-radius: 8px; padding: 10px; font-size: 14px; color: var(--muted);
  min-height: 64px; display: flex; align-items: center; justify-content: center; text-align: center;
}
.box.filled { border-style: solid; border-color: var(--ok); color: var(--ink); background: var(--ok-soft); justify-content: flex-start; text-align: left; }

/* 쿼리 로그 */
.log {
  background: var(--code-bg); border-radius: 8px; padding: 10px 12px; font-family: var(--font-mono);
  font-size: 12.5px; line-height: 1.6; max-height: 300px; overflow: auto; display: flex; flex-direction: column; gap: 2px;
}
.log .row { display: grid; grid-template-columns: 2.4em 1fr; gap: 8px; white-space: pre-wrap; animation: in 0.25s ease-out; }
.log .row .n { color: var(--query); text-align: right; }
.log .row.note { color: var(--muted); grid-template-columns: 1fr; }
.log .row.warn { color: var(--warn); grid-template-columns: 1fr; }
.log .empty { color: var(--muted); }
@keyframes in { from { opacity: 0.2; transform: translateY(2px); } to { opacity: 1; transform: none; } }

/* 시뮬레이터 */
.sim { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 20px; }
.controls { display: flex; flex-direction: column; gap: 18px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field .row-line { display: flex; justify-content: space-between; align-items: baseline; }
.seg { display: flex; flex-wrap: wrap; gap: 6px; }
.seg button { border: 1px solid var(--line); background: var(--surface); border-radius: 8px; padding: 6px 10px; cursor: pointer; font-size: 14px; }
.seg button[aria-pressed="true"] { background: var(--accent); color: var(--surface); border-color: var(--accent); }
input[type="range"] { width: 100%; accent-color: var(--accent); }
.check { display: flex; gap: 8px; align-items: center; font-size: 15px; }
.check input { width: 18px; height: 18px; accent-color: var(--accent); }
.result { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.count-line { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.big { font-family: var(--font-mono); font-size: 52px; font-weight: 500; line-height: 1; color: var(--query); font-variant-numeric: tabular-nums; }
.big.good { color: var(--ok); }
.formula { font-family: var(--font-mono); font-size: 15px; color: var(--muted); }
.lane { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; min-height: 18px; }
.tick { width: 10px; height: 18px; border-radius: 2px; background: var(--query); }
.tick.first { background: var(--accent); }
.verdict { font-size: 15px; }

/* 단계 넘기기 */
.stepper { display: flex; flex-direction: column; gap: 14px; }
.step-dots { display: flex; gap: 6px; flex-wrap: wrap; }
.step-dots button { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 3px 12px; font-family: var(--font-mono); font-size: 13px; cursor: pointer; }
.step-dots button[aria-current="step"] { background: var(--accent); color: var(--surface); border-color: var(--accent); }
.step-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
.flow { display: flex; flex-direction: column; gap: 8px; }
.flow .node { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; font-size: 14px; background: var(--surface); opacity: 0.38; transition: opacity 0.2s; }
.flow .node.on { opacity: 1; border-color: var(--accent); }
.flow .node.hot { border-color: var(--query); background: var(--query-soft); }
.flow .arrow { text-align: center; color: var(--muted); font-size: 13px; line-height: 1; }
.step-nav { display: flex; gap: 8px; }

/* 탭 */
.tabs { display: flex; gap: 6px; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
.tabs button { border: 0; background: none; padding: 10px 12px; cursor: pointer; font-size: 15px; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
.tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); font-weight: 700; }
.tab-panel { display: flex; flex-direction: column; gap: 12px; padding-top: 4px; }
.pc { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.pc div { border-radius: 8px; padding: 12px 14px; font-size: 15px; }
.pc .pro { background: var(--ok-soft); } .pc .con { background: var(--warn-soft); }
.pc h4 { margin: 0 0 4px; font-size: 14px; }
.pc ul, .read ul { margin: 0; padding-left: 20px; }

/* 표 */
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 15px; min-width: 560px; }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-size: 13px; color: var(--muted); font-weight: 500; letter-spacing: 0.03em; }

/* 페이징 */
.rows { display: flex; flex-direction: column; gap: 3px; font-family: var(--font-mono); font-size: 13px; }
.rows .r { display: grid; grid-template-columns: 3em 6em 1fr; gap: 10px; padding: 4px 10px; border-radius: 4px; border-left: 4px solid var(--c); background: var(--surface); }
.rows .r.cut { opacity: 0.3; }
.rows .limit { border-top: 2px dashed var(--query); margin: 4px 0; position: relative; }
.rows .limit span { position: absolute; right: 0; top: -11px; background: var(--bg); color: var(--query); font-size: 12px; padding: 0 6px; }
.page-out { display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
.page-out .bad { color: var(--query); font-weight: 700; }

/* 체크 */
.quiz { display: flex; flex-direction: column; gap: 10px; }
.quiz .opts { display: flex; flex-wrap: wrap; gap: 8px; }
.quiz .feedback { font-size: 15px; border-radius: 8px; padding: 10px 14px; }
.quiz .feedback.right { background: var(--ok-soft); }
.quiz .feedback.wrong { background: var(--query-soft); }
textarea { width: 100%; min-height: 120px; border: 1px solid var(--line); border-radius: 8px; padding: 12px; background: var(--surface); resize: vertical; line-height: 1.7; }
.model { display: flex; flex-direction: column; gap: 10px; }
.model dl { margin: 0; display: grid; grid-template-columns: 7em 1fr; gap: 8px 14px; }
.model dt { font-weight: 700; } .model dd { margin: 0; }

footer { color: var(--muted); font-size: 14px; max-width: 720px; }

@media (max-width: 760px) {
  .sim, .step-body, .pc { grid-template-columns: minmax(0, 1fr); }
  .lazy-grid { grid-template-columns: minmax(0, 1fr); }
  .model dl { grid-template-columns: 1fr; }
  .big { font-size: 42px; }
}
@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; }
}

[hidden] { display: none !important; }
.back { font-size: 14px; color: var(--muted); text-decoration: none; }
.back:hover { color: var(--accent); }
</style>
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">JPA 단원 · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/proxy-lazy-loading/">프록시와 지연 로딩</a></p>
    <h1>JPA N+1 문제</h1>
    <p class="lede">JPA를 처음 보는 사람도 끝까지 따라올 수 있게 만든 학습 페이지예요. 읽기만 하지 말고, 중간중간 예측하고 직접 눌러 보세요. 예측이 틀려도 괜찮아요. 틀린 예측이 오히려 더 오래 남아요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 엔티티, 리포지토리, JPQL(<a href="/dev-lessons/lessons/jpa-basics/">JPA 첫걸음</a>), 프록시와 지연 로딩(<a href="/dev-lessons/lessons/proxy-lazy-loading/">프록시와 지연 로딩</a>), SQL의 JOIN과 LIMIT.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#background"><span>1</span>JPA와 연관관계</a>
      <a href="#lazy"><span>2</span>지연 로딩</a>
      <a href="#sim"><span>3</span>쿼리 세어 보기</a>
      <a href="#eager"><span>4</span>EAGER의 함정</a>
      <a href="#fix"><span>5</span>해결 방법</a>
      <a href="#paging"><span>6</span>페이징 함정</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <!-- 0 -->
  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>DB에 몇 번 물어볼까요?</h2>
    <p>팀이 10개 있고, 팀마다 멤버가 여러 명 있어요. 아래 코드는 팀 목록을 가져온 뒤 팀마다 멤버 수를 출력해요. 이 코드가 실행되는 동안 DB에 SQL을 몇 번 보낼까요? 모르는 게 정상이니 감으로 골라 보세요.</p>
<pre><span class="c-key">List</span>&lt;Team&gt; teams = teamRepository.findAll();
<span class="c-key">for</span> (Team team : teams) &#123;
    System.out.println(team.getMembers().size());
&#125;</pre>
    <div class="panel">
      <div class="field">
        <span class="label">내 예측</span>
        <div class="choice-row" id="predict-opts">
          <button class="chip" type="button" data-v="1" aria-pressed="false">1번</button>
          <button class="chip" type="button" data-v="2" aria-pressed="false">2번</button>
          <button class="chip" type="button" data-v="11" aria-pressed="false">11번</button>
          <button class="chip" type="button" data-v="20" aria-pressed="false">20번</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="predict-conf">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">예측을 고르면 3장에서 직접 확인할 수 있어요.</p>
    </div>
  </section>

  <!-- 1 -->
  <section id="background" class="read">
    <p class="eyebrow">1 · 배경 지식</p>
    <h2>JPA는 객체와 테이블 사이의 통역사예요</h2>
    <p>자바 코드에서는 <code>team.getMembers()</code>처럼 객체를 따라가요. 하지만 실제 데이터는 DB의 테이블에 있어요. <strong>JPA</strong>는 이 둘을 연결하는 도구(ORM)라서, 코드가 데이터를 필요로 하는 순간 SQL을 대신 만들어 DB에 보내요.</p>
    <div class="panel diagram" aria-label="Team과 Member 객체가 team, member 테이블에 대응하는 그림">
      <svg viewBox="0 0 680 250" role="img" aria-labelledby="dg1">
        <title id="dg1">Team 객체의 members 목록은 member 테이블의 team_id 외래 키로 연결된다</title>
        <text class="svg-m" x="20" y="22">자바 객체 (코드)</text>
        <text class="svg-m" x="420" y="22">DB 테이블 (데이터)</text>
        <rect class="svg-box" x="20" y="34" width="230" height="96" rx="8"/>
        <rect class="svg-head" x="21" y="35" width="228" height="28" rx="7"/>
        <text class="svg-tb" x="34" y="54">Team</text>
        <text class="svg-t" x="34" y="84">Long id</text>
        <text class="svg-t" x="34" y="104">String name</text>
        <text class="svg-t" x="34" y="124" style="fill:var(--accent)">List&lt;Member&gt; members</text>
        <rect class="svg-box" x="20" y="150" width="230" height="80" rx="8"/>
        <rect class="svg-head" x="21" y="151" width="228" height="28" rx="7"/>
        <text class="svg-tb" x="34" y="170">Member</text>
        <text class="svg-t" x="34" y="200">String name</text>
        <text class="svg-t" x="34" y="220" style="fill:var(--accent)">Team team</text>
        <rect class="svg-box" x="420" y="34" width="240" height="76" rx="8"/>
        <rect class="svg-head" x="421" y="35" width="238" height="28" rx="7"/>
        <text class="svg-tb" x="434" y="54">team</text>
        <text class="svg-t" x="434" y="84">id (PK)</text>
        <text class="svg-t" x="434" y="102">name</text>
        <rect class="svg-box" x="420" y="150" width="240" height="80" rx="8"/>
        <rect class="svg-head" x="421" y="151" width="238" height="28" rx="7"/>
        <text class="svg-tb" x="434" y="170">member</text>
        <text class="svg-t" x="434" y="200">name</text>
        <text class="svg-t" x="434" y="220" style="fill:var(--accent)">team_id (FK → team.id)</text>
        <path class="svg-line" d="M250 82 H420" stroke-dasharray="4 4"/>
        <path class="svg-line" d="M250 190 H420" stroke-dasharray="4 4"/>
        <text class="svg-m" x="300" y="76">매핑</text>
        <text class="svg-m" x="300" y="184">매핑</text>
        <path class="svg-acc" d="M640 214 C 700 190, 700 100, 640 92"/>
        <text class="svg-m" x="560" y="140" style="fill:var(--accent)">1 : N</text>
      </svg>
    </div>
    <p>팀 하나에 멤버가 여럿이니 <strong>1:N 관계</strong>예요. 테이블에는 멤버 쪽에 <code>team_id</code>가 있고, 객체에는 양쪽에 서로를 가리키는 필드가 있어요.</p>
<pre><span class="c-key">@Entity</span>
<span class="c-key">class</span> Team &#123;
    <span class="c-key">@Id</span> Long id;
    String name;
    <span class="c-key">@OneToMany</span>(mappedBy = "team")          <span class="c-com">// 컬렉션은 기본값이 LAZY</span>
    List&lt;Member&gt; members;
&#125;

<span class="c-key">@Entity</span>
<span class="c-key">class</span> Member &#123;
    <span class="c-key">@Id</span> Long id;
    String name;
    <span class="c-key">@ManyToOne</span>(fetch = FetchType.LAZY)     <span class="c-com">// 기본값이 EAGER라 직접 LAZY로 적는다</span>
    Team team;
&#125;</pre>
    <div class="callout">
      <strong>기억할 한 가지:</strong> SQL을 한 번 보낼 때마다 애플리케이션과 DB 사이에 네트워크 왕복이 한 번 생겨요. 같은 데이터를 가져오더라도 <strong>쿼리 수가 많을수록 느려져요.</strong> N+1은 이 쿼리 수가 데이터 개수에 비례해 늘어나는 문제예요.
    </div>
  </section>

  <!-- 2 -->
  <section id="lazy">
    <div class="read" style="display:flex;flex-direction:column;gap:16px">
      <p class="eyebrow">2 · 지연 로딩과 즉시 로딩</p>
      <h2>필요할 때 채우는 빈 상자</h2>
      <p>연관된 데이터를 <strong>언제</strong> 가져올지 정하는 설정이 로딩 전략이에요.</p>
      <ul>
        <li><strong>지연 로딩(LAZY):</strong> 팀을 가져올 때 멤버는 가져오지 않고 "나중에 채울 빈 상자"(프록시, 지연 컬렉션)만 넣어 둬요. 상자를 처음 열 때(<code>size()</code>, 반복문 등) 그제서야 SQL을 보내요.</li>
        <li><strong>즉시 로딩(EAGER):</strong> 팀을 가져오자마자 멤버도 바로 채워요. 편해 보이지만 4장에서 볼 함정이 있어요.</li>
      </ul>
      <p>아래에서 팀 목록은 이미 가져온 상태예요(쿼리 1번). 각 팀의 상자를 열어 보세요.</p>
    </div>
