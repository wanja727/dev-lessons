---
import Base from '../../layouts/Base.astro';
import RunLocally from '../../components/RunLocally.astro';
import '../../styles/lesson.css';
import '../../styles/retrievo-theme.css';
import { highlight } from '../../lib/highlight';

// 이 레슨은 "핵심 질문" 네 개를 뼈대로 쓴다. 장 하나가 질문 하나에 답하고, 장의 첫머리에 결론을 둔다.
// 문제 파일(content/questions/jpa-n-plus-1.yaml)의 모든 문제는 이 네 질문 중 하나에 연결된다.
const test = 'https://github.com/wanja727/dev-lessons/blob/main/verification/src/test/java/lab/devlessons/nplusone/NPlusOneTest.java';

// 코드는 한 줄이 44자를 넘지 않게 쓴다. 모바일(375px)에서 가로로 밀지 않아도 강조한 곳이 보여야 한다
const codePredict = `// 팀 10개
List<Team> teams = teamRepository.findAll();
for (Team team : teams) {
    int count = team.getMembers().size();
    System.out.println(count);
}`;

// 처음 코드에서 지금 설명하는 줄을 강조해 다시 보여 준다
const codeFindAll = `// 팀 10개
List<Team> teams = [[teamRepository.findAll()]];
for (Team team : teams) {
    int count = team.getMembers().size();
    System.out.println(count);
}`;

const codeLoop = `// 팀 10개
List<Team> teams = teamRepository.findAll();
for (Team team : teams) {
    int count = [[team.getMembers()]].size();
    System.out.println(count);
}`;

const codeEntity = `@Entity
class Team {
    @Id Long id;
    String name;

    // 지연 로딩(LAZY)이 기본값
    @OneToMany(mappedBy = "team")
    [[List<Member> members]];
}`;

const codeEager = `@OneToMany(
    mappedBy = "team",
    [[fetch = FetchType.EAGER]]
)
List<Member> members;`;

const codeFetchJoin = `@Query("""
    select t from Team t
    left [[join fetch]] t.members
    """)
List<Team> findAllWithMembers();

-- 나가는 SQL (1번)
select t.*, m.*
from team t
[[left join member m]] on m.team_id = t.id`;

const codeBatch = `# application.yml
spring:
  jpa:
    properties:
      hibernate:
        default_batch_fetch_size: 100

-- 나가는 SQL (팀 10개일 때 2번)
select * from team
select * from member
where team_id [[in (1, 2, 3, ..., 10)]]`;

const codePagingFix = `-- 1번째: 팀만 페이징해서 조회
select * from team
order by id [[limit 2]]

-- 2번째: 그 팀들의 멤버를 한 번에
select * from member
where team_id [[in (1, 2)]]`;

// 검증 테스트 하나를 그대로 보여 준다 (NPlusOneTest.eagerDoesNotFix)
const codeTest = `@Test
void eagerDoesNotFix() {
    // EAGER인 팀 10개를 조회. 멤버는 안 씀
    eagerTeamRepository.findAll();

    // 나간 SQL이 1 + 10번인지 확인
    assertThat([[SqlCapture.count()]])
        .isEqualTo(1 + TEAMS);
}`;

const codeToOne = `@Query("""
    select m from Member m
    [[join fetch]] m.team
    """)
List<Member> findPage(Pageable pageable);

-- 나가는 SQL (1번)
select m.*, t.*
from member m
join team t on t.id = m.team_id
[[limit 20]]`;
---
<Base theme="soft pastel" title="JPA N+1 문제 · Dev Lessons" description="N+1 문제가 왜 생기는지, EAGER로는 왜 안 되는지, 어떻게 해결하는지, 페이징할 때는 무엇을 고르는지. 네 가지 질문에 스스로 답할 수 있게 만드는 대화형 레슨.">
<link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;700&display=swap" />
<style is:global>
/* 핵심 질문 목록, 장 첫머리의 결론, 보지 않고 답하기 */
.goals { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; counter-reset: goal; }
.goals li { counter-increment: goal; }
.goals a {
  display: grid; grid-template-columns: 2.2em 1fr; align-items: baseline; text-decoration: none; color: var(--ink);
  background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; font-weight: 500;
}
.goals a::before { content: counter(goal); font-family: var(--font-mono); color: var(--accent); }
.goals a:hover { border-color: var(--accent); }
.answer { border-left: 4px solid var(--ink); background: var(--accent-soft); border-radius: 0 12px 12px 0; padding: 18px 22px 20px; }
.answer .label { display: block; margin-bottom: 6px; color: var(--muted); font-size: 14px; font-weight: 600; }
.answer .lead { font-size: 21px; font-weight: 700; line-height: 1.45; letter-spacing: -0.02em; text-wrap: balance; }
.answer .sub { margin: 8px 0 0; font-size: 16px; line-height: 1.7; }
.answer ul.sub { padding-left: 20px; }
/* 코드 아래 설명: 표시한 부분이 무엇인지 */
.code-note { list-style: none; margin: -6px 0 0; padding: 0 4px; display: flex; flex-direction: column; gap: 4px; font-size: 14.5px; color: var(--muted); }
.code-note mark.hl { font-family: var(--font-mono); font-size: 0.9em; font-weight: 400; color: var(--ink); margin-right: 4px; }
/* 진행 표시 */
.progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 20; background: transparent; }
.progress span { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 0 3px 3px 0; }
.where {
  position: fixed; top: 12px; right: 12px; z-index: 20; font-size: 12.5px; font-weight: 600; color: var(--muted);
  background: color-mix(in srgb, var(--surface) 88%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px;
  backdrop-filter: blur(6px);
}
/* 좁은 화면에서는 표를 카드로 쌓는다. 칸 이름은 data-label로 붙인다 */
@media (max-width: 600px) {
  .table-wrap table { min-width: 0; }
  .table-wrap thead { display: none; }
  .table-wrap tr { display: block; padding: 12px 2px; border-bottom: 1px solid var(--line); }
  .table-wrap td { display: block; border: 0; padding: 0; }
  .table-wrap td:first-child { font-weight: 600; margin-bottom: 4px; }
  .table-wrap td:not(:first-child) { color: var(--muted); font-size: 14.5px; }
  .table-wrap td:not(:first-child)::before { content: attr(data-label) " "; font-weight: 600; margin-right: 4px; }
  pre { font-size: 12px; padding: 14px 8px 14px 10px; }
}
/* 레슨 정보 */
.meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 14px; color: var(--muted); }
.next { color: var(--muted); border-top: 1px dashed var(--line); padding-top: 14px; }
.stack { display: flex; flex-direction: column; gap: 16px; }
.phases { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.phase { border: 1px solid var(--line); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.phase h4 { margin: 0; font-size: 14px; display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
.phase h4 span { font-family: var(--font-mono); color: var(--ink); font-size: 15px; }
.phase .log { max-height: 190px; }
.recall { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--line); padding-top: 14px; }
.recall:first-child { border-top: 0; padding-top: 0; }
.recall h3 { font-size: 17px; }
.recall .model-a { background: var(--ok-soft); border-radius: 8px; padding: 12px 14px; }
.recall .back-link { font-size: 14px; }
@media (max-width: 760px) { .phases { grid-template-columns: minmax(0, 1fr); } }
</style>
<!-- 진행 표시: 맨 위의 가는 막대와 지금 읽는 질문 -->
<div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
<div class="where" id="where" hidden></div>
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="meta"><span class="m-unit">JPA</span><span class="m-time">약 15분</span><span class="m-pre">먼저 배울 레슨 <a href="/dev-lessons/lessons/proxy-lazy-loading/">프록시와 지연 로딩</a></span></p>
    <h1>JPA N+1 문제</h1>
    <p class="lede">이 레슨을 마치면 아래 네 질문에 자료를 보지 않고 답할 수 있어요. 장 하나가 질문 하나에 답해요.</p>
    <ol class="goals">
      <li><a href="#q1">N+1 문제는 무엇이고 왜 생기나요?</a></li>
      <li><a href="#q2">EAGER로 바꾸면 왜 해결되지 않나요?</a></li>
      <li><a href="#q3">어떻게 해결하나요?</a></li>
      <li><a href="#q4">페이징이 필요하면 어떤 방법을 써야 하나요?</a></li>
    </ol>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 엔티티, 리포지토리, JPQL(<a href="/dev-lessons/lessons/jpa-basics/">JPA 첫걸음</a>), 지연 로딩(<a href="/dev-lessons/lessons/proxy-lazy-loading/">프록시와 지연 로딩</a>), SQL의 JOIN과 LIMIT.</p>
  </header>

  <!-- 예측 -->
  <section id="predict" class="read">
    <p class="eyebrow">먼저 예측해 보기</p>
    <h2>이 코드는 DB에 SQL을 몇 번 보낼까요?</h2>
    <p>팀이 10개 있고, 팀마다 멤버가 여러 명 있어요. 팀 목록을 가져온 뒤 팀마다 멤버 수를 세서 출력해요. 모르는 게 정상이니 감으로 골라 보세요. 답은 바로 다음 장에 나와요.</p>
    <pre set:html={highlight(codePredict)} />
    <div class="panel">
      <span class="label">내 예측</span>
      <div class="choice-row" id="predict-opts">
        <button class="chip" type="button" data-v="1" aria-pressed="false">1번</button>
        <button class="chip" type="button" data-v="2" aria-pressed="false">2번</button>
        <button class="chip" type="button" data-v="11" aria-pressed="false">11번</button>
        <button class="chip" type="button" data-v="20" aria-pressed="false">20번</button>
      </div>
    </div>
  </section>

  <!-- 질문 1 -->
  <section id="q1">
    <div class="read stack">
      <p class="eyebrow">질문 1</p>
      <h2>N+1 문제는 무엇이고 왜 생기나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">연관된 데이터를 하나씩 따로 가져와서 생겨요.</p>
        <p class="sub">팀 목록을 쿼리 1번으로 가져온 뒤, 팀마다 멤버를 가져오는 쿼리가 1번씩 더 나가요. 팀이 N개면 모두 1 + N번이에요.</p>
      </div>
      <p>예측한 코드의 답은 <strong>11번</strong>이에요. <span id="predict-result" class="muted"></span> 왜 11번인지 직접 확인해 봐요.</p>
      <p>팀은 멤버 목록을 가지고 있어요. 이렇게 엔티티가 다른 엔티티를 가리키는 것을 <strong>연관관계</strong>라고 해요. N+1은 연관관계를 따라가며 데이터를 쓸 때 생겨요.</p>
      <pre set:html={highlight(codeEntity)} />
      <ul class="code-note"><li><mark class="hl">List&lt;Member&gt; members</mark> 팀이 가진 멤버 목록이에요. 이 필드가 팀과 멤버의 연관관계예요.</li></ul>
      <p><code>members</code>는 <strong>지연 로딩</strong>이에요. 팀을 가져올 때 멤버는 가져오지 않고, 코드가 멤버를 처음 쓰는 순간에 그 팀의 멤버만 조회해요. 처음 코드에서는 반복문 안의 <code>team.getMembers()</code>가 그 순간이에요.</p>
      <pre set:html={highlight(codeLoop)} />
      <ul class="code-note"><li><mark class="hl">team.getMembers()</mark> 멤버를 처음 쓰는 곳이에요. 여기서 그 팀의 멤버를 가져오는 쿼리가 나가요.</li></ul>
      <p>아래는 첫 줄이 끝나서 팀 목록을 이미 가져온 상태예요(쿼리 1번). 반복문이 하는 것처럼 팀마다 멤버를 꺼내 보세요.</p>
    </div>
    <div class="panel">
      <div class="lazy-grid" id="lazy-grid"></div>
      <div class="count-line"><span class="label">지금까지 보낸 쿼리</span><span class="mono" id="lazy-count" style="font-weight:500">1번</span></div>
      <div class="log" id="lazy-log" aria-live="polite"></div>
      <p id="lazy-msg" class="verdict" hidden></p>
      <div><button class="btn" type="button" id="lazy-reset">처음으로</button></div>
    </div>
    <div class="read stack">
      <p>팀 하나의 멤버를 꺼낼 때마다 쿼리가 하나씩 나가요. 그래서 쿼리 수는 <strong>목록 1번 + 팀 수 N번</strong>이에요. 팀이 10개면 11번, 1,000개면 1,001번이에요.</p>
      <p>이게 문제인 이유는 쿼리 한 번마다 애플리케이션과 DB 사이를 한 번씩 오가기 때문이에요. 쿼리 수가 데이터 개수를 따라 늘어나니, 데이터가 쌓일수록 화면이 느려져요.</p>
      <p>멤버를 쓰지 않으면 추가 쿼리는 없어요. 팀만 조회하고 끝내면 1번이에요.</p>
      <div class="panel quiz" data-quiz="q1"></div>
      <p class="next"><strong>다음 질문:</strong> 멤버를 나중에 따로 가져와서 생긴 문제예요. 그러면 처음부터 같이 가져오도록 즉시 로딩(EAGER)으로 바꾸면 해결될까요?</p>
    </div>
  </section>

  <!-- 질문 2 -->
  <section id="q2">
    <div class="read stack">
      <p class="eyebrow">질문 2</p>
      <h2>EAGER로 바꾸면 왜 해결되지 않나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">EAGER는 가져오는 시점만 바꾸기 때문이에요.</p>
        <p class="sub">멤버를 팀마다 따로 조회하는 방식은 그대로예요. 그래서 쿼리 수도 그대로 11번이에요.</p>
      </div>
      <p><strong>즉시 로딩(EAGER)</strong>은 팀을 가져오면 멤버도 바로 채우라는 설정이에요.</p>
      <pre set:html={highlight(codeEager)} />
      <ul class="code-note"><li><mark class="hl">fetch = FetchType.EAGER</mark> 로딩 방식을 즉시 로딩으로 바꾸는 설정이에요.</li></ul>
      <p>처음 코드를 그대로 실행한다고 해 볼게요. 아래에서 LAZY와 EAGER를 바꿔 보세요. 쿼리가 언제 나가는지, 모두 몇 번인지 비교해요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">members의 로딩 방식</span>
        <div class="seg" id="tm-fetch">
          <button type="button" data-v="LAZY" aria-pressed="true">LAZY</button>
          <button type="button" data-v="EAGER" aria-pressed="false">EAGER</button>
        </div>
      </div>
      <div class="phases">
        <div class="phase"><h4>findAll()을 실행하는 동안 <span id="tm-c1"></span></h4><div class="log" id="tm-log1"></div></div>
        <div class="phase"><h4>반복문에서 멤버를 쓰는 동안 <span id="tm-c2"></span></h4><div class="log" id="tm-log2"></div></div>
      </div>
      <p class="verdict" id="tm-verdict" aria-live="polite"></p>
    </div>
    <div class="read stack">
      <p>이유는 처음 코드의 첫 줄, <code>teamRepository.findAll()</code>이 실행되는 순서에 있어요. <code>findAll()</code>은 Spring Data JPA가 만들어 주는 "전부 조회" 메서드예요.</p>
      <pre set:html={highlight(codeFindAll)} />
      <ul class="code-note"><li><mark class="hl">teamRepository.findAll()</mark> 아래 세 단계가 모두 이 한 줄 안에서 일어나요.</li></ul>
      <ol style="margin:0;padding-left:22px">
        <li><code>findAll()</code>은 안에서 JPQL <code>select t from Team t</code>를 실행해요. "팀을 전부 가져와라"라는 뜻이에요.</li>
        <li>JPA는 JPQL을 적힌 그대로 SQL로 바꿔요. 팀만 적혀 있으니 SQL도 팀만 조회해요. (쿼리 1번)</li>
        <li>팀 10개를 받은 뒤에야 EAGER 설정을 보고, 팀마다 멤버를 조회해요. (쿼리 10번)</li>
      </ol>
      <p>LAZY와 다른 점은 세 번째 단계가 일어나는 때뿐이에요. LAZY는 반복문에서 멤버를 쓸 때, EAGER는 <code>findAll()</code>이 끝나기 전에 일어나요.</p>
      <p>EAGER는 오히려 손해예요. 멤버가 필요 없는 화면에서도 11번이 나가요. LAZY였다면 1번으로 끝났을 조회예요.</p>
      <div class="callout"><strong>실무 규칙:</strong> 연관관계는 모두 LAZY로 두고, 멤버가 필요한 조회에서만 함께 가져와요. <code>@ManyToOne</code>과 <code>@OneToOne</code>은 기본값이 EAGER라서 <code>fetch = FetchType.LAZY</code>를 직접 적어요.</div>
      <details class="more">
        <summary>더 알아보기: 하나만 찾을 때는 달라요</summary>
        <p><code>em.find(Team.class, id)</code>처럼 id로 하나만 찾을 때는 Hibernate가 EAGER 연관을 join으로 한 번에 가져오기도 해요. N+1이 생기는 건 JPQL로 목록을 조회할 때예요.</p>
      </details>
      <div class="panel quiz" data-quiz="q2"></div>
      <p class="next"><strong>다음 질문:</strong> 가져오는 시점을 바꿔서는 소용이 없어요. "팀마다 따로"를 없애야 해요. 어떻게 하면 될까요?</p>
    </div>
  </section>

  <!-- 질문 3 -->
  <section id="q3">
    <div class="read stack">
      <p class="eyebrow">질문 3</p>
      <h2>어떻게 해결하나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">멤버를 팀마다 따로 가져오지 말고, 묶어서 가져와요.</p>
        <ul class="sub"><li><strong>fetch join:</strong> 팀과 멤버를 join해서 쿼리 1번에 가져와요.</li><li><strong>배치 페치:</strong> 여러 팀의 멤버를 IN 절로 묶어 한 번에 가져와요.</li></ul>
      </div>
      <h3>방법 1. fetch join: join해서 한 번에</h3>
      <p><code>findAll()</code> 대신, JPQL에 <code>join fetch</code>를 적은 조회 메서드를 만들어 써요. 팀과 멤버를 join한 SQL 하나로 함께 가져와서 쿼리는 <strong>1번</strong>이에요.</p>
      <pre set:html={highlight(codeFetchJoin)} />
      <ul class="code-note"><li><mark class="hl"><span class="c-str">join fetch</span></mark> 팀을 조회할 때 멤버도 함께 가져오라는 뜻이에요.</li><li><mark class="hl" set:html={highlight('left join member m')} /> 그래서 SQL에 멤버 테이블 join이 생겨요.</li></ul>
      <p class="muted">Spring Data JPA의 <code>@EntityGraph(attributePaths = "members")</code>도 같은 join을 만들어요. 쿼리를 직접 쓰지 않고 메서드에 붙여서 써요.</p>
      <h3>방법 2. 배치 페치: IN으로 묶어서</h3>
      <p>LAZY는 그대로 둬요. 대신 멤버를 처음 쓸 때 그 팀 하나가 아니라 <strong>여러 팀의 멤버를 IN 절로 묶어</strong> 한 번에 가져와요. IN 절은 <code>where team_id in (1, 2, 3)</code>처럼 여러 값을 한 번에 조건으로 거는 SQL 문법이에요. 설정 하나로 모든 연관관계에 적용돼요.</p>
      <pre set:html={highlight(codeBatch)} />
      <ul class="code-note"><li><mark class="hl" set:html={highlight('in (1, 2, 3, ..., 10)')} /> 팀 10개의 멤버를 조건 하나로 묶었어요. 배치 크기가 100이라 10개가 쿼리 하나에 다 들어가요.</li></ul>
      <p>한 번에 묶는 팀 수가 배치 크기예요. 쿼리 수는 <strong>1 + (팀 수 ÷ 배치 크기, 올림)</strong>이에요. 팀 10개에 배치 크기 5면 1 + 2 = 3번이에요.</p>
      <p>처음 코드에 두 방법을 각각 적용했을 때의 쿼리 수예요. 팀 수와 방법을 바꿔 가며 비교해 보세요.</p>
    </div>
    <div class="panel">
      <div class="sim">
        <div class="controls">
          <div class="field">
            <div class="row-line"><label class="label" for="sim-n">팀 수 (N)</label><span class="mono" id="sim-n-val">10</span></div>
            <input type="range" id="sim-n" min="1" max="20" value="10">
          </div>
          <div class="field">
            <span class="label">방법</span>
            <div class="seg" id="sim-fix">
              <button type="button" data-v="none" aria-pressed="true">아무것도 안 함</button>
              <button type="button" data-v="fetch" aria-pressed="false">fetch join</button>
              <button type="button" data-v="batch" aria-pressed="false">배치 페치</button>
            </div>
          </div>
          <div class="field" id="batch-field" hidden>
            <span class="label">배치 크기</span>
            <div class="seg" id="sim-batch">
              <button type="button" data-v="3" aria-pressed="false">3</button>
              <button type="button" data-v="5" aria-pressed="true">5</button>
              <button type="button" data-v="10" aria-pressed="false">10</button>
              <button type="button" data-v="100" aria-pressed="false">100</button>
            </div>
          </div>
        </div>
        <div class="result">
          <div class="count-line">
            <span class="big" id="sim-count">11</span>
            <span class="formula" id="sim-formula"></span>
          </div>
          <div class="lane" id="sim-lane" aria-hidden="true"></div>
          <p class="verdict" id="sim-verdict" aria-live="polite"></p>
          <div class="log" id="sim-log"></div>
        </div>
      </div>
    </div>
    <div class="read stack">
      <div class="table-wrap">
        <table>
          <thead><tr><th>방법</th><th>하는 일</th><th>쿼리 수</th></tr></thead>
          <tbody>
            <tr><td>아무것도 안 함</td><td>팀마다 멤버를 따로 조회</td><td>1 + N</td></tr>
            <tr><td>fetch join</td><td>팀과 멤버를 join해서 한 번에</td><td>1</td></tr>
            <tr><td>배치 페치</td><td>여러 팀의 멤버를 IN으로 묶어서</td><td>1 + (N ÷ 배치 크기, 올림)</td></tr>
          </tbody>
        </table>
      </div>
      <details class="more">
        <summary>더 알아보기: 세부 동작과 그 밖의 방법</summary>
        <ul>
          <li>join하면 팀 하나가 멤버 수만큼 여러 행이 돼요. Hibernate 6은 결과에서 중복된 팀을 자동으로 하나로 합쳐 줘요.</li>
          <li>Hibernate 6과 PostgreSQL 조합에서는 IN 대신 <code>where team_id = any (?)</code>로 나가기도 해요. 묶어서 가져오는 원리와 쿼리 수는 같아요.</li>
          <li>화면에 값 몇 개와 집계만 필요하면 엔티티 대신 필요한 값만 담은 객체(DTO)로 바로 조회하기도 해요.</li>
        </ul>
      </details>
      <div class="panel quiz" data-quiz="q3"></div>
      <p class="next"><strong>다음 질문:</strong> 쿼리 수만 보면 fetch join이 늘 더 좋아 보여요. 그런데 목록을 페이지로 나눠 보여 줄 때는 fetch join을 쓰면 안 되는 경우가 있어요.</p>
    </div>
  </section>

  <!-- 질문 4 -->
  <section id="q4">
    <div class="read stack">
      <p class="eyebrow">질문 4</p>
      <h2>페이징이 필요하면 어떤 방법을 써야 하나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">팀 목록에 멤버를 붙여 페이징할 때는 배치 페치를 써요.</p>
        <p class="sub">fetch join을 쓰면 DB가 페이지를 자르지 못해요. Hibernate가 전체 데이터를 메모리로 가져온 뒤에 잘라요.</p>
      </div>
      <p>"팀을 2개씩 보여 주는 목록에 멤버도 같이" 보여 주려고 fetch join에 페이징을 걸었다고 해 볼게요. 팀과 멤버를 join한 결과는 <strong>팀 단위가 아니라 멤버 단위 행</strong>이에요. DB의 LIMIT은 행을 기준으로 잘라요. 아래에서 직접 잘라 보세요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <div class="row-line"><label class="label" for="pg-limit">DB에서 행 기준으로 자르기 (LIMIT)</label><span class="mono" id="pg-limit-val">2행</span></div>
        <input type="range" id="pg-limit" min="1" max="10" value="2">
      </div>
      <div class="sim">
        <div class="rows" id="pg-rows" aria-label="team join member 결과 행"></div>
        <div class="page-out" id="pg-out" aria-live="polite"></div>
      </div>
    </div>
    <div class="read stack">
      <p>LIMIT 5일 때만 원하는 결과가 나와요. 그런데 5라는 숫자는 팀 A가 3명, 팀 B가 2명이라는 걸 알아야 정할 수 있어요. 팀마다 멤버 수가 다르니, 행을 기준으로는 "팀 2개와 그 멤버 전부"를 자를 수 없어요.</p>
      <p>그래서 Hibernate는 SQL에 LIMIT을 붙이지 않아요. <strong>전체 행을 메모리로 가져온 뒤</strong> 팀 2개를 골라내고, 아래 경고를 남겨요. 결과는 맞지만, 팀이 수십만 개면 그걸 전부 메모리에 올리다가 장애가 날 수 있어요.</p>
      <pre class="wrap">WARN HHH90003004: firstResult/maxResults specified with collection fetch; applying in memory</pre>
      <h3>고치는 법: 팀만 페이징하고, 멤버는 배치 페치로</h3>
      <p>fetch join을 빼면 SQL에 LIMIT이 정상으로 붙어요. 멤버는 배치 페치가 그 페이지에 있는 팀 것만 묶어서 가져와요. 쿼리는 <strong>2번</strong>이에요.</p>
      <pre set:html={highlight(codePagingFix)} />
      <ul class="code-note"><li><mark class="hl" set:html={highlight('limit 2')} /> 팀을 기준으로 2개만 잘라요.</li><li><mark class="hl" set:html={highlight('in (1, 2)')} /> 그 두 팀의 멤버만 한 번에 가져와요.</li></ul>
      <p class="muted">Hibernate 6은 LIMIT을 같은 뜻의 <code>fetch first 2 rows only</code>로 쓰기도 해요.</p>
      <h3>반대 방향은 fetch join을 써도 안전해요</h3>
      <p>멤버 목록을 페이징하면서 각 멤버의 팀을 보여 줄 때는 얘기가 달라요. 멤버 한 명에 팀은 하나라서 join해도 행이 늘어나지 않아요. 그래서 fetch join과 페이징을 같이 써도 LIMIT이 그대로 붙고, 쿼리 <strong>1번</strong>으로 끝나요.</p>
      <pre set:html={highlight(codeToOne)} />
      <ul class="code-note"><li><mark class="hl"><span class="c-str">join fetch</span></mark> 멤버를 조회할 때 팀도 함께 가져와요.</li><li><mark class="hl" set:html={highlight('limit 20')} /> 행이 늘지 않아서 LIMIT이 SQL에 그대로 붙어요.</li></ul>
      <div class="table-wrap">
        <table>
          <thead><tr><th>상황</th><th>방법</th><th>쿼리 수</th></tr></thead>
          <tbody>
            <tr><td>팀 목록 + 멤버들, 페이징 있음</td><td>팀만 페이징 + 배치 페치</td><td>2 (페이지 크기가 배치 크기 이하일 때)</td></tr>
            <tr><td>팀 목록 + 멤버들, 페이징 없음</td><td>fetch join</td><td>1</td></tr>
            <tr><td>멤버 목록 + 팀, 페이징이 있든 없든</td><td>fetch join</td><td>1</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted">용어: 팀 → 멤버들처럼 여럿을 가리키는 연관을 <strong>컬렉션</strong>, 멤버 → 팀처럼 하나를 가리키는 연관을 <strong>ToOne</strong>이라고 불러요. 한 줄로 줄이면 "컬렉션 fetch join에는 페이징을 걸지 않는다"예요.</p>
      <div class="panel quiz" data-quiz="q4"></div>
    </div>
  </section>

  <!-- 보지 않고 답하기 -->
  <section id="recall" class="read">
    <p class="eyebrow">보지 않고 답하기</p>
    <h2>네 질문에 직접 답해 보세요</h2>
    <p>위로 올라가지 말고, 질문마다 소리 내어 말하거나 머릿속으로 먼저 답해 보세요. 그다음에 모범 답을 열어 비교해요. 읽을 때 안다고 느낀 것과 꺼낼 수 있는 것은 달라요.</p>
    <div class="panel" id="recall-list"></div>

    <h3 style="margin-top:12px">면접 질문: "JPA N+1 문제를 설명해 주세요"</h3>
    <p>네 답을 하나로 이어서, 1분 안에 말해 보세요. 정의 → 원인 → 해결 → 내 경험 순서예요. 말해 본 뒤에 모범 답을 열어요.</p>
    <div><button class="btn primary" type="button" id="model-btn">모범 답 보기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>연관관계가 있는 엔티티 목록을 조회할 때, 목록 쿼리 1번 뒤에 조회한 개수 N만큼 연관 데이터를 가져오는 쿼리가 더 나가는 문제입니다.</dd>
        <dt>원인</dt><dd>JPA는 JPQL에 적힌 대상만 조회하고, 연관 데이터는 엔티티마다 따로 가져옵니다. EAGER로 바꿔도 가져오는 시점만 앞당겨지고 쿼리 수는 같습니다.</dd>
        <dt>해결</dt><dd>연관관계는 모두 LAZY로 두고, 필요한 조회에서 fetch join으로 한 번에 가져옵니다. 컬렉션을 페이징해야 하면 fetch join은 메모리에서 페이징하므로, 배치 페치로 IN 쿼리에 묶습니다.</dd>
        <dt>경험</dt><dd>(내 프로젝트로 채우기) 예: 목록 화면에서 SQL 로그로 쿼리 수를 세어 보고 배치 페치를 적용해 줄였습니다.</dd>
      </dl>
    </div>
  </section>

  <section class="read" id="verified">
    <details class="more">
      <summary>이 레슨의 숫자는 어떻게 확인했나요? (검증 테스트)</summary>
      <div class="stack" style="padding-top:6px">
        <p>이 레슨에 나온 쿼리 수는 짐작이 아니라, 실제 PostgreSQL에서 코드를 돌려 나간 SQL을 세어 본 값이에요. 테스트(<a href={test}>NPlusOneTest</a>)는 팀 10개와 팀마다 멤버 3명을 넣어 두고, 아래 상황마다 결과를 확인해요.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>상황</th><th>확인한 결과</th></tr></thead>
            <tbody>
              <tr><td>지연 로딩에서 팀을 조회하고 멤버를 쓴다</td><td>쿼리 11번</td></tr>
              <tr><td>지연 로딩에서 팀만 조회한다</td><td>쿼리 1번</td></tr>
              <tr><td>EAGER로 바꾸고 팀만 조회한다</td><td>쿼리 11번</td></tr>
              <tr><td>fetch join으로 조회한다</td><td>쿼리 1번, 팀은 중복 없이 10개</td></tr>
              <tr><td>@EntityGraph로 조회한다</td><td>쿼리 1번</td></tr>
              <tr><td>배치 크기 5로 조회하고 멤버를 쓴다</td><td>쿼리 3번</td></tr>
              <tr><td>팀과 멤버를 fetch join하고 페이징한다</td><td>SQL에 LIMIT이 없고, 경고(HHH90003004)가 남는다</td></tr>
              <tr><td>팀만 페이징하고 멤버는 배치 페치로 가져온다</td><td>쿼리 2번, 첫 SQL에 LIMIT이 붙는다</td></tr>
              <tr><td>멤버에 팀을 fetch join하고 페이징한다</td><td>쿼리 1번, SQL에 LIMIT이 붙는다</td></tr>
