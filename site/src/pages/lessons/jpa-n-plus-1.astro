<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function $(id) { return document.getElementById(id); }
  function pressGroup(container, onPick) {
    container.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      container.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function addLog(el, n, sql, cls) {
    var row = document.createElement('div');
    row.className = 'row' + (cls ? ' ' + cls : '');
    if (cls) row.textContent = sql;
    else { row.innerHTML = '<span class="n">' + n + '</span><span></span>'; row.lastChild.textContent = sql; }
    el.appendChild(row);
  }

  /* 예측 */
  var prediction = store('n1-predict');
  function showPrediction() {
    if (!prediction) { $('predict-result').textContent = ''; return; }
    $('predict-result').textContent = prediction === '11' ? '예측이 맞았어요.' : '예측은 ' + prediction + '번이었어요. 틀린 예측이 더 오래 남으니 괜찮아요.';
  }
  var po = $('predict-opts');
  if (prediction) po.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === prediction ? 'true' : 'false'); });
  pressGroup(po, function (v) { prediction = v; store('n1-predict', v); showPrediction(); });
  showPrediction();

  /* 질문 1: 팀마다 멤버를 꺼내 보기 */
  var lazyTeams = [
    { id: 1, name: '팀 A', members: ['김', '이', '박'] },
    { id: 2, name: '팀 B', members: ['최', '정'] },
    { id: 3, name: '팀 C', members: ['강', '조', '윤', '장'] }
  ];
  var lazyQ;
  function lazyReset() {
    lazyQ = 1;
    $('lazy-log').innerHTML = '';
    addLog($('lazy-log'), 1, 'select * from team');
    $('lazy-grid').innerHTML = '';
    $('lazy-msg').hidden = true;
    lazyTeams.forEach(function (t) {
      var card = document.createElement('div'); card.className = 'team-card';
      card.innerHTML = '<h4>' + t.name + '</h4><div class="box">members: 아직 가져오지 않음</div><button class="btn" type="button">team.getMembers().size()</button>';
      var btn = card.querySelector('button'), box = card.querySelector('.box');
      btn.addEventListener('click', function () {
        lazyQ++;
        addLog($('lazy-log'), lazyQ, 'select * from member where team_id = ' + t.id);
        box.className = 'box filled';
        box.textContent = 'members: ' + t.members.map(function (m) { return m + '○○'; }).join(', ') + ' (' + t.members.length + '명)';
        btn.disabled = true; btn.textContent = '가져왔어요';
        $('lazy-count').textContent = lazyQ + '번';
        if (lazyQ === lazyTeams.length + 1) {
          $('lazy-msg').hidden = false;
          $('lazy-msg').textContent = '팀 3개의 멤버를 모두 꺼냈더니 1 + 3 = 4번이에요. 팀이 10개였다면 1 + 10 = 11번이에요.';
        }
      });
      $('lazy-grid').appendChild(card);
    });
    $('lazy-count').textContent = '1번';
  }
  $('lazy-reset').addEventListener('click', lazyReset);
  lazyReset();

  /* 질문 2: LAZY와 EAGER, 쿼리가 나가는 시점 */
  function renderTiming(mode) {
    var l1 = $('tm-log1'), l2 = $('tm-log2'); l1.innerHTML = ''; l2.innerHTML = '';
    addLog(l1, 1, 'select * from team');
    var target = mode === 'EAGER' ? l1 : l2;
    for (var t = 1; t <= 10; t++) addLog(target, t + 1, 'select * from member where team_id = ' + t);
    if (mode === 'EAGER') addLog(l2, 0, '-- 이미 채워져 있어서 쿼리 없음', 'note');
    $('tm-c1').textContent = (mode === 'EAGER' ? 11 : 1) + '번';
    $('tm-c2').textContent = (mode === 'EAGER' ? 0 : 10) + '번';
    $('tm-verdict').textContent = mode === 'EAGER'
      ? 'EAGER: 11 + 0 = 11번. 멤버 쿼리 10번이 findAll() 쪽으로 옮겨 갔을 뿐, 합계는 같아요.'
      : 'LAZY: 1 + 10 = 11번. 멤버 쿼리 10번은 반복문에서 멤버를 쓸 때 나가요.';
  }
  pressGroup($('tm-fetch'), renderTiming);
  renderTiming('LAZY');

  /* 질문 3: 방법별 쿼리 수 */
  var fix = 'none';
  pressGroup($('sim-fix'), function (v) { fix = v; renderSim(); });
  $('sim-n').addEventListener('input', renderSim);
  var batchSize = 5;
  pressGroup($('sim-batch'), function (v) { batchSize = +v; renderSim(); });
  function renderSim() {
    var n = +$('sim-n').value, size = batchSize;
    $('sim-n-val').textContent = n;
    $('batch-field').hidden = fix !== 'batch';
    var log = $('sim-log'); log.innerHTML = '';
    var q = 0, formula, verdict;
    function sql(s) { q++; addLog(log, q, s); }
    if (fix === 'fetch') {
      sql('select t.*, m.* from team t left join member m on m.team_id = t.id');
      formula = '= 1';
      verdict = '팀과 멤버를 한 번에 가져와요. 팀이 몇 개든 1번이에요.';
    } else if (fix === 'batch') {
      sql('select * from team');
      var chunks = Math.ceil(n / size);
      for (var c = 0; c < chunks; c++) {
        var ids = [];
        for (var i = c * size + 1; i <= Math.min(n, (c + 1) * size); i++) ids.push(i);
        sql('select * from member where team_id in (' + ids.join(', ') + ')');
      }
      formula = '= 1 + (' + n + ' ÷ ' + size + ', 올림)';
      verdict = '멤버를 ' + size + '팀씩 IN으로 묶어 ' + chunks + '번에 가져와요.';
    } else {
      sql('select * from team');
      for (var t = 1; t <= n; t++) sql('select * from member where team_id = ' + t);
      formula = '= 1 + N(' + n + ')';
      verdict = '팀마다 멤버를 따로 조회해요. 팀 수만큼 쿼리가 늘어요.';
    }
    var count = $('sim-count');
    count.textContent = q; count.className = 'big' + (fix === 'none' ? '' : ' good');
    $('sim-formula').textContent = formula;
    $('sim-verdict').textContent = verdict;
    var lane = $('sim-lane'); lane.innerHTML = '';
    for (var k = 0; k < q; k++) { var d = document.createElement('span'); d.className = 'tick' + (k === 0 ? ' first' : ''); lane.appendChild(d); }
  }
  renderSim();

  /* 질문 4: join 결과를 행 기준으로 자르기 */
  var pgData = [
    { team: '팀 A', c: 'var(--team-a)', members: ['김○○', '이○○', '박○○'] },
    { team: '팀 B', c: 'var(--team-b)', members: ['최○○', '정○○'] },
    { team: '팀 C', c: 'var(--team-c)', members: ['강○○', '조○○', '윤○○', '장○○'] },
    { team: '팀 D', c: 'var(--team-d)', members: ['임○○'] }
  ];
  function renderPaging() {
    var lim = +$('pg-limit').value, rowsEl = $('pg-rows'), out = $('pg-out');
    $('pg-limit-val').textContent = lim + '행';
    rowsEl.innerHTML = '';
    var idx = 0, got = {};
    var head = document.createElement('div'); head.className = 'r'; head.style.setProperty('--c', 'transparent');
    head.innerHTML = '<span class="muted">행</span><span class="muted">team</span><span class="muted">member</span>'; rowsEl.appendChild(head);
    pgData.forEach(function (t) {
      t.members.forEach(function (m) {
        idx++;
        if (idx === lim + 1) { var l = document.createElement('div'); l.className = 'limit'; l.innerHTML = '<span>LIMIT ' + lim + '</span>'; rowsEl.appendChild(l); }
        var r = document.createElement('div'); r.className = 'r' + (idx > lim ? ' cut' : ''); r.style.setProperty('--c', t.c);
        r.innerHTML = '<span>' + idx + '</span><span>' + t.team + '</span><span>' + m + '</span>';
        rowsEl.appendChild(r);
        if (idx <= lim) got[t.team] = (got[t.team] || 0) + 1;
      });
    });
    var html = '<span class="label">원한 것: 팀 2개와 그 멤버 전부</span><span class="label">받은 것</span>';
    var teams = 0, cutAny = false;
    pgData.forEach(function (t) {
      if (!got[t.team]) return;
      teams++;
      var full = got[t.team] === t.members.length;
      if (!full) cutAny = true;
      html += '<div>' + t.team + ': 멤버 ' + got[t.team] + '명' + (full ? '' : ' <span class="bad">(실제 ' + t.members.length + '명인데 잘림)</span>') + '</div>';
    });
    var ok = teams === 2 && !cutAny;
    html += '<p class="muted" style="margin-top:6px">' + (ok
      ? '원하는 결과가 나왔어요. 하지만 팀 A가 3명, 팀 B가 2명이라는 걸 미리 알아야만 고를 수 있는 숫자예요.'
      : '팀 ' + teams + '개를 받았' + (cutAny ? '고 멤버 목록이 잘렸어요.' : '어요.') + ' 원한 결과가 아니에요.') + '</p>';
    out.innerHTML = html;
  }
  $('pg-limit').addEventListener('input', renderPaging);
  renderPaging();

  /* 좁은 화면에서 표를 카드로 쌓을 때 쓸 칸 이름 */
  document.querySelectorAll('.table-wrap table').forEach(function (table) {
    var heads = [].map.call(table.querySelectorAll('th'), function (th) { return th.textContent; });
    table.querySelectorAll('tbody tr').forEach(function (tr) {
      [].forEach.call(tr.children, function (td, i) { td.setAttribute('data-label', heads[i] || ''); });
    });
  });

  /* 진행 표시: 얼마나 읽었는지와 지금 읽는 질문 */
  var marks = [['predict', '예측'], ['q1', '질문 1 / 4'], ['q2', '질문 2 / 4'], ['q3', '질문 3 / 4'], ['q4', '질문 4 / 4'], ['recall', '마무리']];
  function progress() {
    var doc = document.documentElement, max = doc.scrollHeight - innerHeight;
    $('progress-bar').style.width = (max > 0 ? Math.min(100, scrollY / max * 100) : 0) + '%';
    var label = '';
    marks.forEach(function (m) { if ($(m[0]).getBoundingClientRect().top < innerHeight * 0.4) label = m[1]; });
    $('where').hidden = !label; $('where').textContent = label;
  }
  addEventListener('scroll', progress, { passive: true });
  addEventListener('resize', progress);
  progress();

  /* 슬라이더의 채워진 부분을 그리려고 현재 위치를 --p로 넘긴다 */
  document.querySelectorAll('input[type="range"]').forEach(function (el) {
    function fill() { el.style.setProperty('--p', ((el.value - el.min) / (el.max - el.min) * 100) + '%'); }
    el.addEventListener('input', fill); fill();
  });

  /* 장마다 확인 문제 하나. 기록하지 않는 연습이다 */
  var quizzes = {
    q1: { q: '지연 로딩인 팀 5개를 조회하고, 멤버는 한 번도 쓰지 않았어요. 쿼리는 몇 번일까요?', o: ['1번', '5번', '6번'], a: 0, e: '멤버를 쓰지 않으면 멤버 조회는 나가지 않아요. 팀 목록 1번이 전부예요.' },
    q2: { q: 'members를 EAGER로 바꾸고 findAll()로 팀 10개를 조회했어요. 멤버는 쓰지 않았어요. 쿼리는 몇 번일까요?', o: ['1번', '10번', '11번'], a: 2, e: '팀 조회 1번 뒤에, 쓰든 안 쓰든 팀마다 멤버 쿼리가 10번 나가요.' },
    q3: { q: '배치 크기 5, 팀 10개. 모든 팀의 멤버를 썼어요. 쿼리는 몇 번일까요?', o: ['2번', '3번', '11번'], a: 1, e: '팀 목록 1번 + 멤버를 5팀씩 묶어 2번 = 3번이에요.' },
    q4: { q: '위 표에서 팀 A는 3명, 팀 B는 2명이에요. join 결과에 LIMIT 4를 걸면 팀 B의 멤버는 몇 명을 받을까요?', o: ['0명', '1명', '2명'], a: 1, e: '1~3행이 팀 A, 4행이 팀 B의 첫 멤버예요. 팀 B는 2명 중 1명만 받아요.' }
  };
  document.querySelectorAll('[data-quiz]').forEach(function (box) {
    var item = quizzes[box.dataset.quiz];
    box.innerHTML = '<span class="label">확인</span><p></p><div class="opts"></div><div class="feedback" hidden></div>';
    box.querySelector('p').textContent = item.q;
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '맞아요. ' : '정답은 "' + item.o[item.a] + '"이에요. ') + item.e;
      });
      opts.appendChild(b);
    });
  });

  /* 보지 않고 답하기: 모범 답은 각 장의 결론과 같은 내용이다 */
  var recalls = [
    { id: 'q1', q: 'N+1 문제는 무엇이고 왜 생기나요?', a: '연관된 데이터를 하나씩 따로 가져와서 생겨요. 팀 목록을 쿼리 1번으로 가져온 뒤, 팀마다 멤버를 가져오는 쿼리가 1번씩 더 나가요. 팀이 N개면 모두 1 + N번이에요.' },
    { id: 'q2', q: 'EAGER로 바꾸면 왜 해결되지 않나요?', a: 'JPQL은 적힌 대로 팀만 조회하고, 그 뒤에 팀마다 멤버를 조회해요. EAGER는 그 시점을 앞당길 뿐이라 쿼리 수는 그대로예요. 멤버가 필요 없을 때도 나가서 오히려 손해예요.' },
    { id: 'q3', q: '어떻게 해결하나요?', a: '멤버를 묶어서 가져와요. fetch join은 팀과 멤버를 join해서 1번에, 배치 페치는 여러 팀의 멤버를 IN으로 묶어 1 + (N ÷ 배치 크기, 올림)번에 가져와요.' },
    { id: 'q4', q: '페이징이 필요하면 어떤 방법을 써야 하나요?', a: '팀 목록에 멤버를 붙일 때는 팀만 페이징하고 멤버는 배치 페치로 가져와요(2번). 컬렉션을 fetch join하면 행이 멤버 수만큼 늘어 DB에서 자를 수 없고, Hibernate가 전체를 메모리로 가져와 잘라요. 멤버 목록에 팀을 붙일 때는 행이 늘지 않아 fetch join을 써도 돼요.' }
  ];
  recalls.forEach(function (r, i) {
    var el = document.createElement('div'); el.className = 'recall';
    el.innerHTML = '<h3></h3><div><button class="btn" type="button">모범 답 보기</button></div><div class="model-a" hidden><p></p><a class="back-link"></a></div>';
    el.querySelector('h3').textContent = (i + 1) + '. ' + r.q;
    el.querySelector('.model-a p').textContent = r.a;
    var link = el.querySelector('a'); link.href = '#' + r.id; link.textContent = '막혔다면 질문 ' + (i + 1) + '의 결론 다시 보기';
    var btn = el.querySelector('button');
    btn.addEventListener('click', function () { el.querySelector('.model-a').hidden = false; btn.disabled = true; btn.textContent = '모범 답을 열었어요'; });
    $('recall-list').appendChild(el);
  });
  $('model-btn').addEventListener('click', function () { $('model').hidden = false; this.disabled = true; this.textContent = '모범 답을 열었어요'; });
})();
</script>
</Base>
