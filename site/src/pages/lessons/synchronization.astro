  .scenario { display: flex; flex-direction: column; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .scenario:last-child { border-bottom: 0; padding-bottom: 0; }
  .scenario .fb { font-size: 15px; border-radius: 8px; padding: 8px 12px; }
  .scenario .fb.right { background: var(--ok-soft); } .scenario .fb.wrong { background: var(--query-soft); }
  @media (max-width: 760px) { .cores { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var pred = { p1: store('sy-p1'), p2: store('sy-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 === 'exact' ? '항상 정확히 200만' : '여전히 200만보다 작을 수 있다') + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "여전히 200만보다 작을 수 있다"예요. volatile은 원자성을 주지 않아요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('sy-' + k, v); showPred(); });
  });
  showPred();

  /* 3. 가시성 비유 */
  var V;
  function vReset() { V = { mm: 'true', c1: null, c2: null, started: false, stopped: false, loops: 0 }; vRender('B의 반복을 시작해 보세요.'); }
  function vRender(msg) {
    var vol = document.getElementById('vol').checked;
    document.getElementById('mm').textContent = V.mm;
    var c1 = document.getElementById('c1'); c1.textContent = V.c1 === null ? '-' : V.c1;
    c1.className = V.c1 !== null && V.c1 !== V.mm ? 'stale' : '';
    document.getElementById('c2').textContent = V.c2 === null ? '-' : V.c2;
    document.getElementById('b-state').textContent = !V.started ? '아직 시작 안 함' : V.stopped ? '반복을 멈췄어요' : '반복 중 (' + V.loops + '번)';
    document.getElementById('v-note').textContent = msg;
    document.getElementById('v-tick').disabled = !V.started || V.stopped;
  }
  document.getElementById('v-start').addEventListener('click', function () {
    var vol = document.getElementById('vol').checked;
    V.started = true; V.stopped = false; V.loops = 1; V.c1 = V.mm;
    vRender(vol ? 'B가 메인 메모리에서 running(true)을 읽었어요. volatile이라 매번 메인 메모리에서 읽어요.' : 'B가 running(true)을 읽어 자기 캐시에 두었어요. volatile이 아니라서 다음 반복부터는 캐시 값을 계속 쓸 수 있어요.');
  });
  document.getElementById('v-stop').addEventListener('click', function () {
    var vol = document.getElementById('vol').checked;
    V.c2 = 'false';
    if (vol) { V.mm = 'false'; vRender('A가 false를 썼고, volatile이라 바로 메인 메모리에 반영됐어요.'); }
    else vRender('A가 false를 썼지만 아직 A의 캐시에만 있어요. 언제 메인 메모리로 내려갈지, B가 언제 볼지 보장이 없어요.');
  });
  document.getElementById('v-tick').addEventListener('click', function () {
    var vol = document.getElementById('vol').checked;
    V.loops++;
    if (vol) {
      V.c1 = V.mm;
      if (V.mm === 'false') { V.stopped = true; vRender('B가 메인 메모리에서 false를 읽고 반복을 멈췄어요.'); }
      else vRender('B가 다시 메인 메모리에서 true를 읽었어요. A가 바꾸기 전이에요.');
    } else {
      vRender(V.c2 === 'false' ? 'B는 여전히 캐시의 true를 보고 반복해요. A가 바꾼 값이 B에게 보이지 않아요. 영원히 멈추지 않을 수도 있어요.' : 'B가 캐시의 true를 보고 반복해요.');
    }
  });
  document.getElementById('v-reset').addEventListener('click', vReset);
  document.getElementById('vol').addEventListener('change', vReset);
  vReset();

  /* 6. 도구 고르기 */
  var tools = ['volatile', 'synchronized', 'AtomicInteger', 'computeIfAbsent', 'DB 락'];
  var scenarios = [
    { q: '작업 스레드를 멈추게 하는 종료 플래그. 한 스레드만 쓰고 작업 스레드는 읽기만 해요.', a: 0, e: '한 쪽은 쓰기만, 다른 쪽은 읽기만 하는 값이라 가시성만 있으면 돼요.' },
    { q: '여러 요청 스레드가 동시에 올리는 API 호출 횟수 카운터.', a: 2, e: '변수 하나의 증가라 CAS 기반 원자적 연산이 가볍고 정확해요. 아주 경합이 심하면 LongAdder.' },
    { q: '한 객체의 잔액을 확인하고 부족하지 않으면 출금하고 내역 리스트에 추가해요. 서버는 한 대.', a: 1, e: '여러 값을 함께 바꾸는 복합 연산이라 한 덩어리로 묶는 락이 필요해요.' },
    { q: '환율 캐시: 키가 없으면 외부 API로 한 번만 불러와 넣고 싶어요.', a: 3, e: '"없으면 만들어 넣기"를 한 번에 하는 메서드를 써요. containsKey 후 put은 두 번 만들 수 있어요.' },
    { q: '서버 3대가 같은 상품 재고를 차감해요.', a: 4, e: '프로세스가 다르면 메모리를 공유하지 않아서 자바의 락은 소용없어요. 공유 상태가 있는 DB에서 막아요(락 레슨).' }
  ];
  var ch = document.getElementById('chooser');
  scenarios.forEach(function (s, si) {
    var box = document.createElement('div'); box.className = 'scenario';
    box.innerHTML = '<p><strong>' + (si + 1) + '.</strong> ' + esc(s.q) + '</p><div class="choice-row"></div><div class="fb" hidden></div>';
    var row = box.querySelector('.choice-row'), fb = box.querySelector('.fb');
    tools.forEach(function (t, ti) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = t; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        row.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var ok = ti === s.a; fb.hidden = false; fb.className = 'fb ' + (ok ? 'right' : 'wrong');
        fb.textContent = (ok ? '맞아요. ' : '추천은 ' + tools[s.a] + '예요. ') + s.e;
      });
      row.appendChild(b);
    });
    ch.appendChild(box);
  });

  /* 7. 확인 문제 */
  var quiz = [
    { q: 'volatile이 보장하는 것은?', o: ['원자성과 가시성', '가시성만', '원자성만'], a: 1, e: '쓰기가 바로 보이고 최신 값을 읽게 하지만, 여러 단계를 한 덩어리로 만들지는 않아요.' },
    { q: 'synchronized (new Object()) { count++; } 의 문제는?', o: ['재진입이 안 된다', '호출마다 다른 락이라 아무도 기다리지 않는다', '데드락이 난다'], a: 1, e: '같은 락 객체를 공유해야 서로 기다려요.' },
    { q: 'ConcurrentHashMap에서 "없으면 만들어 넣기"를 안전하게 하려면?', o: ['containsKey 후 put', 'computeIfAbsent'], a: 1, e: '두 메서드를 잇는 사이에 다른 스레드가 끼어들 수 있어요. 한 번에 하는 메서드를 써요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('sy-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('sy-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
