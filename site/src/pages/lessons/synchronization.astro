---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/concurrency/SynchronizationTest.java`;

const codePredict = `class Counter {
    volatile int value;      // volatile을 붙였다
}

// 두 스레드가 동시에 각각 100만 번
for (int i = 0; i < 1_000_000; i++) counter.value++;`;

const codeSync = `class Account {
    private int balance;

    public synchronized void withdraw(int amount) {   // this를 락으로 사용
        if (balance >= amount) {                     // 확인과
            balance -= amount;                       // 변경이 한 덩어리
        }
    }
}

// 블록으로 범위를 좁힐 수도 있다
private final Object lock = new Object();
synchronized (lock) { ... }`;

const codeWrongLock = `public void increment() {
    synchronized (new Object()) {   // 호출마다 새 락 → 아무도 기다리지 않는다
        count++;
    }
}`;

const codeVolatile = `class Worker implements Runnable {
    private volatile boolean running = true;   // 없으면 멈추지 않을 수 있다

    public void run() {
        while (running) { work(); }
    }

    public void stop() { running = false; }    // 다른 스레드가 호출
}`;

const codeCas = `AtomicInteger stock = new AtomicInteger(10);
stock.incrementAndGet();               // 원자적 증가
stock.compareAndSet(10, 9);            // 지금 값이 10이면 9로 (아니면 false)

// incrementAndGet이 내부에서 하는 일 (개념)
int current;
do {
    current = stock.get();
} while (!stock.compareAndSet(current, current + 1));  // 실패하면 다시 시도`;

const codeMap = `// 위험: 두 메서드 사이에 다른 스레드가 끼어든다
if (!cache.containsKey(key)) {
    cache.put(key, loadRate(key));
}

// 안전: 확인과 저장을 한 번에
cache.computeIfAbsent(key, k -> loadRate(k));`;
---
<Base title="동기화 · Dev Lessons" description="synchronized, volatile, 원자적 연산의 차이를 원자성과 가시성 두 문제로 나눠 배우고, 상황별로 어떤 도구를 써야 하는지 직접 골라 봐요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Java 동시성 · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/process-and-thread/">프로세스와 스레드</a></p>
    <h1>동기화: synchronized, volatile, 원자적 연산</h1>
    <p class="lede">"synchronized와 volatile의 차이"는 면접 단골이지만, 둘 다 "동시성 문제를 막는 키워드"로만 외우면 헷갈려요. 동시성 문제를 <strong>원자성</strong>과 <strong>가시성</strong> 두 가지로 나눠 보면 각 도구가 무엇을 막는지 분명해져요.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#problems"><span>1</span>두 가지 문제</a>
      <a href="#sync"><span>2</span>synchronized</a>
      <a href="#volatile"><span>3</span>volatile과 가시성</a>
