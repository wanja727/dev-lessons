---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const testDir = `${repo}/blob/main/verification/src/test/java/lab/devlessons/transaction`;

const codePredict = `@Service
public class OrderService {

    public void placeOrder(Order order) {
        orderRepository.save(order);
        addPoint(order.getUserId(), 100);   // 같은 클래스의 메서드 호출
    }

    @Transactional
    public void addPoint(Long userId, int amount) {
        Point point = pointRepository.findByUserId(userId);
        point.add(amount);                  // 변경 감지로 반영될까?
    }
}`;

const codeProxy = `// 스프링이 실제로 주입하는 것 (개념 코드)
class OrderService$$SpringCGLIB$$0 extends OrderService {
    private OrderService target;            // 진짜 객체
    private TransactionManager txManager;

    @Override
    public void addPoint(Long userId, int amount) {
        TransactionStatus tx = txManager.getTransaction(...); // 1. 시작
        try {
            target.addPoint(userId, amount);                  // 2. 진짜 메서드
            txManager.commit(tx);                             // 3. 커밋
        } catch (RuntimeException e) {
            txManager.rollback(tx);                           // 3'. 롤백
            throw e;
        }
    }
}`;

const codeFix1 = `@Transactional                       // 호출하는 쪽에 붙인다
public void placeOrder(Order order) {
    orderRepository.save(order);
    addPoint(order.getUserId(), 100);    // 이미 열린 트랜잭션 안에서 실행
}`;

const codeFix2 = `@Service
public class PointService {
    @Transactional
    public void addPoint(Long userId, int amount) { ... }
}

// OrderService
public void placeOrder(Order order) {
    orderRepository.save(order);
    pointService.addPoint(order.getUserId(), 100);  // 다른 빈 → 프록시를 거친다
}`;

const codeFix3 = `public void placeOrder(Order order) {
    orderRepository.save(order);
    transactionTemplate.executeWithoutResult(status ->
        addPointInternal(order.getUserId(), 100));  // 코드로 직접 경계를 연다
}`;
---
<Base title="@Transactional 동작 원리 · Dev Lessons" description="@Transactional이 프록시로 동작하는 원리를 호출 경로 단계 실행으로 확인하고, 내부 호출에 적용되지 않는 이유와 해결 방법 세 가지의 차이를 배워요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Spring · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>, <a href="/dev-lessons/lessons/spring-beans/">스프링 빈과 의존성 주입</a>, <a href="/dev-lessons/lessons/jpa-persistence-context/">영속성 컨텍스트</a> (변경 감지)</p>
    <h1>@Transactional 동작 원리와 내부 호출</h1>
    <p class="lede">@Transactional을 붙였는데 트랜잭션이 없다면? 예외도 나지 않고, 데이터만 조용히 빠져요. 이 버그를 이해하려면 "어노테이션이 붙어 있다"가 아니라 <strong>"누가 그 메서드를 어떤 경로로 불렀나"</strong>를 봐야 해요. 호출 경로를 한 단계씩 따라가며 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 트랜잭션·커밋·롤백(<a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>), 빈과 생성자 주입(<a href="/dev-lessons/lessons/spring-beans/">스프링 빈</a>), 변경 감지(<a href="/dev-lessons/lessons/jpa-persistence-context/">영속성 컨텍스트</a>), 자바의 상속과 오버라이드.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#proxy"><span>1</span>프록시가 하는 일</a>
      <a href="#path"><span>2</span>호출 경로 따라가기</a>
      <a href="#why"><span>3</span>내부 호출이 빠지는 이유</a>
      <a href="#fix"><span>4</span>해결 방법 세 가지</a>
      <a href="#traps"><span>5</span>함정</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>포인트는 쌓일까요?</h2>
    <p>컨트롤러가 <code>orderService.placeOrder()</code>를 불렀어요. <code>addPoint</code>에는 @Transactional이 붙어 있어요.</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">요청이 끝나면</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="both" aria-pressed="false">주문 저장, 포인트 반영</button>
          <button class="chip" type="button" data-v="order" aria-pressed="false">주문 저장, 포인트 그대로</button>
          <button class="chip" type="button" data-v="error" aria-pressed="false">예외가 난다</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 2장에서 호출 경로를 따라가며 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="proxy" class="read">
    <p class="eyebrow">1 · 프록시가 하는 일</p>
    <h2>내가 주입받은 건 진짜 객체가 아니에요</h2>
    <p>스프링은 @Transactional이 붙은 빈을 만들 때 진짜 객체를 감싼 <strong>프록시</strong>(대리 객체)를 하나 더 만들고, 다른 빈에는 이 프록시를 주입해요. 스프링 부트는 기본적으로 원래 클래스를 <strong>상속</strong>한 프록시 클래스를 만들어요(이 방식을 CGLIB 프록시라고 불러요). 그래서 <code>orderService.getClass()</code>를 찍어 보면 <code>OrderService$$SpringCGLIB$$0</code> 같은 이름이 나와요.</p>
    <p>프록시는 메서드 호출을 가로채서 앞뒤로 트랜잭션 일을 해요. 개념적으로는 이런 코드예요.</p>
    <pre set:text={codeProxy} />
    <p>이렇게 핵심 로직 바깥에서 공통 기능(트랜잭션, 로그, 권한 등)을 끼워 넣는 방식을 <strong>AOP</strong>(관점 지향 프로그래밍)라고 해요. 핵심은 하나예요. <strong>트랜잭션을 여는 건 어노테이션이 아니라 프록시이고, 프록시를 거친 호출에만 적용돼요.</strong></p>
  </section>

  <section id="path">
    <div class="read stack">
      <p class="eyebrow">2 · 호출 경로 따라가기</p>
      <h2>프록시를 거치는지 한 단계씩 보기</h2>
      <p>상황을 고르고 "다음"을 눌러 호출이 어디를 지나는지 보세요. 오른쪽 위에 그 순간의 트랜잭션 상태가 나와요.</p>
    </div>
    <div class="panel">
      <div class="seg" id="scenario">
        <button type="button" data-v="internal" aria-pressed="true">같은 클래스 내부 호출 (0장)</button>
        <button type="button" data-v="caller" aria-pressed="false">호출하는 쪽에 @Transactional</button>
        <button type="button" data-v="split" aria-pressed="false">다른 빈으로 분리</button>
      </div>
      <label class="check"><input type="checkbox" id="fail"> 포인트 계좌가 없어서 point.add()에서 런타임 예외</label>
      <div class="lanes">
        <div class="lane" data-at="caller"><strong>호출자</strong><span>컨트롤러</span></div>
        <div class="lane" data-at="proxy"><strong>프록시</strong><span>스프링이 만든 대리 객체</span></div>
        <div class="lane" data-at="target"><strong>진짜 객체</strong><span>내가 작성한 코드</span></div>
        <div class="txbox"><span class="label">트랜잭션</span><b id="tx-state">없음</b></div>
      </div>
      <p class="verdict" id="path-text" aria-live="polite"></p>
      <ol class="path-steps" id="path-steps"></ol>
      <div class="step-nav">
        <button class="btn" type="button" id="path-prev">이전</button>
        <button class="btn primary" type="button" id="path-next">다음</button>
      </div>
      <p class="callout" id="path-result" hidden></p>
    </div>
  </section>

  <section id="why" class="read">
    <p class="eyebrow">3 · 내부 호출이 빠지는 이유</p>
    <h2>this는 프록시가 아니라 진짜 객체예요</h2>
    <p>메서드 안에서 <code>addPoint()</code>를 부르는 건 <code>this.addPoint()</code>와 같아요. 그런데 이 코드가 실행되는 곳은 이미 <strong>진짜 객체 안</strong>이라서 <code>this</code>는 진짜 객체를 가리켜요. 호출이 프록시를 다시 거칠 길이 없어요.</p>
    <ul>
      <li>그래서 <code>addPoint</code>는 트랜잭션 없이 실행돼요.</li>
      <li>트랜잭션이 없으니 커밋도 없고, <a href="/dev-lessons/lessons/jpa-persistence-context/">변경 감지</a>로 UPDATE를 보낼 시점(flush)도 오지 않아요.</li>
      <li><code>orderRepository.save()</code>는 리포지토리 메서드가 각자 자기 트랜잭션 안에서 실행되기 때문에(<a href="/dev-lessons/lessons/jpa-basics/">JPA 첫걸음</a>) 따로 저장되고 커밋돼요.</li>
      <li>결과적으로 <strong>예외 없이 주문만 저장되고 포인트는 빠져요.</strong> 가장 찾기 어려운 종류의 버그예요.</li>
    </ul>
    <p>같은 이유로 프록시가 가로챌 수 없는 메서드에도 @Transactional은 효과가 없어요. 대표적으로 <strong>private 메서드</strong>는 상속으로 덮어쓸 수 없어서 프록시가 끼어들지 못해요.</p>
  </section>

  <section id="fix" class="read">
    <p class="eyebrow">4 · 해결 방법 세 가지</p>
    <h2>방법마다 트랜잭션 범위가 달라요</h2>
    <h3>1. 호출하는 쪽에 @Transactional</h3>
    <pre set:text={codeFix1} />
    <p>주문 저장과 포인트 적립이 <strong>한 트랜잭션</strong>이 돼요. 포인트 적립에서 예외가 나면 주문 저장도 함께 롤백돼요.</p>
    <h3>2. 다른 빈으로 분리</h3>
    <pre set:text={codeFix2} />
    <p>호출이 프록시를 거쳐서 포인트 적립에 트랜잭션이 생겨요. 다만 placeOrder 자체에는 트랜잭션이 없으니 <strong>주문 저장과 포인트 적립은 따로 커밋</strong>돼요. 포인트 적립이 실패해도 주문은 남아요.</p>
    <h3>3. TransactionTemplate으로 직접</h3>
    <pre set:text={codeFix3} />
    <p>프록시 대신 코드로 트랜잭션 경계를 정해요. 어디서 시작하고 끝나는지 코드에 그대로 드러나요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>방법</th><th>주문과 포인트</th><th>언제</th></tr></thead>
        <tbody>
          <tr><td>호출하는 쪽에 @Transactional</td><td>함께 커밋, 함께 롤백</td><td>둘이 반드시 같이 성공해야 할 때 (대부분)</td></tr>
          <tr><td>다른 빈으로 분리</td><td>따로 커밋</td><td>책임이 다른 기능이고, 하나가 실패해도 다른 하나는 남아야 할 때</td></tr>
          <tr><td>TransactionTemplate</td><td>코드로 정한 범위</td><td>트랜잭션 범위를 메서드보다 좁게 잡고 싶을 때</td></tr>
        </tbody>
      </table>
    </div>
    <details class="more"><summary>더 알아보기: 다른 해결 방법</summary><p>자기 자신을 주입받거나 <code>AopContext.currentProxy()</code>를 쓰는 방법도 있지만 구조가 꼬여서 잘 권하지 않아요.</p></details>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">5 · 함정</p>
    <h2>"붙어 있다"와 "적용됐다"는 달라요</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>트랜잭션</th><th>이유</th></tr></thead>
        <tbody>
          <tr><td>같은 클래스 안에서 호출</td><td>적용 안 됨</td><td>this는 진짜 객체, 프록시를 안 거침</td></tr>
          <tr><td>private 메서드에 붙임</td><td>적용 안 됨</td><td>프록시가 덮어쓸 수 없음</td></tr>
          <tr><td>트랜잭션 안에서 내부 호출한 메서드의 readOnly 같은 설정</td><td>무시됨</td><td>바깥 트랜잭션에 그냥 합류, 내부 메서드의 어노테이션은 읽히지 않음</td></tr>
          <tr><td>스프링 빈이 아닌 객체 (new로 만든 객체)</td><td>적용 안 됨</td><td>프록시가 없음</td></tr>
        </tbody>
      </table>
    </div>
    <p>디버깅할 때는 어노테이션 대신 <strong>실제로 트랜잭션이 열려 있는지</strong>를 확인해요. <code>TransactionSynchronizationManager.isActualTransactionActive()</code>를 찍어 보거나, 로그 레벨을 올려 트랜잭션 시작과 커밋 로그를 보면 돼요. 이 레슨의 검증 테스트도 이 방법으로 확인해요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "@Transactional은 어떻게 동작하나요? 같은 클래스에서 호출하면 왜 적용되지 않나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: @Transactional은 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>@Transactional은 선언적 트랜잭션으로, 스프링 AOP가 만든 프록시가 메서드 호출을 가로채 트랜잭션을 시작하고 커밋하거나 롤백합니다.</dd>
        <dt>원리</dt><dd>빈에는 진짜 객체 대신 CGLIB 프록시가 주입되고, 외부에서 프록시를 거쳐 호출할 때만 트랜잭션이 적용됩니다. 같은 클래스 안의 호출은 this, 즉 진짜 객체를 직접 부르기 때문에 프록시를 거치지 않아 트랜잭션이 없습니다. private 메서드도 프록시가 덮어쓸 수 없어 적용되지 않습니다.</dd>
        <dt>트레이드오프</dt><dd>해결은 호출하는 쪽에 @Transactional을 붙여 한 트랜잭션으로 묶거나, 다른 빈으로 분리해 각각 커밋되게 하거나, TransactionTemplate으로 범위를 직접 정하는 방법이 있고, 원하는 트랜잭션 범위에 따라 고릅니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 예외 없이 포인트가 빠지는 문제를 TransactionSynchronizationManager로 트랜잭션 여부를 찍어 원인을 찾고, 주문과 포인트를 한 트랜잭션으로 묶었습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: "프록시가 트랜잭션을 연다"와 "this는 진짜 객체"를 말했나요? 해결 방법마다 트랜잭션 범위가 다르다는 점을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 스프링 부트와 PostgreSQL에서, 메서드 안의 트랜잭션 여부와 DB 결과로 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>@Transactional 빈에는 CGLIB 프록시가 주입됨</li>
      <li>밖에서 부르면 트랜잭션 있음, 같은 객체 안에서 부르면 어노테이션이 있어도 없음, TransactionTemplate은 프록시 없이 트랜잭션을 엶</li>
      <li>내부 호출: 주문은 저장되고 포인트는 예외 없이 빠짐. 호출하는 쪽에 @Transactional 또는 빈 분리로 반영됨</li>
      <li>런타임 예외: 호출하는 쪽 트랜잭션이면 주문까지 롤백, 빈을 나누면 이미 커밋된 주문은 남음</li>
    </ul>
    <p><a href={`${testDir}/TransactionalProxyTest.java`}>TransactionalProxyTest</a> · <a href={`${testDir}/SelfInvocationTest.java`}>SelfInvocationTest</a></p>
  </section>

  <footer>
    근거: Spring Framework 참조 문서의 Using @Transactional(프록시 모드와 self-invocation), Understanding AOP Proxies. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .lanes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) 120px; gap: 8px; }
  .lane { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; opacity: 0.45; transition: opacity 0.2s; }
  .lane span { font-size: 13px; color: var(--muted); }
  .lane.on { opacity: 1; border-color: var(--accent); background: var(--accent-soft); }
  .lane.skip { opacity: 1; border-style: dashed; border-color: var(--query); }
  .txbox { border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; background: var(--code-bg); }
  .txbox b { font-size: 16px; }
  .txbox b.open { color: var(--accent); } .txbox b.commit { color: var(--ok); } .txbox b.rollback { color: var(--query); } .txbox b.none { color: var(--muted); }
  .path-steps { margin: 0; padding-left: 22px; font-size: 14px; display: flex; flex-direction: column; gap: 4px; }
  .path-steps li { color: var(--muted); }
  .path-steps li.done { color: var(--ink); }
  .path-steps li.now { color: var(--accent); font-weight: 700; }
  .step-nav { display: flex; gap: 8px; }
  @media (max-width: 760px) { .lanes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { both: '주문 저장, 포인트 반영', order: '주문 저장, 포인트 그대로', error: '예외가 난다' };
  var pred = { p1: store('tx-p1'), p2: store('tx-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "주문 저장, 포인트 그대로"예요. 예외도 나지 않아요. 2장에서 이유를 따라가 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('tx-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 호출 경로 */
  function scenario(name, fail) {
    var S = {
      internal: [
        { at: 'caller', tx: 'none', t: '컨트롤러가 orderService.placeOrder()를 불러요. 주입받은 orderService는 프록시예요.' },
        { at: 'proxy', tx: 'none', t: '프록시가 가로챘지만 placeOrder에는 @Transactional이 없어서 트랜잭션 없이 그대로 진짜 객체로 넘겨요.' },
        { at: 'target', tx: 'none', t: '진짜 객체의 placeOrder 실행. orderRepository.save()는 리포지토리 자체 트랜잭션으로 저장하고 바로 커밋해요.' },
        { at: 'target', tx: 'none', skip: 'proxy', t: 'addPoint()를 불러요. this.addPoint()라서 진짜 객체 안에서 바로 실행돼요. 프록시를 거치지 않아요!' },
        fail ? { at: 'target', tx: 'none', t: 'point.add()에서 예외. 트랜잭션이 없으니 롤백할 것도 없어요. 이미 커밋된 주문은 남아요.' }
             : { at: 'target', tx: 'none', t: 'point.add()로 값만 바뀌었어요. 트랜잭션이 없으니 flush도 커밋도 오지 않아요.' },
        { at: 'caller', tx: 'none', t: fail ? '컨트롤러에 예외가 전달돼요.' : '컨트롤러로 정상 반환. 예외는 없어요.' }
      ],
      caller: [
        { at: 'caller', tx: 'none', t: '컨트롤러가 fixedOrderService.placeOrder()를 불러요. 주입받은 건 프록시예요.' },
        { at: 'proxy', tx: 'open', t: 'placeOrder에 @Transactional이 있어서 프록시가 트랜잭션을 시작해요.' },
        { at: 'target', tx: 'open', t: '진짜 객체의 placeOrder 실행. orderRepository.save()는 이미 열린 트랜잭션에 합류해요.' },
        { at: 'target', tx: 'open', t: 'addPoint()는 내부 호출이지만, 이미 바깥 트랜잭션 안이라 그 안에서 실행돼요.' },
        fail ? { at: 'proxy', tx: 'rollback', t: 'point.add()에서 런타임 예외. 프록시가 잡아서 트랜잭션 전체를 롤백해요. 주문 저장도 취소돼요.' }
             : { at: 'proxy', tx: 'commit', t: '메서드가 정상으로 끝나서 프록시가 커밋해요. 커밋 직전 flush로 포인트 UPDATE가 나가요.' },
        { at: 'caller', tx: fail ? 'rollback' : 'commit', t: fail ? '예외가 컨트롤러로 다시 던져져요.' : '컨트롤러로 반환. 주문과 포인트가 함께 반영됐어요.' }
      ],
      split: [
        { at: 'caller', tx: 'none', t: '컨트롤러가 splitOrderService.placeOrder()를 불러요. placeOrder에는 @Transactional이 없어요.' },
        { at: 'target', tx: 'none', t: 'orderRepository.save()가 자체 트랜잭션으로 주문을 저장하고 커밋해요.' },
        { at: 'proxy', tx: 'open', t: 'pointService.addPoint()는 다른 빈 호출이라 PointService의 프록시를 거쳐요. 프록시가 트랜잭션을 시작해요.' },
        { at: 'target', tx: 'open', t: '진짜 PointService.addPoint 실행.' },
        fail ? { at: 'proxy', tx: 'rollback', t: 'point.add()에서 예외. 프록시가 포인트 트랜잭션만 롤백해요. 앞에서 커밋된 주문은 남아요.' }
             : { at: 'proxy', tx: 'commit', t: '정상 종료. 프록시가 포인트 트랜잭션을 커밋해요.' },
        { at: 'caller', tx: fail ? 'rollback' : 'commit', t: fail ? '예외가 컨트롤러로 전달돼요. 주문은 이미 저장된 상태예요.' : '주문과 포인트가 각각 따로 커밋됐어요.' }
      ]
    };
    return S[name];
  }
  var result = {
    internal: [false, '주문 저장, 포인트 그대로. 예외 없이 데이터만 빠져요.', '주문 저장, 예외 발생. 롤백할 트랜잭션이 없었어요.'],
    caller: [true, '주문과 포인트 모두 반영 (한 트랜잭션).', '주문도 포인트도 없음. 한 트랜잭션이라 함께 롤백됐어요.'],
    split: [true, '주문과 포인트 모두 반영 (트랜잭션 두 개).', '주문은 남고 포인트는 롤백. 트랜잭션이 나뉘어 있었어요.']
  };
  var txLabel = { none: '없음', open: '열림', commit: '커밋', rollback: '롤백' };
  var cur = 'internal', i = 0, steps;
  function load() { steps = scenario(cur, document.getElementById('fail').checked); i = 0; renderPath(); }
  function renderPath() {
    var s = steps[i];
    document.querySelectorAll('.lane').forEach(function (l) {
      l.classList.toggle('on', l.dataset.at === s.at);
      l.classList.toggle('skip', s.skip === l.dataset.at);
    });
    var tx = document.getElementById('tx-state'); tx.textContent = txLabel[s.tx]; tx.className = s.tx;
    document.getElementById('path-text').textContent = s.t;
    document.getElementById('path-steps').innerHTML = steps.map(function (x, k) {
      return '<li class="' + (k < i ? 'done' : k === i ? 'now' : '') + '">' + esc(k <= i ? x.t : '…') + '</li>';
    }).join('');
    document.getElementById('path-prev').disabled = i === 0;
    document.getElementById('path-next').disabled = i === steps.length - 1;
    var res = document.getElementById('path-result');
    if (i === steps.length - 1) {
      var fail = document.getElementById('fail').checked;
      res.hidden = false; res.innerHTML = '<strong>결과:</strong> ' + esc(result[cur][fail ? 2 : 1]);
    } else res.hidden = true;
  }
  document.getElementById('path-next').addEventListener('click', function () { if (i < steps.length - 1) { i++; renderPath(); } });
  document.getElementById('path-prev').addEventListener('click', function () { if (i > 0) { i--; renderPath(); } });
  document.getElementById('fail').addEventListener('change', load);
  pressGroup(document.getElementById('scenario'), function (v) { cur = v; load(); });
  load();

  /* 6. 확인 문제 */
  var quiz = [
    { q: '@Transactional이 붙은 public 메서드를 같은 클래스의 다른 메서드에서 부르면?', o: ['트랜잭션이 적용된다', '프록시를 거치지 않아 적용되지 않는다'], a: 1, e: 'this는 진짜 객체라서 프록시가 끼어들 수 없어요.' },
    { q: '주문 저장과 포인트 적립이 반드시 함께 성공하거나 함께 실패해야 한다면?', o: ['포인트 적립을 다른 빈으로 분리한다', '호출하는 쪽(placeOrder)에 @Transactional을 붙인다'], a: 1, e: '빈을 나누면 트랜잭션도 나뉘어 따로 커밋돼요. 함께 묶으려면 바깥 메서드에 트랜잭션이 있어야 해요.' },
    { q: 'private 메서드에 @Transactional을 붙이면?', o: ['적용된다', '적용되지 않는다'], a: 1, e: 'CGLIB 프록시는 상속으로 메서드를 덮어쓰는데, private 메서드는 덮어쓸 수 없어요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('tx-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('tx-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
