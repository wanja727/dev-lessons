<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var pred = { p1: store('ob-p1'), p2: store('ob-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 === 'sent' ? '메시지는 이미 나갔다' : '메시지도 취소된다') + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "메시지는 이미 나갔다"예요. 2장에서 "바로 보내기" + "재고 부족으로 롤백"으로 확인해 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('ob-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 시뮬레이터: 각 단계는 상태를 바꾸는 동작 목록을 가진다
     o+: 주문 추가(커밋 전), x+: 아웃박스 추가(커밋 전), c: 커밋, r: 롤백, b+: 브로커가 받음, p: 아웃박스 표시 */
  var S = {
    direct: {
      ok: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', '브로커로 바로 보냄', ['b+']], ['서비스', '재고 차감 성공', []], ['DB', '커밋', ['c']]],
      rollback: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', '브로커로 바로 보냄 → 이미 밖으로 나감', ['b+']], ['서비스', '재고 부족 예외', []], ['DB', '롤백: 주문이 사라짐. 브로커의 메시지는 그대로', ['r']]],
      down: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', '브로커로 보내기 → 연결 실패 예외', []], ['DB', '롤백: 브로커 장애 때문에 주문도 실패', ['r']]]
    },
    after: {
      ok: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', 'publishEvent: 스프링 안에서만 알림, 아직 안 보냄', []], ['서비스', '재고 차감 성공', []], ['DB', '커밋', ['c']], ['리스너', 'AFTER_COMMIT: 브로커로 보냄', ['b+']]],
      rollback: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', 'publishEvent: 아직 안 보냄', []], ['서비스', '재고 부족 예외', []], ['DB', '롤백', ['r']], ['리스너', '커밋되지 않았으니 실행되지 않음', []]],
      down: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', 'publishEvent: 아직 안 보냄', []], ['서비스', '재고 차감 성공', []], ['DB', '커밋: 주문 확정', ['c']], ['리스너', 'AFTER_COMMIT: 브로커로 보내기 → 연결 실패', []], ['리스너', '다시 보낼 기록이 없음. 메시지 유실', []]]
    },
    outbox: {
      ok: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', '아웃박스에 메시지 기록 (커밋 전)', ['x+']], ['서비스', '재고 차감 성공', []], ['DB', '커밋: 주문과 아웃박스 행이 함께 확정', ['c']], ['릴레이', '안 보낸 행을 읽어 브로커로 보냄', ['b+']], ['릴레이', 'published_at 표시', ['p']]],
      rollback: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', '아웃박스에 메시지 기록 (커밋 전)', ['x+']], ['서비스', '재고 부족 예외', []], ['DB', '롤백: 주문과 아웃박스 행이 함께 사라짐', ['r']], ['릴레이', '보낼 행 없음', []]],
      down: [['서비스', '주문 저장 (커밋 전)', ['o+']], ['서비스', '아웃박스에 메시지 기록 (커밋 전)', ['x+']], ['DB', '커밋: 주문 확정 (브로커와 상관없음)', ['c']], ['릴레이', '브로커로 보내기 → 연결 실패. 표시하지 않음', []], ['릴레이', '(브로커 복구 후) 같은 행을 다시 읽어 보냄', ['b+']], ['릴레이', 'published_at 표시', ['p']]]
    }
  };
  var method = 'direct', incident = 'ok', idx = -1;
  function steps() { return S[method][incident]; }
  function render() {
    var st = steps();
    var order = 0, outbox = 0, committed = false, rolled = false, broker = 0, published = false;
    for (var i = 0; i <= idx; i++) st[i][2].forEach(function (a) {
      if (a === 'o+') order = 1; else if (a === 'x+') outbox = 1; else if (a === 'c') committed = true;
      else if (a === 'r') { rolled = true; order = 0; outbox = 0; } else if (a === 'b+') broker++; else if (a === 'p') published = true;
    });
    document.getElementById('steps').innerHTML = st.map(function (s, i) {
      return '<li class="' + (i < idx ? 'done' : i === idx ? 'now' : '') + '">' + (i <= idx ? '<span class="who">' + esc(s[0]) + '</span>' + esc(s[1]) : '…') + '</li>';
    }).join('');
    var pending = committed ? '' : ' (커밋 전)';
    var empty = '<tr><td colspan="3" class="muted">비어 있음</td></tr>';
    document.getElementById('t-order').innerHTML = order ? '<tr><td>1</td><td>커피' + pending + '</td></tr>' : empty;
    var showOutbox = method === 'outbox';
    document.getElementById('l-outbox').hidden = !showOutbox;
    document.getElementById('w-outbox').hidden = !showOutbox;
    document.getElementById('t-outbox').innerHTML = outbox ? '<tr><td>1</td><td>OrderPlaced' + pending + '</td><td>' + (published ? '보냄' : '비어 있음') + '</td></tr>' : empty;
    var ghost = broker > 0 && rolled;
    document.getElementById('t-broker').innerHTML = broker ? '<tr class="' + (ghost ? 'bad' : '') + '"><td>1</td><td>OrderPlaced {orderId: 1}</td></tr>' : empty;
    var v = '';
    if (idx === st.length - 1) {
      if (ghost) v = '유령 메시지: 주문은 없는데 배송팀은 메시지를 받았어요.';
      else if (committed && order && !broker) v = '메시지 유실: 주문은 확정됐는데 아무도 몰라요.';
      else if (!order && !broker) v = method === 'direct' && incident === 'down' ? '어긋나지는 않았지만, 브로커 장애 때문에 주문까지 받지 못했어요.' : '일치: 주문도 메시지도 없어요.';
      else v = '일치: 주문 1건, 메시지 1개.' + (method === 'outbox' && incident === 'down' ? ' 브로커가 죽어 있는 동안에도 주문은 받았어요.' : '');
    }
    document.getElementById('sim-verdict').textContent = v;
    document.getElementById('s-next').disabled = idx >= st.length - 1;
  }
  function reset() { idx = -1; render(); }
  document.getElementById('s-next').addEventListener('click', function () { if (idx < steps().length - 1) { idx++; render(); } });
  document.getElementById('s-all').addEventListener('click', function () { idx = steps().length - 1; render(); });
  document.getElementById('s-reset').addEventListener('click', reset);
  pressGroup(document.getElementById('method'), function (v) { method = v; reset(); });
  pressGroup(document.getElementById('incident'), function (v) { incident = v; reset(); });
  reset();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '@TransactionalEventListener(AFTER_COMMIT)로 메시지를 보낼 때 남는 문제는?', o: ['롤백돼도 메시지가 나간다', '커밋 후 보내기가 실패하면 메시지를 잃는다', '같은 메시지가 항상 두 번 나간다'], a: 1, e: '롤백되면 리스너가 실행되지 않아 유령 메시지는 막지만, 커밋이 끝난 뒤 실패하면 다시 보낼 기록이 없어요.' },
    { q: '아웃박스 패턴이 메시지 유실을 막는 핵심 이유는?', o: ['브로커가 트랜잭션을 지원해서', '메시지를 업무 데이터와 같은 트랜잭션으로 DB에 기록해서', '릴레이가 메시지를 한 번만 보내서'], a: 1, e: '주문과 아웃박스 행이 함께 커밋되니, 주문이 있으면 보낼 기록도 반드시 있어요.' },
    { q: '릴레이가 브로커로 보낸 직후, published_at을 적기 전에 죽었다. 재시작하면?', o: ['메시지를 잃는다', '같은 메시지를 다시 보낸다', '자동으로 중복이 걸러진다'], a: 1, e: '표시가 없으니 안 보낸 행으로 보고 다시 보내요. 그래서 받는 쪽이 event_id로 중복을 걸러야 해요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('ob-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('ob-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
