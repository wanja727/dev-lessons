---
import Base from '../../layouts/Base.astro';
import CiOutput from '../../components/CiOutput.astro';
import RunLocally from '../../components/RunLocally.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/inventory/InventoryConcurrencyTest.java`;
const impl = `${repo}/blob/main/verification/src/main/java/lab/devlessons/inventory/InventoryServices.java`;

const codePredict = `@Transactional
public void order(Long itemId) {
    InventoryItem item = items.findById(itemId).orElseThrow();  // 1. 읽고
    if (item.getQuantity() < 1) {
        throw new SoldOutException();                          // 2. 확인하고
    }
    item.decrease();                                           // 3. 하나 빼서 저장 (변경 감지)
}`;

const codeConditional = `-- 확인과 차감을 한 문장으로. 바뀐 행이 0이면 품절
UPDATE inventory_item
   SET quantity = quantity - 1
 WHERE id = ? AND quantity >= 1;`;

const codePessimistic = `@Lock(LockModeType.PESSIMISTIC_WRITE)       // SELECT ... FOR UPDATE
@Query("select i from InventoryItem i where i.id = :id")
Optional<InventoryItem> findForUpdate(@Param("id") Long id);`;

const codeDecr = `long left = redis.decr("stock:1");   // 50 → 49 → ... → 0 → -1 → ... → -50
if (left < 0) {
    throw new SoldOutException();     // 결과가 음수면 품절. 값은 이미 줄어 있다
}`;

const codeLua = `-- 재고가 요청 수량 이상일 때만 줄인다. 스크립트 전체가 한 번에 실행된다
local stock = tonumber(redis.call('GET', KEYS[1]))
if stock == nil or stock < tonumber(ARGV[1]) then
  return -1
end
return redis.call('DECRBY', KEYS[1], ARGV[1])`;
---
<Base title="재고 차감 동시성 · Dev Lessons" description="마지막 남은 상품에 주문이 몰릴 때 초과 판매가 생기는 이유와 막는 법. 조건부 UPDATE, 비관적 락, 낙관적 락, Redis DECR와 Lua 스크립트를 동시 주문 100건으로 비교해요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">동시성 · 개념 학습 · 약 35분 · 선수 레슨: <a href="/dev-lessons/lessons/locking/">낙관적 락 vs 비관적 락</a>, <a href="/dev-lessons/lessons/idempotency/">멱등성</a></p>
    <h1>재고 차감 동시성 (DB 락 vs Redis)</h1>
    <p class="lede">한정판 운동화 50켤레에 주문 100건이 동시에 들어와요. 51번째 손님에게 "주문 완료"를 보내면 환불과 사과가 기다려요. 커머스 면접 단골 질문인 재고 차감을 다섯 가지 방법으로 직접 비교해요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 갱신 손실(<a href="/dev-lessons/lessons/isolation-level/">격리 수준</a>), 비관적 락과 낙관적 락(<a href="/dev-lessons/lessons/locking/">낙관적 락 vs 비관적 락</a>), 변경 감지(<a href="/dev-lessons/lessons/jpa-persistence-context/">영속성 컨텍스트</a>). Redis는 이 레슨에서 처음부터 설명해요.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#background"><span>1</span>초과 판매</a>
      <a href="#sim"><span>2</span>마지막 1개 쟁탈전</a>
      <a href="#real"><span>3</span>실제 100건</a>
      <a href="#redis"><span>4</span>Redis로 차감</a>
      <a href="#traps"><span>5</span>함정</a>
      <a href="#choose"><span>6</span>선택 기준</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>몇 켤레가 팔릴까요?</h2>
    <p>재고 50개인 상품에 주문 100건이 동시에 들어와요. 주문마다 아래 메서드를 실행해요. 재고를 확인하고 있으니 50건만 성공할까요?</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">내 예측</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="50" aria-pressed="false">정확히 50건</button>
          <button class="chip" type="button" data-v="more" aria-pressed="false">50건보다 많이 팔릴 수 있다</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 2장과 3장에서 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="background" class="read">
    <p class="eyebrow">1 · 초과 판매</p>
    <h2>확인과 차감 사이의 틈</h2>
    <p>재고보다 많이 파는 것을 <strong>초과 판매</strong>(overselling)라고 해요. 위 코드는 "읽기 → 확인 → 쓰기" 세 단계로 나뉘어 있어요. 두 주문이 같은 값(재고 1)을 읽으면 둘 다 확인을 통과하고, 둘 다 "1 - 1 = 0"을 써요. 한 번의 차감이 사라졌으니 <a href="/dev-lessons/lessons/isolation-level/">격리 수준 레슨</a>의 <strong>갱신 손실</strong>이에요.</p>
    <p>막는 방법은 크게 두 갈래예요.</p>
    <ul>
      <li><strong>DB에서 막기:</strong> 확인과 차감을 한 SQL로 합치거나(조건부 UPDATE), 읽을 때 잠그거나(비관적 락), 저장할 때 바뀌었는지 확인해요(낙관적 락).</li>
      <li><strong>Redis에서 막기:</strong> <strong>Redis</strong>는 데이터를 메모리에 두는 키-값 저장소예요. 디스크를 거치지 않아 아주 빠르고, 명령을 <strong>한 번에 하나씩</strong> 차례로 실행해요. 그래서 명령 하나는 다른 명령과 섞이지 않아요(원자적).</li>
    </ul>
    <p class="muted"><code>synchronized</code>는 서버 한 대 안에서만 막아요. 서버가 두 대 이상이면 효과가 없어서 여기서는 다루지 않아요(<a href="/dev-lessons/lessons/synchronization/">동기화</a> 레슨).</p>
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">2 · 마지막 1개 쟁탈전</p>
      <h2>손님 둘, 재고 하나</h2>
      <p>방법을 고르고 "다음"을 눌러요. 두 손님의 요청이 어떤 순서로 섞이는지, 결국 몇 개가 팔리는지 보세요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">방법</span>
        <div class="seg" id="method">
          <button type="button" data-v="rmw" aria-pressed="true">읽고-계산하고-쓰기</button>
          <button type="button" data-v="cond" aria-pressed="false">조건부 UPDATE</button>
          <button type="button" data-v="pess" aria-pressed="false">비관적 락</button>
          <button type="button" data-v="opt" aria-pressed="false">낙관적 락</button>
          <button type="button" data-v="decr" aria-pressed="false">Redis DECR</button>
          <button type="button" data-v="lua" aria-pressed="false">Redis Lua</button>
        </div>
      </div>
      <div class="st-grid">
        <div class="pane">
          <span class="label">진행</span>
          <ol class="path-steps" id="steps"></ol>
        </div>
        <div class="pane">
          <span class="label">재고 값</span>
          <div class="big" id="stock-val">1</div>
          <span class="label">결과</span>
          <div class="svc-list">
            <div class="svc"><span class="svc-name">손님 A</span><span class="svc-state" id="res-a">-</span></div>
            <div class="svc"><span class="svc-name">손님 B</span><span class="svc-state" id="res-b">-</span></div>
          </div>
          <p class="verdict" id="sim-verdict"></p>
        </div>
      </div>
      <div class="step-nav">
        <button class="btn" type="button" id="s-reset">처음으로</button>
        <button class="btn primary" type="button" id="s-next">다음</button>
        <button class="btn" type="button" id="s-all">끝까지</button>
      </div>
    </div>
  </section>

  <section id="real" class="read">
    <p class="eyebrow">3 · 실제 100건</p>
    <h2>PostgreSQL과 Redis에서 동시에 주문 100건</h2>
    <p>재고 50개에 주문 100건을 스레드 100개로 동시에 시작했어요. 예측한 답을 확인해 보세요.</p>
    <CiOutput lesson="stock-concurrency" key="summary" label="실제 결과 보기: 여섯 방법 비교" source="InventoryConcurrencyTest" />
    <ul>
      <li><strong>읽고-계산하고-쓰기</strong>는 50건보다 많이 팔려요. 재고 숫자는 0 이상으로 남아 있어 겉보기엔 멀쩡한데, 주문 수가 재고보다 많아요. 테스트는 실서버의 다른 처리 시간을 흉내 내려고 읽기와 쓰기 사이를 10ms 쉬게 했어요.</li>
      <li><strong>조건부 UPDATE</strong>와 <strong>비관적 락</strong>은 정확히 50건이에요. 조건부 UPDATE는 한 문장이라 DB가 같은 행에 대한 UPDATE를 차례로 처리하고, 비관적 락은 먼저 잠근 트랜잭션이 끝날 때까지 다음 트랜잭션이 기다려요.</li>
      <li><strong>낙관적 락</strong>은 초과 판매는 없지만, 같은 버전을 읽은 주문들이 커밋 때 충돌로 실패해요. 재고가 남아 있는데 "주문 실패"를 받는 손님이 생겨요. 재시도를 붙여야 해요.</li>
    </ul>
    <p class="muted">시간(ms)은 CI 서버에서 잰 값이라 실행마다 달라요. 순위보다 "어떤 방법이 기다리는가"를 보세요.</p>
    <p class="muted">전체 코드: <a href={impl}>InventoryServices.java</a></p>
    <h3>DB 방법 코드</h3>
    <pre set:text={codeConditional} />
    <pre set:text={codePessimistic} />
  </section>

  <section id="redis" class="read">
    <p class="eyebrow">4 · Redis로 차감</p>
    <h2>DECR은 원자적이지만, 멈추지는 않아요</h2>
    <p><code>DECR</code>은 값을 1 줄이고 줄어든 값을 돌려주는 Redis 명령이에요. 명령 하나는 섞이지 않으니 갱신 손실은 없어요. 하지만 0에서 멈추지 않아요.</p>
    <pre set:text={codeDecr} />
    <p>주문 100건이면 값은 <strong>-50</strong>까지 내려가요. 결과가 음수인 주문을 품절로 처리하면 판매는 정확히 50건이지만, 재고 값이 음수로 남아 "재고 조회" 화면이 이상해지고 재입고 계산도 꼬여요. 실패한 만큼 <code>INCR</code>로 되돌려야 해요.</p>
    <p>확인과 차감을 한 번에 하려면 <strong>Lua 스크립트</strong>를 써요. Redis는 스크립트 하나를 실행하는 동안 다른 명령을 끼워 넣지 않아요. 그래서 "확인하고 줄이기"가 DECR 한 번처럼 원자적으로 실행돼요.</p>
    <pre set:text={codeLua} />
    <p>Lua 스크립트로는 정확히 50건이 팔리고 재고는 0에서 멈춰요. 3장의 실제 결과 5번, 6번 줄에서 확인할 수 있어요.</p>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">5 · 함정</p>
    <h2>재고만 맞으면 끝이 아니에요</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>함정</th><th>무슨 일이</th><th>대응</th></tr></thead>
        <tbody>
          <tr><td>Redis 차감 후 DB 주문 저장 실패</td><td>Redis 재고는 줄었는데 주문은 없어요. Redis와 DB는 하나의 트랜잭션으로 묶이지 않아요</td><td>주문 저장이 실패하면 INCR로 되돌리고, 주기적으로 DB 주문 수와 Redis 재고를 맞춰 봐요</td></tr>
          <tr><td>Redis가 원본이 되어 버림</td><td>Redis는 메모리 저장소라 설정에 따라 장애 때 최근 변경을 잃을 수 있어요</td><td>재고의 원본은 DB에 두고, Redis는 앞단에서 주문을 걸러내는 용도로 써요</td></tr>
          <tr><td>낙관적 락에 재시도 없음</td><td>경합이 심하면 재고가 남았는데도 대부분 실패해요</td><td>짧은 재시도를 붙이거나, 경합이 심한 상품은 다른 방법을 써요</td></tr>
          <tr><td>비관적 락의 대기</td><td>인기 상품 하나에 모든 주문이 줄을 서요. 여러 행을 다른 순서로 잠그면 데드락도 생겨요</td><td>잠그는 범위를 작게, 트랜잭션은 짧게, 잠그는 순서는 항상 같게</td></tr>
          <tr><td>같은 주문이 두 번 차감</td><td>재시도로 같은 주문 요청이 두 번 와요</td><td><a href="/dev-lessons/lessons/idempotency/">멱등 키</a>로 주문 자체를 한 번만 처리해요</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="choose" class="read">
    <p class="eyebrow">6 · 선택 기준</p>
    <h2>상황별 추천</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>추천</th><th>이유</th></tr></thead>
        <tbody>
          <tr><td>일반 상품, 주문이 고르게 들어옴</td><td>조건부 UPDATE</td><td>코드가 가장 단순하고, 확인과 차감이 한 문장이라 틈이 없어요</td></tr>
          <tr><td>재고 확인 말고도 같은 행으로 판단할 게 많음</td><td>비관적 락</td><td>잠근 동안 여러 컬럼을 읽고 계산해도 안전해요</td></tr>
          <tr><td>충돌이 드묾 (B2B 주문, 관리자 수정)</td><td>낙관적 락 + 재시도</td><td>평소엔 락 없이 빠르고, 드문 충돌만 다시 해요</td></tr>
          <tr><td>선착순 이벤트, 초당 수천 건이 한 상품에 몰림</td><td>Redis Lua로 먼저 거르고 DB에 주문 저장</td><td>DB 한 행에 줄을 세우지 않고 메모리에서 빠르게 걸러요</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "선착순 한정판 상품의 재고 차감을 어떻게 구현하나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 읽고 확인하고 쓰는 방식은 동시 주문에서 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>재고를 읽고 확인한 뒤 줄여 저장하면, 동시 주문이 같은 값을 읽어 갱신 손실과 초과 판매가 생깁니다. 확인과 차감을 원자적으로 만들어야 합니다.</dd>
        <dt>원리</dt><dd>DB에서는 quantity >= 1 조건을 건 UPDATE 한 문장으로 확인과 차감을 합치거나, SELECT FOR UPDATE로 잠근 뒤 줄입니다. 트래픽이 몰리는 선착순이면 Redis에서 Lua 스크립트로 확인과 차감을 한 번에 실행해 먼저 걸러내고, 통과한 주문만 DB에 저장합니다.</dd>
        <dt>트레이드오프</dt><dd>비관적 락은 인기 상품 하나에 줄을 세워 대기가 길어지고, 낙관적 락은 경합이 심하면 재고가 있어도 실패해 재시도가 필요합니다. Redis DECR만 쓰면 음수까지 내려가므로 Lua로 막거나 되돌려야 하고, Redis와 DB가 한 트랜잭션이 아니어서 주문 저장 실패 시 복원과 주기적 대사가 필요합니다. 재고 원본은 DB에 둡니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 재고 50개에 동시 주문 100건 테스트로 읽고 쓰기 방식의 초과 판매를 재현하고, 조건부 UPDATE·비관적 락·Redis Lua가 정확히 50건만 성공시키는 것을 확인했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 왜 초과 판매가 생기는지(갱신 손실), DB 방법 하나 이상, Redis 방법과 그 한계(음수, DB와 정합성)를 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 PostgreSQL과 Redis 7을 띄워, 재고 50개에 스레드 100개로 동시에 주문해 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>읽고-계산하고-쓰기: 50건보다 많이 성공한다 (초과 판매)</li>
      <li>조건부 UPDATE: 정확히 50건 성공, 50건 품절, 남은 재고 0</li>
      <li>비관적 락: 정확히 50건 성공, 남은 재고 0</li>
      <li>낙관적 락(재시도 없음): 판 만큼만 줄고(성공 + 남은 재고 = 50), 충돌 실패가 생긴다</li>
      <li>Redis DECR: 성공은 50건이지만 값은 -50까지 내려간다</li>
      <li>Redis Lua 스크립트: 정확히 50건 성공, 값은 0에서 멈춘다</li>
      <li>Redis 동시 INCR 1,000번은 정확히 1,000</li>
    </ul>
    <p><a href={test}>InventoryConcurrencyTest</a></p>
    <RunLocally tests={['lab.devlessons.inventory.InventoryConcurrencyTest']} docker />
  </section>

  <footer>
    근거: PostgreSQL 16 문서(Explicit Locking, UPDATE), Redis 문서(DECR, EVAL, Scripting with Lua의 원자적 실행). 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .st-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 16px; }
  .pane { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .svc-list { display: flex; flex-direction: column; gap: 8px; }
  .svc { display: flex; justify-content: space-between; gap: 8px; border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; font-size: 14px; }
  .svc-name { color: var(--muted); }
  .svc-state { font-family: var(--font-mono); font-weight: 700; text-align: right; }
  .svc-state.ok { color: var(--ok); }
  .svc-state.bad { color: var(--warn); }
  #stock-val.neg { color: var(--query); }
  .path-steps { margin: 0; padding-left: 22px; font-size: 14px; display: flex; flex-direction: column; gap: 6px; }
  .path-steps li { color: var(--muted); }
  .path-steps li.done { color: var(--ink); }
  .path-steps li.now { color: var(--accent); font-weight: 700; }
  .path-steps .who { font-family: var(--font-mono); font-size: 12px; padding: 1px 6px; border-radius: 4px; background: var(--code-bg); margin-right: 4px; }
  .step-nav { display: flex; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 760px) { .st-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var pred = { p1: store('stk-p1'), p2: store('stk-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 === 'more' ? '50건보다 많이 팔릴 수 있다' : '정확히 50건') + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "50건보다 많이 팔릴 수 있다"예요. 2장 시뮬레이터와 3장 실제 결과로 확인해 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('stk-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 시뮬레이터: [누가, 설명, 재고 값(바뀌면), A 결과, B 결과] */
  var S = {
    rmw: [
      ['A', 'SELECT: 재고 1을 읽음', null], ['B', 'SELECT: 재고 1을 읽음 (A가 아직 안 씀)', null],
      ['A', '1 ≥ 1 확인 통과', null], ['B', '1 ≥ 1 확인 통과', null],
      ['A', 'UPDATE quantity = 0, 커밋', 0, '주문 성공'], ['B', 'UPDATE quantity = 0 (읽은 1에서 뺌), 커밋', 0, null, '주문 성공']
    ],
    cond: [
      ['A', 'UPDATE ... WHERE quantity >= 1 → 1행 바뀜 (재고 0)', 0, '주문 성공'],
      ['B', 'UPDATE ... WHERE quantity >= 1 → 0행 바뀜', null, null, '품절']
    ],
    pess: [
      ['A', 'SELECT ... FOR UPDATE: 재고 1, 행을 잠금', null], ['B', 'SELECT ... FOR UPDATE: A의 잠금 때문에 기다림', null],
      ['A', '확인 통과, UPDATE quantity = 0, 커밋 (잠금 풀림)', 0, '주문 성공'],
      ['B', '이제 읽음: 재고 0', null], ['B', '0 < 1, 품절', null, null, '품절']
    ],
    opt: [
      ['A', 'SELECT: 재고 1, version 1', null], ['B', 'SELECT: 재고 1, version 1', null],
      ['A', 'UPDATE ... WHERE version = 1 → 성공 (version 2), 커밋', 0, '주문 성공'],
      ['B', 'UPDATE ... WHERE version = 1 → 0행. 충돌 예외', null, null, '충돌 실패']
    ],
    decr: [
      ['A', 'DECR → 0 (0 이상이니 성공)', 0, '주문 성공'],
      ['B', 'DECR → -1 (음수니 품절. 값은 이미 줄었음)', -1, null, '품절']
    ],
    lua: [
      ['A', '스크립트: GET 1 → 1 ≥ 1 → DECRBY → 0 (한 번에 실행)', 0, '주문 성공'],
      ['B', '스크립트: GET 0 → 0 < 1 → -1 반환, 값은 그대로', null, null, '품절']
    ]
  };
  var V = {
    rmw: '두 켤레가 팔렸는데 재고는 0. 한 켤레를 더 팔았어요 (초과 판매).',
    cond: '확인과 차감이 한 문장이라 틈이 없어요. 1개만 팔렸어요.',
    pess: 'B는 A가 끝날 때까지 기다렸다가 최신 값을 읽었어요. 1개만 팔렸어요.',
    opt: '초과 판매는 없어요. 다만 B는 재고가 있었어도 충돌로 실패할 수 있어요(재시도 필요).',
    decr: '1개만 팔렸지만 재고 값이 -1로 남았어요. INCR로 되돌려야 해요.',
    lua: '확인과 차감이 한 번에 실행돼 1개만 팔리고 값은 0에서 멈췄어요.'
  };
  var method = 'rmw', idx = -1;
  function render() {
    var st = S[method], stock = 1, a = '-', b = '-';
    for (var i = 0; i <= idx; i++) {
      if (st[i][2] !== null) stock = st[i][2];
      if (st[i][3]) a = st[i][3];
      if (st[i][4]) b = st[i][4];
    }
    document.getElementById('steps').innerHTML = st.map(function (s, i) {
      return '<li class="' + (i < idx ? 'done' : i === idx ? 'now' : '') + '">' + (i <= idx ? '<span class="who">손님 ' + esc(s[0]) + '</span>' + esc(s[1]) : '…') + '</li>';
    }).join('');
    var sv = document.getElementById('stock-val');
    sv.textContent = stock; sv.className = 'big' + (stock < 0 ? ' neg' : '');
    [['res-a', a], ['res-b', b]].forEach(function (p) {
      var el = document.getElementById(p[0]); el.textContent = p[1];
      el.className = 'svc-state' + (p[1] === '주문 성공' ? ' ok' : p[1] === '-' ? '' : ' bad');
    });
    document.getElementById('sim-verdict').textContent = idx === st.length - 1 ? V[method] : '';
    document.getElementById('s-next').disabled = idx >= st.length - 1;
  }
  function reset() { idx = -1; render(); }
  document.getElementById('s-next').addEventListener('click', function () { if (idx < S[method].length - 1) { idx++; render(); } });
  document.getElementById('s-all').addEventListener('click', function () { idx = S[method].length - 1; render(); });
  document.getElementById('s-reset').addEventListener('click', reset);
  pressGroup(document.getElementById('method'), function (v) { method = v; reset(); });
  reset();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '"읽고 확인하고 줄여 저장"하는 재고 차감에 동시 주문이 몰리면 생기는 문제는?', o: ['데드락', '갱신 손실로 인한 초과 판매', '팬텀 읽기'], a: 1, e: '두 주문이 같은 값을 읽고 둘 다 통과해, 한 번의 차감이 사라져요.' },
    { q: 'Redis DECR만으로 재고 50에 주문 100건을 처리하면 최종 값은?', o: ['0', '-50', '50'], a: 1, e: 'DECR은 원자적이지만 0에서 멈추지 않아요. 확인과 차감을 함께 하려면 Lua 스크립트를 써요.' },
    { q: '낙관적 락(재시도 없음)에 경합이 심할 때 생기는 일은?', o: ['초과 판매', '재고가 남았는데 충돌로 실패하는 주문', '모든 주문이 대기'], a: 1, e: '같은 버전을 읽은 주문 중 하나만 성공하고 나머지는 실패해요. 초과 판매는 없어요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('stk-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('stk-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
