---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/concurrency/CompletableFutureTest.java`;

const codePredict = `CompletableFuture<Integer> price = CompletableFuture
    .supplyAsync(() -> priceApi.fetch())       // 여기서 예외가 난다면?
    .thenApply(p -> p * 2)                     // ① 이 단계는 실행될까?
    .exceptionally(e -> 0);                    // ②

price.join();  // 결과는?`;

const codeOps = `CompletableFuture.supplyAsync(() -> rateApi.fetch(), apiPool)   // 비동기로 시작 (결과 있음)
    .thenApply(rate -> rate.toKrw())                            // 값 변환
    .thenCompose(krw -> CompletableFuture.supplyAsync(           // 앞 결과로 다음 비동기 호출
            () -> quoteApi.fetch(krw), apiPool))
    .thenCombine(priceFuture, (quote, price) -> merge(quote, price)) // 다른 작업과 합치기
    .thenAccept(result -> cache.put(result))                    // 결과 소비 (반환 없음)
    .exceptionally(e -> { log.warn("실패", e); return null; });  // 실패 처리`;

const codeTable = `allOf(a, b, c)              // 모두 끝나면 완료 (결과는 각자 join으로 꺼냄)
anyOf(a, b, c)              // 하나라도 끝나면 완료
orTimeout(1, SECONDS)       // 시간 안에 안 끝나면 TimeoutException으로 실패
completeOnTimeout(v, 1, SECONDS)  // 시간 안에 안 끝나면 기본값 v로 완료`;

const codePool = `// 나쁜 예: 외부 API 호출(블로킹 I/O)을 공용 풀에서
CompletableFuture.supplyAsync(() -> slowApi.call());

// 좋은 예: I/O용 풀을 따로 만들어 넘긴다
ExecutorService apiPool = Executors.newFixedThreadPool(20);
CompletableFuture.supplyAsync(() -> slowApi.call(), apiPool);`;
---
<Base title="CompletableFuture · Dev Lessons" description="Future의 한계를 넘어 비동기 결과를 이어 붙이고, 합치고, 실패와 타임아웃을 처리하는 CompletableFuture. 주문 화면 조합 시뮬레이터로 블로킹 없는 조합을 직접 확인해요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Java 동시성 · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/future-and-callable/">Future와 Callable</a></p>
    <h1>CompletableFuture</h1>
    <p class="lede"><a href="/dev-lessons/lessons/future-and-callable/">Future</a>는 결과를 받으려면 결국 get()으로 기다려야 했어요. CompletableFuture는 "끝나면 이걸 해 줘"를 미리 등록해서 <strong>기다리지 않고</strong> 결과를 이어 붙이고 합쳐요. 여러 외부 API를 조합하는 화면을 직접 만들어 보며 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> <a href="/dev-lessons/lessons/future-and-callable/">Future와 Callable</a>, 람다, 체크 예외와 런타임 예외의 차이.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#why"><span>1</span>Future와 무엇이 다른가</a>
      <a href="#ops"><span>2</span>연결 메서드</a>
      <a href="#sim"><span>3</span>주문 화면 조합하기</a>
      <a href="#errors"><span>4</span>예외와 타임아웃</a>
      <a href="#pool"><span>5</span>어느 스레드에서 도나</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>예외가 나면 다음 단계는?</h2>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">priceApi.fetch()가 예외를 던지면</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="a" aria-pressed="false">① 실행됨, join()은 예외</button>
          <button class="chip" type="button" data-v="b" aria-pressed="false">① 건너뜀, join()은 0</button>
          <button class="chip" type="button" data-v="c" aria-pressed="false">① 건너뜀, join()은 예외</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 4장에서 이유를 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="why" class="read">
    <p class="eyebrow">1 · Future와 무엇이 다른가</p>
    <h2>기다리지 않고 "다음 할 일"을 등록</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th></th><th>Future</th><th>CompletableFuture</th></tr></thead>
        <tbody>
          <tr><td>결과 쓰기</td><td>get()으로 기다린 뒤</td><td>thenApply, thenAccept로 미리 등록</td></tr>
          <tr><td>두 결과 합치기</td><td>각각 get()</td><td>thenCombine, allOf</td></tr>
          <tr><td>결과로 다음 비동기 호출</td><td>get() 후 다시 submit</td><td>thenCompose</td></tr>
          <tr><td>실패 처리</td><td>get()에서 try-catch</td><td>exceptionally, handle</td></tr>
          <tr><td>직접 완료시키기</td><td>불가</td><td>complete(값), completeExceptionally(예외)</td></tr>
        </tbody>
      </table>
    </div>
    <p>CompletableFuture는 Future이면서, 단계를 이어 붙이는 기능도 함께 가져요(<code>CompletionStage</code> 인터페이스). 그래서 get()도 쓸 수 있지만, 진짜 쓰임새는 단계를 이어 붙이는 데 있어요.</p>
  </section>

  <section id="ops" class="read">
    <p class="eyebrow">2 · 연결 메서드</p>
    <h2>자주 쓰는 다섯 가지</h2>
    <pre set:text={codeOps} />
    <ul>
      <li><strong>supplyAsync / runAsync:</strong> 비동기로 시작. 결과가 있으면 supply, 없으면 run.</li>
      <li><strong>thenApply:</strong> 결과 값을 다른 값으로 바꿔요. 예: 달러 → 원.</li>
      <li><strong>thenCompose:</strong> 앞 결과로 <strong>또 다른 비동기 호출</strong>(CompletableFuture를 돌려주는 호출)을 이어요. 여기에 thenApply를 쓰면 <code>CompletableFuture&lt;CompletableFuture&lt;T&gt;&gt;</code>처럼 겹쳐요.</li>
      <li><strong>thenCombine:</strong> 서로 상관없는 두 작업이 둘 다 끝나면 합쳐요. 두 작업은 동시에 실행돼요.</li>
      <li><strong>thenAccept / thenRun:</strong> 결과를 쓰기만 하고 끝내요.</li>
    </ul>
    <pre set:text={codeTable} />
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">3 · 주문 화면 조합하기</p>
      <h2>환율, 시세, 회원 등급을 모아 한 화면으로</h2>
      <p>환율 API 1초, 시세 API 2초, 회원 조회 0.5초 → 그 결과로 등급 조회 0.5초. 방식과 장애를 바꿔 보며 요청 스레드가 얼마나 묶이는지, 결과가 어떻게 나오는지 보세요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">방식</span>
        <div class="seg" id="c-mode">
          <button type="button" data-v="future" aria-pressed="false">Future + get() 차례로</button>
          <button type="button" data-v="cf" aria-pressed="true">CompletableFuture 조합</button>
        </div>
      </div>
      <div class="field">
        <span class="label">시세 API</span>
        <div class="seg" id="c-fault">
          <button type="button" data-v="ok" aria-pressed="true">정상 (2초)</button>
          <button type="button" data-v="fail" aria-pressed="false">예외</button>
          <button type="button" data-v="slow" aria-pressed="false">느림 (5초)</button>
        </div>
      </div>
      <div class="field">
        <span class="label">대비책 (CompletableFuture에서만)</span>
        <div class="seg" id="c-guard">
          <button type="button" data-v="none" aria-pressed="true">없음</button>
          <button type="button" data-v="default" aria-pressed="false">exceptionally로 기본값</button>
          <button type="button" data-v="timeout" aria-pressed="false">completeOnTimeout(1.5초, 기본값)</button>
        </div>
      </div>
      <div class="gantt" id="c-gantt"></div>
      <p class="verdict" id="c-verdict"></p>
      <div class="log" id="c-log"></div>
    </div>
  </section>

  <section id="errors" class="read">
    <p class="eyebrow">4 · 예외와 타임아웃</p>
    <h2>실패는 뒤로 전파되고, 처리하는 곳에서 멈춰요</h2>
    <p>0장의 답은 <strong>"① 건너뜀, join()은 0"</strong>이에요. 어떤 단계에서 예외가 나면 그 뒤의 thenApply 같은 일반 단계는 실행되지 않고, 예외를 담은 채로 다음 단계로 넘어가요. <code>exceptionally</code>나 <code>handle</code>을 만나면 거기서 복구해요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>메서드</th><th>언제 실행</th><th>쓰임</th></tr></thead>
        <tbody>
          <tr><td>exceptionally(e -&gt; 기본값)</td><td>실패했을 때만</td><td>기본값으로 복구</td></tr>
          <tr><td>handle((값, e) -&gt; ...)</td><td>성공, 실패 모두</td><td>두 경우를 한 곳에서 처리</td></tr>
          <tr><td>whenComplete((값, e) -&gt; ...)</td><td>성공, 실패 모두</td><td>로그만 남기고 결과는 그대로</td></tr>
        </tbody>
      </table>
    </div>
    <ul>
      <li><strong>join()과 get():</strong> 실패한 결과를 꺼내면 <code>join()</code>은 언체크 예외(RuntimeException 계열이라 try-catch를 강제하지 않는 예외) <code>CompletionException</code>, <code>get()</code>은 체크 예외 <code>ExecutionException</code>으로 감싸 던져요. 람다 안에서는 join이 편해요.</li>
      <li><strong>타임아웃:</strong> 외부 API는 언제든 느려질 수 있어요. <code>orTimeout</code>은 실패로, <code>completeOnTimeout</code>은 기본값으로 끝내요. 타임아웃을 두지 않으면 느린 API 하나에 화면 전체가 묶여요.</li>
      <li><strong>아무도 결과를 안 꺼내면</strong> 예외가 조용히 사라져요. 마지막에 exceptionally나 whenComplete로 기록해 두세요.</li>
    </ul>
  </section>

  <section id="pool" class="read">
    <p class="eyebrow">5 · 어느 스레드에서 도나</p>
    <h2>기본 풀을 조심하세요</h2>
    <ul>
      <li><strong>executor를 안 넘기면</strong> supplyAsync는 JVM 전체가 함께 쓰는 <code>ForkJoinPool.commonPool()</code>에서 돌아요. 이 풀은 CPU 계산용으로 크기가 작아요(보통 코어 수 - 1).</li>
      <li>여기서 외부 API처럼 <strong>기다리는 작업</strong>을 돌리면 몇 개만으로 풀이 꽉 차고, 같은 풀을 쓰는 다른 코드(예: <code>parallelStream()</code>)까지 느려져요.</li>
      <li><strong>thenApply</strong>(Async 없음)는 앞 단계를 완료시킨 스레드나 등록한 스레드에서 바로 실행돼요. 무거운 작업이면 <strong>thenApplyAsync(fn, executor)</strong>로 풀을 지정해요.</li>
    </ul>
    <pre set:text={codePool} />
    <p>스레드 풀의 크기와 큐는 <a href="/dev-lessons/lessons/thread-pool/">스레드 풀 레슨</a>의 기준을 그대로 따라요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "CompletableFuture를 Future 대신 쓰는 이유는 무엇인가요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: Future는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>CompletableFuture는 Future에 단계 연결(CompletionStage)을 더한 클래스로, 비동기 결과가 나왔을 때 할 일을 미리 등록하고 여러 결과를 조합할 수 있습니다.</dd>
        <dt>원리</dt><dd>thenApply로 값을 바꾸고, thenCompose로 앞 결과에 의존하는 비동기 호출을 잇고, thenCombine과 allOf로 독립된 작업을 동시에 실행해 합칩니다. 예외는 뒤 단계로 전파되다가 exceptionally나 handle에서 복구하고, orTimeout과 completeOnTimeout으로 시간을 제한합니다.</dd>
        <dt>트레이드오프</dt><dd>Future는 결과를 쓰려면 get()으로 블로킹하고 조합이 어렵지만, CompletableFuture는 블로킹 없이 조합할 수 있습니다. 대신 executor를 지정하지 않으면 공용 풀에서 돌아 I/O 작업에 부적합하고, 체인이 길어지면 예외와 스레드 추적이 어려워집니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 여러 외부 API를 조합하는 화면을 전용 풀 + thenCombine + completeOnTimeout으로 바꿔, 느린 API 하나 때문에 화면 전체가 실패하지 않게 했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 블로킹 없는 조합, thenCompose와 thenCombine의 차이, 예외 전파와 복구, 전용 executor를 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <ul>
      <li>executor 없는 supplyAsync는 ForkJoinPool.commonPool, executor를 넘기면 그 풀</li>
      <li>thenApply는 값을 완성시킨 스레드에서, thenApplyAsync는 지정한 풀에서 실행</li>
      <li>thenCombine으로 300ms 작업 두 개를 합치면 0.55초 안에, allOf로 세 개를 모으면 0.8초 안에</li>
      <li>thenCompose는 이어 붙이고, 같은 일을 thenApply로 하면 CompletableFuture가 겹침</li>
      <li>예외가 나면 뒤의 thenApply는 실행되지 않고 join은 CompletionException, get은 ExecutionException</li>
      <li>exceptionally와 handle의 성공·실패 동작, orTimeout은 TimeoutException, completeOnTimeout은 기본값</li>
    </ul>
    <p><a href={test}>CompletableFutureTest</a></p>
  </section>

  <footer>
    근거: Java SE 21 API 문서의 CompletableFuture, CompletionStage, ForkJoinPool. 공용 풀이 I/O 작업에 맞지 않는다는 설명은 API 문서와 일반 권장이며 테스트하지 않았어요. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .gantt { display: flex; flex-direction: column; gap: 6px; }
  .g-row { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 8px; align-items: center; }
  .g-label { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .g-track { position: relative; height: 28px; background: var(--code-bg); border-radius: 6px; overflow: hidden; }
  .g-bar { position: absolute; top: 3px; bottom: 3px; border-radius: 4px; font-size: 12px; color: var(--surface); display: flex; align-items: center; padding: 0 6px; white-space: nowrap; overflow: hidden; background: var(--accent); }
  .g-bar.fail { background: var(--query); }
  .g-bar.wait { background: repeating-linear-gradient(45deg, var(--warn-soft), var(--warn-soft) 6px, var(--line) 6px, var(--line) 12px); color: var(--ink); }
  .g-bar.free { background: var(--ok-soft); color: var(--ink); }
  .g-axis { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 8px; }
  .g-ticks { position: relative; height: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .g-ticks span { position: absolute; transform: translateX(-50%); }
  @media (max-width: 520px) { .g-row, .g-axis { grid-template-columns: 64px minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  var pl = { a: '① 실행됨, join()은 예외', b: '① 건너뜀, join()은 0', c: '① 건너뜀, join()은 예외' };
  var pred = { p1: store('cf-p1'), p2: store('cf-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + pl[pred.p1] + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "① 건너뜀, join()은 0"이에요. 4장에서 이유를 확인해 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('cf-' + k, v); showPred(); });
  });
  showPred();

  /* 3. 시뮬레이터 */
  var cfg = { mode: 'cf', fault: 'ok', guard: 'none' };
  function f1(x) { return (Math.round(x * 10) / 10).toFixed(1); }
  function compute() {
    var priceDur = cfg.fault === 'slow' ? 5 : 2, priceFail = cfg.fault === 'fail';
    var bars = { 'api-1': [], 'api-2': [], 'api-3': [] }, main = [], log = [], outcome, end;
    bars['api-1'].push({ s: 0, e: 1, t: '환율' });
    bars['api-2'].push({ s: 0, e: priceFail ? 0.8 : priceDur, t: priceFail ? '시세 ✕' : '시세', fail: priceFail });
    bars['api-3'].push({ s: 0, e: 0.5, t: '회원' }, { s: 0.5, e: 1, t: '등급' });
    var priceDone = priceFail ? 0.8 : priceDur;
    if (cfg.mode === 'future') {
      var t = 1; log.push('t=1.0s 환율.get() 결과 받음');
      if (priceFail) { t = Math.max(t, 0.8); log.push('t=' + f1(t) + 's 시세.get() → ExecutionException'); outcome = 'fail'; end = t; }
      else { t = Math.max(t, priceDur); log.push('t=' + f1(t) + 's 시세.get() 결과 받음'); t = Math.max(t, 1); log.push('t=' + f1(t) + 's 회원 → 등급 결과 받음 (등급 조회는 회원 결과를 get한 뒤 다시 submit해야 함)'); outcome = 'ok'; end = t; }
      main.push({ s: 0, e: end, t: '요청 스레드가 get()에서 대기', cls: 'wait' });
    } else {
      main.push({ s: 0, e: 0.1, t: '조합 등록', cls: '' }, { s: 0.1, e: 5, t: '요청 스레드 반납 (다른 요청 처리 가능)', cls: 'free' });
      log.push('t=0.0s 세 체인 등록 후 바로 반환 (thenCompose로 회원 → 등급, thenCombine/allOf로 합치기)');
      var guardT = cfg.guard === 'timeout' ? 1.5 : Infinity;
      if (priceFail) {
        if (cfg.guard === 'default') { log.push('t=0.8s 시세 실패 → exceptionally로 기본값'); end = 1; outcome = 'default'; }
        else if (cfg.guard === 'timeout') { log.push('t=0.8s 시세 실패 → completeOnTimeout은 예외를 복구하지 않아요. 결과는 CompletionException'); end = 1; outcome = 'fail'; }
        else { log.push('t=0.8s 시세 실패 → 뒤 단계 건너뜀, 최종 결과도 실패 (CompletionException)'); end = 1; outcome = 'fail'; }
      } else if (priceDur > guardT) {
        log.push('t=1.5s 시세가 늦어 completeOnTimeout이 기본값으로 완료'); end = 1.5; outcome = 'default';
      } else {
        end = Math.max(1, priceDur); outcome = 'ok';
        log.push('t=' + f1(end) + 's 마지막 결과(' + (priceDur > 1 ? '시세' : '환율') + ')가 오는 순간 thenCombine이 합쳐서 화면 완성');
      }
    }
    return { bars: bars, main: main, log: log, outcome: outcome, end: end };
  }
  function render() {
    var r = compute(), scale = 5.5;
    function pct(x) { return (Math.min(x, scale) / scale * 100) + '%'; }
    var html = '<div class="g-row"><span class="g-label">요청 스레드</span><div class="g-track">' + r.main.map(function (b) {
      var e = Math.min(b.e, Math.max(r.end, b.s + 0.1)); if (b.cls === 'free') e = scale;
      return '<div class="g-bar ' + b.cls + '" style="left:' + pct(b.s) + ';width:' + pct(e - b.s) + '">' + esc(b.t) + '</div>';
    }).join('') + '</div></div>';
    Object.keys(r.bars).forEach(function (k) {
      html += '<div class="g-row"><span class="g-label">' + k + '</span><div class="g-track">' + r.bars[k].map(function (b) {
        return '<div class="g-bar' + (b.fail ? ' fail' : '') + '" style="left:' + pct(b.s) + ';width:' + pct(b.e - b.s) + '">' + esc(b.t) + '</div>';
      }).join('') + '</div></div>';
    });
    var ticks = ''; for (var s = 0; s <= 5; s++) ticks += '<span style="left:' + pct(s) + '">' + s + 's</span>';
    html += '<div class="g-axis"><span></span><div class="g-ticks">' + ticks + '</div></div>';
    document.getElementById('c-gantt').innerHTML = html;
    var v = { ok: '화면 완성: ' + f1(r.end) + '초.', default: '기본값을 넣어 화면 완성: ' + f1(r.end) + '초. 시세 칸만 "잠시 후 갱신"으로 보여줄 수 있어요.', fail: '화면 실패. 시세 하나 때문에 전체가 실패했어요.' }[r.outcome];
    if (cfg.mode === 'future') v += ' 그동안 요청 스레드는 get()에서 묶여 있었어요.';
    else v += ' 요청 스레드는 처음에 바로 반납됐어요 (비동기 응답일 때).';
    document.getElementById('c-verdict').textContent = v;
    document.getElementById('c-log').innerHTML = r.log.map(function (l) { return '<div class="row note">' + esc(l) + '</div>'; }).join('');
    document.querySelectorAll('#c-guard button').forEach(function (b) { b.disabled = cfg.mode === 'future'; });
  }
  pressGroup(document.getElementById('c-mode'), function (v) { cfg.mode = v; render(); });
  pressGroup(document.getElementById('c-fault'), function (v) { cfg.fault = v; render(); });
  pressGroup(document.getElementById('c-guard'), function (v) { cfg.guard = v; render(); });
  render();

  var quiz = [
    { q: '회원 id를 받은 뒤 그 id로 등급을 비동기 조회해야 한다. 알맞은 메서드는?', o: ['thenApply', 'thenCompose', 'thenCombine'], a: 1, e: '앞 결과로 또 다른 CompletableFuture를 만드는 호출은 thenCompose예요. thenApply면 겹쳐져요.' },
    { q: 'executor 없이 supplyAsync로 외부 API를 호출하면 어느 풀에서 도나요?', o: ['요청 스레드', 'ForkJoinPool.commonPool', '새 스레드'], a: 1, e: '공용 풀은 크기가 작아 I/O 작업에 맞지 않아요. 전용 풀을 넘겨요.' },
    { q: 'join()으로 실패한 결과를 꺼내면?', o: ['ExecutionException', 'CompletionException', 'null'], a: 1, e: 'join은 언체크 예외 CompletionException, get은 체크 예외 ExecutionException이에요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('cf-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('cf-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
