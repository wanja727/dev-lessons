---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';
import CiOutput from '../../components/CiOutput.astro';
import RunLocally from '../../components/RunLocally.astro';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/jpabasics/JpaBasicsTest.java`;
const mainDir = `${repo}/blob/main/verification/src/main/java/lab/devlessons/jpabasics`;

const codePredict = `@Entity
@Table(name = "cafe_menu")
public class CafeMenu {
    @Column(name = "menu_name")
    private String name;
    private int price;
}

// JPQL 쿼리
select m from CafeMenu m where m.name = 'latte'`;

const codeJdbc = `// JPA 없이 (JDBC로 직접)
PreparedStatement ps = conn.prepareStatement(
    "select id, menu_name, price from cafe_menu where id = ?");
ps.setLong(1, id);
ResultSet rs = ps.executeQuery();
rs.next();
CafeMenu menu = new CafeMenu(rs.getString("menu_name"), rs.getInt("price"));  // 손으로 옮겨 담기`;

const codeJpa = `// JPA로
CafeMenu menu = cafeMenuRepository.findById(id).orElseThrow();   // SQL과 옮겨 담기는 Hibernate가`;

const codeEntity = `@Entity                                   // 이 클래스는 테이블의 행을 나타낸다
@Table(name = "cafe_menu")                // 테이블 이름 (안 적으면 클래스 이름 기준)
public class CafeMenu {

    @Id                                   // 기본 키
    @GeneratedValue(strategy = GenerationType.IDENTITY)   // id는 DB가 만든다
    private Long id;

    @Column(name = "menu_name", nullable = false, unique = true)   // 컬럼 이름을 따로 지정
    private String name;

    private int price;                    // 적지 않으면 필드 이름 그대로 컬럼 price

    protected CafeMenu() { }              // JPA가 조회 결과로 객체를 만들 때 쓰는 기본 생성자
}`;

const codeRepo = `public interface CafeMenuRepository extends JpaRepository<CafeMenu, Long> {
    //                                               엔티티 ↑   id 타입 ↑

    Optional<CafeMenu> findByName(String name);              // 메서드 이름 쿼리
    List<CafeMenu> findByPriceLessThan(int price);

    @Query("select m from CafeMenu m where m.price >= :min order by m.price")   // JPQL
    List<CafeMenu> findExpensive(@Param("min") int min);
}
// save, findById, findAll, deleteById 등은 JpaRepository가 이미 갖고 있다`;
---
<Base title="JPA 첫걸음 · Dev Lessons" description="ORM, JPA, Hibernate, Spring Data JPA의 관계와 엔티티, 리포지토리, JPQL을 자바 코드와 실제로 나간 SQL을 나란히 보며 배워요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">JPA · 기초 · 약 25분 · 선수 레슨: <a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>, <a href="/dev-lessons/lessons/spring-beans/">스프링 빈과 의존성 주입</a></p>
    <h1>JPA 첫걸음</h1>
    <p class="lede">스프링 프로젝트를 열어 보면 SQL은 거의 없고 <code>save()</code>, <code>findById()</code> 같은 메서드만 있어요. 그런데 DB에는 분명 SQL이 나가요. 누가, 어떤 SQL을 만들까요? 자바 코드와 <strong>실제로 나간 SQL</strong>을 나란히 놓고 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> SQL의 SELECT, INSERT, WHERE, 테이블과 컬럼. 트랜잭션(<a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>), 빈과 주입(<a href="/dev-lessons/lessons/spring-beans/">스프링 빈</a>). 자바의 인터페이스와 어노테이션.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#orm"><span>1</span>ORM과 JPA</a>
      <a href="#entity"><span>2</span>엔티티 = 테이블의 행</a>
      <a href="#repo"><span>3</span>리포지토리</a>
      <a href="#translate"><span>4</span>번역 과정 보기</a>
      <a href="#jpql"><span>5</span>JPQL</a>
      <a href="#traps"><span>6</span>함정과 다음 레슨</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>이 JPQL은 어떤 SQL이 될까요?</h2>
    <p>JPQL은 SQL과 비슷하게 생긴, JPA의 조회 언어예요. 자세한 건 5장에서 다루니, 지금은 감으로 골라 보세요.</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">DB로 나가는 SQL의 WHERE 조건은</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="name" aria-pressed="false">where name = 'latte'</button>
          <button class="chip" type="button" data-v="menu_name" aria-pressed="false">where menu_name = 'latte'</button>
          <button class="chip" type="button" data-v="error" aria-pressed="false">오류 (그런 테이블 없음)</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 4장에서 번역 과정을 직접 볼 수 있어요.</p>
    </div>
  </section>

  <section id="orm" class="read">
    <p class="eyebrow">1 · ORM과 JPA</p>
    <h2>객체와 테이블 사이의 통역사</h2>
    <p>자바는 데이터를 <strong>객체</strong>로 다루고, DB는 <strong>테이블의 행</strong>으로 다뤄요. 둘 사이를 오가려면 SQL을 쓰고, 결과를 객체에 한 칸씩 옮겨 담아야 해요.</p>
    <pre set:text={codeJdbc} />
    <p>이 일을 대신해 주는 기술을 <strong>ORM</strong>(Object-Relational Mapping, 객체-관계 매핑)이라고 해요. 객체와 테이블의 대응 관계만 알려 주면 SQL을 만들고 결과를 옮겨 담는 건 ORM이 해요.</p>
    <pre set:text={codeJpa} />
    <p>이름이 여러 개 나오는데, 층이 달라요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>이름</th><th>정체</th><th>비유</th></tr></thead>
        <tbody>
          <tr><td><strong>JPA</strong> (Jakarta Persistence)</td><td>자바 ORM의 <strong>표준 규칙</strong>(인터페이스와 어노테이션 모음). 코드는 들어 있지 않아요</td><td>"콘센트 규격"</td></tr>
          <tr><td><strong>Hibernate</strong></td><td>JPA 규칙을 실제로 구현한 라이브러리. SQL을 만들고 실행하는 건 여기예요</td><td>규격에 맞춘 "제품"</td></tr>
          <tr><td><strong>Spring Data JPA</strong></td><td>JPA를 더 편하게 쓰도록 리포지토리 인터페이스만으로 기본 기능을 만들어 주는 스프링 모듈</td><td>제품 위의 "리모컨"</td></tr>
        </tbody>
      </table>
    </div>
    <p>내 코드는 JPA 규칙(<code>@Entity</code>, <code>EntityManager</code>)과 Spring Data의 리포지토리를 쓰고, 실제로 SQL을 보내는 건 Hibernate예요. 검증 테스트에서 JPA 표준 객체(<code>EntityManagerFactory</code>)를 열어 보면 안에 Hibernate 객체가 들어 있어요.</p>
    <CiOutput lesson="jpa-basics" key="impl" label="JPA 표준 객체의 실제 구현 보기" source="JpaBasicsTest.hibernateIsTheImplementation" />
  </section>

  <section id="entity" class="read">
    <p class="eyebrow">2 · 엔티티 = 테이블의 행</p>
    <h2>클래스에 어노테이션으로 대응 관계를 적어요</h2>
    <p><strong>엔티티</strong>는 DB 테이블과 짝이 되는 자바 클래스예요. 엔티티 객체 하나가 테이블의 행 하나예요.</p>
    <pre set:text={codeEntity} />
    <p>개발 중에는 Hibernate가 엔티티를 보고 테이블을 직접 만들기도 해요(<code>ddl-auto</code> 설정. 운영 DB에서는 쓰지 않아요). 이 레슨의 테스트도 그렇게 만든 테이블이에요. 필드 <code>name</code>이 어떤 컬럼이 됐는지 보세요.</p>
    <CiOutput lesson="jpa-basics" key="table" label="실제로 만들어진 테이블의 컬럼 보기" source="JpaBasicsTest.entityBecomesTable" />
  </section>

  <section id="repo" class="read">
    <p class="eyebrow">3 · 리포지토리</p>
    <h2>인터페이스만 쓰면 구현은 스프링이 만들어요</h2>
    <p><strong>리포지토리</strong>는 엔티티를 저장하고 꺼내는 객체예요. Spring Data JPA에서는 <code>JpaRepository</code>를 상속한 <strong>인터페이스만</strong> 선언하면, 스프링이 구현 객체를 만들어 빈으로 등록해요. 서비스는 그걸 <a href="/dev-lessons/lessons/spring-beans/">생성자로 주입</a>받아 써요.</p>
    <pre set:text={codeRepo} />
    <ul>
      <li><strong>기본 메서드:</strong> <code>save</code>, <code>findById</code>, <code>findAll</code>, <code>deleteById</code>, <code>count</code> 등은 이미 있어요.</li>
      <li><strong>메서드 이름 쿼리:</strong> <code>findBy</code> + 필드 이름 + 조건(LessThan, Containing 등)으로 이름을 지으면 그대로 WHERE 조건이 돼요.</li>
      <li><strong>@Query:</strong> 이름으로 표현하기 어려우면 JPQL을 직접 적어요(5장).</li>
      <li>리포지토리의 메서드는 각자 트랜잭션 안에서 실행돼요. 여러 호출을 한 트랜잭션으로 묶으려면 서비스 메서드에 <code>@Transactional</code>을 붙여요.</li>
    </ul>
  </section>

  <section id="translate">
    <div class="read stack">
      <p class="eyebrow">4 · 번역 과정 보기</p>
      <h2>자바 호출이 SQL이 되기까지</h2>
      <p>호출을 골라 보세요. 자바 코드 → JPQL → SQL → 결과 순서로 바뀌는 과정이에요. 같은 색은 서로 짝이에요. 메뉴는 americano 4500, latte 5000, vanilla latte 5500 세 개예요.</p>
    </div>
    <div class="panel">
      <div class="seg" id="call">
        <button type="button" data-v="save" aria-pressed="true">save</button>
        <button type="button" data-v="findById" aria-pressed="false">findById</button>
        <button type="button" data-v="findByName" aria-pressed="false">findByName</button>
        <button type="button" data-v="lessThan" aria-pressed="false">findByPriceLessThan</button>
        <button type="button" data-v="query" aria-pressed="false">@Query (JPQL)</button>
      </div>
      <div class="chain" id="chain"></div>
      <p class="muted small">SQL은 읽기 쉽게 줄인 모양이에요. Hibernate가 실제로 보낸 SQL은 아래 버튼으로 볼 수 있어요.</p>
    </div>
    <div class="read stack">
      <CiOutput lesson="jpa-basics" key="save-find" label="save, findById의 실제 SQL 보기" source="JpaBasicsTest.saveAndFind" />
      <CiOutput lesson="jpa-basics" key="derived" label="메서드 이름 쿼리의 실제 SQL 보기" source="JpaBasicsTest.derivedQueries" />
      <p class="muted">실제 SQL의 <code>cm1_0</code> 같은 이름은 Hibernate가 붙인 테이블 별칭이고, <code>?</code>는 값이 들어갈 자리(바인딩 파라미터)예요. 값은 SQL과 따로 보내요.</p>
    </div>
  </section>

  <section id="jpql" class="read">
    <p class="eyebrow">5 · JPQL</p>
    <h2>테이블이 아니라 엔티티를 대상으로 쓰는 쿼리</h2>
    <p><strong>JPQL</strong>(Jakarta Persistence Query Language)은 SQL과 문법이 거의 같지만, <strong>테이블과 컬럼 대신 엔티티 이름과 필드 이름</strong>을 써요. Hibernate가 2장의 대응 관계를 보고 실제 테이블과 컬럼 이름의 SQL로 바꿔요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th></th><th>JPQL</th><th>SQL</th></tr></thead>
        <tbody>
          <tr><td>대상</td><td><code>CafeMenu</code> (엔티티 클래스 이름)</td><td><code>cafe_menu</code> (테이블 이름)</td></tr>
          <tr><td>조건</td><td><code>m.name</code> (필드 이름)</td><td><code>menu_name</code> (컬럼 이름)</td></tr>
          <tr><td>결과</td><td>엔티티 객체</td><td>행</td></tr>
          <tr><td>DB 종류</td><td>DB가 바뀌어도 같음</td><td>DB마다 조금씩 다름</td></tr>
        </tbody>
      </table>
    </div>
    <p>그래서 0장의 답은 <code>where menu_name = 'latte'</code>예요. JPQL의 <code>m.name</code>은 필드 이름이고, 실제 컬럼은 <code>@Column(name = "menu_name")</code>이에요. 반대로 JPQL에 컬럼 이름 <code>menu_name</code>을 쓰면 "그런 필드 없음" 오류가 나요.</p>
    <CiOutput lesson="jpa-basics" key="jpql" label="JPQL과 실제 SQL 나란히 보기" source="JpaBasicsTest.jpqlIsTranslated" />
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">6 · 함정과 다음 레슨</p>
    <h2>편하지만 SQL을 몰라도 되는 건 아니에요</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>문제</th><th>대응</th></tr></thead>
        <tbody>
          <tr><td>어떤 SQL이 나가는지 안 봄</td><td>코드 한 줄이 SQL 수십 번이 되는 걸 모름 (<a href="/dev-lessons/lessons/jpa-n-plus-1/">N+1</a>)</td><td>개발 중에는 SQL 로그를 켜고 봐요</td></tr>
          <tr><td>JPQL에 테이블·컬럼 이름을 씀</td><td>"엔티티나 필드를 찾을 수 없음" 오류</td><td>JPQL은 엔티티·필드 이름</td></tr>
          <tr><td>엔티티에 기본 생성자가 없음</td><td>조회 결과로 객체를 못 만들어 오류</td><td>protected 기본 생성자를 둬요</td></tr>
          <tr><td>운영에서 ddl-auto로 테이블 생성·변경</td><td>의도치 않은 테이블 변경</td><td>운영은 none이나 validate, 변경은 마이그레이션 도구로</td></tr>
        </tbody>
      </table>
    </div>
    <p><strong>다음 레슨:</strong> JPA는 조회한 엔티티를 바로 버리지 않고 <strong>영속성 컨텍스트</strong>라는 작업 공간에 담아 둬요. 그래서 "save()를 안 불렀는데 UPDATE가 나가는" 일이 생겨요. <a href="/dev-lessons/lessons/jpa-persistence-context/">영속성 컨텍스트</a>에서 이어서 배워요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "JPA와 Hibernate, Spring Data JPA의 차이를 설명해 주세요"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: JPA는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>JPA는 자바 ORM의 표준 명세로 인터페이스와 어노테이션을 정의하고, Hibernate는 그 명세를 구현해 실제로 SQL을 만들고 실행하는 라이브러리입니다. Spring Data JPA는 JPA 위에서 리포지토리 인터페이스만으로 기본 CRUD와 쿼리 메서드를 만들어 주는 스프링 모듈입니다.</dd>
        <dt>원리</dt><dd>@Entity로 클래스와 테이블을 대응시키면, 리포지토리의 save와 findById 같은 호출이나 JPQL이 Hibernate를 거쳐 실제 테이블과 컬럼 이름의 SQL로 번역됩니다. JPQL은 테이블이 아니라 엔티티와 필드를 대상으로 쓰고, 메서드 이름 쿼리는 이름에서 WHERE 조건을 만듭니다.</dd>
        <dt>트레이드오프</dt><dd>반복적인 SQL과 객체 변환 코드가 사라지고 DB 종류에 덜 묶이지만, 어떤 SQL이 나가는지 보지 않으면 N+1 같은 성능 문제를 놓칩니다. 그래서 SQL 로그를 확인하고, 복잡한 조회는 JPQL이나 네이티브 쿼리로 직접 씁니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 리포지토리 메서드마다 실제 SQL을 로그로 확인하는 테스트를 두고 쿼리 수를 검증했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 표준(JPA)과 구현(Hibernate)을 구분했나요? JPQL이 엔티티 기준이라는 점, SQL을 직접 확인해야 한다는 점을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 PostgreSQL과 Hibernate로 코드가 바뀔 때마다 다시 확인하고, 그때 나간 SQL을 위의 버튼으로 공개해요.</p>
    <ul>
      <li>엔티티로 만들어진 테이블에 필드 name은 menu_name 컬럼으로 있음 (name 컬럼은 없음)</li>
      <li>save()는 INSERT, findById()는 WHERE가 있는 SELECT 1번</li>
      <li>findByName은 menu_name 조건, findByPriceLessThan(5000)은 price 조건으로 americano만</li>
      <li>JPQL의 CafeMenu와 m.price가 cafe_menu와 price 컬럼의 SQL로 번역되고, 5000 이상이 가격 순</li>
      <li>리포지토리는 인터페이스인데 스프링이 만든 프록시 객체가 주입됨</li>
      <li>JPA 표준 EntityManagerFactory의 실제 구현은 org.hibernate 패키지</li>
    </ul>
    <p><a href={test}>JpaBasicsTest</a> · <a href={`${mainDir}/CafeMenu.java`}>CafeMenu</a> · <a href={`${mainDir}/CafeMenuRepository.java`}>CafeMenuRepository</a></p>
    <RunLocally tests={['lab.devlessons.jpabasics.JpaBasicsTest']} docker={true} />
  </section>

  <footer>
    근거: Jakarta Persistence 3.1 명세, Spring Data JPA 참조 문서의 Query Methods, Hibernate ORM 6.6 Introduction. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .assume { font-size: 15px; border-left: 3px solid var(--accent); padding-left: 10px; }
  .small { font-size: 13px; }
  .chain { display: flex; flex-direction: column; gap: 6px; }
  .chain .hop { border: 1.5px solid var(--line); border-radius: 10px; padding: 8px 12px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .chain .hop .label { font-size: 12px; }
  .chain .hop code { font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; background: none; padding: 0; }
  .chain .arrow { color: var(--muted); font-size: 13px; padding-left: 12px; }
  .chain .hop.result { background: var(--ok-soft); border-color: var(--ok); }
  .k1 { color: var(--accent); font-weight: 700; }
  .k2 { color: var(--query); font-weight: 700; }
  .k3 { color: var(--ok); font-weight: 700; }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { name: "where name = 'latte'", menu_name: "where menu_name = 'latte'", error: '오류' };
  var pred = { p1: store('jb-p1'), p2: store('jb-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + (pred.p2 ? ' (' + pred.p2 + ')' : '') + ". 정답은 \"where menu_name = 'latte'\"예요. JPQL은 엔티티(CafeMenu)와 필드(name)로 쓰고, Hibernate가 테이블(cafe_menu)과 컬럼(menu_name)으로 바꿔요.";
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('jb-' + k, v); showPred(); });
  });
  showPred();

  /* 4. 번역 과정: [[라벨, HTML]] (HTML은 정적인 문자열만 쓴다) */
  var E = '<span class="k1">CafeMenu</span>', T = '<span class="k1">cafe_menu</span>';
  var F = '<span class="k2">name</span>', C = '<span class="k2">menu_name</span>';
  var P = '<span class="k3">price</span>';
  var chains = {
    save: [
      ['자바 코드', 'cafeMenuRepository.save(new ' + E + '("mocha", 5800))'],
      ['Spring Data JPA', 'id가 없는 새 엔티티 → entityManager.persist(...)'],
      ['Hibernate가 만든 SQL', 'insert into ' + T + ' (' + C + ', ' + P + ') values (?, ?) returning id'],
      ['결과', '새 행이 생기고, DB가 만든 id가 객체에 채워져요']
    ],
    findById: [
      ['자바 코드', 'cafeMenuRepository.findById(2L)'],
      ['Spring Data JPA', 'entityManager.find(' + E + '.class, 2L)'],
      ['Hibernate가 만든 SQL', 'select id, ' + C + ', ' + P + ' from ' + T + ' where id = ?'],
      ['결과', 'Optional[' + E + '(id=2, ' + F + '=latte, ' + P + '=5000)]']
    ],
    findByName: [
      ['자바 코드', 'cafeMenuRepository.findBy<span class="k2">Name</span>("latte")'],
      ['Spring Data JPA가 만든 JPQL', 'select m from ' + E + ' m where m.' + F + ' = ?1'],
      ['Hibernate가 만든 SQL', 'select id, ' + C + ', ' + P + ' from ' + T + ' where ' + C + ' = ?'],
      ['결과', 'Optional[' + E + '(' + F + '=latte, ' + P + '=5000)]']
    ],
    lessThan: [
      ['자바 코드', 'cafeMenuRepository.findBy<span class="k3">Price</span>LessThan(5000)'],
      ['Spring Data JPA가 만든 JPQL', 'select m from ' + E + ' m where m.' + P + ' < ?1'],
      ['Hibernate가 만든 SQL', 'select id, ' + C + ', ' + P + ' from ' + T + ' where ' + P + ' < ?'],
      ['결과', '[' + E + '(' + F + '=americano, ' + P + '=4500)]']
    ],
    query: [
      ['자바 코드', 'cafeMenuRepository.findExpensive(5000)'],
      ['@Query에 적은 JPQL', 'select m from ' + E + ' m where m.' + P + ' >= :min order by m.' + P],
      ['Hibernate가 만든 SQL', 'select id, ' + C + ', ' + P + ' from ' + T + ' where ' + P + ' >= ? order by ' + P],
      ['결과', '[latte 5000, vanilla latte 5500]']
    ]
  };
  function renderChain(k) {
    var c = chains[k];
    document.getElementById('chain').innerHTML = c.map(function (h, i) {
      return (i ? '<div class="arrow">↓</div>' : '') + '<div class="hop' + (i === c.length - 1 ? ' result' : '') + '"><span class="label">' + esc(h[0]) + '</span><code>' + h[1] + '</code></div>';
    }).join('');
  }
  pressGroup(document.getElementById('call'), renderChain);
  renderChain('save');

  /* 7. 확인 문제 */
  var quiz = [
    { q: 'JPA와 Hibernate의 관계는?', o: ['JPA는 표준 규칙, Hibernate는 그 구현', '같은 라이브러리의 다른 이름'], a: 0, e: '실제로 SQL을 만들고 실행하는 건 구현체인 Hibernate예요.' },
    { q: "@Column(name = \"menu_name\") private String name; 일 때 JPQL 조건으로 맞는 것은?", o: ["where m.name = 'latte'", "where m.menu_name = 'latte'"], a: 0, e: 'JPQL은 필드 이름을 써요. 컬럼 이름으로 바꾸는 건 Hibernate가 해요.' },
    { q: 'CafeMenuRepository는 인터페이스만 선언했다. findByName의 구현은?', o: ['직접 클래스를 만들어야 한다', 'Spring Data JPA가 메서드 이름을 보고 만들어 준다'], a: 1, e: '스프링이 구현 객체를 만들어 빈으로 등록하고, 이름에서 WHERE 조건을 만들어요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('jb-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('jb-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
