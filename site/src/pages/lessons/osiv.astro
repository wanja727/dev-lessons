---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const testDir = `${repo}/blob/main/verification/src/test/java/lab/devlessons/osiv`;

const codePredict = `@GetMapping("/players/{id}/team-name")
public String teamName(@PathVariable Long id) {
    Player player = playerService.findPlayer(id);   // @Transactional, team은 LAZY
    return player.getTeam().getName();              // 트랜잭션 밖
}
// application.yml에 open-in-view 설정이 없다 (부트 기본값)`;

const codeWarn = `WARN ... JpaBaseConfiguration$JpaWebConfiguration :
spring.jpa.open-in-view is enabled by default. Therefore, database queries may be
performed during view rendering. Explicitly configure spring.jpa.open-in-view
to disable this warning`;

const codeOff = `spring:
  jpa:
    open-in-view: false`;

const codeTrap = `@PostMapping("/players/{id}/preview")
public String preview(@PathVariable Long id, @RequestParam String name) {
    Player player = playerService.findPlayer(id);
    player.rename(name);            // 화면 미리보기용으로 잠깐 바꿨을 뿐
    visitService.recordVisit();     // 상관없는 @Transactional 쓰기
    return "ok";
}`;

const codeFix = `// 서비스가 화면에 필요한 것까지 트랜잭션 안에서 만들어 반환
@Transactional(readOnly = true)
public PlayerView findPlayerView(Long id) {
    Player p = playerRepository.findWithTeam(id).orElseThrow();   // fetch join
    return new PlayerView(p.getName(), p.getTeam().getName());
}`;
---
<Base title="OSIV · Dev Lessons" description="스프링 부트 OSIV가 켜져 있을 때와 꺼져 있을 때 영속성 컨텍스트, 트랜잭션, DB 커넥션의 범위가 어떻게 다른지 요청 타임라인과 커넥션 풀 계산으로 배워요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">JPA · 개념 학습 · 약 25분 · 선수 레슨: <a href="/dev-lessons/lessons/transactional-proxy/">@Transactional 동작 원리</a>, <a href="/dev-lessons/lessons/proxy-lazy-loading/">프록시와 지연 로딩</a></p>
    <h1>OSIV (Open Session In View)</h1>
    <p class="lede">지난 레슨에서 트랜잭션 밖의 지연 로딩은 LazyInitializationException이라고 배웠어요. 그런데 스프링 부트 기본 설정에서는 컨트롤러에서도 지연 로딩이 <strong>돼요.</strong> 그 이유가 OSIV이고, 그 대가는 <strong>DB 커넥션</strong>이에요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> <a href="/dev-lessons/lessons/proxy-lazy-loading/">프록시와 지연 로딩</a>(LazyInitializationException), <a href="/dev-lessons/lessons/connection-pool/">DB 커넥션과 커넥션 풀</a>, 컨트롤러 → 서비스 흐름(<a href="/dev-lessons/lessons/spring-beans/">스프링 빈</a>).</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#what"><span>1</span>OSIV가 하는 일</a>
      <a href="#timeline"><span>2</span>요청 타임라인</a>
      <a href="#pool"><span>3</span>커넥션 비용</a>
      <a href="#trap"><span>4</span>숨은 함정</a>
      <a href="#choose"><span>5</span>끄고 나서</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>이 컨트롤러는 팀 이름을 돌려줄까요?</h2>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">결과</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="ok" aria-pressed="false">팀 이름을 돌려준다</button>
          <button class="chip" type="button" data-v="lie" aria-pressed="false">LazyInitializationException</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 1장에서 이유를 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="what" class="read">
    <p class="eyebrow">1 · OSIV가 하는 일</p>
    <h2>영속성 컨텍스트를 요청 끝까지 열어 둔다</h2>
    <p>OSIV(Open Session In View, JPA에서는 Open EntityManager In View)는 <strong>요청이 들어올 때 영속성 컨텍스트를 열고, 응답이 나갈 때 닫는</strong> 방식이에요. 스프링 부트는 <code>spring.jpa.open-in-view</code>의 기본값이 <strong>true</strong>라서, 아무 설정을 안 하면 켜져 있어요. 그래서 0장의 정답은 "팀 이름을 돌려준다"예요(설정을 안 했다면).</p>
    <ul>
      <li><strong>트랜잭션</strong>은 여전히 서비스의 @Transactional 범위예요. OSIV는 트랜잭션을 늘리지 않아요.</li>
      <li>대신 트랜잭션이 끝나도 <strong>영속성 컨텍스트는 열린 채</strong>로 남아요. 엔티티는 계속 영속 상태라 지연 로딩이 돼요.</li>
      <li>트랜잭션 밖의 지연 로딩 SELECT는 트랜잭션 없이(자동 커밋으로) 실행돼요.</li>
    </ul>
    <p>켜 둔 채로 앱을 띄우면 이런 경고가 나와요. 스프링 부트가 "기본으로 켜 뒀지만 정말 원하는지 명시하라"고 말하는 거예요.</p>
    <pre set:text={codeWarn} />
  </section>

  <section id="timeline">
    <div class="read stack">
      <p class="eyebrow">2 · 요청 타임라인</p>
      <h2>무엇이 언제 열리고 닫히나</h2>
      <p>요청 하나가 처리되는 동안 영속성 컨텍스트, 트랜잭션, DB 커넥션이 각각 언제 살아 있는지 보세요. 컨트롤러가 서비스 호출 뒤에 외부 API를 부르는 흔한 경우예요.</p>
    </div>
    <div class="panel">
      <div class="seg" id="osiv">
        <button type="button" data-v="on" aria-pressed="true">OSIV 켜짐 (부트 기본값)</button>
        <button type="button" data-v="off" aria-pressed="false">OSIV 꺼짐</button>
      </div>
      <div class="tl" aria-hidden="true">
        <div class="tl-head">
          <span style="--w:8">요청 진입</span><span style="--w:30">서비스 (@Transactional)</span><span style="--w:12">지연 로딩</span><span style="--w:42">외부 API 호출 (느림)</span><span style="--w:8">응답</span>
        </div>
        <div class="tl-row"><span class="tl-label">영속성 컨텍스트</span><div class="tl-track"><div class="tl-bar pc" id="bar-pc"></div></div></div>
        <div class="tl-row"><span class="tl-label">트랜잭션</span><div class="tl-track"><div class="tl-bar tx" id="bar-tx"></div></div></div>
        <div class="tl-row"><span class="tl-label">DB 커넥션</span><div class="tl-track"><div class="tl-bar conn" id="bar-conn"></div></div></div>
        <div class="tl-row"><span class="tl-label">지연 로딩</span><div class="tl-track"><div class="tl-mark" id="mark-lazy"></div></div></div>
      </div>
      <p class="verdict" id="tl-text" aria-live="polite"></p>
    </div>
  </section>

  <section id="pool">
    <div class="read stack">
      <p class="eyebrow">3 · 커넥션 비용</p>
      <h2>왜 끄라고 할까: 커넥션을 오래 쥐면 동시 처리량이 준다</h2>
      <p>DB <a href="/dev-lessons/lessons/connection-pool/">커넥션 풀</a>은 크기가 정해져 있어요(스프링 부트 기본 10개). 요청이 커넥션을 쥐고 있는 시간이 길수록, 같은 풀로 동시에 처리할 수 있는 요청이 줄어요. 아래는 <strong>단순한 모형 계산</strong>이에요. 실제 수치는 부하 테스트로 확인해야 해요.</p>
    </div>
    <div class="panel">
      <div class="sliders">
        <label>커넥션 풀 크기 <b id="v-pool"></b><input type="range" id="s-pool" min="5" max="50" step="5" value="10"></label>
        <label>트랜잭션 안 DB 작업 시간 <b id="v-db"></b><input type="range" id="s-db" min="10" max="200" step="10" value="30"></label>
        <label>트랜잭션 밖 작업 시간 (외부 API 호출, 화면 만들기) <b id="v-ext"></b><input type="range" id="s-ext" min="0" max="2000" step="50" value="300"></label>
      </div>
      <div class="pool-out">
        <div><span class="label">OSIV 켜짐: 요청당 커넥션 점유</span><b id="o-on-hold"></b><span class="muted">초당 최대 요청 (커넥션 기준)</span><b id="o-on-rps" class="big"></b></div>
        <div><span class="label">OSIV 꺼짐: 요청당 커넥션 점유</span><b id="o-off-hold"></b><span class="muted">초당 최대 요청 (커넥션 기준)</span><b id="o-off-rps" class="big"></b></div>
      </div>
      <p class="verdict" id="pool-text" aria-live="polite"></p>
    </div>
    <div class="read">
      <p>모형: 커넥션 기준 최대 처리량 ≈ 풀 크기 ÷ 요청당 커넥션 점유 시간. OSIV를 켜면 점유 시간이 "트랜잭션 + 트랜잭션 밖 작업"이 되고, 끄면 "트랜잭션"만이에요. 외부 API가 느려지는 순간 OSIV 켜진 서버는 <strong>DB는 한가한데 커넥션이 없어서</strong> 요청이 줄 서요. 이 레슨의 검증 테스트는 서비스 호출이 끝난 직후 사용 중인 커넥션 수가 켜짐 1개, 꺼짐 0개임을 확인해요.</p>
    </div>
  </section>

  <section id="trap" class="read">
    <p class="eyebrow">4 · 숨은 함정</p>
    <h2>컨트롤러에서 바꾼 값이 DB에 저장된다</h2>
    <pre set:text={codeTrap} />
    <p>OSIV가 켜져 있으면 컨트롤러가 받은 player는 여전히 <strong>영속 상태</strong>예요. 이름을 바꾼 것만으로는 아무 일도 없지만, 그 뒤에 <strong>아무 쓰기 트랜잭션</strong>이 같은 영속성 컨텍스트에서 커밋되면 flush가 일어나면서 <a href="/dev-lessons/lessons/jpa-persistence-context/">변경 감지</a>가 이름 변경까지 UPDATE해요. 상관없는 recordVisit()이 플레이어 이름을 바꿔 버리는 거예요.</p>
    <p>OSIV가 꺼져 있으면 서비스 트랜잭션이 끝날 때 영속성 컨텍스트도 닫혀서 player는 <strong>준영속</strong>이 돼요. 컨트롤러에서 바꿔도 반영되지 않아요. 두 경우 모두 검증 테스트로 확인했어요.</p>
  </section>

  <section id="choose" class="read">
    <p class="eyebrow">5 · 끄고 나서</p>
    <h2>지연 로딩은 서비스 안에서 끝낸다</h2>
    <pre set:text={codeOff} />
    <p>끄면 컨트롤러와 뷰(서버에서 HTML 화면을 만드는 템플릿)에서 지연 로딩이 안 되니, 화면에 필요한 데이터는 서비스가 트랜잭션 안에서 모두 준비해야 해요.</p>
    <pre set:text={codeFix} />
    <div class="table-wrap">
      <table>
        <thead><tr><th></th><th>OSIV 켜짐</th><th>OSIV 꺼짐</th></tr></thead>
        <tbody>
          <tr><td>영속성 컨텍스트</td><td>요청 전체</td><td>트랜잭션 범위</td></tr>
          <tr><td>컨트롤러, 뷰에서 지연 로딩</td><td>됨</td><td>LazyInitializationException</td></tr>
          <tr><td>DB 커넥션 점유</td><td>처음 쓴 시점부터 응답까지</td><td>트랜잭션 동안만</td></tr>
          <tr><td>컨트롤러에서 바꾼 엔티티</td><td>영속 상태, 이후 쓰기 트랜잭션에서 반영될 수 있음</td><td>준영속, 반영 안 됨</td></tr>
          <tr><td>어울리는 곳</td><td>트래픽 적은 어드민, 서버 렌더링 화면, 빠른 프로토타입</td><td>트래픽 많은 API 서버, 외부 호출이 많은 서비스</td></tr>
        </tbody>
      </table>
    </div>
    <p>끄는 대신 조회 전용 서비스(Query Service)를 따로 두는 구조가 흔해요. 명령(쓰기)과 조회를 나누면 화면용 DTO를 만드는 코드가 한곳에 모여요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "OSIV가 무엇이고, 왜 끄라고 하나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: OSIV는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>OSIV는 영속성 컨텍스트를 요청 시작부터 응답까지 열어 두는 방식이고, 스프링 부트에서는 spring.jpa.open-in-view 기본값이 true입니다.</dd>
        <dt>원리</dt><dd>트랜잭션은 서비스 범위 그대로지만 영속성 컨텍스트가 요청 끝까지 살아 있어서, 컨트롤러나 뷰에서도 엔티티가 영속 상태이고 지연 로딩이 됩니다. 대신 처음 DB를 쓴 시점부터 응답까지 커넥션을 붙잡습니다.</dd>
        <dt>트레이드오프</dt><dd>편하지만 트랜잭션 밖의 외부 API 호출이나 렌더링 시간 동안에도 커넥션을 쥐고 있어서, 트래픽이 많으면 커넥션 풀이 먼저 고갈됩니다. 또 컨트롤러에서 바꾼 엔티티가 이후 쓰기 트랜잭션에서 의도치 않게 반영될 수 있습니다. 그래서 API 서버에서는 끄고, 서비스가 fetch join으로 필요한 데이터를 조회해 DTO로 반환합니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 외부 결제 API가 느려질 때 커넥션 풀 대기가 생겨서 OSIV를 끄고 조회 서비스를 DTO 반환으로 바꿨습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: "트랜잭션은 그대로, 영속성 컨텍스트만 길어진다"를 구분했나요? 커넥션 점유를 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 스프링 부트와 PostgreSQL에서, 같은 컨트롤러를 OSIV를 켜고 끈 두 설정으로 호출해 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>꺼짐: 컨트롤러 지연 로딩은 LazyInitializationException / 켜짐: "레드" 반환</li>
      <li>서비스 호출 직후 HikariCP 사용 중 커넥션: 꺼짐 0개 / 켜짐 1개</li>
      <li>컨트롤러에서 이름 변경 후 상관없는 쓰기 트랜잭션: 꺼짐 반영 안 됨 / 켜짐 반영됨</li>
    </ul>
    <p><a href={`${testDir}/OsivOffTest.java`}>OsivOffTest</a> · <a href={`${testDir}/OsivOnTest.java`}>OsivOnTest</a></p>
  </section>

  <footer>
    근거: Spring Boot 참조 문서의 Open EntityManager in View, Spring Framework OpenEntityManagerInViewInterceptor API. 커넥션 처리량 계산은 단순 모형이에요. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .tl { display: flex; flex-direction: column; gap: 8px; }
  .tl-head { display: flex; margin-left: 130px; font-size: 12px; color: var(--muted); }
  .tl-head span { flex: 0 0 calc(var(--w) * 1%); border-left: 1px dashed var(--line); padding-left: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl-row { display: flex; align-items: center; gap: 10px; }
  .tl-label { flex: 0 0 120px; font-size: 13px; font-weight: 700; }
  .tl-track { position: relative; flex: 1; height: 22px; background: var(--code-bg); border-radius: 6px; }
  .tl-bar { position: absolute; top: 3px; bottom: 3px; border-radius: 4px; transition: left 0.3s, width 0.3s; }
  .tl-bar.pc { background: var(--accent); }
  .tl-bar.tx { background: var(--ok); }
  .tl-bar.conn { background: var(--query); }
  .tl-mark { position: absolute; top: 2px; bottom: 2px; width: 12%; left: 38%; border-radius: 4px; border: 2px solid var(--ink); }
  .tl-mark.fail { border-color: var(--query); border-style: dashed; }
  .sliders { display: flex; flex-direction: column; gap: 10px; }
  .sliders label { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
  .sliders input { width: 100%; }
  .pool-out { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .pool-out > div { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; }
  .pool-out b.big { font-size: 24px; }
  @media (max-width: 760px) {
    .tl-head { display: none; }
    .tl-label { flex-basis: 90px; font-size: 12px; }
    .pool-out { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { ok: '팀 이름을 돌려준다', lie: 'LazyInitializationException' };
  var pred = { p1: store('osiv-p1') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + '. 정답은 "팀 이름을 돌려준다"예요. 부트 기본값으로 OSIV가 켜져 있어서요. open-in-view: false로 끄면 LazyInitializationException이에요.';
  }
  ['p1'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('osiv-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 타임라인: 구간 경계(%) 요청 0-8, 서비스 8-38, 지연 로딩 38-50, 외부 API 50-92, 응답 92-100 */
  function bar(id, l, r) { var el = document.getElementById(id); el.style.left = l + '%'; el.style.width = (r - l) + '%'; }
  function renderTl(mode) {
    var mark = document.getElementById('mark-lazy');
    if (mode === 'on') {
      bar('bar-pc', 2, 98); bar('bar-tx', 8, 38); bar('bar-conn', 10, 98);
      mark.className = 'tl-mark';
      document.getElementById('tl-text').textContent = '영속성 컨텍스트가 요청 내내 열려 있어서 지연 로딩이 돼요(트랜잭션 없이 SELECT). 대신 서비스에서 처음 DB를 쓴 순간부터 응답이 나갈 때까지 커넥션을 쥐고 있어요. 느린 외부 API를 기다리는 동안에도요.';
    } else {
      bar('bar-pc', 8, 38); bar('bar-tx', 8, 38); bar('bar-conn', 10, 38);
      mark.className = 'tl-mark fail';
      document.getElementById('tl-text').textContent = '영속성 컨텍스트, 트랜잭션, 커넥션이 모두 서비스 범위에서 끝나요. 외부 API를 기다리는 동안 커넥션은 풀에 돌아가 있어요. 대신 서비스 밖의 지연 로딩(점선)은 LazyInitializationException이에요.';
    }
  }
  pressGroup(document.getElementById('osiv'), renderTl);
  renderTl('on');

  /* 3. 커넥션 풀 모형 */
  var sPool = document.getElementById('s-pool'), sDb = document.getElementById('s-db'), sExt = document.getElementById('s-ext');
  function renderPool() {
    var pool = +sPool.value, db = +sDb.value, ext = +sExt.value;
    document.getElementById('v-pool').textContent = pool + '개';
    document.getElementById('v-db').textContent = db + 'ms';
    document.getElementById('v-ext').textContent = ext + 'ms';
    var holdOn = db + ext, holdOff = db;
    var rpsOn = Math.floor(pool * 1000 / holdOn), rpsOff = Math.floor(pool * 1000 / holdOff);
    document.getElementById('o-on-hold').textContent = holdOn + 'ms';
    document.getElementById('o-off-hold').textContent = holdOff + 'ms';
    document.getElementById('o-on-rps').textContent = rpsOn.toLocaleString() + ' 요청/초';
    document.getElementById('o-off-rps').textContent = rpsOff.toLocaleString() + ' 요청/초';
    var ratio = (rpsOff / rpsOn);
    document.getElementById('pool-text').textContent = ext === 0
      ? '트랜잭션 밖 작업이 없으면 차이가 없어요. OSIV의 비용은 "트랜잭션 밖에서 보내는 시간"에 비례해요.'
      : '같은 풀로 OSIV를 끄면 커넥션 기준 처리량이 약 ' + ratio.toFixed(1) + '배예요. 외부 API를 ' + ext + 'ms 기다리는 동안 OSIV 켜진 요청은 커넥션을 놓지 않아요.';
  }
  [sPool, sDb, sExt].forEach(function (s) { s.addEventListener('input', renderPool); });
  renderPool();

  /* 6. 확인 문제 */
  var quiz = [
    { q: 'OSIV를 켜면 @Transactional 트랜잭션의 범위도 요청 전체로 늘어난다?', o: ['그렇다', '아니다. 트랜잭션은 그대로, 영속성 컨텍스트만 요청 끝까지 열린다'], a: 1, e: '트랜잭션 밖의 지연 로딩 SELECT는 트랜잭션 없이 실행돼요.' },
    { q: 'OSIV가 켜져 있을 때 DB 커넥션은 언제 풀로 돌아가나?', o: ['서비스 트랜잭션이 끝날 때', '요청이 끝나 영속성 컨텍스트가 닫힐 때'], a: 1, e: '영속성 컨텍스트가 커넥션을 쥔 채로 응답까지 가요. 검증 테스트에서 서비스 직후 사용 중 커넥션이 1개였어요.' },
    { q: 'OSIV를 껐을 때 컨트롤러에서 연관 엔티티 데이터가 필요하면?', o: ['컨트롤러에 @Transactional을 붙인다', '서비스에서 fetch join으로 조회해 DTO로 반환한다'], a: 1, e: '필요한 데이터를 트랜잭션 안에서 준비하는 게 원칙이에요. 컨트롤러 트랜잭션은 결국 OSIV와 같은 문제를 만들어요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('osiv-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('osiv-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
