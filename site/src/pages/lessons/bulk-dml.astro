---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/dml/BulkDmlTest.java`;

const codeNaive = `-- 운영 DB에서 바로
UPDATE orders SET status = 'EXPIRED'
 WHERE status = 'PENDING' AND created_at < '2026-10-01';
COMMIT;`;

const runbook = `-- 0. 사전 점검: 대상 건수를 세고 기록한다
SELECT count(*) FROM orders
 WHERE status = 'PENDING' AND created_at < '2026-10-01';          -- 예: 5,000

-- 1. 백업: 바꿀 행을 그대로 복사해 둔다
CREATE TABLE orders_bak_20261116 AS
SELECT * FROM orders
 WHERE status = 'PENDING' AND created_at < '2026-10-01';
SELECT count(*) FROM orders_bak_20261116;                        -- 0번과 같아야 함

-- 2. 분할 실행: id 범위로 나누고, 대상 조건을 WHERE에 그대로 둔다 (재실행해도 안전)
UPDATE orders SET status = 'EXPIRED'
 WHERE id BETWEEN :from AND :to
   AND status = 'PENDING' AND created_at < '2026-10-01';
COMMIT;                                                          -- 범위마다 커밋, 바뀐 건수 기록

-- 3. 사후 검증
SELECT count(*) FROM orders
 WHERE status = 'PENDING' AND created_at < '2026-10-01';         -- 0
SELECT count(*) FROM orders o JOIN orders_bak_20261116 b ON o.id = b.id
 WHERE o.status = 'EXPIRED';                                     -- 백업 건수와 같아야 함

-- 4. 원복 (문제가 생기면)
UPDATE orders o SET status = b.status
  FROM orders_bak_20261116 b
 WHERE o.id = b.id;`;
---
<Base title="대량 DML 안전하게 하기 · Dev Lessons" description="운영 DB에서 수천~수십만 건을 UPDATE·DELETE할 때의 절차. 백업 테이블, 전후 건수 비교, 분할 커밋, 재실행 가능한 조건, 원복 스크립트를 시뮬레이터와 테스트로 확인하고 바로 쓸 수 있는 작업 SQL 템플릿까지.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">DB · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a></p>
    <h1>대량 DML 안전하게 하기</h1>
    <p class="lede">운영 DB에서 수만 건을 고치는 일은 SQL 한 줄이지만, 잘못되면 되돌릴 수 없어요. 면접에서 "대량 데이터를 수정해야 하면 어떻게 하나요?"라고 묻는 건 SQL 문법이 아니라 <strong>절차</strong>를 묻는 거예요. 백업, 건수 확인, 분할 커밋, 원복까지 하나씩 왜 필요한지 확인해요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 커밋과 롤백, 자동 커밋(<a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>), SQL의 UPDATE·JOIN. 이 레슨의 <strong>DML</strong>은 데이터를 바꾸는 SQL(INSERT, UPDATE, DELETE)을 말해요.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#risk"><span>1</span>한 줄의 위험</a>
      <a href="#sim"><span>2</span>직접 돌려 보기</a>
      <a href="#steps"><span>3</span>안전한 절차</a>
      <a href="#runbook"><span>4</span>작업 SQL 템플릿</a>
      <a href="#more"><span>5</span>더 챙길 것</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>분할 작업이 중간에 죽었다면?</h2>
    <p>10,000건 중 대상 5,000건을 id 1,000개씩 나눠 UPDATE하고 묶음마다 커밋했어요. 네 번째 묶음을 처리하다 장애가 났어요. 같은 스크립트를 <strong>처음부터 다시</strong> 돌리면 어떻게 될까요? 각 UPDATE의 WHERE에는 <code>status = 'PENDING'</code> 조건이 있어요.</p>
    <div class="panel">
      <div class="field">
        <span class="label">다시 돌리면</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="dup" aria-pressed="false">앞 묶음이 두 번 처리되어 꼬인다</button>
          <button class="chip" type="button" data-v="safe" aria-pressed="false">이미 바뀐 행은 건너뛰고 나머지만 처리된다</button>
          <button class="chip" type="button" data-v="restore" aria-pressed="false">먼저 원복해야만 다시 돌릴 수 있다</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 2장에서 직접 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="risk" class="read">
    <p class="eyebrow">1 · 한 줄의 위험</p>
    <h2>이렇게 바로 실행하면 생기는 일</h2>
    <pre set:text={codeNaive} />
    <div class="table-wrap">
      <table>
        <thead><tr><th>위험</th><th>무슨 일이</th></tr></thead>
        <tbody>
          <tr><td>조건 실수</td><td>날짜 하나만 틀려도 엉뚱한 수만 건이 바뀌어요. 이미 커밋했다면 무엇이 원래 값이었는지 알 수 없어요.</td></tr>
          <tr><td>긴 트랜잭션과 락</td><td>커밋 전까지 바뀐 행이 모두 잠겨요. 그동안 같은 행을 고치려는 서비스 요청이 기다리거나 타임아웃으로 실패해요.</td></tr>
          <tr><td>끝에서 실패</td><td>한 트랜잭션이라 마지막에 실패하면 전부 롤백돼요. 오래 기다린 작업이 0이 돼요.</td></tr>
          <tr><td>DB 부하</td><td>한 번에 많은 변경이 몰려 디스크 쓰기가 늘고, 예비 DB가 원본을 따라잡는 시간(복제 지연)이 길어질 수 있어요.</td></tr>
        </tbody>
      </table>
    </div>
    <p>그래서 대량 DML은 <strong>되돌릴 수 있게(백업), 확인할 수 있게(건수), 작게 나눠서(분할 커밋), 다시 돌려도 안전하게(조건)</strong> 해요.</p>
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">2 · 직접 돌려 보기</p>
      <h2>10,000건 중 대상 5,000건</h2>
      <p>칸 하나가 id 100개(그중 대상 50건)예요. 방식을 고르고 실행해 보세요. 40% 지점에서 장애가 나도록 할 수 있어요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">방식</span>
        <div class="seg" id="d-mode">
          <button type="button" data-v="one" aria-pressed="false">한 트랜잭션으로 한 번에</button>
          <button type="button" data-v="split" aria-pressed="true">id 1,000개씩 분할 커밋</button>
        </div>
      </div>
      <label class="check"><input type="checkbox" id="d-fail" checked> 진행 중 장애 (네 번째 묶음 = 40% 지점)</label>
      <label class="check"><input type="checkbox" id="d-backup" checked> 실행 전 백업 테이블 만들기</label>
      <div class="cells" id="d-cells" aria-label="id 범위별 상태"></div>
      <div class="legend"><span class="cl done"></span>바뀜(커밋) <span class="cl rb"></span>롤백 <span class="cl"></span>대상 남음</div>
      <div class="actions">
        <button class="btn primary" type="button" id="d-run">실행</button>
        <button class="btn" type="button" id="d-rerun">장애 고치고 처음부터 다시 실행</button>
        <button class="btn" type="button" id="d-restore">원복 스크립트 실행</button>
        <button class="btn" type="button" id="d-reset">처음으로</button>
      </div>
      <div class="d-meta">
        <div><span class="label">대상 조건에 남은 건수</span><span class="big" id="d-left">5000</span></div>
        <div><span class="label">바뀐 건수</span><span class="big" id="d-done">0</span></div>
        <div><span class="label">백업 테이블</span><span class="big" id="d-bak">-</span></div>
      </div>
      <div class="log" id="d-log"></div>
    </div>
  </section>

  <section id="steps" class="read">
    <p class="eyebrow">3 · 안전한 절차</p>
    <h2>다섯 단계와 각각의 이유</h2>
    <ol>
      <li><strong>사전 점검:</strong> 대상 건수를 먼저 세고 기록해요. 예상과 크게 다르면 조건이 틀린 거예요. 실행 계획도 확인해서 조건이 인덱스를 타는지 봐요.</li>
      <li><strong>백업:</strong> 바꿀 행을 백업 테이블로 그대로 복사해요(<code>CREATE TABLE ... AS SELECT</code>). 백업 건수가 사전 건수와 같은지 확인해요. 원복의 유일한 근거예요.</li>
      <li><strong>분할 실행:</strong> id 범위(또는 일정 건수)로 나눠 실행하고 묶음마다 커밋해요. 락은 짧게, 실패해도 이미 한 만큼은 남아요. <strong>대상 조건을 WHERE에 그대로 두면</strong> 이미 바뀐 행은 조건에 걸리지 않아서 처음부터 다시 돌려도 안전해요(0장의 답).</li>
      <li><strong>사후 검증:</strong> 바뀐 건수 합계 = 사전 건수, 대상 조건으로 다시 세면 0건, 백업과 조인해서 모두 바뀌었는지 확인해요.</li>
      <li><strong>원복 준비:</strong> 백업 테이블과 id로 조인해 되돌리는 SQL을 <strong>실행 전에</strong> 써 두고 검토받아요. 문제가 생긴 뒤에 쓰면 늦어요.</li>
    </ol>
    <div class="callout">
      <strong>분할의 대가:</strong> 분할하면 작업이 중간에 멈췄을 때 "절반만 바뀐" 상태가 실제로 서비스에 보여요. 그 상태가 허용되는 작업인지(만료 처리는 대개 괜찮음), 아니면 전부 아니면 전무여야 하는지(금액 이동 등)를 먼저 판단해요. 후자라면 업무 시간 외에 짧게 한 트랜잭션으로 하거나 다른 설계가 필요해요.
    </div>
  </section>

  <section id="runbook" class="read">
    <p class="eyebrow">4 · 작업 SQL 템플릿</p>
    <h2>그대로 복사해서 쓰는 작업 순서</h2>
    <p>PostgreSQL 문법이에요. 백업 테이블 이름에 작업 날짜를 넣어 두면 나중에 정리하기 쉬워요.</p>
    <pre set:text={runbook} />
    <p class="muted">MySQL은 조인 UPDATE 문법이 <code>UPDATE orders o JOIN orders_bak b ON o.id = b.id SET o.status = b.status</code>처럼 달라요.</p>
  </section>

  <section id="more" class="read">
    <p class="eyebrow">5 · 더 챙길 것</p>
    <h2>SQL 밖의 준비</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>항목</th><th>이유</th></tr></thead>
        <tbody>
          <tr><td>작업 시간</td><td>트래픽이 적은 시간에. 서비스 요청과 락 경합을 줄여요.</td></tr>
          <tr><td>두 사람 확인</td><td>조건과 원복 SQL을 다른 사람이 검토해요.</td></tr>
          <tr><td>클라이언트 자동 커밋 끄기</td><td>DB 툴의 자동 커밋이 켜져 있으면 실수한 문장이 바로 확정돼요.</td></tr>
          <tr><td>락 타임아웃</td><td>작업 세션에 짧은 lock_timeout을 걸어, 서비스가 잡은 락을 오래 기다리며 다른 요청을 막지 않게 해요.</td></tr>
          <tr><td>백업 테이블 정리</td><td>검증 기간이 지나면 지워요. 개인정보가 들어 있다면 특히.</td></tr>
          <tr><td>코드로 해야 하면</td><td>반복되는 대량 작업은 <a href="/dev-lessons/lessons/spring-batch/">스프링 배치</a>로 만들어 청크 커밋과 재시작을 맡겨요.</td></tr>
        </tbody>
      </table>
    </div>
    <p class="muted">이 장의 내용은 운영 관행으로, 테스트로 확인한 것은 검증 섹션의 항목들이에요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "운영 DB에서 대량 데이터를 수정해야 할 때 어떻게 진행하나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 먼저 대상 건수를 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>절차</dt><dd>먼저 대상 건수를 세서 기록하고, 대상 행을 백업 테이블로 복사한 뒤 건수가 같은지 확인합니다. 원복 SQL은 실행 전에 미리 작성해 검토받습니다.</dd>
        <dt>실행</dt><dd>id 범위로 나눠 묶음마다 커밋하고, 대상 조건을 WHERE에 그대로 두어 중간에 실패해도 처음부터 다시 돌릴 수 있게 합니다. 묶음마다 바뀐 건수를 기록합니다.</dd>
        <dt>검증과 트레이드오프</dt><dd>바뀐 건수 합계가 사전 건수와 같은지, 대상 조건으로 다시 세면 0건인지 확인합니다. 한 트랜잭션은 락이 길고 끝에서 실패하면 전부 롤백되며, 분할은 중간 상태가 보이므로 작업 성격에 따라 고르고, 트래픽이 적은 시간에 lock_timeout을 걸고 진행합니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 만료 처리 작업을 백업, 분할 커밋, 건수 비교 순서로 진행했고 원복 스크립트를 미리 검토받았습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 백업, 전후 건수, 분할 커밋, 재실행 가능한 조건, 원복 SQL 다섯 가지를 모두 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 PostgreSQL에 주문 10,000건(대상 5,000건)을 만들어, 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>백업 테이블 건수 = 대상 건수</li>
      <li>UPDATE가 바꾼 건수 = 사전 건수, 실행 후 대상 조건은 0건</li>
      <li>한 트랜잭션으로 하다 끝에서 실패하면 바뀐 건수 0 (전부 롤백)</li>
      <li>1,000개 범위씩 분할 커밋 중 네 번째 묶음에서 실패: 앞 세 묶음 1,500건은 남음</li>
      <li>대상 조건을 둔 분할 작업을 처음부터 다시 돌리면 나머지 3,500건만 처리, 최종 5,000건</li>
      <li>원복 스크립트 후 백업과 값이 모두 같음</li>
      <li>커밋 전 대량 UPDATE 동안 같은 행을 고치는 다른 요청은 lock_timeout으로 실패 (SQLSTATE 55P03)</li>
    </ul>
    <p><a href={test}>BulkDmlTest</a></p>
  </section>

  <footer>
    근거: PostgreSQL 16 문서의 UPDATE, CREATE TABLE AS, lock_timeout. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .cells { display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: 3px; }
  .cl { display: inline-block; height: 22px; border-radius: 3px; border: 1px solid var(--line); background: var(--surface); }
  .cl.done { background: var(--ok-soft); border-color: var(--ok); }
  .cl.rb { background: repeating-linear-gradient(45deg, var(--query-soft), var(--query-soft) 3px, transparent 3px, transparent 6px); border-color: var(--query); }
  .cl.batch { box-shadow: inset 2px 0 0 var(--accent); }
  .legend { font-size: 13px; color: var(--muted); }
  .legend .cl { width: 18px; height: 14px; vertical-align: middle; margin: 0 4px 0 10px; }
  .d-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .d-meta > div { display: flex; flex-direction: column; gap: 2px; }
  .d-meta .big { font-size: 30px; }
  @media (max-width: 520px) { .cells { grid-template-columns: repeat(10, minmax(0, 1fr)); } .d-meta { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  var pl = { dup: '앞 묶음이 두 번 처리되어 꼬인다', safe: '이미 바뀐 행은 건너뛰고 나머지만 처리된다', restore: '먼저 원복해야만 다시 돌릴 수 있다' };
  var pred = { p1: store('dml-p1'), p2: store('dml-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + pl[pred.p1] + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "이미 바뀐 행은 건너뛰고 나머지만 처리된다"예요. 대상 조건이 WHERE에 있어서예요. 2장에서 확인해 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('dml-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 시뮬레이터: 칸 100개 = id 100개씩, 칸마다 대상 50건 */
  var CELLS = 100, PER = 50, D, mode = 'split';
  function fresh() { D = { cells: [], backup: null, log: [] }; for (var i = 0; i < CELLS; i++) D.cells.push(''); }
  function done() { return D.cells.filter(function (c) { return c === 'done'; }).length * PER; }
  function run(failActive) {
    var startDone = done();
    if (document.getElementById('d-backup').checked && D.backup === null) {
      D.backup = (CELLS * PER) - startDone;
      D.log.push('백업 테이블 생성: ' + D.backup + '건 (사전 건수와 같음)');
    }
    if (mode === 'one') {
      if (failActive) {
        for (var i = 0; i < CELLS; i++) if (D.cells[i] !== 'done') D.cells[i] = 'rb';
        D.log.push('한 트랜잭션으로 진행하다 40% 지점에서 장애 → 전부 롤백. 바뀐 건수 0');
      } else {
        for (var j = 0; j < CELLS; j++) D.cells[j] = 'done';
        D.log.push('한 번에 UPDATE 후 커밋: ' + (CELLS * PER - startDone) + '건');
      }
      return;
    }
    for (var b = 0; b < 10; b++) {
      if (failActive && b === 3) {
        for (var k = b * 10; k < b * 10 + 10; k++) if (D.cells[k] !== 'done') D.cells[k] = 'rb';
        D.log.push('묶음 ' + (b + 1) + ' (id ' + (b * 1000 + 1) + '~' + (b + 1) * 1000 + ') 처리 중 장애 → 이 묶음만 롤백. 앞 묶음은 커밋됨');
        return;
      }
      var changed = 0;
      for (var m = b * 10; m < b * 10 + 10; m++) { if (D.cells[m] !== 'done') { D.cells[m] = 'done'; changed += PER; } }
      D.log.push('묶음 ' + (b + 1) + ' (id ' + (b * 1000 + 1) + '~' + (b + 1) * 1000 + '): ' + changed + '건 바뀜, 커밋' + (changed === 0 ? ' (이미 바뀐 행은 조건에 안 걸림)' : ''));
    }
  }
  function render(note) {
    var html = '';
    for (var i = 0; i < CELLS; i++) html += '<span class="cl ' + D.cells[i] + (i % 10 === 0 ? ' batch' : '') + '" title="id ' + (i * 100 + 1) + '~' + (i + 1) * 100 + '"></span>';
    document.getElementById('d-cells').innerHTML = html;
    document.getElementById('d-left').textContent = CELLS * PER - done();
    document.getElementById('d-done').textContent = done();
    document.getElementById('d-bak').textContent = D.backup === null ? '-' : D.backup + '건';
    var logs = D.log.slice(); if (note) logs.push(note);
    document.getElementById('d-log').innerHTML = logs.length ? logs.map(function (l) { return '<div class="row note">' + esc(l) + '</div>'; }).join('') : '<div class="empty">실행을 눌러 보세요</div>';
  }
  document.getElementById('d-run').addEventListener('click', function () { fresh(); run(document.getElementById('d-fail').checked); render(); });
  document.getElementById('d-rerun').addEventListener('click', function () {
    for (var i = 0; i < CELLS; i++) if (D.cells[i] === 'rb') D.cells[i] = '';
    D.log.push('--- 장애 원인을 고치고 같은 스크립트를 처음부터 다시 실행 ---');
    run(false); render();
  });
  document.getElementById('d-restore').addEventListener('click', function () {
    if (D.backup === null) { render('백업 테이블이 없어서 원래 값을 알 수 없어요. 원복할 방법이 없어요.'); return; }
    var n = done();
    for (var i = 0; i < CELLS; i++) D.cells[i] = '';
    D.log.push('원복: 백업과 id로 조인해 ' + n + '건을 원래 값으로 되돌림. 대상 조건에 다시 ' + (CELLS * PER) + '건');
    render();
  });
  document.getElementById('d-reset').addEventListener('click', function () { fresh(); render(); });
  pressGroup(document.getElementById('d-mode'), function (v) { mode = v; fresh(); render(); });
  fresh(); render();

  /* 6. 확인 문제 */
  var quiz = [
    { q: '분할 UPDATE를 재실행해도 안전하게 만드는 핵심은?', o: ['묶음 크기를 작게', '대상 조건(예: status = PENDING)을 WHERE에 그대로 둔다', '매번 원복 후 실행'], a: 1, e: '이미 바뀐 행은 조건에 걸리지 않아 다시 바뀌지 않아요.' },
    { q: '한 트랜잭션으로 5만 건을 UPDATE하는 동안 서비스에 생길 수 있는 일은?', o: ['아무 영향 없다', '같은 행을 고치는 요청이 커밋까지 기다리거나 타임아웃된다'], a: 1, e: '바뀐 행은 커밋 전까지 잠겨 있어요.' },
    { q: '원복 SQL은 언제 작성하나요?', o: ['문제가 생긴 뒤에', '실행 전에 미리 작성해 검토'], a: 1, e: '문제가 생긴 순간에는 시간이 없고 실수하기 쉬워요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('dml-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('dml-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
