---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/index/IndexPlanTest.java`;

const codePredict = `-- 주문 20만 건, status는 PAID 99%, CANCELED 1%
CREATE INDEX idx_status ON orders (status);

EXPLAIN SELECT * FROM orders WHERE status = 'PAID';`;

const codeExplain = `EXPLAIN SELECT * FROM orders WHERE member_id = 123;

Bitmap Heap Scan on orders  (cost=4.38..39.39 rows=10 width=58)
  Recheck Cond: (member_id = 123)
  ->  Bitmap Index Scan on idx_member  (cost=0.00..4.38 rows=10 width=0)
        Index Cond: (member_id = 123)`;

const codeComposite = `CREATE INDEX idx_status_created ON orders (status, created_at);

-- 인덱스 안의 정렬: status로 먼저, 같은 status 안에서 created_at 순
-- (CANCELED, 01-01) (CANCELED, 01-02) ... (PAID, 01-01) (PAID, 01-02) ...

WHERE status = 'CANCELED' AND created_at > '2026-03-01'   -- 한 구간만 읽으면 끝
WHERE created_at > '2026-03-01'                           -- 선두 컬럼 조건이 없어 효율적으로 못 씀`;
---
<Base title="인덱스와 실행계획 · Dev Lessons" description="인덱스가 조회를 빠르게 하는 원리와, 인덱스가 있어도 쓰이지 않는 경우(함수, 앞쪽 와일드카드, 낮은 선택도, 복합 인덱스 순서)를 PostgreSQL EXPLAIN 실험실에서 직접 확인해요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">DB · 개념 학습 · 약 30분 · 선수 레슨 없음</p>
    <h1>인덱스와 실행계획</h1>
    <p class="lede">"인덱스를 걸면 빨라진다"까지는 다들 알아요. 면접과 실무에서 차이를 만드는 건 <strong>인덱스가 있는데도 안 쓰이는 경우</strong>를 알고, 그걸 <strong>실행계획으로 확인</strong>하는 습관이에요. 모든 결과는 PostgreSQL 16에서 실제 EXPLAIN으로 확인했어요.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#what"><span>1</span>인덱스가 하는 일</a>
      <a href="#explain"><span>2</span>실행계획 읽기</a>
      <a href="#lab"><span>3</span>EXPLAIN 실험실</a>
      <a href="#miss"><span>4</span>인덱스를 못 타는 경우</a>
      <a href="#composite"><span>5</span>복합 인덱스의 순서</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>인덱스를 걸었으니 쓰일까요?</h2>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">실행계획은</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="index" aria-pressed="false">idx_status를 쓴다</button>
          <button class="chip" type="button" data-v="seq" aria-pressed="false">인덱스를 무시하고 전체를 읽는다</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 3장 실험실에서 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="what" class="read">
    <p class="eyebrow">1 · 인덱스가 하는 일</p>
    <h2>정렬된 목차로 바로 찾아가기</h2>
    <p>인덱스가 없으면 DB는 조건에 맞는 행을 찾으려고 테이블을 처음부터 끝까지 읽어요. 이걸 <strong>Seq Scan</strong>(순차 스캔)이라고 해요. 인덱스는 특정 컬럼 값을 <strong>정렬해서</strong> 따로 저장하고 각 값이 테이블의 어느 위치에 있는지 가리켜요. 책 뒤의 찾아보기와 같아요.</p>
    <ul>
      <li>대부분의 인덱스는 <strong>B-tree</strong> 구조예요. 정렬된 값을 트리로 나눠 두어서, 20만 건이든 2천만 건이든 몇 단계만 내려가면 원하는 값을 찾아요.</li>
      <li>정렬돼 있어서 <code>=</code>뿐 아니라 범위(<code>&gt;</code>, <code>BETWEEN</code>), 정렬(<code>ORDER BY</code>), 접두어 검색에도 쓸 수 있어요.</li>
    </ul>
    <div class="callout warn">
      <strong>공짜가 아니에요.</strong> INSERT·UPDATE·DELETE 때마다 인덱스도 함께 고쳐야 해서 쓰기가 느려지고, 저장 공간도 들어요. 그래서 "자주 조회하는 조건"에만 걸어요.
    </div>
  </section>

  <section id="explain" class="read">
    <p class="eyebrow">2 · 실행계획 읽기</p>
    <h2>EXPLAIN으로 DB의 계획을 본다</h2>
    <p>같은 SQL이라도 DB의 <strong>옵티마이저</strong>(플래너)는 데이터 분포 통계를 보고 가장 싸 보이는 방법을 골라요. <code>EXPLAIN</code>을 앞에 붙이면 실행하지 않고 그 계획을 보여줘요.</p>
    <pre set:text={codeExplain} />
    <div class="table-wrap">
      <table>
        <thead><tr><th>노드</th><th>뜻</th></tr></thead>
        <tbody>
          <tr><td>Seq Scan</td><td>테이블 전체를 순서대로 읽음</td></tr>
          <tr><td>Index Scan</td><td>인덱스로 찾은 위치의 행을 하나씩 읽음</td></tr>
          <tr><td>Bitmap Index Scan + Bitmap Heap Scan</td><td>인덱스로 위치를 모은 뒤 테이블을 위치 순으로 읽음 (중간 정도 건수에 유리)</td></tr>
          <tr><td>Index Only Scan</td><td>필요한 컬럼이 모두 인덱스에 있어 테이블을 읽지 않음</td></tr>
        </tbody>
      </table>
    </div>
    <ul>
      <li><code>cost</code>는 플래너가 추정한 상대 비용, <code>rows</code>는 추정 행 수예요. 실제 값이 아니에요.</li>
      <li><code>EXPLAIN ANALYZE</code>는 <strong>실제로 실행</strong>해서 실제 시간과 행 수를 보여줘요. UPDATE·DELETE에 쓰면 정말 바뀌니 트랜잭션 안에서 롤백하며 써요.</li>
      <li>통계가 오래되면 플래너가 잘못 고를 수 있어요. 대량 변경 후에는 <code>ANALYZE</code>로 통계를 갱신해요.</li>
    </ul>
  </section>

  <section id="lab">
    <div class="read stack">
      <p class="eyebrow">3 · EXPLAIN 실험실</p>
      <h2>쿼리와 인덱스를 골라 보세요</h2>
      <p>주문 20만 건 테이블이에요. member_id는 2만 명에 고르게, status는 PAID 99%·CANCELED 1%, created_at은 1월 1일부터 1분 간격이에요. 결과는 테스트에서 확인한 계획을 바탕으로 해요. 실제로는 Index Scan 대신 Bitmap 스캔이 나오기도 해요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">쿼리 (SELECT * FROM orders WHERE …)</span>
        <select id="q" class="lab-select"></select>
      </div>
      <div class="field">
        <span class="label">만들어 둔 인덱스</span>
        <div class="idx-list" id="idx"></div>
      </div>
      <pre id="plan" class="plan"></pre>
      <p class="verdict" id="why"></p>
    </div>
  </section>

  <section id="miss" class="read">
    <p class="eyebrow">4 · 인덱스를 못 타는 경우</p>
    <h2>있는데 안 쓰이는 다섯 가지</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>경우</th><th>예</th><th>이유와 대응</th></tr></thead>
        <tbody>
          <tr><td>컬럼에 함수·연산</td><td><code>lower(email) = ...</code>, <code>created_at::date = ...</code></td><td>인덱스는 원래 값으로 정렬돼 있어요. 같은 식으로 <strong>함수 인덱스</strong>를 만들거나, 조건을 범위로 바꿔요 (<code>created_at &gt;= '06-01' AND &lt; '06-02'</code>)</td></tr>
          <tr><td>앞쪽 와일드카드</td><td><code>LIKE '%@example.com'</code></td><td>시작 글자를 몰라 정렬된 목차를 쓸 수 없어요. 전문 검색이나 다른 설계가 필요해요</td></tr>
          <tr><td>접두어 LIKE와 정렬 규칙</td><td><code>LIKE 'user12%'</code></td><td>PostgreSQL은 DB 정렬 규칙(collation)이 C가 아니면 일반 인덱스로 LIKE를 못 써요. <code>text_pattern_ops</code>로 만든 인덱스가 필요해요</td></tr>
          <tr><td>낮은 선택도</td><td><code>status = 'PAID'</code> (99%)</td><td>거의 다 읽어야 하면 인덱스를 거쳐 하나씩 읽는 것보다 전체를 읽는 게 싸요. 플래너가 일부러 안 써요</td></tr>
          <tr><td>복합 인덱스의 선두 컬럼 누락</td><td>(status, created_at)인데 created_at만 조건</td><td>5장</td></tr>
        </tbody>
      </table>
    </div>
    <p>0장의 답은 <strong>"전체를 읽는다"</strong>예요. 같은 인덱스도 1%인 CANCELED를 찾을 때는 써요. 인덱스를 걸지 말지는 컬럼이 아니라 <strong>그 조건이 얼마나 좁히는지</strong>로 판단해요.</p>
  </section>

  <section id="composite" class="read">
    <p class="eyebrow">5 · 복합 인덱스의 순서</p>
    <h2>왼쪽부터 차례로 써요</h2>
    <pre set:text={codeComposite} />
    <ul>
      <li>복합 인덱스는 <strong>첫 번째 컬럼으로 먼저 정렬</strong>되고, 같은 값 안에서 두 번째 컬럼으로 정렬돼요. 전화번호부가 성, 이름 순인 것과 같아요. 이름만으로는 찾기 어렵죠.</li>
      <li>그래서 보통 <strong>등치 조건(=) 컬럼을 앞에, 범위 조건 컬럼을 뒤에</strong> 둬요.</li>
      <li>(status, created_at) 인덱스가 있으면 status만 조건인 쿼리도 이 인덱스를 써요. status 단독 인덱스를 따로 만들 필요가 없을 수 있어요.</li>
      <li>PostgreSQL 18부터는 선두 컬럼 조건이 없어도 일부 경우에 인덱스를 건너뛰며 읽는 skip scan을 지원해요. 이 레슨의 테스트는 16 기준이에요.</li>
    </ul>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "인덱스가 조회를 빠르게 하는 원리와, 인덱스가 있어도 쓰이지 않는 경우를 설명해 주세요"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 인덱스는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>인덱스는 컬럼 값을 정렬해 저장하고 행 위치를 가리키는 자료구조로, 대부분 B-tree라서 전체를 읽지 않고 몇 단계 만에 원하는 값을 찾습니다.</dd>
        <dt>원리</dt><dd>옵티마이저가 통계를 보고 인덱스 사용 여부를 정하므로 EXPLAIN으로 확인합니다. 컬럼에 함수를 씌우거나, 앞쪽 와일드카드 LIKE, 복합 인덱스의 선두 컬럼 누락, 그리고 대부분의 행이 해당하는 낮은 선택도에서는 인덱스가 있어도 쓰이지 않습니다.</dd>
        <dt>트레이드오프</dt><dd>조회는 빨라지지만 쓰기마다 인덱스를 갱신해야 해서 쓰기가 느려지고 공간이 듭니다. 그래서 자주 쓰고 선택도가 높은 조건에, 복합 인덱스는 등치 컬럼을 앞에 두고 만듭니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 날짜에 함수를 씌운 조건 때문에 Seq Scan이 나오는 것을 실행계획으로 찾아 범위 조건으로 바꿨습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: B-tree와 정렬, 실행계획 확인, 못 쓰는 경우 2개 이상, 쓰기 비용을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>PostgreSQL 16(Testcontainers)에 20만 건을 넣고 EXPLAIN 결과를 확인해요.</p>
    <ul>
      <li>인덱스 없음: Seq Scan. member_id 인덱스 생성 후: 인덱스 사용</li>
      <li>lower(email) 조건: email 인덱스는 못 쓰고 Seq Scan, 함수 인덱스는 사용</li>
      <li>text_pattern_ops 인덱스: LIKE 'user12345@%'는 사용, LIKE '%345@example.com'은 Seq Scan. 정렬 규칙이 C가 아니면 일반 인덱스로는 접두어 LIKE도 Seq Scan</li>
      <li>선택도: CANCELED(1%)는 인덱스, PAID(99%)는 Seq Scan</li>
      <li>복합 인덱스 (status, created_at): 두 조건 함께면 사용, 선두 컬럼 없이 넓은 범위면 Seq Scan</li>
      <li>VACUUM 후 member_id만 조회: Index Only Scan</li>
    </ul>
    <p class="muted">"선두 컬럼이 없으면 효율적으로 못 쓴다"는 테스트에서 범위가 넓은 경우만 확인했어요. 범위가 아주 좁으면 플래너가 인덱스 전체를 읽는 쪽을 고를 수도 있어요.</p>
    <p><a href={test}>IndexPlanTest</a></p>
  </section>

  <footer>
    근거: PostgreSQL 16 문서의 Using EXPLAIN, Multicolumn Indexes, Indexes on Expressions, Operator Classes, Index-Only Scans. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .lab-select { width: 100%; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-family: var(--font-mono); font-size: 13px; }
  .idx-list { display: flex; flex-direction: column; gap: 6px; }
  .idx-list label { display: flex; gap: 8px; align-items: center; font-family: var(--font-mono); font-size: 13px; }
  .idx-list input { width: 18px; height: 18px; accent-color: var(--accent); }
  .plan { min-height: 64px; }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  var pred = { p1: store('ix-p1'), p2: store('ix-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 === 'index' ? 'idx_status를 쓴다' : '전체를 읽는다') + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "전체를 읽는다"예요. 99%가 PAID라서요. 3장에서 status 쿼리 두 개를 비교해 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('ix-' + k, v); showPred(); });
  });
  showPred();

  /* 3. 실험실 */
  var IDX = [
    ['idx_member', 'idx_member (member_id)'],
    ['idx_email', 'idx_email (email)'],
    ['idx_email_lower', 'idx_email_lower (lower(email))'],
    ['idx_email_pattern', 'idx_email_pattern (email text_pattern_ops)'],
    ['idx_status', 'idx_status (status)'],
    ['idx_status_created', 'idx_status_created (status, created_at)']
  ];
  var Q = [
    { sql: "member_id = 123", cond: "(member_id = 123)", use: ['idx_member'], why: { hit: '선택도가 높은 등치 조건이라 인덱스로 바로 찾아요.', miss: '인덱스가 없어서 20만 건을 모두 읽고 조건을 걸러요.' } },
    { sql: "lower(email) = 'user77@example.com'", cond: "(lower(email) = 'user77@example.com')", use: ['idx_email_lower'], why: { hit: '같은 식으로 만든 함수 인덱스를 써요.', miss: 'email 인덱스가 있어도 lower(email)은 다른 값이라 못 써요. 함수 인덱스가 필요해요.' } },
    { sql: "email LIKE 'user12345@%'", cond: "((email ~>=~ 'user12345@') AND (email ~<~ 'user12345A'))", use: ['idx_email_pattern'], why: { hit: '접두어 검색은 정렬된 인덱스의 한 구간만 읽으면 돼요. text_pattern_ops 인덱스라 가능해요.', miss: '정렬 규칙(collation)이 C가 아니라서 일반 email 인덱스로는 LIKE를 못 써요. text_pattern_ops 인덱스가 필요해요.' } },
    { sql: "email LIKE '%345@example.com'", cond: null, use: [], why: { miss: '앞이 %라 시작 글자를 몰라서, 어떤 인덱스로도 구간을 정할 수 없어요.' } },
    { sql: "status = 'CANCELED'", cond: "(status = 'CANCELED')", use: ['idx_status', 'idx_status_created'], why: { hit: '1%만 해당해서 인덱스가 이득이에요. (status, created_at) 인덱스도 선두 컬럼이 status라 쓸 수 있어요.', miss: '인덱스가 없어 전체를 읽어요.' } },
    { sql: "status = 'PAID'", cond: null, use: [], why: { miss: '99%가 해당해요. 인덱스를 거쳐 거의 모든 행을 하나씩 읽는 것보다 전체를 순서대로 읽는 게 싸서, 인덱스가 있어도 플래너가 안 써요.' } },
    { sql: "status = 'CANCELED' AND created_at > '2026-03-01'", cond: "((status = 'CANCELED') AND (created_at > '2026-03-01'))", use: ['idx_status_created', 'idx_status'], why: { hit: '(status, created_at) 인덱스면 두 조건을 모두 인덱스 안에서 처리해요. status 인덱스만 있으면 status로 찾고 created_at은 걸러내요(Filter).', miss: '쓸 인덱스가 없어 전체를 읽어요.' } },
    { sql: "created_at > '2026-03-01'", cond: null, use: [], why: { miss: '절반 넘는 행이 해당하고, (status, created_at) 인덱스는 선두 컬럼 status 조건이 없어 효율적으로 못 써요.' } },
    { sql: "member_id BETWEEN 100 AND 110  (SELECT member_id만)", cond: "((member_id >= 100) AND (member_id <= 110))", use: ['idx_member'], only: true, why: { hit: '필요한 컬럼(member_id)이 인덱스에 다 있어 테이블을 읽지 않아요. VACUUM으로 가시성 정보가 갱신된 뒤에 가능해요.', miss: '인덱스가 없어 전체를 읽어요.' } }
  ];
  var qSel = document.getElementById('q');
  Q.forEach(function (q, i) { var o = document.createElement('option'); o.value = i; o.textContent = q.sql; qSel.appendChild(o); });
  var idxBox = document.getElementById('idx');
  IDX.forEach(function (x) {
    var l = document.createElement('label');
    l.innerHTML = '<input type="checkbox" id="ix-' + x[0] + '" value="' + x[0] + '"> ' + esc(x[1]);
    idxBox.appendChild(l);
  });
  function renderLab() {
    var q = Q[+qSel.value], have = [];
    idxBox.querySelectorAll('input:checked').forEach(function (c) { have.push(c.value); });
    var pick = null;
    for (var i = 0; i < q.use.length; i++) if (have.indexOf(q.use[i]) >= 0) { pick = q.use[i]; break; }
    var plan, why;
    if (pick) {
      var node = q.only ? 'Index Only Scan' : 'Index Scan';
      plan = node + ' using ' + pick + ' on orders\n  Index Cond: ' + q.cond;
      if (pick === 'idx_status' && q.sql.indexOf('created_at') >= 0) plan = 'Index Scan using idx_status on orders\n  Index Cond: (status = \'CANCELED\')\n  Filter: (created_at > \'2026-03-01\')';
      why = q.why.hit;
    } else {
      plan = 'Seq Scan on orders\n  Filter: (' + q.sql.replace(/\s+\(.*\)$/, '') + ')';
      why = q.why.miss;
      if (q.use.length === 0 && have.length) why += ' (만들어 둔 인덱스가 있어도 마찬가지예요)';
    }
    document.getElementById('plan').textContent = plan;
    document.getElementById('why').textContent = why;
  }
  qSel.addEventListener('change', renderLab);
  idxBox.addEventListener('change', renderLab);
  renderLab();

  var quiz = [
    { q: "created_at에 인덱스가 있다. WHERE created_at::date = '2026-06-01'은?", o: ['인덱스를 쓴다', '컬럼을 변환해서 인덱스를 못 쓴다'], a: 1, e: "범위 조건(created_at >= '2026-06-01' AND created_at < '2026-06-02')으로 바꾸면 써요." },
    { q: '복합 인덱스 (status, created_at)가 있을 때 인덱스를 효율적으로 쓰는 조건은?', o: ['created_at > ?', "status = ? AND created_at > ?", 'created_at = ? OR status = ?'], a: 1, e: '선두 컬럼부터 차례로 조건이 있어야 해요.' },
    { q: 'EXPLAIN과 EXPLAIN ANALYZE의 차이는?', o: ['같다', 'ANALYZE는 실제로 실행해서 실제 시간과 행 수를 보여준다'], a: 1, e: 'UPDATE·DELETE에 ANALYZE를 쓰면 실제로 바뀌니 트랜잭션 안에서 롤백해요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('ix-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('ix-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
