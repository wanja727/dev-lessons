    .pc-grid, .traps { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var pred = { p1: store('pc-p1'), p2: store('pc-p2'), p3: store('pc-p3') };
  var msg = document.getElementById('predict-msg');
  function showPred() {
    if (!pred.p1 && !pred.p2) return;
    msg.textContent = '내 예측: SELECT ' + (pred.p1 ? pred.p1 + '번' : '?') + ', 제목 ' + (pred.p2 === 'yes' ? '바뀐다' : pred.p2 === 'no' ? '그대로다' : '?') + (pred.p3 ? ' (' + pred.p3 + ')' : '') + '. 정답은 SELECT 1번, 제목은 바뀐다예요. 3장에서 이유를 확인해 보세요.';
  }
  ['p1', 'p2', 'p3'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('pc-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 생명주기 */
  var lc = null;
  var lcText = {
    new: ['비영속이에요. JPA는 이 객체를 몰라요.', '제목을 바꿔도 DB와는 아무 관계가 없어요.'],
    managed: ['영속이에요. 1차 캐시에 들어가고 스냅샷이 생겼어요.', '제목을 바꾸면 flush 때 변경 감지로 UPDATE가 나가요.'],
    detached: ['준영속이에요. 영속성 컨텍스트가 더 이상 관리하지 않아요.', '제목을 바꿔도 반영되지 않아요. 다시 반영하려면 merge하거나, 새로 조회해서 바꿔야 해요.'],
    removed: ['삭제 상태예요. flush 때 DELETE가 나가요.', '커밋하면 DB에서 지워져요.']
  };
  var allowed = {
    null: ['new', 'find'], new: ['new', 'persist'], managed: ['new', 'detach', 'clear', 'remove'],
    detached: ['new', 'merge', 'find'], removed: ['new', 'persist']
  };
  var lcNotes = {
    new: 'new Book("JPA 입문"): 객체만 만들었어요.',
    persist: 'em.persist(): 영속성 컨텍스트에 넣었어요. (SEQUENCE면 INSERT는 flush 때)',
    find: 'em.find(): DB에서 읽어 1차 캐시에 넣었어요.',
    detach: 'em.detach(): 이 엔티티만 관리 대상에서 뺐어요.',
    clear: '트랜잭션이 끝나 영속성 컨텍스트가 닫혔어요. 그 안의 엔티티는 모두 준영속이 돼요.',
    merge: 'em.merge(): 준영속 객체의 값을 복사한 영속 객체를 돌려줘요. 넘긴 객체 자체는 여전히 준영속이니, 돌려받은 객체를 써야 해요.',
    remove: 'em.remove(): 삭제 예정으로 표시했어요.'
  };
  var nextState = { new: 'new', persist: 'managed', find: 'managed', detach: 'detached', clear: 'detached', merge: 'managed', remove: 'removed' };
  var lcActions = document.getElementById('lc-actions');
  function renderLc() {
    document.querySelectorAll('#states .state').forEach(function (s) { s.classList.toggle('on', s.dataset.s === lc); });
    lcActions.querySelectorAll('button').forEach(function (b) { b.disabled = allowed[lc].indexOf(b.dataset.a) < 0; });
    var t = lc ? lcText[lc] : ['아직 엔티티가 없어요. new Book()이나 em.find()로 시작해 보세요.', '상태를 고르면 "이 상태에서 제목을 바꾸면?"의 답이 여기 나와요.'];
    document.getElementById('lc-change').innerHTML = '<strong>이 상태에서 제목을 바꾸면?</strong> ' + esc(t[1]);
    if (!lc) document.getElementById('lc-note').textContent = t[0];
  }
  lcActions.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-a]'); if (!b || b.disabled) return;
    lc = nextState[b.dataset.a];
    document.getElementById('lc-note').textContent = lcNotes[b.dataset.a] + ' → ' + lcText[lc][0];
    renderLc();
  });
  renderLc();

  /* 3. 시뮬레이터 */
  var S;
  function fresh() {
    S = { strategy: S ? S.strategy : 'SEQUENCE', db: [{ id: 1, title: 'JPA 입문' }, { id: 2, title: '스프링 핵심' }], cache: [], queue: [], log: [], q: 0, nextId: 3 };
  }
  function cached(id) { for (var i = 0; i < S.cache.length; i++) if (S.cache[i].id === id) return S.cache[i]; return null; }
  function dbRow(id) { for (var i = 0; i < S.db.length; i++) if (S.db[i].id === id) return S.db[i]; return null; }
  function sql(text) { S.q++; S.log.push({ n: S.q, t: text }); }
  function lognote(text) { S.log.push({ note: text }); }
  function applyToDb(item) {
    if (item.type === 'insert') S.db.push({ id: item.id, title: item.title });
    if (item.type === 'update') dbRow(item.id).title = item.title;
  }
  function dirtyCheck() {
    S.cache.forEach(function (e) {
      if (e.snapshot !== null && e.title !== e.snapshot) S.queue.push({ type: 'update', id: e.id, title: e.title, sql: "update book set title = '" + e.title + "' where id = " + e.id });
    });
  }
  function doFlush() {
    dirtyCheck();
    var n = S.queue.length;
    S.queue.forEach(function (item) { sql(item.sql); applyToDb(item); });
    S.queue = [];
    S.cache.forEach(function (e) { e.snapshot = e.title; });
    return n;
  }
  var note = document.getElementById('pc-note');
  var actions = {
    find1: function () { return find(1); },
    find2: function () { return find(2); },
    rename: function () {
      var e = cached(1);
      if (!e) return '1번 책이 영속성 컨텍스트에 없어요. 먼저 find(1)을 눌러 보세요. 영속 상태가 아니면 바꿔도 반영되지 않아요.';
      e.title = e.title.indexOf(' 2판') > 0 ? e.title.replace(' 2판', '') : e.title + ' 2판';
      return '객체의 값만 바뀌었어요. SQL은 아직 없어요. flush 때 스냅샷과 비교해서 달라진 걸 찾아요.';
    },
    persist: function () {
      var id = S.nextId++, title = '새 책 ' + id;
      var ins = { type: 'insert', id: id, title: title, sql: "insert into book (title, id) values ('" + title + "', " + id + ')' };
      if (S.strategy === 'IDENTITY') {
        sql("insert into book (title) values ('" + title + "') returning id");
        applyToDb(ins);
        S.cache.push({ id: id, title: title, snapshot: title });
        return 'IDENTITY는 DB가 id를 만들어서, 영속 상태가 되려면 바로 INSERT해야 해요. 쓰기 지연이 안 돼요.';
      }
      S.queue.push(ins);
      S.cache.push({ id: id, title: title, snapshot: title });
      return 'INSERT를 바로 보내지 않고 쓰기 지연 SQL 저장소에 넣었어요. 1차 캐시에는 이미 들어 있어요.';
    },
    jpql: function () {
      dirtyCheck();
      var hasPending = S.queue.length > 0;
      if (hasPending) lognote('-- JPQL 실행 전 자동 flush');
      var flushed = hasPending ? doFlush() : 0;
      sql('select * from book');
      var reused = 0;
      S.db.forEach(function (r) { if (cached(r.id)) reused++; else S.cache.push({ id: r.id, title: r.title, snapshot: r.title }); });
      return (flushed ? '조회 전에 자동으로 flush해서 ' + flushed + '개의 SQL을 먼저 보냈어요. ' : '') + 'JPQL은 1차 캐시를 보지 않고 SQL을 보내요.' + (reused ? ' 이미 캐시에 있던 ' + reused + '권은 캐시의 객체를 그대로 돌려줘요.' : '');
    },
    flush: function () {
      var n = doFlush();
      return n ? 'flush: 바뀐 엔티티를 찾아 UPDATE를 만들고, 모아 둔 SQL ' + n + '개를 보냈어요. 트랜잭션은 아직 열려 있어요.' : '보낼 SQL이 없어요. 바뀐 엔티티도, 모아 둔 SQL도 없어요.';
    },
    commit: function () {
      var n = doFlush();
      lognote('-- commit');
      S.cache = [];
      return '커밋 직전에 flush해서 SQL ' + n + '개를 보내고 커밋했어요. 트랜잭션이 끝나 영속성 컨텍스트도 비었어요.';
    },
    clear: function () {
      dirtyCheck();
      var lost = S.queue.length;
      S.queue = []; S.cache = [];
      return lost ? 'clear()는 flush하지 않은 변경 ' + lost + '건을 버려요. DB에는 반영되지 않아요.' : '1차 캐시를 비웠어요. 이제 find하면 다시 SELECT가 나가요.';
    },
    reset: function () { fresh(); return '처음 상태예요. DB에 책 두 권이 있고, 영속성 컨텍스트는 비어 있어요.'; }
  };
  function find(id) {
    if (cached(id)) return 'find(' + id + '): 1차 캐시에 있어서 SQL 없이 같은 객체를 돌려줬어요.';
    var r = dbRow(id);
    sql('select * from book where id = ' + id);
    if (!r) return 'DB에 없는 책이에요.';
    S.cache.push({ id: id, title: r.title, snapshot: r.title });
    return 'find(' + id + '): 1차 캐시에 없어서 SELECT를 보내고, 결과를 1차 캐시에 넣고 스냅샷을 찍었어요.';
  }
  function renderPc() {
    var c = document.getElementById('cache');
    c.innerHTML = S.cache.length ? S.cache.map(function (e) {
      var d = e.snapshot !== null && e.title !== e.snapshot;
      return '<tr><td>' + e.id + '</td><td class="' + (d ? 'diff' : '') + '">' + esc(e.title) + '</td><td>' + esc(e.snapshot) + '</td></tr>';
    }).join('') : '<tr><td class="empty" colspan="3">비어 있음</td></tr>';
    var q = document.getElementById('queue');
    q.innerHTML = S.queue.length ? S.queue.map(function (i) { return '<div>' + esc(i.sql) + '</div>'; }).join('') : '<div class="empty">비어 있음</div>';
    document.getElementById('db').innerHTML = S.db.map(function (r) { return '<tr><td>' + r.id + '</td><td>' + esc(r.title) + '</td></tr>'; }).join('');
    var l = document.getElementById('pc-log');
    l.innerHTML = S.log.length ? S.log.map(function (x) {
      return x.note ? '<div class="row note">' + esc(x.note) + '</div>' : '<div class="row"><span class="n">' + x.n + '</span><span>' + esc(x.t) + '</span></div>';
    }).join('') : '<div class="empty">아직 SQL이 없어요</div>';
    document.getElementById('sql-count').textContent = S.q + '번';
  }
  document.getElementById('pc-actions').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-a]'); if (!b) return;
    note.textContent = actions[b.dataset.a]();
    renderPc();
  });
  pressGroup(document.getElementById('strategy'), function (v) { S.strategy = v; fresh(); note.textContent = v + ' 전략으로 바꾸고 처음 상태로 돌렸어요.'; renderPc(); });
  fresh(); note.textContent = actions.reset(); renderPc();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '트랜잭션 안에서 findById(1)을 두 번 하고, 그 사이에 JPQL로 id가 1인 책을 한 번 조회했어요. SELECT는 몇 번?', o: ['1번', '2번', '3번'], a: 1, e: 'find는 1차 캐시를 쓰지만 JPQL은 항상 SQL을 보내요. 처음 find 1번 + JPQL 1번 = 2번. 두 번째 find는 캐시에서 꺼내요.' },
    { q: 'IDENTITY 전략 엔티티를 persist한 직후, flush 전에 INSERT는?', o: ['이미 나갔다', '아직 안 나갔다'], a: 0, e: 'IDENTITY는 id를 DB가 만들어서, 영속 상태가 되려면 바로 INSERT해야 해요.' },
    { q: 'em.detach(book) 후 제목을 바꾸고 커밋하면 UPDATE는?', o: ['나간다', '나가지 않는다'], a: 1, e: '준영속 엔티티는 변경 감지 대상이 아니에요. 스냅샷과 비교하지 않아요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('pc-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('pc-answer', ans.value); syncBtn(); });
  syncBtn();
