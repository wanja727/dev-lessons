---
import Base from '../../layouts/Base.astro';
import CiOutput from '../../components/CiOutput.astro';
import CoreQuestionKit from '../../components/CoreQuestionKit.astro';
import RunLocally from '../../components/RunLocally.astro';
import '../../styles/lesson.css';
import '../../styles/retrievo-theme.css';
import '../../styles/core-question.css';
import { highlight } from '../../lib/highlight';

// 이 레슨은 "핵심 질문" 네 개를 뼈대로 쓴다. 장 하나가 질문 하나에 답하고, 장의 첫머리에 결론을 둔다.
// 문제 파일(content/questions/connection-pool.yaml)의 모든 문제는 이 네 질문 중 하나에 연결된다.
// 숫자는 ConnectionPoolTest와 같다: 풀 크기 2, 기다리는 최대 시간 500ms에서 세 번째 요청이 실패한다.
const test = 'https://github.com/wanja727/dev-lessons/blob/main/verification/src/test/java/lab/devlessons/connpool/ConnectionPoolTest.java';

// 코드는 한 줄이 44자를 넘지 않게 쓴다
const codePredict = `// 풀이 가진 연결은 2개
try (Connection conn =
         dataSource.getConnection()) {
    // 오래 걸리는 SQL 실행
}`;

const codeRaw = `try (Connection conn =
         [[DriverManager.getConnection(url)]]) {
    // SQL 실행
}`;

const codePool = `try (Connection conn =
         [[dataSource.getConnection()]]) {
    // SQL 실행
[[}]]`;

const codeWait = `// 풀이 가진 연결은 2개
try (Connection conn =
         [[dataSource.getConnection()]]) {
    // 오래 걸리는 SQL 실행
}`;

const codeConfig = `# application.yml
spring:
  datasource:
    hikari:
      [[maximum-pool-size: 10]]
      [[connection-timeout: 30000]]`;

const codeTx = `@Transactional
void checkout(Long id) {
    Order o = orders.findById(id);
    Receipt r = [[paymentApi.pay(o)]];
    o.markPaid(r);
}`;

const codeTxFix = `void checkout(Long id) {
    Order o = orderService.find(id);
    Receipt r = paymentApi.pay(o);
    [[orderService.markPaid(id, r)]];
}`;

// 검증 테스트 하나를 그대로 보여 준다 (ConnectionPoolTest.closeReturnsToPool)
const codeTest = `@Test
void closeReturnsToPool() {
    // 연결이 1개뿐인 풀
    int first, second;
    try (var c = pool.getConnection()) {
        first = [[backendPid(c)]];
    }
    try (var c = pool.getConnection()) {
        second = [[backendPid(c)]];
    }
    // 같은 연결을 다시 받았는지 확인
    assertThat(second).isEqualTo(first);
}`;
---
<Base theme="soft pastel" title="DB 커넥션과 커넥션 풀 · Dev Lessons" description="커넥션을 매번 새로 만들면 왜 안 되는지, 커넥션 풀이 어떻게 동작하는지, 연결이 모두 쓰이고 있으면 어떻게 되는지, 트랜잭션이 연결을 얼마나 오래 쥐는지. 네 가지 질문에 스스로 답할 수 있게 만드는 대화형 레슨.">
<link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;700&display=swap" />
<style is:global>
.slots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.slot { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.slot.busy { border-color: var(--accent); background: var(--accent-soft); }
.slot .who { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
.slot .state { font-weight: 600; font-size: 15px; }
.sliders { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; }
.sliders label { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
.sliders label b { font-family: var(--font-mono); font-weight: 500; }
.sliders input { width: 100%; }
.legend { display: flex; gap: 14px; align-items: center; font-size: 13px; color: var(--muted); flex-wrap: wrap; }
.legend span { display: inline-flex; align-items: center; gap: 5px; }
.sw { display: inline-block; width: 14px; height: 10px; border-radius: 2px; }
.sw.wait, .g-wait { background: repeating-linear-gradient(45deg, var(--muted), var(--muted) 2px, transparent 2px, transparent 5px); }
.sw.hold, .g-hold { background: var(--accent); }
.sw.fail, .g-fail { background: var(--query); }
.sw.api, .g-api { background: var(--query); opacity: 0.55; }
.gantt { display: flex; flex-direction: column; gap: 4px; }
.g-row { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 6px; align-items: center; font-size: 12px; font-family: var(--font-mono); }
.g-track { position: relative; height: 16px; background: var(--code-bg); border-radius: 4px; overflow: hidden; }
.g-track span { position: absolute; top: 2px; bottom: 2px; border-radius: 3px; }
.g-axis { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-left: 58px; }
@media (max-width: 520px) { .sliders, .slots { grid-template-columns: minmax(0, 1fr); } }
</style>
<CoreQuestionKit />
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="meta"><span class="m-unit">DB</span><span class="m-time">약 20분</span><span class="m-pre">먼저 배울 레슨 <a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a></span></p>
    <h1>DB 커넥션과 커넥션 풀</h1>
    <p class="lede">이 레슨을 마치면 아래 네 질문에 자료를 보지 않고 답할 수 있어요. 장 하나가 질문 하나에 답해요.</p>
    <ol class="goals">
      <li><a href="#q1">커넥션은 무엇이고, 왜 매번 새로 만들면 안 되나요?</a></li>
      <li><a href="#q2">커넥션 풀은 어떻게 동작하나요?</a></li>
      <li><a href="#q3">풀의 연결이 모두 쓰이고 있으면 다음 요청은 어떻게 되나요?</a></li>
      <li><a href="#q4">트랜잭션은 연결을 얼마나 오래 쥐고 있나요?</a></li>
    </ol>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> SQL 기초, 트랜잭션의 커밋과 롤백(<a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>), 자바의 try-with-resources. 풀은 스프링 부트가 기본으로 쓰는 HikariCP, DB는 PostgreSQL 16이에요.</p>
  </header>

  <!-- 예측 -->
  <section id="predict" class="read">
    <p class="eyebrow">먼저 예측해 보기</p>
    <h2>연결이 남아 있지 않으면 세 번째 요청은 어떻게 될까요?</h2>
    <p>아래 코드는 풀에서 DB 연결을 하나 빌려 SQL을 실행해요. 풀이 가진 연결은 2개뿐이에요. 요청 두 개가 연결을 하나씩 빌려 오래 걸리는 SQL을 실행하는 중에, 세 번째 요청이 같은 코드를 실행했어요. 모르는 게 정상이니 감으로 골라 보세요. 답은 질문 3에서 확인해요.</p>
    <pre set:html={highlight(codePredict)} />
    <div class="panel">
      <span class="label">세 번째 요청은</span>
      <div class="choice-row" id="predict-opts">
        <button class="chip" type="button" data-v="more" aria-pressed="false">연결을 하나 더 만들어 받는다</button>
        <button class="chip" type="button" data-v="fail" aria-pressed="false">바로 실패한다</button>
        <button class="chip" type="button" data-v="wait" aria-pressed="false">기다리다가, 정해진 시간이 지나면 실패한다</button>
      </div>
    </div>
  </section>

  <!-- 질문 1 -->
  <section id="q1">
    <div class="read stack">
      <p class="eyebrow">질문 1</p>
      <h2>커넥션은 무엇이고, 왜 매번 새로 만들면 안 되나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">커넥션은 프로그램과 DB 서버 사이에 열린 통신 통로예요. 만드는 데 드는 비용이 커서 매번 새로 만들면 느려요.</p>
        <p class="sub">연결 하나를 만들려면 네트워크 접속, 인증, DB 서버의 준비가 필요해요. DB 서버가 동시에 받을 수 있는 연결 수에도 한계가 있어요.</p>
      </div>
      <p>프로그램이 DB에 SQL을 보내고 결과를 받는 일은 모두 <strong>커넥션</strong>(연결)을 통해서 해요. 풀을 쓰지 않으면 요청마다 연결을 새로 만들어야 해요.</p>
      <pre set:html={highlight(codeRaw)} />
      <ul class="code-note"><li><mark class="hl" set:html={highlight('DriverManager.getConnection(url)')} /> DB 서버에 새로 접속해서 연결을 만들어요. try 블록이 끝나면 그 연결을 끊어요.</li></ul>
      <p>연결 하나를 새로 만들 때는 세 가지 일이 일어나요.</p>
      <ol style="margin:0;padding-left:22px">
        <li>네트워크로 DB 서버에 접속해요.</li>
        <li>아이디와 비밀번호로 인증해요.</li>
        <li>DB 서버가 이 연결을 맡을 준비를 해요. PostgreSQL은 연결마다 서버 프로세스를 하나씩 띄워요.</li>
      </ol>
      <p>아래에서 방식을 고르고 요청을 여러 번 처리해 보세요. 요청마다 무슨 일을 하는지, 연결을 몇 번 새로 만드는지 세어 봐요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">방식</span>
        <div class="seg" id="c1-mode">
          <button type="button" data-v="raw" aria-pressed="true">요청마다 새로 연결</button>
          <button type="button" data-v="pool" aria-pressed="false">풀에서 빌리기</button>
        </div>
      </div>
      <div class="btn-row"><button class="btn primary" type="button" id="c1-run">요청 하나 처리하기</button><button class="btn" type="button" id="c1-reset">처음으로</button></div>
      <div class="duo">
        <div class="cell"><span class="label">처리한 요청</span><div class="kv"><span>요청 수</span><b id="c1-req">0</b></div></div>
        <div class="cell"><span class="label">새로 만든 연결</span><div class="kv"><span>접속, 인증, 준비</span><b id="c1-new">0</b></div></div>
      </div>
      <div class="log" id="c1-log" aria-live="polite"></div>
      <p id="c1-msg" class="verdict" hidden></p>
    </div>
    <div class="read stack">
      <p>요청마다 새로 연결하면 SQL 한 번을 보내려고 접속, 인증, 준비를 매번 다시 해요. 얼마나 차이 나는지 실제로 재 봤어요. 연결을 새로 만들어 SELECT 한 번 하는 시간과, 풀에서 빌려 SELECT 한 번 하는 시간을 20번씩 재서 평균을 낸 값이에요.</p>
      <CiOutput lesson="connection-pool" key="timing" label="실제로 잰 시간 보기" source="ConnectionPoolTest.newConnectionIsSlowerThanPooled" />
      <p>연결을 무한정 만들 수도 없어요. DB 서버가 동시에 받을 수 있는 연결 수에는 한계가 있고, PostgreSQL의 기본값은 100개예요.</p>
      <div class="panel quiz" data-quiz="q1"></div>
      <p class="next"><strong>다음 질문:</strong> 연결을 만드는 일이 비싸다면, 한 번 만든 연결을 끊지 않고 계속 쓰면 되지 않을까요?</p>
    </div>
  </section>

  <!-- 질문 2 -->
  <section id="q2">
    <div class="read stack">
      <p class="eyebrow">질문 2</p>
      <h2>커넥션 풀은 어떻게 동작하나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">연결을 미리 만들어 두고, 요청마다 빌려주고 돌려받아요.</p>
        <p class="sub">풀에서 빌린 연결의 close()는 연결을 끊지 않고 풀에 반납해요. 반납된 연결은 다음 요청이 다시 써요.</p>
      </div>
      <p><strong>커넥션 풀</strong>은 연결을 정해진 개수만큼 가지고 있다가 필요한 요청에 빌려줘요. 스프링 부트는 <strong>HikariCP</strong>라는 풀을 기본으로 쓰고, <code>dataSource</code>로 꺼내 쓸 수 있게 해 줘요.</p>
      <pre set:html={highlight(codePool)} />
      <ul class="code-note">
        <li><mark class="hl" set:html={highlight('dataSource.getConnection()')} /> 연결을 새로 만들지 않고 풀에서 하나 빌려요.</li>
        <li><mark class="hl">&#125;</mark> try 블록이 끝나면 <code>close()</code>가 자동으로 불려요. 풀에서 빌린 연결은 이때 끊기지 않고 풀로 돌아가요.</li>
      </ul>
      <p>코드는 풀이 없을 때와 거의 같아요. 달라진 것은 <code>close()</code>의 뜻이에요. 아래는 연결 2개를 가진 풀이에요. 빌리고 반납하기를 반복해 보세요. 연결 옆의 번호는 그 연결을 맡은 DB 서버 프로세스의 번호예요.</p>
    </div>
    <div class="panel">
      <div class="slots" id="c2-slots"></div>
      <div class="btn-row"><button class="btn primary" type="button" id="c2-borrow">빌리기 getConnection()</button><button class="btn" type="button" id="c2-reset">처음으로</button></div>
      <div class="count-line"><span class="label">DB 서버에 열려 있는 연결</span><span class="mono" style="font-weight:500">2개 그대로</span></div>
      <div class="log" id="c2-log" aria-live="polite"></div>
      <p id="c2-msg" class="verdict" hidden></p>
    </div>
    <div class="read stack">
      <p>반납한 뒤에 다시 빌리면 같은 번호의 연결이 나와요. 새로 만든 것이 아니라 풀에 돌아와 있던 연결을 다시 쓰는 거예요. 실제 PostgreSQL에서도 서버 프로세스 번호가 같은지 확인했어요.</p>
      <CiOutput lesson="connection-pool" key="reuse" label="반납한 뒤 다시 빌린 실제 결과 보기" source="ConnectionPoolTest.closeReturnsToPool" />
      <p>그래서 빌린 연결은 꼭 <code>close()</code>해야 해요. 반납하지 않은 연결은 다른 요청이 쓸 수 없어요. try-with-resources를 쓰거나, 스프링의 <code>JdbcTemplate</code>이나 JPA처럼 빌리고 반납하는 일을 대신 해 주는 도구를 써요.</p>
      <div class="panel quiz" data-quiz="q2"></div>
      <p class="next"><strong>다음 질문:</strong> 위에서 연결 2개를 모두 빌리면 빌리기 버튼이 눌리지 않았어요. 실제 풀에서는 그때 온 요청이 어떻게 될까요?</p>
    </div>
  </section>

  <!-- 질문 3 -->
  <section id="q3">
    <div class="read stack">
      <p class="eyebrow">질문 3</p>
      <h2>풀의 연결이 모두 쓰이고 있으면 다음 요청은 어떻게 되나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">연결이 반납될 때까지 기다려요. 정해진 시간 안에 받지 못하면 예외로 실패해요.</p>
        <p class="sub">풀은 최대 크기를 넘겨 연결을 더 만들지 않아요. 기다리는 동안 누군가 반납하면 그 연결을 바로 받아요.</p>
      </div>
      <p>처음 예측의 답은 <strong>기다리다가, 정해진 시간이 지나면 실패한다</strong>예요. <span id="predict-result" class="muted"></span></p>
      <pre set:html={highlight(codeWait)} />
      <ul class="code-note"><li><mark class="hl" set:html={highlight('dataSource.getConnection()')} /> 빌려줄 연결이 없으면 이 줄에서 멈춰서 기다려요.</li></ul>
      <p>풀의 크기와 기다리는 최대 시간은 설정으로 정해요. 아래는 HikariCP의 기본값이에요.</p>
      <pre set:html={highlight(codeConfig)} />
      <ul class="code-note">
        <li><mark class="hl">maximum-pool-size: 10</mark> 풀이 가질 수 있는 연결의 최대 개수예요.</li>
        <li><mark class="hl">connection-timeout: 30000</mark> 연결을 기다리는 최대 시간이에요. 단위는 밀리초라 30초예요.</li>
      </ul>
      <p>아래는 요청이 0.1초 간격으로 들어와서 각자 연결을 하나씩 쓰고 반납하는 모습이에요. 처음 값은 예측한 상황과 같아요. 값을 바꿔 가며 누가 기다리고 누가 실패하는지 보세요.</p>
    </div>
    <div class="panel">
      <div class="sliders">
        <label>풀 크기 <b id="v-pool"></b><input type="range" id="s-pool" min="1" max="6" value="2"></label>
        <label>요청 수 <b id="v-req"></b><input type="range" id="s-req" min="2" max="10" value="3"></label>
        <label>요청 하나가 연결을 쓰는 시간 <b id="v-hold"></b><input type="range" id="s-hold" min="200" max="2000" step="100" value="1000"></label>
        <label>기다리는 최대 시간 <b id="v-timeout"></b><input type="range" id="s-timeout" min="100" max="2000" step="100" value="500"></label>
      </div>
      <div class="legend"><span><i class="sw wait"></i>기다림</span><span><i class="sw hold"></i>연결 사용</span><span><i class="sw fail"></i>실패</span></div>
      <div class="gantt" id="gantt" aria-hidden="true"></div>
      <p class="verdict" id="sim-text" aria-live="polite"></p>
    </div>
    <div class="read stack">
      <p>같은 상황을 실제 HikariCP로 돌린 결과예요. 풀 크기 2, 기다리는 최대 시간 500ms에서 세 번째 요청이 받은 예외 메시지를 볼 수 있어요.</p>
      <CiOutput lesson="connection-pool" key="timeout" label="세 번째 요청의 실제 결과 보기" source="ConnectionPoolTest.exhaustedPoolTimesOut" />
      <p>실패한 요청이 받는 예외는 <code>SQLTransientConnectionException</code>이에요. 메시지는 "Connection is not available, request timed out"으로 시작해요. 이 메시지를 봤다면 DB가 느린 것이 아니라 <strong>풀에 빌려줄 연결이 없었다</strong>는 뜻이에요.</p>
      <details class="more">
        <summary>더 알아보기: 풀을 크게 잡으면 되지 않나요?</summary>
        <p>풀을 키우면 기다림은 줄지만, DB 서버가 받을 수 있는 연결 수와 자원에는 한계가 있어요. 풀 크기를 어떻게 정하는지는 <a href="/dev-lessons/lessons/pool-sizing/">커넥션 풀과 톰캣 스레드 풀 크기</a> 레슨에서 다뤄요.</p>
      </details>
      <div class="panel quiz" data-quiz="q3"></div>
      <p class="next"><strong>다음 질문:</strong> 연결을 오래 쥐고 있을수록 다른 요청이 기다리게 돼요. 그러면 요청 하나는 연결을 얼마나 오래 쥐고 있을까요?</p>
    </div>
  </section>

  <!-- 질문 4 -->
  <section id="q4">
    <div class="read stack">
      <p class="eyebrow">질문 4</p>
      <h2>트랜잭션은 연결을 얼마나 오래 쥐고 있나요?</h2>
      <div class="answer">
        <span class="label">결론</span>
        <p class="lead">트랜잭션이 끝날 때까지 연결 하나를 쥐고 있어요.</p>
        <p class="sub">커밋이나 롤백을 해야 연결이 풀로 돌아가요. 그래서 트랜잭션 안에 느린 작업이 있으면 그동안 연결을 붙잡아요.</p>
      </div>
      <p>트랜잭션은 연결 하나 위에서 진행돼요. <a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>에서 "연결 A의 커밋 전 변경은 연결 B에 보이지 않는다"고 했던 그 연결이에요. 트랜잭션이 진행되는 동안에는 그 연결을 다른 요청에 빌려줄 수 없어요.</p>
      <p>아래는 주문을 조회하고, 외부 결제 서버를 부르고, 결제 결과를 저장하는 코드예요.</p>
      <pre set:html={highlight(codeTx)} />
      <ul class="code-note"><li><mark class="hl" set:html={highlight('paymentApi.pay(o)')} /> 다른 회사의 결제 서버를 부르는 줄이에요. 응답에 몇 초가 걸릴 수 있어요. 그동안 DB에 보내는 SQL은 없지만 연결은 쥔 채예요.</li></ul>
      <p>결제 서버의 응답에 3초가 걸리고, SQL은 한 번에 0.05초가 걸린다고 해 볼게요. 결제 호출이 트랜잭션 안에 있을 때와 밖에 있을 때, 요청 하나가 연결을 쥐는 시간을 비교해 보세요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">결제 서버 호출의 위치</span>
        <div class="seg" id="c4-mode">
          <button type="button" data-v="in" aria-pressed="true">트랜잭션 안</button>
          <button type="button" data-v="out" aria-pressed="false">트랜잭션 밖</button>
        </div>
      </div>
      <div class="legend"><span><i class="sw hold"></i>연결을 쥐고 SQL 실행</span><span><i class="sw api"></i>결제 서버 응답을 기다림</span></div>
      <div class="gantt" id="c4-gantt" aria-hidden="true"></div>
      <div class="duo">
        <div class="cell"><span class="label">요청 하나가 연결을 쥐는 시간</span><div class="kv"><span>초</span><b id="c4-hold"></b></div></div>
        <div class="cell"><span class="label">연결 10개로 1초에 처리할 수 있는 주문</span><div class="kv"><span>건</span><b id="c4-rate"></b></div></div>
      </div>
      <p class="verdict" id="c4-msg" aria-live="polite"></p>
    </div>
    <div class="read stack">
      <p>결제 호출이 트랜잭션 안에 있으면 DB는 한가한데도 풀의 연결이 모자라요. 요청이 조금만 몰려도 질문 3의 기다림과 실패가 생겨요. 고치는 방법은 느린 호출을 트랜잭션 밖으로 빼고, DB에 저장하는 부분만 짧은 트랜잭션으로 묶는 거예요.</p>
      <pre set:html={highlight(codeTxFix)} />
      <ul class="code-note"><li><mark class="hl" set:html={highlight('orderService.markPaid(id, r)')} /> 결제 결과를 저장하는 메서드예요. <code>checkout</code>에서는 <code>@Transactional</code>을 떼고 이 메서드에만 붙여요. 결제 서버를 기다리는 동안에는 연결을 쥐지 않아요.</li></ul>
      <p>트랜잭션이 연결을 쥐고 있다가 끝나면 돌려준다는 것은 테스트로 확인했어요. 스프링 트랜잭션 안에서 SQL을 보낸 직후에 풀에서 쓰이고 있는 연결은 1개였고, 트랜잭션이 끝난 뒤에는 0개였어요.</p>
      <details class="more">
        <summary>더 알아보기: 연결을 요청 끝까지 쥐게 하는 설정</summary>
        <p>스프링 부트의 기본 설정에는 트랜잭션이 끝난 뒤에도 요청이 끝날 때까지 연결을 쥐게 할 수 있는 것이 있어요. <a href="/dev-lessons/lessons/osiv/">OSIV</a> 레슨에서 다뤄요.</p>
      </details>
      <div class="panel quiz" data-quiz="q4"></div>
    </div>
  </section>

  <!-- 보지 않고 답하기 -->
  <section id="recall" class="read">
    <p class="eyebrow">보지 않고 답하기</p>
    <h2>네 질문에 직접 답해 보세요</h2>
    <p>위로 올라가지 말고, 질문마다 소리 내어 말하거나 머릿속으로 먼저 답해 보세요. 그다음에 모범 답을 열어 비교해요. 읽을 때 안다고 느낀 것과 꺼낼 수 있는 것은 달라요.</p>
    <div class="panel" id="recall-list"></div>

    <h3 style="margin-top:12px">면접 질문: "커넥션 풀을 왜 쓰나요?"</h3>
    <p>네 답을 하나로 이어서, 1분 안에 말해 보세요. 정의 → 원리 → 주의할 점 → 내 경험 순서예요. 말해 본 뒤에 모범 답을 열어요.</p>
    <div><button class="btn primary" type="button" id="model-btn">모범 답 보기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>커넥션 풀은 DB 연결을 미리 만들어 두고 요청마다 빌려주고 돌려받는 구조입니다. 스프링 부트는 HikariCP를 기본으로 쓰고, 기본 최대 크기는 10입니다.</dd>
        <dt>원리</dt><dd>연결을 새로 만들려면 네트워크 접속, 인증, DB 서버의 준비가 필요해서 비용이 큽니다. 풀에서 빌린 연결의 close()는 끊지 않고 반납이라 다음 요청이 같은 연결을 다시 씁니다. 연결이 모두 쓰이고 있으면 다음 요청은 기다리고, 정해진 시간 안에 받지 못하면 예외로 실패합니다.</dd>
        <dt>주의할 점</dt><dd>트랜잭션은 끝날 때까지 연결 하나를 쥐고 있습니다. 트랜잭션 안에서 외부 API처럼 느린 작업을 하면 DB는 한가해도 풀이 모자라므로, 느린 작업은 트랜잭션 밖으로 빼고 트랜잭션을 짧게 둡니다.</dd>
        <dt>경험</dt><dd>(내 프로젝트로 채우기) 예: 연결 대기 타임아웃의 원인이 트랜잭션 안의 외부 API 호출인 것을 찾아, 호출을 트랜잭션 밖으로 옮겼습니다.</dd>
      </dl>
    </div>
  </section>

  <section class="read" id="verified">
    <details class="more">
      <summary>이 레슨의 내용은 어떻게 확인했나요? (검증 테스트)</summary>
      <div class="stack" style="padding-top:6px">
        <p>이 레슨에 나온 동작은 짐작이 아니라, 실제 PostgreSQL 16과 HikariCP에서 코드를 돌려 확인했어요. 테스트(<a href={test}>ConnectionPoolTest</a>)는 아래 상황마다 결과를 확인해요.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>상황</th><th>확인한 결과</th></tr></thead>
            <tbody>
              <tr><td>연결을 새로 만들어 SELECT 한 번, 풀에서 빌려 SELECT 한 번을 20번씩 잰다</td><td>새로 만드는 쪽이 더 오래 걸린다</td></tr>
              <tr><td>연결이 1개인 풀에서 빌리고, 반납하고, 다시 빌린다</td><td>두 번 모두 같은 서버 프로세스 번호</td></tr>
              <tr><td>연결 2개를 동시에 쥔다</td><td>서버 프로세스 번호가 서로 다르다</td></tr>
              <tr><td>풀 크기 2, 기다리는 최대 시간 500ms에서 세 번째로 빌린다</td><td>450ms 넘게 기다린 뒤 SQLTransientConnectionException</td></tr>
              <tr><td>연결이 1개인 풀에서 기다리는 중에 앞 요청이 반납한다</td><td>기다리던 요청이 그 연결을 받는다</td></tr>
              <tr><td>스프링 트랜잭션 안에서 SQL을 보낸 직후와 끝난 뒤</td><td>쓰이고 있는 연결은 1개, 끝난 뒤 0개</td></tr>
              <tr><td>스프링 부트가 만든 풀의 최대 크기</td><td>10</td></tr>
            </tbody>
          </table>
        </div>
        <p class="muted">코드가 바뀔 때마다 이 테스트가 자동으로 다시 돌아요. 결과가 달라지면 레슨을 고쳐요. 질문 4의 3초와 0.05초는 설명하려고 정한 숫자이고, 잰 값이 아니에요.</p>
        <h3>테스트는 이렇게 생겼어요</h3>
        <p>"반납한 연결을 다시 쓴다"를 확인하는 테스트예요. PostgreSQL은 연결마다 서버 프로세스가 따로 있어서, 프로세스 번호가 같으면 같은 연결이에요.</p>
        <pre set:html={highlight(codeTest)} />
        <ul class="code-note"><li><mark class="hl" set:html={highlight('backendPid(c)')} /> 이 연결을 맡은 DB 서버 프로세스의 번호를 DB에 물어봐요.</li></ul>
        <RunLocally tests={['lab.devlessons.connpool.ConnectionPoolTest']} docker />
