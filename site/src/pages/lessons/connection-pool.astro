<script is:inline>
(function () {
  var L = window.Lesson, $ = L.$;
  /* 로그 한 줄: 몇 번째인지와 내용 */
  function addLog(el, text) {
    var row = document.createElement('div');
    row.className = 'row';
    row.innerHTML = '<span class="n">' + (el.children.length + 1) + '</span><span></span>';
    row.lastChild.textContent = text;
    el.appendChild(row);
    el.scrollTop = el.scrollHeight;
  }

  /* 예측: 답은 질문 3에서 알려 준다 */
  var labels = { more: '연결을 하나 더 만들어 받는다', fail: '바로 실패한다', wait: '기다리다가, 정해진 시간이 지나면 실패한다' };
  L.predict({
    key: 'cp-predict', opts: 'predict-opts', result: 'predict-result', answer: 'wait',
    right: '예측이 맞았어요.',
    wrong: function (v) { return '예측은 "' + labels[v] + '"였어요. 틀린 예측이 더 오래 남으니 괜찮아요.'; }
  });

  /* 질문 1: 요청마다 새로 연결하기와 풀에서 빌리기 */
  var c1Mode = 'raw', c1Req, c1New;
  function c1Reset() {
    c1Req = 0; c1New = 0;
    $('c1-req').textContent = '0'; $('c1-new').textContent = '0'; $('c1-new').className = '';
    $('c1-log').innerHTML = ''; $('c1-msg').hidden = true;
  }
  L.pressGroup($('c1-mode'), function (v) { c1Mode = v; c1Reset(); });
  $('c1-run').addEventListener('click', function () {
    c1Req++;
    var log = $('c1-log'), who = '요청 ' + c1Req + ': ';
    if (c1Mode === 'raw') {
      c1New++;
      ['DB 서버에 접속', '아이디와 비밀번호로 인증', 'DB 서버가 프로세스를 띄움', 'SQL 실행', '연결 끊기'].forEach(function (s) { addLog(log, who + s); });
    } else {
      ['풀에서 연결 빌리기', 'SQL 실행', '풀에 연결 반납'].forEach(function (s) { addLog(log, who + s); });
    }
    $('c1-req').textContent = c1Req;
    $('c1-new').textContent = c1New; $('c1-new').className = c1New ? 'bad' : '';
    if (c1Req >= 3) {
      $('c1-msg').hidden = false;
      $('c1-msg').textContent = c1Mode === 'raw'
        ? '요청 ' + c1Req + '개를 처리하려고 연결을 ' + c1New + '번 새로 만들었어요. SQL 한 번마다 접속, 인증, 준비가 따라붙어요.'
        : '요청 ' + c1Req + '개를 처리하는 동안 새로 만든 연결은 0개예요. 미리 만들어 둔 연결을 빌려 썼어요.';
    }
  });
  $('c1-reset').addEventListener('click', c1Reset);
  c1Reset();

  /* 질문 2: 빌리고 반납하기. 연결 2개, 서버 프로세스 번호는 예시 값 */
  var conns, borrowCount, reused;
  function c2Render() {
    $('c2-slots').innerHTML = '';
    conns.forEach(function (c) {
      var el = document.createElement('div'); el.className = 'slot' + (c.busy ? ' busy' : '');
      el.innerHTML = '<span class="who">연결 ' + c.id + ' (서버 프로세스 ' + c.pid + ')</span><span class="state">' + (c.busy ? '빌려준 상태' : '풀에서 대기 중') + '</span>'
        + (c.busy ? '<div><button class="btn" type="button">반납 close()</button></div>' : '');
      if (c.busy) el.querySelector('button').addEventListener('click', function () {
        c.busy = false; c.returned = true;
        addLog($('c2-log'), 'close()  → 연결 ' + c.id + ' 반납 (끊지 않고 풀로 돌아감)');
        c2Render();
      });
      $('c2-slots').appendChild(el);
    });
    var free = conns.filter(function (c) { return !c.busy; }).length;
    $('c2-borrow').disabled = free === 0;
    if (reused) { $('c2-msg').hidden = false; $('c2-msg').textContent = '반납했던 연결을 다시 빌렸어요. 서버 프로세스 번호가 그대로예요. 새로 만든 연결이 아니에요.'; }
    else if (free === 0) { $('c2-msg').hidden = false; $('c2-msg').textContent = '연결 2개를 모두 빌려줬어요. 하나를 반납해야 다시 빌릴 수 있어요.'; }
    else $('c2-msg').hidden = true;
  }
  function c2Reset() {
    conns = [{ id: 1, pid: 4101, busy: false, returned: false }, { id: 2, pid: 4102, busy: false, returned: false }];
    borrowCount = 0; reused = false; $('c2-log').innerHTML = ''; c2Render();
  }
  $('c2-borrow').addEventListener('click', function () {
    var c = conns.filter(function (x) { return !x.busy; })[0]; if (!c) return;
    borrowCount++; c.busy = true;
    if (c.returned) reused = true;
    addLog($('c2-log'), 'getConnection()  → 연결 ' + c.id + ' (서버 프로세스 ' + c.pid + ')' + (c.returned ? ', 반납했던 연결을 다시 씀' : ''));
    c2Render();
  });
  $('c2-reset').addEventListener('click', c2Reset);
  c2Reset();

  /* 질문 3: 요청은 100ms 간격으로 도착하고, 가장 먼저 비는 연결을 기다린다 */
  var ids = ['pool', 'req', 'hold', 'timeout'], s = {};
  ids.forEach(function (k) { s[k] = $('s-' + k); });
  function simulate(pool, n, hold, timeout) {
    var free = [], rows = [];
    for (var c = 0; c < pool; c++) free.push(0);
    for (var i = 0; i < n; i++) {
      var arrive = i * 100, k = 0;
      for (var j = 1; j < pool; j++) if (free[j] < free[k]) k = j;
      var start = Math.max(arrive, free[k]), wait = start - arrive;
      if (wait > timeout) { rows.push({ arrive: arrive, wait: timeout, fail: true }); continue; }
      free[k] = start + hold;
      rows.push({ arrive: arrive, wait: wait, hold: hold, fail: false });
    }
    return rows;
  }
  function renderSim() {
    var pool = +s.pool.value, n = +s.req.value, hold = +s.hold.value, timeout = +s.timeout.value;
    $('v-pool').textContent = pool + '개'; $('v-req').textContent = n + '개';
    $('v-hold').textContent = hold + 'ms'; $('v-timeout').textContent = timeout + 'ms';
    var rows = simulate(pool, n, hold, timeout);
    var end = Math.max.apply(null, rows.map(function (r) { return r.arrive + r.wait + (r.fail ? 0 : r.hold); }));
    var scale = 100 / Math.max(end, 1);
    var html = rows.map(function (r, i) {
      var w = '<span class="g-wait" style="left:' + (r.arrive * scale) + '%;width:' + (r.wait * scale) + '%"></span>';
      var h = r.fail
        ? '<span class="g-fail" style="left:' + ((r.arrive + r.wait) * scale) + '%;width:2%"></span>'
        : '<span class="g-hold" style="left:' + ((r.arrive + r.wait) * scale) + '%;width:' + (r.hold * scale) + '%"></span>';
      return '<div class="g-row"><span>요청 ' + (i + 1) + '</span><div class="g-track">' + w + h + '</div></div>';
    }).join('');
    html += '<div class="g-axis"><span>0ms</span><span>' + Math.round(end / 2) + 'ms</span><span>' + end + 'ms</span></div>';
    $('gantt').innerHTML = html;
    var failed = rows.filter(function (r) { return r.fail; }).length;
    var waited = rows.filter(function (r) { return !r.fail && r.wait > 0; });
    var maxWait = Math.max.apply(null, [0].concat(waited.map(function (r) { return r.wait; })));
    $('sim-text').textContent = failed
      ? '요청 ' + n + '개 가운데 ' + failed + '개가 ' + timeout + 'ms를 기다려도 연결을 받지 못해 실패했어요.'
      : waited.length
        ? '모두 연결을 받았어요. ' + waited.length + '개는 기다렸다가 반납된 연결을 받았고, 가장 오래 기다린 시간은 ' + maxWait + 'ms예요.'
        : '풀이 넉넉해서 아무도 기다리지 않았어요.';
  }
  ids.forEach(function (k) { s[k].addEventListener('input', renderSim); });
  renderSim();

  /* 질문 4: 결제 호출이 트랜잭션 안에 있을 때와 밖에 있을 때 연결을 쥐는 시간. 3초와 0.05초는 예시 값 */
  var API = 3, SQL = 0.05;
  function renderTx(mode) {
    var total = API + SQL * 2, scale = 100 / total, held, rows;
    if (mode === 'in') {
      held = total;
      rows = '<div class="g-row"><span>연결</span><div class="g-track"><span class="g-hold" style="left:0;width:100%"></span></div></div>'
           + '<div class="g-row"><span>하는 일</span><div class="g-track"><span class="g-hold" style="left:0;width:' + (SQL * scale) + '%"></span><span class="g-api" style="left:' + (SQL * scale) + '%;width:' + (API * scale) + '%"></span><span class="g-hold" style="left:' + ((SQL + API) * scale) + '%;width:' + (SQL * scale) + '%"></span></div></div>';
    } else {
      held = SQL;
      rows = '<div class="g-row"><span>연결</span><div class="g-track"><span class="g-hold" style="left:' + (API * scale) + '%;width:' + Math.max(SQL * scale, 1.5) + '%"></span></div></div>'
           + '<div class="g-row"><span>하는 일</span><div class="g-track"><span class="g-api" style="left:0;width:' + (API * scale) + '%"></span><span class="g-hold" style="left:' + (API * scale) + '%;width:' + Math.max(SQL * scale, 1.5) + '%"></span></div></div>';
    }
    $('c4-gantt').innerHTML = rows + '<div class="g-axis"><span>0초</span><span>' + (total / 2).toFixed(2) + '초</span><span>' + total.toFixed(2) + '초</span></div>';
    $('c4-hold').textContent = held.toFixed(2);
    $('c4-hold').className = mode === 'in' ? 'bad' : 'changed';
    var rate = 10 / held;
    $('c4-rate').textContent = rate >= 10 ? Math.round(rate) : rate.toFixed(1);
    $('c4-rate').className = mode === 'in' ? 'bad' : 'changed';
    $('c4-msg').textContent = mode === 'in'
      ? '연결을 3.10초 동안 쥐어요. 그 가운데 3초는 SQL을 보내지 않고 결제 서버만 기다리는 시간이에요. 연결 10개로는 1초에 약 3.2건밖에 처리하지 못해요.'
      : '연결을 0.05초만 쥐어요. 결제 서버를 기다리는 3초 동안에는 연결을 쓰지 않아요. 같은 연결 10개로 1초에 200건을 처리할 수 있어요.';
  }
  L.pressGroup($('c4-mode'), renderTx);
  renderTx('in');

  L.progress([['predict', '예측'], ['q1', '질문 1 / 4'], ['q2', '질문 2 / 4'], ['q3', '질문 3 / 4'], ['q4', '질문 4 / 4'], ['recall', '마무리']]);

  L.quizzes({
    q1: { q: '풀을 쓰지 않고 요청마다 연결을 새로 만들어요. 요청 100개를 차례로 처리하면 DB 서버에 접속하고 인증하는 일은 몇 번 일어날까요?', o: ['1번', '10번', '100번'], a: 2, e: '요청마다 연결을 새로 만들고 끊으니, 접속과 인증도 요청 수만큼 일어나요.' },
    q2: { q: '연결이 1개뿐인 풀에서 연결을 빌려 쓰고 close()한 다음, 다시 빌렸어요. 두 번째로 빌린 연결은?', o: ['처음과 같은 연결', '새로 만든 다른 연결'], a: 0, e: '풀에서 빌린 연결의 close()는 끊지 않고 반납이에요. 풀에 돌아온 그 연결을 다시 빌려요.' },
    q3: { q: '풀 크기는 2, 기다리는 최대 시간은 500ms예요. 요청 두 개가 연결을 쥔 채 2초짜리 SQL을 실행하는 중에 세 번째 요청이 연결을 달라고 했어요. 세 번째 요청은?', o: ['세 번째 연결을 만들어 받는다', '약 500ms 기다린 뒤 예외로 실패한다', '2초 기다린 뒤 연결을 받는다'], a: 1, e: '풀은 최대 크기를 넘겨 만들지 않아요. 500ms 안에 반납되는 연결이 없으니 예외로 실패해요.' },
    q4: { q: '@Transactional 메서드가 주문을 조회하고(0.05초), 결제 서버를 부르고(3초), 결과를 저장해요(0.05초). 이 요청이 연결을 쥐는 시간은?', o: ['0.1초', '3초', '3.1초'], a: 2, e: '트랜잭션이 끝날 때까지 연결을 쥐어요. 결제 서버를 기다리는 3초도 포함돼요.' }
  });

  L.recalls('recall-list', [
    { id: 'q1', q: '커넥션은 무엇이고, 왜 매번 새로 만들면 안 되나요?', a: '커넥션은 프로그램과 DB 서버 사이에 열린 통신 통로예요. 하나를 만들려면 네트워크 접속, 인증, DB 서버의 준비(PostgreSQL은 서버 프로세스를 띄움)가 필요해서 SQL 한 번보다 훨씬 오래 걸려요. DB 서버가 동시에 받을 수 있는 연결 수에도 한계가 있어요.' },
    { id: 'q2', q: '커넥션 풀은 어떻게 동작하나요?', a: '연결을 미리 만들어 두고 요청마다 빌려주고 돌려받아요. 풀에서 빌린 연결의 close()는 끊지 않고 반납이라, 다음 요청이 같은 연결을 다시 써요. 그래서 빌린 연결은 꼭 close()해야 해요.' },
    { id: 'q3', q: '풀의 연결이 모두 쓰이고 있으면 다음 요청은 어떻게 되나요?', a: '최대 크기를 넘겨 연결을 만들지 않고, 반납될 때까지 기다려요. 기다리는 동안 누군가 반납하면 그 연결을 받고, 정해진 시간(HikariCP 기본 30초) 안에 받지 못하면 SQLTransientConnectionException으로 실패해요.' },
    { id: 'q4', q: '트랜잭션은 연결을 얼마나 오래 쥐고 있나요?', a: '트랜잭션이 끝날 때까지 연결 하나를 쥐고, 커밋이나 롤백을 해야 풀로 돌려줘요. 트랜잭션 안에서 외부 서버 호출처럼 느린 작업을 하면 그동안 연결을 붙잡아서 풀이 모자라요. 느린 작업은 트랜잭션 밖으로 빼고 트랜잭션을 짧게 둬요.' }
  ]);
  L.reveal('model-btn', 'model');
})();
</script>
</Base>
