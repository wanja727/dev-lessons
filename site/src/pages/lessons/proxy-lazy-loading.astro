---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const testDir = `${repo}/blob/main/verification/src/test/java/lab/devlessons/lazy`;

const codePredict = `@Transactional(readOnly = true)
public Player findPlayer(Long id) {
    return playerRepository.findById(id).orElseThrow();   // team은 LAZY
}

// 컨트롤러 (트랜잭션 밖. OSIV 설정은 꺼져 있다고 가정: OSIV 레슨에서 다뤄요)
Player player = playerService.findPlayer(1L);
Long teamId = player.getTeam().getId();       // ①
String teamName = player.getTeam().getName(); // ②`;

const codeEntity = `@Entity
public class Player {
    @ManyToOne(fetch = FetchType.LAZY)   // @ManyToOne의 기본은 EAGER라 직접 적는다
    @JoinColumn(name = "team_id")
    private Team team;
}`;

const codeProxy = `// Hibernate가 런타임에 만드는 프록시 (개념 코드)
class Team$HibernateProxy extends Team {
    private Long id;                 // 식별자는 처음부터 안다 (FK 값)
    private Team target;             // 진짜 엔티티, 처음엔 null
    private Session session;         // 초기화할 때 쓸 영속성 컨텍스트

    public Long getId() { return id; }          // SELECT 없음
    public String getName() {
        if (target == null) {
            if (session 닫힘) throw new LazyInitializationException(...);
            target = session.select(Team, id);  // 여기서 SELECT
        }
        return target.getName();
    }
}`;

const codeFix = `// 1. fetch join: 처음부터 함께 조회
@Query("select p from Player p join fetch p.team where p.id = :id")
Optional<Player> findWithTeam(Long id);

// 2. @EntityGraph: 같은 일을 어노테이션으로
@EntityGraph(attributePaths = "team")
Optional<Player> findById(Long id);

// 3. 트랜잭션 안에서 DTO로 바꿔서 반환 (엔티티를 밖으로 내보내지 않음)
@Transactional(readOnly = true)
public PlayerResponse findPlayer(Long id) {
    Player p = playerRepository.findById(id).orElseThrow();
    return new PlayerResponse(p.getName(), p.getTeam().getName());
}`;

const codeEquals = `// 프록시와 비교하면 깨지는 equals
if (getClass() != o.getClass()) return false;   // Team vs Team$HibernateProxy → false

// 안전한 쪽
if (!(o instanceof Team other)) return false;
return id != null && id.equals(other.getId());  // 필드 대신 getter`;
---
<Base title="프록시와 지연 로딩 · Dev Lessons" description="JPA 프록시가 언제 SELECT를 보내는지 직접 호출해 보며 확인하고, find와 getReference의 차이, LazyInitializationException의 원인과 해결법을 배워요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">JPA · 개념 학습 · 약 25분 · 선수 레슨: <a href="/dev-lessons/lessons/jpa-persistence-context/">영속성 컨텍스트</a> · 다음 레슨: <a href="/dev-lessons/lessons/jpa-n-plus-1/">N+1 문제</a></p>
    <h1>프록시와 지연 로딩</h1>
    <p class="lede">플레이어를 조회하면 팀도 같이 조회될까요? LAZY라면 팀 자리에는 <strong>프록시</strong>라는 가짜 객체가 들어가요. 프록시가 언제 진짜 데이터를 가져오는지 알면 N+1도, LazyInitializationException도 설명할 수 있어요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> <a href="/dev-lessons/lessons/jpa-persistence-context/">영속성 컨텍스트</a>(1차 캐시, 트랜잭션 범위), 엔티티와 리포지토리(<a href="/dev-lessons/lessons/jpa-basics/">JPA 첫걸음</a>), 자바의 상속.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#proxy"><span>1</span>프록시란</a>
      <a href="#lab"><span>2</span>직접 호출해 보기</a>
      <a href="#find-ref"><span>3</span>find와 getReference</a>
      <a href="#lie"><span>4</span>LazyInitializationException</a>
      <a href="#traps"><span>5</span>함정</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>①과 ② 중 어디서 예외가 날까요?</h2>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">예외가 나는 곳</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="none" aria-pressed="false">둘 다 괜찮다</button>
          <button class="chip" type="button" data-v="one" aria-pressed="false">①부터 예외</button>
          <button class="chip" type="button" data-v="two" aria-pressed="false">②에서만 예외</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 2장에서 직접 호출해 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="proxy" class="read">
    <p class="eyebrow">1 · 프록시란</p>
    <h2>진짜 엔티티 대신 들어가는 빈 껍데기</h2>
    <pre set:text={codeEntity} />
    <p><code>@ManyToOne</code>은 "여러 플레이어가 한 팀에 속한다"(다대일) 관계를 뜻하고, 플레이어 테이블의 <code>team_id</code> 컬럼(외래 키)으로 이어져요. <code>fetch = FetchType.LAZY</code>는 연관된 팀을 "필요할 때 나중에" 불러오라는 설정이에요.</p>
    <p>LAZY로 설정하면 플레이어를 조회할 때 팀 테이블은 SELECT하지 않아요. 그런데 <code>player.team</code> 필드를 null로 둘 수는 없으니, Hibernate는 <strong>Team을 상속한 프록시 객체</strong>를 넣어 둬요. 플레이어 행에 있는 team_id(FK) 값만 들고 있는 껍데기예요.</p>
    <pre set:text={codeProxy} />
    <ul>
      <li><strong>getId()</strong>는 이미 아는 값이라 SELECT가 없어요.</li>
      <li>id가 아닌 값을 <strong>처음 읽을 때</strong> 영속성 컨텍스트를 통해 SELECT해서 진짜 엔티티를 채워요. 이걸 <strong>프록시 초기화</strong>라고 해요.</li>
      <li>한 번 초기화되면 다시 SELECT하지 않아요.</li>
      <li>초기화하려면 영속성 컨텍스트가 열려 있어야 해요. 닫혀 있으면 예외예요.</li>
    </ul>
    <p class="callout">@Transactional의 프록시와 이름은 같지만 다른 물건이에요. 그쪽은 <strong>빈</strong>을 감싸 트랜잭션을 여는 스프링 프록시, 이쪽은 <strong>엔티티</strong> 자리를 채우는 Hibernate 프록시예요. 둘 다 "상속해서 메서드 호출을 가로챈다"는 원리는 같아요.</p>
  </section>

  <section id="lab">
    <div class="read stack">
      <p class="eyebrow">2 · 직접 호출해 보기</p>
      <h2>버튼을 눌러 코드를 한 줄씩 실행해 보세요</h2>
      <p>어떤 순서로 눌러도 돼요. 오른쪽에 실제로 DB로 나간 SQL이 쌓여요. 0장 코드는 "플레이어 find → 트랜잭션 종료 → getId → getName" 순서예요.</p>
    </div>
    <div class="panel">
      <div class="lab-actions">
        <button class="btn" type="button" data-act="findPlayer">em.find(Player, 1)</button>
        <button class="btn" type="button" data-act="getRef">em.getReference(Team, 10)</button>
        <button class="btn" type="button" data-act="findTeam">em.find(Team, 10)</button>
        <button class="btn" type="button" data-act="getId">team.getId()</button>
        <button class="btn" type="button" data-act="getName">team.getName()</button>
        <button class="btn" type="button" data-act="close">트랜잭션 종료</button>
        <button class="btn" type="button" data-act="reset">처음부터</button>
      </div>
      <div class="lab-grid">
        <div class="lab-box">
          <span class="label">영속성 컨텍스트 <b id="pc-state"></b></span>
          <div id="pc-items" class="pc-items"></div>
        </div>
        <div class="lab-box">
          <span class="label">내 손의 team 변수</span>
          <div id="team-var" class="team-var"></div>
        </div>
        <div class="lab-box sql">
          <span class="label">DB로 나간 SQL</span>
          <ol id="sql-log"></ol>
        </div>
      </div>
      <p class="verdict" id="lab-msg" aria-live="polite"></p>
    </div>
  </section>

  <section id="find-ref" class="read">
    <p class="eyebrow">3 · find와 getReference</p>
    <h2>바로 조회할까, 껍데기만 받을까</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th></th><th>em.find()</th><th>em.getReference()</th></tr></thead>
        <tbody>
          <tr><td>SELECT 시점</td><td>호출 즉시</td><td>id 외의 값을 처음 읽을 때</td></tr>
          <tr><td>돌려주는 것</td><td>진짜 엔티티</td><td>프록시 (Team을 상속한 다른 클래스)</td></tr>
          <tr><td>없는 id</td><td>null</td><td>바로는 괜찮고, 초기화할 때 EntityNotFoundException</td></tr>
          <tr><td>Spring Data</td><td>findById()</td><td>getReferenceById()</td></tr>
        </tbody>
      </table>
    </div>
    <p>getReference가 쓸모 있는 곳은 <strong>연관관계만 걸 때</strong>예요. 주문을 저장하면서 회원을 연결하려면 회원의 id만 있으면 되니, SELECT 없이 프록시로 FK만 채울 수 있어요.</p>
    <p><strong>예외가 하나 있어요.</strong> 영속성 컨텍스트는 같은 id에 대해 항상 같은 인스턴스를 돌려줘요. 그래서 이미 진짜 엔티티가 있으면 getReference도 진짜를 주고, 반대로 프록시를 먼저 받았으면 find도 <strong>그 프록시</strong>를 (초기화해서) 줘요. 2장에서 getReference → find 순서로 눌러 확인해 보세요.</p>
  </section>

  <section id="lie" class="read">
    <p class="eyebrow">4 · LazyInitializationException</p>
    <h2>영속성 컨텍스트가 닫힌 뒤의 초기화</h2>
    <p>스프링에서 영속성 컨텍스트는 기본적으로 <strong>트랜잭션과 함께 열리고 닫혀요.</strong> 서비스가 엔티티를 돌려주고 트랜잭션이 끝나면, 그 안의 초기화되지 않은 프록시는 SELECT할 방법이 없어요. 그때 id가 아닌 값을 읽으면 <code>LazyInitializationException: could not initialize proxy - no Session</code>이 나요.</p>
    <p>0장의 정답은 "②에서만 예외"예요. ①의 getId()는 프록시가 이미 아는 값이라 괜찮아요.</p>
    <h3>해결: 트랜잭션 안에서 필요한 만큼 미리 로딩</h3>
    <pre set:text={codeFix} />
    <p>실무에서 가장 권하는 건 3번이에요. 화면에 필요한 데이터를 서비스 안에서 DTO(화면에 필요한 값만 담아 옮기는 단순한 객체)로 만들어 반환하면, 어디까지 로딩해야 하는지가 서비스 코드에 드러나요. 트랜잭션 밖까지 영속성 컨텍스트를 열어 두는 OSIV라는 방법도 있는데, 다음 레슨에서 비용과 함께 다뤄요.</p>
    <p class="muted">LAZY를 EAGER로 바꾸는 건 해결이 아니에요. 필요 없는 곳에서도 항상 조회하고, JPQL에서는 <a href="/dev-lessons/lessons/jpa-n-plus-1/">N+1</a>을 만들어요.</p>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">5 · 함정</p>
    <h2>프록시라서 생기는 일</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>문제</th><th>대응</th></tr></thead>
        <tbody>
          <tr><td><code>getClass() ==</code>로 타입 비교</td><td>프록시는 하위 클래스라 false</td><td>instanceof, Hibernate.getClass()</td></tr>
          <tr><td>equals에서 필드 직접 접근 (<code>other.name</code>)</td><td>프록시의 필드는 비어 있음</td><td>getter로 접근</td></tr>
          <tr><td>엔티티 클래스나 메서드를 final로</td><td>상속할 수 없어 프록시를 만들지 못함</td><td>final 금지</td></tr>
          <tr><td>toString, JSON 직렬화에 연관 필드 포함</td><td>트랜잭션 밖에서 LazyInitializationException, 안에서는 의도치 않은 SELECT</td><td>엔티티를 직접 응답하지 않고 DTO로</td></tr>
          <tr><td>반복문 안에서 프록시 초기화</td><td>N+1</td><td>fetch join, 배치 사이즈</td></tr>
        </tbody>
      </table>
    </div>
    <pre set:text={codeEquals} />
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "지연 로딩은 어떻게 동작하고, LazyInitializationException은 왜 나나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 지연 로딩은 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>지연 로딩은 연관 엔티티를 실제로 사용할 때까지 조회를 미루는 방식이고, 그동안 연관 필드에는 엔티티를 상속한 프록시가 들어갑니다.</dd>
        <dt>원리</dt><dd>프록시는 식별자만 알고 있어서 getId()는 SELECT 없이 돌려주고, 다른 값을 처음 읽을 때 영속성 컨텍스트를 통해 SELECT해 초기화합니다. 영속성 컨텍스트는 기본적으로 트랜잭션과 생명주기가 같아서, 트랜잭션이 끝난 뒤 초기화하려고 하면 LazyInitializationException이 납니다.</dd>
        <dt>트레이드오프</dt><dd>필요한 데이터만 조회할 수 있지만 반복문 안에서 초기화하면 N+1이 생기고, 트랜잭션 밖에서는 쓸 수 없습니다. 그래서 트랜잭션 안에서 fetch join이나 EntityGraph로 필요한 만큼 함께 조회하고 DTO로 바꿔 반환합니다. 프록시는 하위 클래스라 getClass 비교나 필드 직접 접근도 주의해야 합니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 엔티티를 그대로 JSON으로 응답하다 LazyInitializationException이 나서, 서비스에서 fetch join으로 조회해 DTO로 반환하도록 바꿨습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: "getId는 초기화하지 않는다"와 "영속성 컨텍스트의 범위는 트랜잭션"을 말했나요? EAGER가 해결책이 아닌 이유를 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 PostgreSQL에서 나간 SELECT 수를 세어, 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>find는 즉시 SELECT 1번, 진짜 클래스</li>
      <li>getReference는 SELECT 0번, 다른 클래스지만 instanceof는 참. getId()도 0번, getName()에서 1번, 다시 읽어도 1번</li>
      <li>LAZY 연관 필드는 초기화되지 않은 프록시, 이름을 읽을 때 SELECT</li>
      <li>find 후 getReference는 같은 진짜 엔티티, getReference 후 find는 같은 프록시(초기화됨)</li>
      <li>트랜잭션 밖: getId()는 괜찮고 getName()은 LazyInitializationException</li>
      <li>fetch join, Hibernate.initialize로 미리 로딩하면 트랜잭션 밖에서도 읽힘</li>
      <li>없는 id의 getReference는 초기화할 때 EntityNotFoundException</li>
    </ul>
    <p><a href={`${testDir}/ProxyLazyLoadingTest.java`}>ProxyLazyLoadingTest</a></p>
  </section>

  <footer>
    근거: Hibernate ORM 6.6 User Guide의 Fetching, Jakarta Persistence 3.1 EntityManager API. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .lab-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .lab-actions .btn { font-family: var(--mono, monospace); font-size: 13px; }
  .lab-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr); gap: 10px; }
  .lab-box { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .lab-box b.open { color: var(--ok); } .lab-box b.closed { color: var(--query); }
  .pc-items { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .pc-items span, .team-var span { display: inline-block; padding: 2px 8px; border-radius: 6px; background: var(--code-bg); }
  .team-var { font-size: 14px; display: flex; flex-direction: column; gap: 4px; }
  .team-var .proxy { border: 1.5px dashed var(--accent); }
  .team-var .real, .team-var .inited { border: 1.5px solid var(--ok); }
  .sql ol { margin: 0; padding-left: 20px; font-family: var(--mono, monospace); font-size: 12px; display: flex; flex-direction: column; gap: 2px; overflow-wrap: anywhere; }
  .sql li.new { color: var(--accent); font-weight: 700; }
  @media (max-width: 760px) { .lab-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { none: '둘 다 괜찮다', one: '①부터 예외', two: '②에서만 예외' };
  var pred = { p1: store('lazy-p1'), p2: store('lazy-p2') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + (pred.p2 ? ' (' + pred.p2 + ')' : '') + '. 정답은 "②에서만 예외"예요. getId()는 프록시가 이미 아는 값이에요. 2장에서 같은 순서로 눌러 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('lazy-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 실험실: Team 10 하나만 다룬다 */
  var st;
  function reset() {
    st = { open: true, player: false, team: null, teamVar: null, sqls: [], fresh: -1 };
    // team: null | 'proxy' | 'inited' | 'real' (영속성 컨텍스트 안의 Team 10 인스턴스)
    // teamVar: null | 'player' | 'ref' | 'find' (변수를 어떻게 얻었나)
  }
  function sql(s) { st.sqls.push(s); st.fresh = st.sqls.length - 1; }
  function act(a) {
    st.fresh = -1;
    if (a === 'reset') { reset(); return '처음 상태예요. 트랜잭션이 열려 있고 영속성 컨텍스트는 비어 있어요.'; }
    if (a === 'close') {
      if (!st.open) return '이미 닫혀 있어요.';
      st.open = false; return '트랜잭션이 커밋되고 영속성 컨텍스트가 닫혔어요. 손에 든 객체들은 이제 준영속 상태예요.';
    }
    if (!st.open && (a === 'findPlayer' || a === 'getRef' || a === 'findTeam')) return '영속성 컨텍스트가 닫혀서 조회할 수 없어요. "처음부터"를 눌러 주세요.';
    if (a === 'findPlayer') {
      if (st.player) return '플레이어 1은 이미 영속성 컨텍스트에 있어서 SELECT 없이 같은 인스턴스를 돌려줘요.';
      sql('select p.id, p.name, p.team_id from lazy_player p where p.id=1');
      st.player = true;
      if (!st.team) st.team = 'proxy';
      st.teamVar = 'player';
      return '플레이어만 SELECT했어요. team 필드에는 team_id=10만 아는 ' + (st.team === 'proxy' ? '프록시' : '이미 있던 같은 인스턴스') + '가 들어갔어요. team 변수 = player.getTeam().';
    }
    if (a === 'getRef') {
      st.teamVar = 'ref';
      if (!st.team) { st.team = 'proxy'; return 'SELECT 없이 프록시를 받았어요. id=10만 알고 있어요.'; }
      if (st.team === 'real') return '영속성 컨텍스트에 이미 진짜 Team 10이 있어서, getReference도 SELECT 없이 그 진짜 엔티티를 돌려줘요.';
      return '이미 Team 10의 프록시가 있어서 같은 프록시를 돌려줘요. SELECT는 없어요.';
    }
    if (a === 'findTeam') {
      st.teamVar = 'find';
      if (!st.team) { sql('select t.id, t.name from lazy_team t where t.id=10'); st.team = 'real'; return '즉시 SELECT해서 진짜 엔티티를 받았어요.'; }
      if (st.team === 'proxy') { sql('select t.id, t.name from lazy_team t where t.id=10'); st.team = 'inited'; return '이미 프록시가 있어서, find는 그 프록시를 초기화(SELECT)해서 같은 프록시를 돌려줘요. 클래스는 여전히 프록시예요.'; }
      return 'Team 10은 이미 로딩돼 있어서 SELECT 없이 같은 인스턴스를 돌려줘요.';
    }
    if (!st.teamVar) return '먼저 team을 얻어야 해요. find나 getReference를 눌러 보세요.';
    if (a === 'getId') return '10. 프록시든 진짜든 id는 이미 알고 있어서 SELECT도 예외도 없어요.';
    if (a === 'getName') {
      if (st.team !== 'proxy') return '"레드". 이미 로딩된 값이라 SELECT가 없어요.';
      if (!st.open) return 'LazyInitializationException: could not initialize proxy [Team#10] - no Session. 초기화하려면 영속성 컨텍스트가 필요한데 닫혔어요.';
      sql('select t.id, t.name from lazy_team t where t.id=10'); st.team = 'inited';
      return '"레드". 처음으로 id 외의 값을 읽어서 프록시가 초기화됐어요(SELECT 1번). 다시 눌러도 SELECT는 없어요.';
    }
    return '';
  }
  function render(msg) {
    var pcs = document.getElementById('pc-state');
    pcs.textContent = st.open ? '열림' : '닫힘'; pcs.className = st.open ? 'open' : 'closed';
    var items = [];
    if (st.player) items.push('<span>Player#1 (진짜)</span>');
    if (st.team) items.push('<span>Team#10 (' + { proxy: '프록시, 미초기화', inited: '프록시, 초기화됨', real: '진짜' }[st.team] + ')</span>');
    document.getElementById('pc-items').innerHTML = st.open ? (items.join('') || '<span class="muted">비어 있음</span>') : '<span class="muted">닫혀서 관리하지 않음</span>';
    var tv = document.getElementById('team-var');
    if (!st.teamVar) tv.innerHTML = '<span class="muted">없음</span>';
    else {
      var cls = st.team === 'real' ? 'real' : st.team === 'inited' ? 'inited' : 'proxy';
      var desc = st.team === 'real' ? 'Team (진짜 클래스)' : 'Team$HibernateProxy' + (st.team === 'inited' ? ' · target 채워짐' : ' · target = null');
      var from = { player: 'player.getTeam()', ref: 'em.getReference()', find: 'em.find()' }[st.teamVar];
      tv.innerHTML = '<span class="' + cls + '">' + esc(desc) + '</span><span class="muted">얻은 방법: ' + esc(from) + '</span><span class="muted">id = 10</span>';
    }
    document.getElementById('sql-log').innerHTML = st.sqls.length
      ? st.sqls.map(function (s, k) { return '<li class="' + (k === st.fresh ? 'new' : '') + '">' + esc(s) + '</li>'; }).join('')
      : '<li class="muted">아직 없음</li>';
    document.getElementById('lab-msg').textContent = msg;
  }
  reset();
  render('트랜잭션이 열려 있어요. 0장 순서대로 "em.find(Player, 1)"부터 눌러 보세요.');
  document.querySelector('.lab-actions').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-act]'); if (!b) return;
    render(act(b.dataset.act));
  });

  /* 6. 확인 문제 */
  var quiz = [
    { q: '초기화되지 않은 Team 프록시에서 getId()를 호출하면?', o: ['SELECT가 나간다', 'SELECT 없이 id를 돌려준다'], a: 1, e: '프록시는 FK로 받은 식별자를 이미 알고 있어요. 트랜잭션 밖에서도 예외가 나지 않아요.' },
    { q: '같은 트랜잭션에서 em.find(Team, 10)을 먼저 하고 em.getReference(Team, 10)을 하면?', o: ['프록시를 돌려준다', '이미 있는 진짜 엔티티를 돌려준다'], a: 1, e: '영속성 컨텍스트는 같은 id에 같은 인스턴스를 보장해요.' },
    { q: 'LazyInitializationException의 가장 권장되는 해결은?', o: ['연관관계를 EAGER로 바꾼다', '트랜잭션 안에서 fetch join으로 조회해 DTO로 반환한다'], a: 1, e: 'EAGER는 필요 없는 곳에서도 조회하고 N+1을 만들어요. 필요한 범위를 서비스에서 정하는 게 좋아요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('lazy-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('lazy-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
