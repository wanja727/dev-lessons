---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/concurrency/ProcessAndThreadTest.java`;

const codePredict = `class Counter { int value; }

Counter counter = new Counter();
// 스레드 두 개가 동시에 출발해서 각각 100만 번씩
Runnable task = () -> {
    for (int i = 0; i < 1_000_000; i++) counter.value++;
};`;

const codeCoupon = `@RestController
public class CouponController {
    private int issuedCount = 0;   // 싱글톤 빈의 필드: 모든 요청 스레드가 공유

    @PostMapping("/coupons")
    public String issue() {
        if (issuedCount >= 100) return "마감";
        issuedCount++;             // 동시에 들어오면 100장보다 많이 발급될 수 있다
        return "발급";
    }
}`;

const codeFix = `// 1) 원자적 연산
private final AtomicInteger counter = new AtomicInteger();
counter.incrementAndGet();

// 2) 한 번에 한 스레드만
synchronized (lock) {
    counter.value++;
}

// 3) 여러 서버(프로세스)라면 공유 상태를 DB나 Redis로 옮기고,
//    DB 락이나 원자적 명령으로 처리한다`;
---
<Base title="프로세스와 스레드 · Dev Lessons" description="처음 배우는 사람을 위한 프로세스와 스레드 레슨. 메모리 구조와 경쟁 상태를 직접 단계별로 실행해 보고, 백엔드 서버와 연결해요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">운영체제 · 개념 학습 · 약 25분 · 선수 레슨 없음</p>
    <h1>프로세스와 스레드</h1>
    <p class="lede">"프로세스와 스레드의 차이"는 면접 단골 질문이에요. 그런데 정의를 외우는 것보다 중요한 건 <strong>스레드는 메모리를 공유한다</strong>는 한 문장이 실제로 무슨 일을 일으키는지 아는 거예요. 직접 단계별로 실행해 보면서 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 자바 기초(클래스, 객체, new, 메서드). 운영체제 지식은 없어도 돼요.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#background"><span>1</span>프로그램, 프로세스, 스레드</a>
      <a href="#memory"><span>2</span>무엇을 공유하나</a>
      <a href="#race"><span>3</span>공유의 대가</a>
      <a href="#compare"><span>4</span>비교</a>
      <a href="#backend"><span>5</span>백엔드에서는</a>
      <a href="#traps"><span>6</span>함정</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>두 스레드가 100만 번씩 더하면?</h2>
    <p>스레드 두 개가 같은 객체의 값을 각각 100만 번씩 1씩 올려요. 둘 다 끝나면 <code>counter.value</code>는 얼마일까요?</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">내 예측</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="exact" aria-pressed="false">항상 정확히 200만</button>
          <button class="chip" type="button" data-v="less" aria-pressed="false">200만보다 작을 수 있다</button>
          <button class="chip" type="button" data-v="million" aria-pressed="false">항상 100만</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 3장에서 직접 단계별로 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="background" class="read">
    <p class="eyebrow">1 · 배경 지식</p>
    <h2>프로그램, 프로세스, 스레드</h2>
    <ul>
      <li><strong>프로그램:</strong> 디스크에 저장된 실행 파일이에요. 아직 아무 일도 하지 않아요.</li>
      <li><strong>프로세스:</strong> 실행 중인 프로그램이에요. 운영체제가 프로세스마다 <strong>독립된 메모리 공간</strong>과 자원(열린 파일 등)을 줘요. <code>java -jar app.jar</code>를 실행하면 JVM 프로세스 하나가 생겨요.</li>
      <li><strong>스레드:</strong> 프로세스 안에서 실제로 코드를 실행하는 흐름이에요. 한 프로세스 안에 여러 개가 있을 수 있고, <strong>프로세스의 메모리를 함께 써요.</strong></li>
    </ul>
    <p>CPU 코어 하나는 한 순간에 스레드 하나만 실행해요. 운영체제는 아주 짧은 간격으로 실행할 스레드를 바꿔 가며 동시에 도는 것처럼 보이게 하는데, 이렇게 바꾸는 일을 <strong>컨텍스트 스위칭</strong>이라고 해요. 바꿀 때마다 지금까지의 실행 상태를 저장하고 다음 스레드의 상태를 불러와야 해서 비용이 들어요.</p>
  </section>

  <section id="memory">
    <div class="read stack">
      <p class="eyebrow">2 · 무엇을 공유하나</p>
      <h2>메모리 구조로 보는 차이</h2>
      <p>프로세스의 메모리는 크게 네 영역이에요. <strong>코드</strong>(실행할 명령), <strong>데이터</strong>(전역·static 변수), <strong>힙</strong>(new로 만든 객체), <strong>스택</strong>(메서드 호출과 지역 변수). 아래에서 "프로세스 2개"와 "스레드 2개"를 바꿔 보세요.</p>
    </div>
    <div class="panel">
      <div class="seg" id="mem-mode">
        <button type="button" data-v="process" aria-pressed="true">프로세스 2개</button>
        <button type="button" data-v="thread" aria-pressed="false">스레드 2개 (한 프로세스)</button>
      </div>
      <div class="mem" id="mem"></div>
      <p class="callout" id="mem-note"></p>
    </div>
  </section>

  <section id="race">
    <div class="read stack">
      <p class="eyebrow">3 · 공유의 대가</p>
      <h2>count++는 한 번에 일어나지 않아요</h2>
      <p>코드로는 한 줄이지만, CPU는 <code>count++</code>를 세 단계로 실행해요. ① 메모리에서 값을 <strong>읽고</strong> ② 1을 <strong>더하고</strong> ③ 메모리에 <strong>쓰기</strong>. 각 스레드는 읽은 값을 자기만의 공간(레지스터)에 들고 있어요. 두 스레드가 이 단계를 섞어서 실행하면 무슨 일이 생기는지 직접 순서를 정해 보세요.</p>
    </div>
    <div class="panel">
      <label class="check"><input type="checkbox" id="race-lock"> synchronized로 감싸기 (한 번에 한 스레드만)</label>
      <div class="race">
        <div class="thread-box" id="ta">
          <strong>스레드 A</strong>
          <ol class="steps"><li>읽기</li><li>더하기</li><li>쓰기</li></ol>
          <span class="reg">레지스터: <b id="ra">-</b></span>
          <button class="btn" type="button" id="btn-a">A 다음 단계</button>
        </div>
        <div class="memory-cell">
          <span class="label">공유 메모리</span>
          <span class="big" id="mem-count">0</span>
          <span class="muted small">count</span>
        </div>
        <div class="thread-box" id="tb">
          <strong>스레드 B</strong>
          <ol class="steps"><li>읽기</li><li>더하기</li><li>쓰기</li></ol>
          <span class="reg">레지스터: <b id="rb">-</b></span>
          <button class="btn" type="button" id="btn-b">B 다음 단계</button>
        </div>
      </div>
      <div class="actions">
        <button class="btn" type="button" id="race-bad">나쁜 순서 자동 재생</button>
        <button class="btn" type="button" id="race-reset">처음으로</button>
      </div>
      <p class="verdict" id="race-note" aria-live="polite"></p>
      <div class="log" id="race-log"></div>
    </div>
    <div class="read callout warn">
      <strong>이게 갱신 손실(lost update)이에요.</strong> 두 스레드가 모두 1을 더했는데 결과는 1이에요. 100만 번씩 반복하면 이런 겹침이 수없이 생겨서 0장 코드의 결과는 200만보다 작아져요. 이렇게 실행 순서에 따라 결과가 달라지는 상황을 <strong>경쟁 상태(race condition)</strong>라고 해요. 실제로 테스트에서 매번 확인해요.
    </div>
  </section>

  <section id="compare" class="read">
    <p class="eyebrow">4 · 비교</p>
    <h2>한눈에 보는 차이</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>기준</th><th>프로세스</th><th>스레드</th></tr></thead>
        <tbody>
          <tr><td>메모리</td><td>각자 독립된 공간</td><td>코드·데이터·힙 공유, 스택만 각자</td></tr>
          <tr><td>만드는 비용</td><td>큼 (메모리 공간을 새로 준비)</td><td>작음 (스택만 새로)</td></tr>
          <tr><td>컨텍스트 스위칭</td><td>비쌈 (메모리 공간까지 바뀜)</td><td>상대적으로 쌈</td></tr>
          <tr><td>서로 데이터 주고받기</td><td>프로세스 간 통신(IPC) 필요: 소켓, 파이프, 파일, DB 등</td><td>같은 객체를 바로 읽고 씀 (대신 동기화 필요)</td></tr>
          <tr><td>장애 격리</td><td>한 프로세스가 죽어도 다른 프로세스는 영향 없음</td><td>한 스레드의 문제(예: OutOfMemoryError)가 프로세스 전체에 영향</td></tr>
        </tbody>
      </table>
    </div>
    <p>한 줄로 정리하면 <strong>스레드는 가볍고 공유가 쉬운 대신 동기화를 책임져야 하고, 프로세스는 무겁지만 서로 격리돼요.</strong> 면접에서는 이 트레이드오프까지 말하면 좋아요.</p>
  </section>

  <section id="backend" class="read">
    <p class="eyebrow">5 · 백엔드에서는</p>
    <h2>내 Spring 서버는 이미 멀티 스레드예요</h2>
    <p>Spring Boot 애플리케이션은 JVM <strong>프로세스 하나</strong>예요. 그 안에서 HTTP 요청을 받는 웹 서버인 <strong>톰캣</strong>은 요청이 올 때마다 <strong>스레드 풀</strong>에서 스레드를 하나 꺼내 처리해요. 기본 최대 스레드 수는 200개예요(<code>server.tomcat.threads.max</code>).</p>
    <p>그런데 요청을 처리하는 객체(컨트롤러, 서비스)는 스프링이 하나만 만들어 모두가 함께 쓰는 <strong>싱글톤 빈</strong>이에요(<a href="/dev-lessons/lessons/spring-beans/">스프링 빈과 의존성 주입</a>). 즉 동시에 들어온 요청 스레드 수백 개가 <strong>같은 객체</strong>를 함께 써요. 그래서 빈의 필드에 요청마다 바뀌는 상태를 두면 3장의 경쟁 상태가 그대로 생겨요.</p>
    <pre set:text={codeCoupon} />
    <p>고치는 방법은 상황에 따라 달라요.</p>
    <pre set:text={codeFix} />
    <div class="callout">
      서버를 여러 대(프로세스 여러 개) 띄우면 서로 메모리를 공유하지 않아서, <code>AtomicInteger</code>나 <code>synchronized</code>도 서버 한 대 안에서만 효과가 있어요. 그래서 실무에서 공유 상태는 보통 DB나 Redis에 두고, 동시성은 DB 락 같은 방법으로 해결해요. 이건 낙관적 락·비관적 락 레슨으로 이어져요.
    </div>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">6 · 함정</p>
    <h2>자주 틀리는 세 가지</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>오해</th><th>실제</th></tr></thead>
        <tbody>
          <tr><td>스레드를 많이 만들수록 빨라진다</td><td>코어 수보다 훨씬 많으면 컨텍스트 스위칭과 메모리(스레드마다 스택) 비용이 커져요. DB 커넥션처럼 다른 자원이 병목이면 스레드만 늘려도 빨라지지 않아요.</td></tr>
          <tr><td>지역 변수도 공유돼서 위험하다</td><td>지역 변수는 스레드마다 자기 스택에 있어서 안전해요. 위험한 건 여러 스레드가 함께 보는 <strong>힙의 객체</strong>(빈의 필드, static 변수 등)예요.</td></tr>
          <tr><td>프로세스끼리도 static 변수로 값을 나눌 수 있다</td><td>프로세스는 메모리가 따로라서 static 변수도 각자 따로예요. 테스트에서 자식 JVM이 바꾼 static 값이 부모에는 0 그대로인 것을 확인해요.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "프로세스와 스레드의 차이를 설명해 주세요"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 프로세스는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>프로세스는 운영체제로부터 독립된 메모리 공간을 받아 실행 중인 프로그램이고, 스레드는 프로세스 안에서 실제로 코드를 실행하는 흐름입니다.</dd>
        <dt>원리</dt><dd>같은 프로세스의 스레드들은 코드, 데이터, 힙을 공유하고 스택과 레지스터만 각자 가집니다. 그래서 스레드는 만들고 전환하는 비용이 작고 데이터를 바로 공유할 수 있습니다.</dd>
        <dt>트레이드오프</dt><dd>대신 공유 자원에 동시에 접근하면 경쟁 상태가 생겨 동기화가 필요하고, 한 스레드의 문제가 프로세스 전체에 영향을 줍니다. 프로세스는 무겁고 통신에 IPC가 필요하지만 서로 격리됩니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: Spring의 싱글톤 빈은 요청 스레드들이 함께 쓰기 때문에 필드에 요청별 상태를 두지 않고, 동시성 문제가 있는 카운트는 DB 락이나 원자적 연산으로 처리했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 무엇을 공유하는지(힙 공유, 스택은 각자) 말했나요? 공유의 대가(경쟁 상태, 동기화)를 말했나요? 백엔드 서버와 연결했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 JDK 21에서 실제로 프로세스와 스레드를 만들어, 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>자식 프로세스(새 JVM)가 static 변수를 100으로 바꿔도 부모 프로세스의 값은 0, PID도 서로 다름</li>
      <li>다른 스레드가 힙의 객체에 쓴 값을 그대로 읽음</li>
      <li>동기화 없이 두 스레드가 100만 번씩 count++: 200만보다 작은 값이 나옴 (갱신 손실)</li>
      <li>AtomicInteger, synchronized: 정확히 200만</li>
    </ul>
    <p><a href={test}>ProcessAndThreadTest</a></p>
  </section>

  <footer>
    근거: Oracle Java Tutorials의 Processes and Threads, Java 언어 명세 17장(스레드와 락), Spring Boot 공통 애플리케이션 속성(server.tomcat.threads.max). 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .small { font-size: 13px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .mem { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .mem.one { grid-template-columns: minmax(0, 1fr); }
  .proc { border: 2px solid var(--accent); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .proc > strong { color: var(--accent); font-size: 14px; }
  .area { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; font-size: 14px; background: var(--surface); }
  .area.shared { background: var(--ok-soft); border-color: var(--ok); }
  .area.own { background: var(--accent-soft); }
  .stacks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .race { display: grid; grid-template-columns: minmax(0, 1fr) 140px minmax(0, 1fr); gap: 12px; align-items: stretch; }
  .thread-box { border: 1px solid var(--line); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .thread-box.waiting { opacity: 0.55; }
  .steps { margin: 0; padding-left: 20px; font-size: 14px; }
  .steps li.done { color: var(--muted); text-decoration: line-through; }
  .steps li.next { color: var(--accent); font-weight: 700; }
  .reg { font-family: var(--font-mono); font-size: 14px; }
  .memory-cell { border: 2px dashed var(--query); border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 12px; }
  @media (max-width: 760px) {
    .mem, .race { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { exact: '항상 정확히 200만', less: '200만보다 작을 수 있다', million: '항상 100만' };
  var pred = { p1: store('pt-p1') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + '. 정답은 "200만보다 작을 수 있다"예요. 3장에서 왜 그런지 직접 확인해 보세요.';
  }
  ['p1'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('pt-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 메모리 구조 */
  function area(name, cls) { return '<div class="area ' + cls + '">' + name + '</div>'; }
  function renderMem(mode) {
    var el = document.getElementById('mem'), note = document.getElementById('mem-note');
    if (mode === 'process') {
      el.className = 'mem';
      el.innerHTML = [1, 2].map(function (n) {
        return '<div class="proc"><strong>프로세스 ' + n + ' (PID ' + (4200 + n) + ')</strong>' + area('코드', 'own') + area('데이터 (static 변수)', 'own') + area('힙 (객체)', 'own') + area('스택', 'own') + '</div>';
      }).join('');
      note.innerHTML = '<strong>모든 영역이 따로예요.</strong> 프로세스 1이 static 변수를 바꿔도 프로세스 2는 모르고, 데이터를 주고받으려면 소켓이나 파일 같은 프로세스 간 통신(IPC)이 필요해요.';
    } else {
      el.className = 'mem one';
      el.innerHTML = '<div class="proc"><strong>프로세스 1 (PID 4201)</strong>' + area('코드 · 공유', 'shared') + area('데이터 (static 변수) · 공유', 'shared') + area('힙 (객체) · 공유', 'shared') +
        '<div class="stacks">' + area('스레드 A의 스택 + 레지스터', 'own') + area('스레드 B의 스택 + 레지스터', 'own') + '</div></div>';
      note.innerHTML = '<strong>초록색은 함께 써요.</strong> 스레드 A가 힙의 객체를 바꾸면 B도 바로 그 값을 봐요. 지역 변수는 각자의 스택에 있어서 공유되지 않아요. 편하지만, 동시에 같은 객체를 바꾸면 3장의 문제가 생겨요.';
    }
  }
  pressGroup(document.getElementById('mem-mode'), renderMem);
  renderMem('process');

  /* 3. 경쟁 상태 */
  var R;
  var stepNames = ['읽기', '더하기', '쓰기'];
  function resetRace() {
    R = { mem: 0, a: { step: 0, reg: null }, b: { step: 0, reg: null }, lockHolder: null, log: [] };
    document.getElementById('race-note').textContent = 'A와 B의 버튼을 원하는 순서로 눌러 보세요. 각자 읽기 → 더하기 → 쓰기를 한 번씩 하면 끝나요.';
    renderRace();
  }
  function step(name) {
    var t = R[name], other = name === 'a' ? 'b' : 'a', locked = document.getElementById('race-lock').checked, label = name.toUpperCase();
    if (t.step >= 3) return;
    if (locked && R.lockHolder && R.lockHolder !== name) {
      document.getElementById('race-note').textContent = '스레드 ' + R.lockHolder.toUpperCase() + '가 락을 잡고 있어서 ' + label + '는 기다려요. 한 번에 한 스레드만 세 단계를 끝까지 실행해요.';
      return;
    }
    if (locked && t.step === 0) R.lockHolder = name;
    if (t.step === 0) { t.reg = R.mem; R.log.push(label + ': 메모리에서 ' + R.mem + '을(를) 읽음'); }
    else if (t.step === 1) { t.reg = t.reg + 1; R.log.push(label + ': 레지스터 값에 1을 더해 ' + t.reg); }
    else { R.mem = t.reg; R.log.push(label + ': 메모리에 ' + t.reg + '을(를) 씀'); if (locked) R.lockHolder = null; }
    t.step++;
    var note = '';
    if (R.a.step === 3 && R.b.step === 3) {
      note = R.mem === 2 ? '결과 2. 두 스레드가 겹치지 않고 차례로 실행돼서 정확해요.' : '결과 ' + R.mem + '. 둘 다 1을 더했는데 하나가 사라졌어요. 두 스레드가 같은 값(0)을 읽었기 때문이에요.';
    } else if (t.step === 1 && R[other].step > 0 && R[other].step < 3) {
      note = '두 스레드가 모두 읽기를 했고 아직 쓰지 않았어요. 둘 다 같은 값을 들고 있어서 위험한 순간이에요.';
    } else {
      note = label + ' ' + stepNames[t.step - 1] + ' 완료.';
    }
    document.getElementById('race-note').textContent = note;
    renderRace();
  }
  function renderRace() {
    document.getElementById('mem-count').textContent = R.mem;
    ['a', 'b'].forEach(function (n) {
      var t = R[n];
      document.getElementById('r' + n).textContent = t.reg === null ? '-' : t.reg;
      document.querySelectorAll('#t' + n + ' .steps li').forEach(function (li, i) {
        li.className = i < t.step ? 'done' : (i === t.step ? 'next' : '');
      });
      document.getElementById('btn-' + n).disabled = t.step >= 3;
      document.getElementById('t' + n).classList.toggle('waiting', !!(R.lockHolder && R.lockHolder !== n));
    });
    document.getElementById('race-log').innerHTML = R.log.length ? R.log.map(function (l, i) { return '<div class="row"><span class="n">' + (i + 1) + '</span><span>' + esc(l) + '</span></div>'; }).join('') : '<div class="empty">아직 실행하지 않았어요</div>';
  }
  document.getElementById('btn-a').addEventListener('click', function () { step('a'); });
  document.getElementById('btn-b').addEventListener('click', function () { step('b'); });
  document.getElementById('race-reset').addEventListener('click', resetRace);
  document.getElementById('race-lock').addEventListener('change', resetRace);
  document.getElementById('race-bad').addEventListener('click', function () {
    resetRace();
    ['a', 'b', 'a', 'b', 'a', 'b'].forEach(function (n) { step(n); });
    if (document.getElementById('race-lock').checked) {
      step('b'); step('b'); step('b');
      document.getElementById('race-note').textContent = 'synchronized에서는 B가 A가 끝날 때까지 기다려서 겹칠 수 없어요. 결과 ' + R.mem + '.';
    }
  });
  resetRace();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '같은 프로세스의 두 스레드가 공유하지 않는 것은?', o: ['힙의 객체', 'static 변수', '지역 변수(스택)'], a: 2, e: '스택은 스레드마다 따로 있어요. 그래서 지역 변수는 다른 스레드와 섞이지 않아요.' },
    { q: 'Spring 컨트롤러(싱글톤 빈)의 필드에 요청마다 바뀌는 값을 저장하면?', o: ['요청마다 새 객체라 안전하다', '모든 요청 스레드가 같은 객체를 써서 경쟁 상태가 생긴다'], a: 1, e: '싱글톤 빈은 객체가 하나라 요청 스레드들이 함께 써요.' },
    { q: '서버 두 대(프로세스 2개)에서 같은 쿠폰 수량을 관리할 때 AtomicInteger로 충분한가요?', o: ['충분하다', '충분하지 않다'], a: 1, e: '프로세스는 메모리를 공유하지 않아서 각 서버의 AtomicInteger는 따로예요. 공유 상태는 DB나 Redis에 둬야 해요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('pt-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('pt-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
