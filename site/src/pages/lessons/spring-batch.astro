---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/batch/SpringBatchTest.java`;
const impl = `${repo}/blob/main/verification/src/main/java/lab/devlessons/batch/ImportJobConfig.java`;

const codeJob = `@Bean
Job importJob(JobRepository jobRepository, Step importStep) {
    return new JobBuilder("importJob", jobRepository)
            .start(importStep)
            .build();
}

@Bean
Step importStep(JobRepository jobRepository, PlatformTransactionManager tx,
                ItemReader<Integer> reader, ItemWriter<Integer> writer) {
    return new StepBuilder("importStep", jobRepository)
            .<Integer, Integer>chunk(10, tx)   // 10건마다 한 트랜잭션
            .reader(reader)
            .processor(item -> item)
            .writer(writer)
            .build();
}`;

const codeLoop = `// 청크 하나가 처리되는 방식 (개념 코드)
트랜잭션 시작
  items = []
  10번 반복: item = reader.read(); items.add(processor.process(item))
  writer.write(items)              // 10건을 한 번에
  ExecutionContext에 "읽은 개수" 저장
커밋                                // 실패하면 이 10건만 롤백`;

const codeReader = `public class NumberReader extends AbstractItemCountingItemStreamItemReader<Integer> {
    public NumberReader() { setName("numberReader"); }   // 저장 키: numberReader.read.count

    @Override protected Integer doRead() { ... }
    @Override protected void jumpToItem(int itemIndex) { index = itemIndex; } // 재시작 시 건너뛰기
}

@Bean
@StepScope                     // Step 실행마다 새 리더 (상태가 섞이지 않게)
NumberReader numberReader() { return new NumberReader(); }`;

const codeSkip = `.<Integer, Integer>chunk(10, tx)
.reader(reader).processor(processor).writer(writer)
.faultTolerant()
.skip(IllegalArgumentException.class)   // 잘못된 데이터는 건너뛰고
.skipLimit(5)                           // 5건을 넘으면 Job 실패
.retry(TransientDataAccessException.class)  // 일시적 오류는 다시 시도
.retryLimit(3)`;
---
<Base title="스프링 배치: 청크 처리와 재시작 · Dev Lessons" description="25건을 청크 10으로 처리하다 17번째에서 실패하면 무엇이 남고, 재시작하면 어디서부터 하나요? 시뮬레이터로 청크 커밋과 재시작을 직접 돌려 보고 JobInstance, ExecutionContext, skip까지 배워요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Batch · 개념 학습 · 약 35분 · 선수 레슨: <a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>, <a href="/dev-lessons/lessons/spring-beans/">스프링 빈</a></p>
    <h1>스프링 배치: 청크 처리와 재시작</h1>
    <p class="lede">수십만 건을 처리하는 배치가 중간에 죽었다면, 처음부터 다시 돌릴까요? 이미 처리한 건은 어떻게 될까요? 스프링 배치의 핵심은 <strong>청크 단위로 커밋하고, 어디까지 했는지 기록해 두었다가 거기서부터 다시 시작</strong>하는 거예요. 직접 실패시키고 재시작해 보며 배워요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 커밋과 롤백(<a href="/dev-lessons/lessons/tx-basics/">트랜잭션 기초</a>), 빈과 <code>@Bean</code>(<a href="/dev-lessons/lessons/spring-beans/">스프링 빈</a>), SQL의 LIMIT·OFFSET.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#model"><span>1</span>배치의 구성 요소</a>
      <a href="#chunk"><span>2</span>청크 처리</a>
      <a href="#sim"><span>3</span>실패시키고 재시작하기</a>
      <a href="#restart"><span>4</span>재시작의 조건</a>
      <a href="#skip"><span>5</span>skip과 retry</a>
      <a href="#tips"><span>6</span>실무 함정</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>17번째에서 실패하면 몇 건이 남을까요?</h2>
    <p>1부터 25까지 25건을 청크 크기 10으로 DB에 저장하는 배치가, 17번째 항목을 처리하다 예외로 실패했어요.</p>
    <div class="panel">
      <div class="field">
        <span class="label">DB에 남은 건수는</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="0" aria-pressed="false">0건 (전부 롤백)</button>
          <button class="chip" type="button" data-v="10" aria-pressed="false">10건</button>
          <button class="chip" type="button" data-v="16" aria-pressed="false">16건</button>
          <button class="chip" type="button" data-v="17" aria-pressed="false">17건</button>
        </div>
      </div>
      <div class="field">
        <span class="label">원인을 고치고 같은 파라미터로 다시 실행하면</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="1" aria-pressed="false">1번부터 다시 (중복 오류)</button>
          <button class="chip" type="button" data-v="11" aria-pressed="false">11번부터 이어서</button>
          <button class="chip" type="button" data-v="17" aria-pressed="false">17번부터 이어서</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 3장 시뮬레이터에서 직접 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="model" class="read">
    <p class="eyebrow">1 · 배치의 구성 요소</p>
    <h2>Job, Step, 그리고 실행 기록</h2>
    <p><strong>배치</strong>는 사용자 요청을 기다리지 않고, 정해진 때에 많은 데이터를 한꺼번에 처리하는 작업이에요(예: 매일 밤 정산, 만료 처리). 웹 요청은 한 건을 빨리 처리하고 끝나지만, 배치는 수십만 건을 오래 처리하니 <strong>중간에 실패했을 때 어디서부터 다시 할지</strong>가 핵심이에요. 스프링 배치는 이걸 돕는 스프링 모듈이에요.</p>
    <ul>
      <li><strong>Job:</strong> 배치 작업 하나 (예: "매일 밤 정산 데이터 적재"). 여러 Step으로 이뤄져요.</li>
      <li><strong>Step:</strong> 실제 처리 단위. 대부분 <strong>Reader → Processor → Writer</strong>로 읽고, 가공하고, 써요. 단순 작업은 Tasklet 하나로 끝내기도 해요.</li>
      <li><strong>JobParameters:</strong> 실행 조건 (예: 기준일 2026-11-16).</li>
      <li><strong>JobInstance:</strong> Job + JobParameters 한 묶음. "11월 16일자 정산"이라는 논리적 실행이에요.</li>
      <li><strong>JobExecution:</strong> JobInstance를 실제로 돌린 시도 한 번. 실패 후 재시작하면 같은 JobInstance에 JobExecution이 하나 더 생겨요.</li>
      <li><strong>ExecutionContext:</strong> Step이 "어디까지 했는지"를 저장하는 공간. 재시작의 핵심이에요.</li>
    </ul>
    <p>이 기록은 모두 <strong>JobRepository</strong>를 통해 DB의 메타데이터 테이블(<code>BATCH_JOB_INSTANCE</code>, <code>BATCH_JOB_EXECUTION</code>, <code>BATCH_STEP_EXECUTION</code> 등)에 저장돼요. 배치가 죽어도 기록은 DB에 남아요.</p>
    <pre set:text={codeJob} />
  </section>

  <section id="chunk" class="read">
    <p class="eyebrow">2 · 청크 처리</p>
    <h2>N건씩 묶어서 한 트랜잭션</h2>
    <p>청크 지향 처리는 항목을 하나씩 읽고 가공해서 모았다가, 정해진 개수(청크 크기)가 되면 한 번에 쓰고 커밋해요.</p>
    <pre set:text={codeLoop} />
    <div class="table-wrap">
      <table>
        <thead><tr><th>방식</th><th>장점</th><th>단점</th></tr></thead>
        <tbody>
          <tr><td>전체를 한 트랜잭션</td><td>전부 되거나 전부 안 되거나</td><td>수십만 건이면 트랜잭션이 너무 길고, 마지막에 실패하면 처음부터</td></tr>
          <tr><td>건마다 커밋</td><td>실패 범위가 1건</td><td>커밋이 수십만 번이라 느림</td></tr>
          <tr><td><strong>청크마다 커밋</strong></td><td>적당한 크기로 묶어 빠르고, 실패해도 그 청크만 롤백</td><td>청크 크기를 정해야 함</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">3 · 실패시키고 재시작하기</p>
      <h2>25건, 청크 10, 17번째에서 실패</h2>
      <p>"실행"으로 Job을 돌리고, 실패하면 "원인 고치고 재시작"을 눌러 보세요. 같은 파라미터로 다시 돌리는 거예요. 테스트로 확인한 동작 그대로예요.</p>
    </div>
    <div class="panel">
      <div class="field">
        <span class="label">청크 크기</span>
        <div class="seg" id="b-size">
          <button type="button" data-v="5" aria-pressed="false">5</button>
          <button type="button" data-v="10" aria-pressed="true">10</button>
        </div>
      </div>
      <div class="field">
        <span class="label">실패 지점</span>
        <div class="seg" id="b-fail">
          <button type="button" data-v="0" aria-pressed="false">없음</button>
          <button type="button" data-v="17" aria-pressed="true">17번째 항목</button>
        </div>
      </div>
      <div class="items" id="b-items" aria-label="25개 항목의 상태"></div>
      <div class="legend"><span class="it ok"></span>커밋됨 <span class="it rb"></span>롤백됨 <span class="it"></span>아직</div>
      <div class="actions">
        <button class="btn primary" type="button" id="b-run">실행 (새 파라미터)</button>
        <button class="btn" type="button" id="b-restart">원인 고치고 재시작 (같은 파라미터)</button>
      </div>
      <div class="b-meta">
        <div><span class="label">DB에 저장된 건수</span><span class="big" id="b-rows">0</span></div>
        <div><span class="label">ExecutionContext</span><span class="mono" id="b-ctx">-</span></div>
      </div>
      <div class="log" id="b-log"></div>
    </div>
  </section>

  <section id="restart" class="read">
    <p class="eyebrow">4 · 재시작의 조건</p>
    <h2>재시작은 공짜가 아니에요</h2>
    <p>0장의 답은 <strong>10건</strong>, 재시작은 <strong>11번부터</strong>예요. 첫 청크는 커밋됐고, 실패한 두 번째 청크는 통째로 롤백됐어요. 재시작하면 ExecutionContext에 저장된 "읽은 개수 10"을 보고 11번부터 읽어요. 이렇게 되려면 조건이 있어요.</p>
    <ol>
      <li><strong>리더가 상태를 저장해야 해요.</strong> 스프링 배치가 제공하는 대부분의 리더(파일, DB 조회 등)는 읽은 위치를 저장해요. 직접 만든 리더라면 직접 구현해야 해요.</li>
      <li><strong>같은 JobParameters로 실행해야 해요.</strong> 파라미터가 다르면 새 JobInstance라서 처음부터 시작해요.</li>
      <li><strong>완료된 JobInstance는 다시 못 돌려요.</strong> 같은 파라미터로 실행하면 <code>JobInstanceAlreadyCompleteException</code>이에요. 그래서 매일 도는 배치는 보통 기준일을 파라미터로 넣어요.</li>
    </ol>
    <pre set:text={codeReader} />
    <div class="callout warn">
      <strong>롤백되지 않는 것도 있어요.</strong> DB 쓰기는 청크 트랜잭션과 함께 롤백되지만, 청크 안에서 보낸 이메일이나 외부 API 호출은 되돌릴 수 없어요. 재시작하면 그 청크가 다시 처리되니 외부 호출도 다시 나가요. 그래서 writer는 <a href="/dev-lessons/lessons/idempotency/">멱등하게</a> 만드는 게 안전해요.
    </div>
    <p class="muted">전체 코드: <a href={impl}>ImportJobConfig.java</a></p>
  </section>

  <section id="skip" class="read">
    <p class="eyebrow">5 · skip과 retry</p>
    <h2>나쁜 데이터 몇 건 때문에 전체를 멈추지 않기</h2>
    <pre set:text={codeSkip} />
    <ul>
      <li><strong>skip:</strong> 지정한 예외가 나는 항목은 건너뛰고 계속해요. 25건 중 7, 14, 21이 잘못된 데이터면 22건이 저장되고 Job은 성공해요. 건너뛴 항목은 <code>SkipListener</code>로 기록해 두고 나중에 처리해요.</li>
      <li><strong>skipLimit:</strong> 건너뛴 건수가 한도를 넘으면 실패시켜요. 데이터 전체가 이상한데 조용히 다 건너뛰는 걸 막아요.</li>
      <li><strong>retry:</strong> 일시적인 오류(락 경합, 네트워크)는 몇 번 다시 시도해요. 데이터 자체가 잘못된 건 retry해도 소용없으니 skip 대상이에요.</li>
    </ul>
  </section>

  <section id="tips" class="read">
    <p class="eyebrow">6 · 실무 함정</p>
    <h2>자주 겪는 문제</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>함정</th><th>설명</th><th>대응</th></tr></thead>
        <tbody>
          <tr><td>처리하며 조회 조건을 바꿈</td><td>"status = 대기"를 페이지로 읽으며 status를 완료로 바꾸면, OFFSET 기반 페이징(앞에서부터 N개를 건너뛰고 읽기)은 다음 페이지가 밀려 건너뛰는 행이 생길 수 있어요</td><td>DB 결과를 한 줄씩 이어 읽는 커서 기반 리더, 또는 "마지막으로 읽은 id 다음부터" 읽는 방식</td></tr>
          <tr><td>청크 크기를 감으로</td><td>너무 작으면 커밋이 많아 느리고, 너무 크면 롤백 범위와 메모리가 커져요</td><td>측정해서 정하고, 리더의 페이지 크기와 맞춰요</td></tr>
          <tr><td>운영 DB에 한 번에 대량 쓰기</td><td>락과 부하가 몰려 서비스에 영향을 줘요</td><td>다음 레슨 <strong>대량 DML 안전하게 하기</strong></td></tr>
        </tbody>
      </table>
    </div>
    <p class="muted">이 장의 내용은 설계상의 주의로, 테스트로 재현하지는 않았어요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "스프링 배치의 청크 처리와 실패 시 재시작은 어떻게 동작하나요?"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 청크 처리는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>청크 지향 처리는 Reader로 한 건씩 읽고 Processor로 가공해 청크 크기만큼 모은 뒤, Writer로 한 번에 쓰고 커밋하는 방식입니다. 청크마다 하나의 트랜잭션입니다.</dd>
        <dt>원리</dt><dd>청크가 커밋될 때 리더의 읽은 위치 같은 상태가 ExecutionContext에 저장되고 JobRepository를 통해 메타데이터 테이블에 남습니다. 중간에 실패하면 실패한 청크만 롤백되고, 같은 JobParameters로 재실행하면 같은 JobInstance의 새 JobExecution으로 마지막 커밋 지점 다음부터 이어서 처리합니다. 완료된 인스턴스는 다시 실행할 수 없습니다.</dd>
        <dt>트레이드오프</dt><dd>청크 크기가 작으면 커밋이 많아 느리고, 크면 롤백 범위와 메모리가 커집니다. 재시작이 되려면 리더가 상태를 저장해야 하고, 외부 호출 같은 부수 효과는 롤백되지 않으니 writer를 멱등하게 만들어야 합니다. 잘못된 데이터는 skip, 일시적 오류는 retry로 다룹니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 실패 후 재시작 테스트로 마지막 커밋 지점부터 이어서 처리되고 중복이 생기지 않는 것을 확인했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: 청크 = 트랜잭션, ExecutionContext, JobInstance와 JobExecution의 차이, 같은 파라미터로 재시작을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 스프링 배치 5와 PostgreSQL에서 Job을 돌려, 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>25건, 청크 10: writer는 10, 10, 5건씩 세 번, 25건 저장</li>
      <li>17번째에서 실패: Job FAILED, 10건만 남음, ExecutionContext의 numberReader.read.count = 10</li>
      <li>같은 파라미터로 재시작: 같은 JobInstance, 15건만 읽어 처리, 중복 없이 25건 (대상 테이블의 기본 키가 중복을 막음)</li>
      <li>완료된 JobInstance를 같은 파라미터로 실행: JobInstanceAlreadyCompleteException</li>
      <li>skip: 7, 14, 21을 건너뛰고 22건 저장, Job 성공, processSkipCount = 3</li>
    </ul>
    <p><a href={test}>SpringBatchTest</a></p>
  </section>

  <footer>
    근거: Spring Batch 참조 문서의 The Domain Language of Batch, Chunk-oriented Processing, Restartability. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .items { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 4px; }
  .it { display: inline-flex; align-items: center; justify-content: center; height: 32px; border-radius: 4px; border: 1px solid var(--line); font-family: var(--font-mono); font-size: 12px; }
  .legend .it { width: 18px; height: 14px; vertical-align: middle; margin: 0 4px 0 10px; }
  .legend { font-size: 13px; color: var(--muted); }
  .it.ok { background: var(--ok-soft); border-color: var(--ok); }
  .it.rb { background: repeating-linear-gradient(45deg, var(--query-soft), var(--query-soft) 4px, transparent 4px, transparent 8px); border-color: var(--query); }
  .it.chunk-start { box-shadow: inset 3px 0 0 var(--accent); }
  .b-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .b-meta > div { display: flex; flex-direction: column; gap: 2px; }
  .b-meta .big { font-size: 36px; }
  @media (max-width: 520px) { .items { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  var p1l = { '0': '0건', '10': '10건', '16': '16건', '17': '17건' }, p2l = { '1': '1번부터 다시', '11': '11번부터 이어서', '17': '17번부터 이어서' };
  var pred = { p1: store('ba-p1'), p2: store('ba-p2') };
  function showPred() {
    if (!pred.p1 && !pred.p2) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 ? p1l[pred.p1] : '?') + ', 재시작은 ' + (pred.p2 ? p2l[pred.p2] : '?') + '. 정답은 10건, 11번부터 이어서예요. 3장에서 직접 확인해 보세요.';
  }
  ['p1', 'p2'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('ba-' + k, v); showPred(); });
  });
  showPred();

  /* 3. 청크 시뮬레이터 */
  var TOTAL = 25, size = 10, failOn = 17, B;
  function fresh() { B = { state: [], readCount: 0, status: null, execs: 0, log: [], fixed: false, instance: 0 }; for (var i = 0; i < TOTAL; i++) B.state.push(''); }
  function runFrom(start, failActive) {
    B.execs++;
    var execNo = B.execs;
    B.log.push('JobExecution #' + execNo + ' 시작 (JobInstance #' + B.instance + '), ' + (start + 1) + '번부터 읽음');
    for (var i = start; i < TOTAL; i += size) {
      var end = Math.min(i + size, TOTAL);
      if (failActive && failOn > i && failOn <= end) {
        for (var j = i; j < end; j++) B.state[j] = 'rb';
        B.log.push('청크 ' + (i + 1) + '~' + end + ': ' + failOn + '번 처리 중 예외 → 이 청크 롤백');
        B.status = 'FAILED';
        B.log.push('JobExecution #' + execNo + ' FAILED. ExecutionContext의 read.count = ' + B.readCount);
        return;
      }
      for (var k = i; k < end; k++) B.state[k] = 'ok';
      B.readCount = end;
      B.log.push('청크 ' + (i + 1) + '~' + end + ': ' + (end - i) + '건 쓰고 커밋, read.count = ' + end);
    }
    B.status = 'COMPLETED';
    B.log.push('JobExecution #' + execNo + ' COMPLETED');
  }
  function render(note) {
    var html = '';
    for (var i = 0; i < TOTAL; i++) html += '<span class="it ' + B.state[i] + (i % size === 0 ? ' chunk-start' : '') + '">' + (i + 1) + '</span>';
    document.getElementById('b-items').innerHTML = html;
    document.getElementById('b-rows').textContent = B.state.filter(function (s) { return s === 'ok'; }).length;
    document.getElementById('b-ctx').textContent = B.status ? 'numberReader.read.count = ' + B.readCount : '-';
    var logs = B.log.slice(); if (note) logs.push(note);
    document.getElementById('b-log').innerHTML = logs.length ? logs.map(function (l) { return '<div class="row note">' + esc(l) + '</div>'; }).join('') : '<div class="empty">실행을 눌러 보세요</div>';
    document.getElementById('b-restart').disabled = !B.status;
  }
  document.getElementById('b-run').addEventListener('click', function () {
    var inst = B.instance + 1; fresh(); B.instance = inst;
    runFrom(0, failOn > 0); render();
  });
  document.getElementById('b-restart').addEventListener('click', function () {
    if (B.status === 'COMPLETED') { render('같은 파라미터로 실행 → JobInstanceAlreadyCompleteException. 완료된 인스턴스는 다시 돌릴 수 없어요.'); return; }
    for (var i = 0; i < TOTAL; i++) if (B.state[i] === 'rb') B.state[i] = '';
    runFrom(B.readCount, false); render();
  });
  pressGroup(document.getElementById('b-size'), function (v) { size = +v; fresh(); render(); });
  pressGroup(document.getElementById('b-fail'), function (v) { failOn = +v; fresh(); render(); });
  fresh(); render();

  /* 7. 확인 문제 */
  var quiz = [
    { q: '청크 크기 100으로 1,000건을 처리하다 450번째에서 실패했다. DB에 남는 건수는?', o: ['0건', '400건', '449건', '450건'], a: 1, e: '1~400은 네 청크로 커밋됐고, 401~500 청크는 통째로 롤백돼요.' },
    { q: '실패한 Job을 다른 JobParameters로 다시 실행하면?', o: ['마지막 커밋 지점부터 이어서', '새 JobInstance라서 처음부터'], a: 1, e: '재시작은 같은 JobInstance(같은 Job + 같은 파라미터)일 때만 이어서 해요.' },
    { q: '청크 안에서 알림 메일을 보내는 writer가 실패 후 재시작되면?', o: ['메일도 롤백되어 한 번만 간다', '그 청크가 다시 처리되며 메일이 다시 갈 수 있다'], a: 1, e: '외부 부수 효과는 롤백되지 않아요. writer를 멱등하게 만들어요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('ba-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('ba-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
