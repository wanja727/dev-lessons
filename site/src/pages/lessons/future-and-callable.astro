---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const test = `${repo}/blob/main/verification/src/test/java/lab/devlessons/concurrency/FutureTest.java`;

const codePredict = `ExecutorService pool = Executors.newFixedThreadPool(3);

// 세 작업은 각각 1초씩 걸린다
Future<Rate>  rate  = pool.submit(() -> rateApi.fetch());
Future<Price> price = pool.submit(() -> priceApi.fetch());
Future<News>  news  = pool.submit(() -> newsApi.fetch());

Rate r  = rate.get();
Price p = price.get();
News n  = news.get();`;

const codeRunnable = `// Runnable: 결과도 없고, 체크 예외도 못 던진다
Runnable log = () -> System.out.println("기록");

// Callable: 결과를 돌려주고, 예외를 던질 수 있다
Callable<Price> fetch = () -> priceApi.fetch();

Future<?>     f1 = pool.submit(log);    // f1.get()은 null
Future<Price> f2 = pool.submit(fetch);  // f2.get()은 Price`;

const codeApi = `Future<Price> future = pool.submit(() -> priceApi.fetch());

future.isDone();                      // 끝났나? (기다리지 않음)
future.get();                         // 끝날 때까지 기다렸다가 결과
future.get(500, TimeUnit.MILLISECONDS); // 최대 0.5초만 기다림
future.cancel(true);                  // 취소, 실행 중이면 인터럽트
future.isCancelled();`;

const codeException = `try {
    Price p = future.get(1, TimeUnit.SECONDS);
} catch (ExecutionException e) {
    Throwable cause = e.getCause();   // 작업 안에서 난 진짜 예외
} catch (TimeoutException e) {
    future.cancel(true);              // 기다리기를 포기했으면 작업도 정리
} catch (InterruptedException e) {
    Thread.currentThread().interrupt();
}`;

const codeFutureStyle = `Future<Rate>  rate  = pool.submit(() -> rateApi.fetch());
Future<Price> price = pool.submit(() -> priceApi.fetch());

// 결과를 합치려면 결국 get()으로 기다려야 한다
Quote q = new Quote(rate.get(), price.get());`;

const codeCfStyle = `CompletableFuture<Rate>  rate  = CompletableFuture.supplyAsync(() -> rateApi.fetch(), pool);
CompletableFuture<Price> price = CompletableFuture.supplyAsync(() -> priceApi.fetch(), pool);

// 기다리지 않고 "둘 다 끝나면 할 일"을 등록한다
CompletableFuture<Quote> quote = rate
    .thenCombine(price, Quote::new)
    .exceptionally(e -> Quote.empty());  // 실패하면 기본값`;

const codeBug = ` 1  ExecutorService pool = Executors.newFixedThreadPool(3);
 2
 3  Future<Rate> rate = pool.submit(() -> rateApi.fetch());
 4  Rate r = rate.get();
 5  Future<Price> price = pool.submit(() -> priceApi.fetch());
 6  Price p = price.get();
 7  Future<News> news = pool.submit(() -> newsApi.fetch());
 8  News n = news.get();`;
---
<Base title="Future와 Callable · Dev Lessons" description="자바 Future와 Callable을 처음 배우는 사람을 위한 레슨. 스레드 타임라인 시뮬레이터로 get()의 블로킹, 타임아웃, 예외를 직접 확인하고 CompletableFuture로 이어져요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Java 동시성 · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/process-and-thread/">프로세스와 스레드</a></p>
    <h1>Future와 Callable</h1>
    <p class="lede">외부 API 세 개를 호출해야 하는데 하나에 1초씩 걸린다면, 차례로 부르면 3초예요. 다른 스레드들에 동시에 맡기면 1초면 되죠. 그때 "맡긴 작업의 결과를 나중에 받는 방법"이 Future예요. 결과를 받는 순간 무슨 일이 생기는지 타임라인으로 직접 확인해요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> 자바 기초, 람다, 체크 예외와 try-catch, <a href="/dev-lessons/lessons/thread-pool/">스레드 풀</a>.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#background"><span>1</span>작업을 맡기는 법</a>
      <a href="#future"><span>2</span>Future의 메서드</a>
      <a href="#sim"><span>3</span>타임라인</a>
      <a href="#exceptions"><span>4</span>예외와 취소</a>
      <a href="#limits"><span>5</span>한계와 CompletableFuture</a>
      <a href="#traps"><span>6</span>함정</a>
      <a href="#check"><span>7</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>총 몇 초가 걸릴까요?</h2>
    <p>스레드 3개짜리 풀에 1초짜리 작업 세 개를 맡기고, 결과를 차례로 받아요.</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">마지막 줄까지 걸리는 시간은?</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="1" aria-pressed="false">약 1초</button>
          <button class="chip" type="button" data-v="3" aria-pressed="false">약 3초</button>
        </div>
      </div>
      <div class="field">
        <span class="label">priceApi.fetch()에서 예외가 나면 어디서 알 수 있을까?</span>
        <div class="choice-row" id="p2">
          <button class="chip" type="button" data-v="submit" aria-pressed="false">submit 하는 줄</button>
          <button class="chip" type="button" data-v="get" aria-pressed="false">price.get() 하는 줄</button>
          <button class="chip" type="button" data-v="none" aria-pressed="false">알 수 없다</button>
        </div>
      </div>
      <div class="field">
        <span class="label">확신도</span>
        <div class="choice-row" id="p3">
          <button class="chip" type="button" data-v="확실" aria-pressed="false">확실</button>
          <button class="chip" type="button" data-v="애매" aria-pressed="false">애매</button>
          <button class="chip" type="button" data-v="모름" aria-pressed="false">모름</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 3장 타임라인에서 직접 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="background" class="read">
    <p class="eyebrow">1 · 작업을 맡기는 법</p>
    <h2>스레드 풀, Runnable, Callable</h2>
    <p>스레드를 작업마다 새로 만들면 비싸요(<a href="/dev-lessons/lessons/process-and-thread/">선수 레슨</a> 참고). 그래서 보통 스레드를 미리 만들어 두고 돌려 쓰는 <strong>스레드 풀</strong>에 작업을 맡겨요. 자바에서는 <code>ExecutorService</code>가 스레드 풀이에요. 풀의 스레드가 모두 바쁘면 남은 작업은 <strong>큐에서 기다려요.</strong></p>
    <p>맡기는 작업은 두 종류예요.</p>
    <pre set:text={codeRunnable} />
    <ul>
      <li><strong>Runnable:</strong> 일만 하고 결과는 없어요.</li>
      <li><strong>Callable:</strong> 결과를 돌려주고 예외도 던질 수 있어요. 외부 API 호출처럼 결과가 필요한 작업은 Callable이에요.</li>
    </ul>
    <p><code>submit()</code>은 작업을 큐에 넣고 <strong>바로</strong> 돌아와요. 작업이 끝나길 기다리지 않아요. 대신 <strong>Future</strong>를 돌려줘요.</p>
  </section>

  <section id="future" class="read">
    <p class="eyebrow">2 · Future의 메서드</p>
    <h2>나중에 결과를 받는 표</h2>
    <p>Future는 식당의 주문 번호표 같은 거예요. 주문(submit)하면 번호표를 받고, 음식이 나오면 그 번호표로 받아 가요. 정확히는 <strong>아직 끝나지 않았을 수도 있는 작업의 결과를 가리키는 객체</strong>예요.</p>
    <pre set:text={codeApi} />
    <div class="callout warn">
      <strong>핵심은 get()이 블로킹이라는 점이에요.</strong> 작업이 아직 안 끝났으면 get()을 부른 스레드는 결과가 나올 때까지 <strong>멈춰서 기다려요.</strong> 그 사이 그 스레드는 다른 일을 못 해요. 웹 서버라면 요청을 처리하던 톰캣 스레드가 멈춰 있는 거예요.
    </div>
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">3 · 타임라인</p>
      <h2>스레드들이 실제로 언제 일하고 언제 기다리나</h2>
      <p>메인 스레드가 환율(1초), 시세(2초), 뉴스(1.5초) API 작업을 풀에 맡기고 결과를 차례로 get()해요. 설정을 바꾸면서 빗금 친 <strong>기다리는 구간</strong>과 총 시간을 보세요.</p>
    </div>
    <div class="panel">
      <div class="sim-controls">
        <div class="field">
          <span class="label">스레드 풀 크기</span>
          <div class="seg" id="f-pool">
            <button type="button" data-v="1" aria-pressed="false">1</button>
            <button type="button" data-v="2" aria-pressed="false">2</button>
            <button type="button" data-v="3" aria-pressed="true">3</button>
          </div>
        </div>
        <div class="field">
          <span class="label">호출 방식</span>
          <div class="seg" id="f-mode">
            <button type="button" data-v="all" aria-pressed="true">모두 submit 후 get</button>
            <button type="button" data-v="each" aria-pressed="false">submit 직후 바로 get</button>
          </div>
        </div>
        <div class="field">
          <span class="label">시세 API</span>
          <div class="seg" id="f-fail">
            <button type="button" data-v="ok" aria-pressed="true">정상</button>
            <button type="button" data-v="fail" aria-pressed="false">예외 발생</button>
          </div>
        </div>
        <div class="field">
          <span class="label">get 방식</span>
          <div class="seg" id="f-timeout">
            <button type="button" data-v="none" aria-pressed="true">get()</button>
            <button type="button" data-v="1.5" aria-pressed="false">get(1.5초)</button>
          </div>
        </div>
      </div>
      <div class="count-line"><span class="big" id="f-total">2.0초</span><span class="formula" id="f-formula"></span></div>
      <div class="gantt" id="gantt" aria-label="스레드별 타임라인"></div>
      <p class="verdict" id="f-verdict"></p>
      <div class="log" id="f-log"></div>
    </div>
  </section>

  <section id="exceptions" class="read">
    <p class="eyebrow">4 · 예외와 취소</p>
    <h2>예외는 get()에서 포장된 채로 나와요</h2>
    <p>작업은 다른 스레드에서 실행되니, 그 안에서 난 예외는 submit한 메인 스레드로 바로 날아오지 않아요. Future에 보관됐다가 <strong>get()을 부를 때</strong> <code>ExecutionException</code>으로 감싸져 나와요. 진짜 원인은 <code>getCause()</code>로 꺼내요. 그래서 get()을 부르지 않으면 실패를 영영 모를 수도 있어요.</p>
    <pre set:text={codeException} />
    <ul>
      <li><strong>TimeoutException:</strong> 기다리기를 포기한 것일 뿐, 작업은 계속 돌아요. 필요 없으면 <code>cancel(true)</code>로 정리해요.</li>
      <li><strong>cancel(true):</strong> 실행 중인 스레드에 <strong>인터럽트</strong>를 걸어요. 인터럽트는 스레드에게 "하던 일을 멈춰 달라"고 보내는 신호예요. 작업 코드가 인터럽트에 반응해야(sleep, 블로킹 I/O 등) 실제로 멈춰요. 취소된 Future의 get()은 <code>CancellationException</code>이에요.</li>
      <li><strong>InterruptedException:</strong> 기다리는 중에 내 스레드가 인터럽트되면 나요. 삼키지 말고 인터럽트 상태를 다시 설정해요.</li>
    </ul>
  </section>

  <section id="limits">
    <div class="read stack">
      <p class="eyebrow">5 · 한계와 CompletableFuture</p>
      <h2>"끝나면 이걸 해 줘"라고 말할 수 없어요</h2>
      <p>Future로 결과를 합치거나 이어서 처리하려면 결국 get()으로 기다려야 해요. 결과가 나오면 할 일을 미리 등록할 방법이 없어요. 자바 8에서 추가된 <strong>CompletableFuture</strong>는 이 한계를 보완해요. Future를 구현하면서, 완료되면 실행할 다음 단계를 이어 붙일 수 있어요.</p>
    </div>
    <div class="panel">
      <div class="tabs" role="tablist" id="cf-tabs">
        <button role="tab" type="button" aria-selected="true" aria-controls="tab-f" id="t-f">Future</button>
        <button role="tab" type="button" aria-selected="false" aria-controls="tab-cf" id="t-cf">CompletableFuture</button>
      </div>
      <div class="tab-panel" role="tabpanel" id="tab-f" aria-labelledby="t-f">
        <pre set:text={codeFutureStyle} />
        <p>두 결과를 합치려면 get()을 두 번 불러 메인 스레드가 기다려요. 실패 처리도 try-catch로 직접 해야 해요.</p>
      </div>
      <div class="tab-panel" role="tabpanel" id="tab-cf" aria-labelledby="t-cf" hidden>
        <pre set:text={codeCfStyle} />
        <p>"둘 다 끝나면 합친다", "실패하면 기본값"을 미리 등록하고 메인 스레드는 다른 일을 할 수 있어요. 등록한 단계는 값이 완성되는 순간 실행돼요.</p>
      </div>
    </div>
    <div class="read table-wrap">
      <table>
        <thead><tr><th></th><th>Future</th><th>CompletableFuture</th></tr></thead>
        <tbody>
          <tr><td>결과 받기</td><td>get()으로 기다림</td><td>thenApply, thenAccept로 이어 붙임 (get도 가능)</td></tr>
          <tr><td>여러 결과 합치기</td><td>각각 get()</td><td>thenCombine, allOf</td></tr>
          <tr><td>예외 처리</td><td>get()에서 ExecutionException</td><td>exceptionally, handle</td></tr>
          <tr><td>실행 스레드</td><td>ExecutorService</td><td>지정하지 않으면 공용 풀(ForkJoinPool.commonPool). I/O 작업은 별도 풀을 넘기는 게 좋음</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">6 · 함정</p>
    <h2>코드로 보는 실수</h2>
    <p>세 API를 병렬로 부르려고 스레드 풀을 만들었는데, 총 시간이 세 호출의 합만큼 걸려요. 어느 줄 때문일까요? 답을 먼저 정하고 아래를 보세요.</p>
    <pre set:text={codeBug} />
    <details class="panel">
      <summary>답 보기</summary>
      <p><strong>4번, 6번 줄.</strong> submit 직후 바로 get()으로 기다려서, 다음 작업은 앞 작업이 끝난 뒤에야 맡겨져요. 3장에서 "submit 직후 바로 get"을 고른 것과 같아요. 세 작업을 모두 submit한 뒤에 get()을 불러야 해요. 8번 줄은 마지막이라 순서상 문제가 없어요.</p>
    </details>
    <ul>
      <li><strong>타임아웃 없는 get():</strong> 외부 API가 응답하지 않으면 요청 스레드가 무한정 묶여요. 실무에서는 항상 get(timeout)을 써요.</li>
      <li><strong>풀 정리:</strong> 직접 만든 ExecutorService는 <code>shutdown()</code>해야 스레드가 정리돼요. 스프링에서는 빈으로 등록해 컨테이너가 관리하게 해요.</li>
      <li><strong>풀 크기:</strong> 스레드 수보다 작업이 많으면 큐에서 기다려서 3장처럼 총 시간이 늘어요.</li>
    </ul>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">7 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "자바의 Future 인터페이스에 대해 설명해 주세요"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: Future는 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>Future는 비동기로 실행 중인 작업의 결과를 나타내는 인터페이스입니다. ExecutorService에 Callable을 submit하면 바로 Future를 돌려받고, 나중에 get()으로 결과를 받습니다.</dd>
        <dt>원리</dt><dd>get()은 작업이 끝날 때까지 호출한 스레드를 블로킹하고, get(timeout)으로 대기 시간을 제한할 수 있습니다. 작업 안의 예외는 get()에서 ExecutionException으로 감싸져 나오고, cancel(true)로 실행 중인 작업에 인터럽트를 걸 수 있습니다.</dd>
        <dt>트레이드오프</dt><dd>여러 작업을 병렬로 맡겨 응답 시간을 줄일 수 있지만, 결과를 쓰려면 결국 블로킹해야 하고 결과를 조합하거나 완료 후 처리를 등록할 수 없습니다. 그래서 자바 8부터는 thenCombine, exceptionally 같은 조합이 가능한 CompletableFuture를 주로 씁니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 여러 외부 API를 순차 호출하던 화면을 병렬 호출로 바꾸면서 모두 submit한 뒤 get(timeout)으로 받도록 해 응답 시간을 가장 느린 API 수준으로 줄였습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: get()의 블로킹, 타임아웃, ExecutionException을 말했나요? 한계와 CompletableFuture까지 이어서 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 JDK 21의 실제 스레드 풀로, 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>submit은 즉시 Future를 돌려주고, 작업 중에는 isDone()이 false</li>
      <li>get()은 작업이 끝날 때까지 블로킹, get(timeout)은 TimeoutException이고 작업은 계속 남음</li>
      <li>작업의 예외는 get()에서 ExecutionException으로 감싸져 나옴</li>
      <li>cancel(true)는 실행 중인 스레드를 인터럽트하고, 이후 get()은 CancellationException</li>
      <li>Runnable의 get()은 null, 풀 크기보다 많은 작업은 큐에서 대기</li>
      <li>300ms 작업 3개: 모두 submit 후 get은 0.8초 미만, submit 직후 get은 0.85초 이상</li>
      <li>CompletableFuture: 콜백은 값이 완성되는 순간 실행, thenCombine으로 합치기, exceptionally로 기본값</li>
    </ul>
    <p><a href={test}>FutureTest</a></p>
  </section>

  <footer>
    근거: Java SE 21 API 문서의 Future, ExecutorService, CompletableFuture. 시뮬레이터의 작업 시간은 설명을 위한 값이에요. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .sim-controls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 20px; }
  .gantt { display: flex; flex-direction: column; gap: 6px; }
  .g-row { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 8px; align-items: center; }
  .g-label { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); }
  .g-track { position: relative; height: 30px; background: var(--code-bg); border-radius: 6px; overflow: hidden; }
  .g-bar { position: absolute; top: 3px; bottom: 3px; border-radius: 4px; font-size: 12px; color: var(--surface); display: flex; align-items: center; padding: 0 6px; white-space: nowrap; overflow: hidden; }
  .g-bar.task { background: var(--accent); }
  .g-bar.task.fail { background: var(--query); }
  .g-bar.wait { background: repeating-linear-gradient(45deg, var(--warn-soft), var(--warn-soft) 6px, var(--line) 6px, var(--line) 12px); color: var(--ink); }
  .g-bar.queued { background: transparent; border: 1.5px dashed var(--muted); color: var(--muted); }
  .g-axis { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 8px; }
  .g-ticks { position: relative; height: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .g-ticks span { position: absolute; transform: translateX(-50%); }
  details.panel summary { cursor: pointer; font-weight: 700; }
  @media (max-width: 760px) {
    .sim-controls { grid-template-columns: minmax(0, 1fr); }
    .g-row, .g-axis { grid-template-columns: 56px minmax(0, 1fr); }
  }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var pred = { p1: store('fu-p1'), p2: store('fu-p2'), p3: store('fu-p3') };
  var p2label = { submit: 'submit 하는 줄', get: 'price.get() 하는 줄', none: '알 수 없다' };
  function showPred() {
    if (!pred.p1 && !pred.p2) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + (pred.p1 ? '약 ' + pred.p1 + '초' : '?') + ', 예외는 ' + (pred.p2 ? p2label[pred.p2] : '?') + (pred.p3 ? ' (' + pred.p3 + ')' : '') + '. 정답은 약 1초, price.get() 하는 줄이에요. 3장에서 확인해 보세요.';
  }
  ['p1', 'p2', 'p3'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('fu-' + k, v); showPred(); });
  });
  showPred();

  /* 3. 타임라인 시뮬레이터 */
  var cfg = { pool: 3, mode: 'all', fail: 'ok', timeout: 'none' };
  var TASKS = [{ name: '환율', d: 1.0 }, { name: '시세', d: 2.0 }, { name: '뉴스', d: 1.5 }];
  function f1(x) { return (Math.round(x * 10) / 10).toFixed(1); }
  function simulate() {
    var free = []; for (var i = 0; i < cfg.pool; i++) free.push(0);
    var runs = [], waits = [], log = [], t = 0, stopped = false, outcome = 'ok';
    var to = cfg.timeout === 'none' ? null : parseFloat(cfg.timeout);
    function schedule(idx, submitAt) {
      var k = 0; for (var j = 1; j < free.length; j++) if (free[j] < free[k]) k = j;
      var start = Math.max(submitAt, free[k]), end = start + TASKS[idx].d;
      free[k] = end;
      var r = { idx: idx, thread: k, submit: submitAt, start: start, end: end, fail: cfg.fail === 'fail' && idx === 1 };
      runs[idx] = r;
      log.push('t=' + f1(submitAt) + 's  submit(' + TASKS[idx].name + ')' + (start > submitAt ? '  → 스레드가 없어 ' + f1(start - submitAt) + '초 큐에서 대기' : ''));
      return r;
    }
    function get(idx) {
      var r = runs[idx];
      var deadline = to === null ? Infinity : t + to;
      if (r.end > deadline) {
        waits.push({ from: t, to: deadline, idx: idx });
        log.push('t=' + f1(deadline) + 's  ' + TASKS[idx].name + '.get(1.5초) → TimeoutException (작업은 ' + f1(r.end) + '초까지 계속 실행)');
        t = deadline; outcome = 'timeout'; return false;
      }
      if (r.end > t) waits.push({ from: t, to: r.end, idx: idx });
      t = Math.max(t, r.end);
      if (r.fail) { log.push('t=' + f1(t) + 's  ' + TASKS[idx].name + '.get() → ExecutionException (원인: 시세 API 예외)'); outcome = 'fail'; return false; }
      log.push('t=' + f1(t) + 's  ' + TASKS[idx].name + '.get() → 결과 받음');
      return true;
    }
    if (cfg.mode === 'all') {
      TASKS.forEach(function (_, i) { schedule(i, 0); });
      for (var g = 0; g < TASKS.length && !stopped; g++) stopped = !get(g);
    } else {
      for (var s = 0; s < TASKS.length && !stopped; s++) { schedule(s, t); stopped = !get(s); }
    }
    return { runs: runs.filter(Boolean), waits: waits, log: log, total: t, outcome: outcome };
  }
  function render() {
    var r = simulate();
    var maxT = Math.max(r.total, Math.max.apply(null, r.runs.map(function (x) { return x.end; }))), scale = Math.ceil(maxT + 0.5);
    function pct(x) { return (x / scale * 100) + '%'; }
    var rows = '';
    rows += '<div class="g-row"><span class="g-label">main</span><div class="g-track">' + r.waits.map(function (w) {
      return '<div class="g-bar wait" style="left:' + pct(w.from) + ';width:' + pct(w.to - w.from) + '">' + TASKS[w.idx].name + '.get() 대기</div>';
    }).join('') + '</div></div>';
    for (var k = 0; k < cfg.pool; k++) {
      rows += '<div class="g-row"><span class="g-label">thread-' + (k + 1) + '</span><div class="g-track">' + r.runs.filter(function (x) { return x.thread === k; }).map(function (x) {
        var q = x.start > x.submit ? '<div class="g-bar queued" style="left:' + pct(x.submit) + ';width:' + pct(x.start - x.submit) + '">큐</div>' : '';
        return q + '<div class="g-bar task' + (x.fail ? ' fail' : '') + '" style="left:' + pct(x.start) + ';width:' + pct(x.end - x.start) + '">' + TASKS[x.idx].name + (x.fail ? ' ✕' : '') + '</div>';
      }).join('') + '</div></div>';
    }
    var ticks = ''; for (var s = 0; s <= scale; s++) ticks += '<span style="left:' + pct(s) + '">' + s + 's</span>';
    rows += '<div class="g-axis"><span></span><div class="g-ticks">' + ticks + '</div></div>';
    document.getElementById('gantt').innerHTML = rows;
    document.getElementById('f-total').textContent = f1(r.total) + '초';
    var sum = TASKS.reduce(function (a, x) { return a + x.d; }, 0);
    document.getElementById('f-formula').textContent = '메인 스레드가 마지막 줄을 지난 시각 (작업 시간 합 ' + f1(sum) + '초, 가장 긴 작업 2.0초)';
    var v;
    if (r.outcome === 'fail') v = '시세 API의 예외는 submit할 때가 아니라 시세.get()을 부를 때 ExecutionException으로 나왔어요. 그 뒤의 뉴스 결과는 받지 못했어요.';
    else if (r.outcome === 'timeout') v = '1.5초 안에 끝나지 않은 작업에서 TimeoutException이 났어요. 기다리기를 포기했을 뿐 작업은 계속 돌고 있으니 cancel(true)로 정리해야 해요.';
    else if (cfg.mode === 'each') v = 'submit 직후 바로 get()하면 앞 작업을 기다리는 동안 다음 작업을 맡기지 못해요. 스레드가 ' + cfg.pool + '개여도 사실상 하나씩 실행돼서 총 시간이 작업 시간의 합이에요.';
    else if (cfg.pool < 3) v = '스레드가 ' + cfg.pool + '개라 남은 작업은 큐에서 기다렸다가 실행돼요(점선). 그만큼 총 시간이 늘어요.';
    else if (cfg.timeout !== 'none') v = '모든 get()이 1.5초 안에 결과를 받아서 타임아웃이 나지 않았어요. 풀 크기를 1로 줄이거나 "submit 직후 바로 get"을 골라 보세요.';
    else v = '세 작업이 동시에 실행돼서 총 시간은 가장 긴 작업(시세 2초)만큼이에요. 메인 스레드는 get()에서 기다리지만, 그동안 다른 작업들도 같이 진행돼요.';
    document.getElementById('f-verdict').textContent = v;
    document.getElementById('f-log').innerHTML = r.log.map(function (l) { return '<div class="row note">' + esc(l) + '</div>'; }).join('');
  }
  pressGroup(document.getElementById('f-pool'), function (v) { cfg.pool = +v; render(); });
  pressGroup(document.getElementById('f-mode'), function (v) { cfg.mode = v; render(); });
  pressGroup(document.getElementById('f-fail'), function (v) { cfg.fail = v; render(); });
  pressGroup(document.getElementById('f-timeout'), function (v) { cfg.timeout = v; render(); });
  render();

  /* 5. 탭 */
  var tabs = document.querySelectorAll('#cf-tabs [role="tab"]');
  tabs.forEach(function (tab, idx) {
    tab.addEventListener('click', function () { select(tab); });
    tab.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { var n = tabs[(idx + 1) % tabs.length]; select(n); n.focus(); }
    });
  });
  function select(tab) {
    tabs.forEach(function (t) { var on = t === tab; t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')).hidden = !on; });
  }

  /* 7. 확인 문제 */
  var quiz = [
    { q: '스레드 2개짜리 풀에 1초짜리 작업 3개를 모두 submit한 뒤 차례로 get()하면 총 시간은?', o: ['약 1초', '약 2초', '약 3초'], a: 1, e: '두 작업이 먼저 1초 동안 실행되고, 세 번째 작업은 큐에서 기다렸다가 다음 1초에 실행돼요.' },
    { q: 'future.get(1, SECONDS)에서 TimeoutException이 났어요. 작업은?', o: ['자동으로 취소된다', '계속 실행된다'], a: 1, e: '기다리기를 포기한 것뿐이에요. 필요 없으면 cancel(true)로 정리해요.' },
    { q: 'Callable 안에서 IllegalStateException이 나면 get()에서 받는 예외는?', o: ['IllegalStateException', 'ExecutionException', 'CancellationException'], a: 1, e: '작업의 예외는 ExecutionException으로 감싸지고, 원인은 getCause()로 꺼내요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('fu-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('fu-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
