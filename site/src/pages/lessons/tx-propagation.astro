---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';

const repo = 'https://github.com/wanja727/dev-lessons';
const testDir = `${repo}/blob/main/verification/src/test/java/lab/devlessons/propagation`;

const codePredict = `@Transactional
public void placeOrder(Order order) {                 // OrderService
    orderRepository.save(order);
    try {
        couponService.use(order.getCouponId());       // @Transactional (REQUIRED)
    } catch (CouponException e) {                     // RuntimeException
        log.warn("쿠폰 사용 실패, 주문은 계속 진행");
    }
}`;

const codeRules = `@Transactional                                   // 기본: REQUIRED
@Transactional(propagation = Propagation.REQUIRES_NEW)
@Transactional(rollbackFor = Exception.class)    // 체크 예외도 롤백
@Transactional(noRollbackFor = CouponException.class)  // 이 런타임 예외는 롤백 안 함`;

const codeFixA = `// 1. 실패해도 되는 일은 안쪽에서 예외를 내지 않게 바꾼다
public boolean tryUse(Long couponId) {   // 결과를 값으로 돌려준다
    ...
}`;

const codeFixB = `// 2. 정말 독립된 작업이면 REQUIRES_NEW (안쪽만 롤백, 바깥은 계속)
@Transactional(propagation = Propagation.REQUIRES_NEW)
public void use(Long couponId) { ... }`;
---
<Base title="트랜잭션 전파와 롤백 규칙 · Dev Lessons" description="REQUIRED와 REQUIRES_NEW의 차이, 예외를 잡아도 UnexpectedRollbackException이 나는 이유(rollback-only), 체크 예외의 롤백 규칙을 시나리오로 확인해요.">
<main>
  <header class="top">
    <a class="back" href="/dev-lessons/">← 레슨 목록</a>
    <p class="eyebrow">Spring · 개념 학습 · 약 30분 · 선수 레슨: <a href="/dev-lessons/lessons/transactional-proxy/">@Transactional 동작 원리</a> (프록시)</p>
    <h1>트랜잭션 전파와 롤백 규칙</h1>
    <p class="lede">트랜잭션 안에서 다른 @Transactional 메서드를 부르면 무슨 일이 일어날까요? 기존 트랜잭션에 <strong>합류</strong>할지, <strong>새로 열지</strong>를 정하는 게 전파(propagation)예요. 예외를 잡았는데 커밋에서 터지는 UnexpectedRollbackException, 체크 예외가 커밋되는 규칙까지 시나리오로 확인해요.</p>
    <p class="muted assume"><strong>알고 있다고 보는 것:</strong> <a href="/dev-lessons/lessons/transactional-proxy/">@Transactional 동작 원리</a>(프록시, 다른 빈 호출), DB 연결(<a href="/dev-lessons/lessons/connection-pool/">커넥션과 커넥션 풀</a>), 자바의 체크 예외와 런타임 예외.</p>
    <nav class="toc" aria-label="목차">
      <a href="#predict"><span>0</span>먼저 예측</a>
      <a href="#join"><span>1</span>합류와 새 트랜잭션</a>
      <a href="#sim"><span>2</span>시나리오 실행</a>
      <a href="#rollback-only"><span>3</span>rollback-only</a>
      <a href="#rules"><span>4</span>롤백 규칙</a>
      <a href="#traps"><span>5</span>함정과 고르는 법</a>
      <a href="#check"><span>6</span>확인과 면접 답변</a>
    </nav>
  </header>

  <section id="predict" class="read">
    <p class="eyebrow">0 · 먼저 예측</p>
    <h2>쿠폰이 실패해도 주문은 저장될까요?</h2>
    <p>쿠폰 사용이 실패하면 경고만 남기고 주문은 계속 진행하려고 예외를 잡았어요. <code>couponService.use()</code>는 기본 @Transactional(REQUIRED)이고 다른 빈이에요.</p>
    <pre set:text={codePredict} />
    <div class="panel">
      <div class="field">
        <span class="label">쿠폰에서 예외가 나면</span>
        <div class="choice-row" id="p1">
          <button class="chip" type="button" data-v="saved" aria-pressed="false">주문은 저장된다</button>
          <button class="chip" type="button" data-v="unexpected" aria-pressed="false">주문도 롤백되고 예외가 난다</button>
          <button class="chip" type="button" data-v="silent" aria-pressed="false">주문만 조용히 롤백된다</button>
        </div>
      </div>
      <p class="muted" id="predict-msg">고르면 2장에서 시나리오로 확인할 수 있어요.</p>
    </div>
  </section>

  <section id="join" class="read">
    <p class="eyebrow">1 · 합류와 새 트랜잭션</p>
    <h2>물리 트랜잭션과 논리 트랜잭션</h2>
    <p>DB 입장에서 트랜잭션은 커넥션 하나의 BEGIN부터 COMMIT/ROLLBACK까지예요. 이걸 <strong>물리 트랜잭션</strong>이라고 해요. 스프링은 @Transactional 메서드마다 <strong>논리 트랜잭션</strong>을 하나씩 만들고, 전파 설정으로 물리 트랜잭션과 어떻게 연결할지 정해요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>전파</th><th>바깥 트랜잭션이 있으면</th><th>없으면</th></tr></thead>
        <tbody>
          <tr><td><strong>REQUIRED</strong> (기본)</td><td>합류: 같은 물리 트랜잭션, 같은 커넥션</td><td>새로 시작</td></tr>
          <tr><td><strong>REQUIRES_NEW</strong></td><td>바깥을 잠시 멈추고 새 물리 트랜잭션 (커넥션 하나 더)</td><td>새로 시작</td></tr>
        </tbody>
      </table>
    </div>
    <p>전파 설정은 모두 일곱 가지지만, 실무와 면접에서 핵심은 이 두 개예요.</p>
    <details class="more"><summary>더 알아보기: 나머지 다섯 가지</summary>
      <div class="table-wrap"><table>
        <thead><tr><th>전파</th><th>바깥 트랜잭션이 있으면</th><th>없으면</th></tr></thead>
        <tbody>
          <tr><td>SUPPORTS</td><td>합류</td><td>트랜잭션 없이 실행</td></tr>
          <tr><td>MANDATORY</td><td>합류</td><td>예외</td></tr>
          <tr><td>NOT_SUPPORTED</td><td>바깥을 멈추고 트랜잭션 없이</td><td>트랜잭션 없이</td></tr>
          <tr><td>NEVER</td><td>예외</td><td>트랜잭션 없이</td></tr>
          <tr><td>NESTED</td><td>같은 트랜잭션 안에 되돌아갈 지점(세이브포인트)을 만듦</td><td>새로 시작</td></tr>
        </tbody>
      </table></div>
      <p>NESTED는 DB의 세이브포인트 기능을 써서, 트랜잭션 관리자 종류에 따라 지원하지 않기도 해요.</p>
    </details>
    <p class="callout"><strong>전파는 프록시를 거칠 때만 의미가 있어요.</strong> 같은 클래스 안의 호출은 <a href="/dev-lessons/lessons/transactional-proxy/">프록시를 안 거쳐서</a> REQUIRES_NEW를 붙여도 새 트랜잭션이 생기지 않아요. 이 레슨의 예시는 모두 다른 빈 호출이에요.</p>
  </section>

  <section id="sim">
    <div class="read stack">
      <p class="eyebrow">2 · 시나리오 실행</p>
      <h2>어느 행이 남고, 호출자는 무엇을 받나</h2>
      <p>바깥 서비스가 <code>outer</code> 행을, 안쪽 서비스가 <code>inner</code> 행을 저장해요. 시나리오를 고르고 "다음"을 눌러 보세요. 모든 시나리오는 검증 테스트와 1:1로 대응해요.</p>
    </div>
    <div class="panel">
      <div class="seg" id="scenario">
        <button type="button" data-v="reqCatch" aria-pressed="true">REQUIRED 안쪽 실패, 바깥이 잡음</button>
        <button type="button" data-v="newCatch" aria-pressed="false">REQUIRES_NEW 안쪽 실패, 바깥이 잡음</button>
        <button type="button" data-v="newThenOuterFail" aria-pressed="false">REQUIRES_NEW 커밋 후 바깥 실패</button>
        <button type="button" data-v="visibility" aria-pressed="false">REQUIRES_NEW에서 바깥 행이 보이나</button>
      </div>
      <div class="txs">
        <div class="tx" id="tx-outer"><span class="tag">물리 트랜잭션 A (커넥션 1)</span><b id="tx-outer-state">-</b><span class="rows" id="tx-outer-rows"></span></div>
        <div class="tx" id="tx-inner"><span class="tag" id="tx-inner-tag">물리 트랜잭션 B (커넥션 2)</span><b id="tx-inner-state">-</b><span class="rows" id="tx-inner-rows"></span></div>
      </div>
      <p class="verdict" id="sim-text" aria-live="polite"></p>
      <ol class="path-steps" id="sim-steps"></ol>
      <div class="step-nav">
        <button class="btn" type="button" id="sim-prev">이전</button>
        <button class="btn primary" type="button" id="sim-next">다음</button>
      </div>
      <p class="callout" id="sim-result" hidden></p>
    </div>
  </section>

  <section id="rollback-only" class="read">
    <p class="eyebrow">3 · rollback-only</p>
    <h2>예외를 잡았는데 왜 롤백될까요</h2>
    <p>REQUIRED로 합류한 안쪽 메서드는 물리 트랜잭션을 <strong>직접 롤백할 수 없어요.</strong> 시작한 쪽(바깥)만 커밋, 롤백을 결정해요. 그래서 안쪽 프록시는 런타임 예외를 보면 롤백 대신 트랜잭션에 <strong>rollback-only 표시</strong>만 남기고 예외를 던져요.</p>
    <ol>
      <li>안쪽 프록시: 예외 발견 → 공유 트랜잭션에 rollback-only 표시 → 예외를 바깥으로 던짐</li>
      <li>바깥 코드: try-catch로 예외를 잡고 정상 종료</li>
      <li>바깥 프록시: 커밋하려는데 rollback-only 표시가 있음 → 실제로는 롤백 → <code>UnexpectedRollbackException</code></li>
    </ol>
    <p>예외가 나는 게 오히려 다행이에요. 호출자는 "커밋된 줄 알았는데 사실 롤백됐다"는 걸 알 수 있어요. 0장의 정답이 "주문도 롤백되고 예외가 난다"인 이유예요.</p>
    <h3>고치는 방법</h3>
    <pre set:text={codeFixA} />
    <pre set:text={codeFixB} />
    <p>안쪽 실패가 바깥과 상관없어야 한다면 두 방법 중 하나예요. 반대로 쿠폰 실패 시 주문도 취소되어야 한다면 지금 동작이 맞으니, 예외를 잡지 말고 그대로 던지면 돼요.</p>
  </section>

  <section id="rules" class="read">
    <p class="eyebrow">4 · 롤백 규칙</p>
    <h2>체크 예외는 기본적으로 커밋돼요</h2>
    <p>스프링의 기본 규칙은 <strong>RuntimeException과 Error만 롤백</strong>이에요. <code>Exception</code>을 상속한 체크 예외는 예외가 호출자에게 전달되더라도 <strong>트랜잭션은 커밋</strong>돼요.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>예외</th><th>기본 동작</th><th>바꾸는 법</th></tr></thead>
        <tbody>
          <tr><td>RuntimeException, Error</td><td>롤백</td><td>noRollbackFor</td></tr>
          <tr><td>체크 예외 (Exception, IOException 등)</td><td><strong>커밋</strong></td><td>rollbackFor = Exception.class</td></tr>
        </tbody>
      </table>
    </div>
    <pre set:text={codeRules} />
    <p>이 규칙의 생각은 이래요. 체크 예외는 "호출자가 처리할 수 있는 업무 상황"(잔액 부족 같은)으로 보고, 런타임 예외는 "복구할 수 없는 오류"로 봐요. 실무에서는 업무 예외를 RuntimeException으로 만들거나, 체크 예외를 쓴다면 rollbackFor를 명시해요.</p>
    <div class="panel">
      <span class="label">메서드 안에서 저장한 뒤 예외가 나면</span>
      <div class="seg" id="ex-kind">
        <button type="button" data-v="runtime" aria-pressed="true">IllegalStateException</button>
        <button type="button" data-v="checked" aria-pressed="false">Exception (체크)</button>
        <button type="button" data-v="checkedFor" aria-pressed="false">Exception + rollbackFor</button>
      </div>
      <p class="verdict" id="ex-result" aria-live="polite"></p>
    </div>
  </section>

  <section id="traps" class="read">
    <p class="eyebrow">5 · 함정과 고르는 법</p>
    <h2>REQUIRES_NEW는 공짜가 아니에요</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>상황</th><th>결과</th><th>대응</th></tr></thead>
        <tbody>
          <tr><td>REQUIRED 안쪽 예외를 바깥에서 잡음</td><td>UnexpectedRollbackException, 전부 롤백</td><td>안쪽에서 예외를 내지 않게 하거나 REQUIRES_NEW</td></tr>
          <tr><td>REQUIRES_NEW 남발</td><td>요청 하나가 커넥션 2개 이상 점유. 동시 요청이 많으면 풀 고갈, 서로 기다리는 교착</td><td>정말 독립 커밋이 필요한 곳에만 (감사 로그, 실패 기록)</td></tr>
          <tr><td>REQUIRES_NEW가 바깥의 미커밋 데이터를 기대</td><td>다른 트랜잭션이라 안 보임. 같은 행을 수정하면 바깥의 락을 기다리다 멈출 수 있음</td><td>필요한 값은 인자로 넘김</td></tr>
          <tr><td>체크 예외를 던지는 서비스</td><td>예외가 나도 커밋</td><td>rollbackFor 명시 또는 런타임 예외로</td></tr>
          <tr><td>같은 클래스 안에서 REQUIRES_NEW 메서드 호출</td><td>새 트랜잭션이 생기지 않음</td><td>다른 빈으로 분리</td></tr>
        </tbody>
      </table>
    </div>
    <p><strong>고르는 법:</strong> 기본은 REQUIRED예요. "바깥이 실패해도 이건 남아야 한다"(감사 로그, 실패 이력, 발급된 번호 기록)일 때만 REQUIRES_NEW를 써요. <a href="/dev-lessons/lessons/aop-audit/">AOP와 감사 로그</a> 레슨의 실패 기록이 그 예예요.</p>
  </section>

  <section id="check" class="read">
    <p class="eyebrow">6 · 확인과 면접 답변</p>
    <h2>방금 배운 걸 꺼내 보기</h2>
    <p>다시 보지 말고 바로 답해 보세요.</p>
    <div class="panel" id="quiz"></div>

    <h3 style="margin-top:12px">면접 질문: "트랜잭션 전파 속성 REQUIRED와 REQUIRES_NEW의 차이를 설명해 주세요"</h3>
    <p>정의 → 원리 → 트레이드오프 → 내 경험 순서로, 1분 안에 말한다고 생각하고 먼저 써 보세요.</p>
    <label class="label" for="my-answer">내 답</label>
    <textarea id="my-answer" placeholder="예: 전파 속성은 ..."></textarea>
    <div><button class="btn primary" type="button" id="model-btn" disabled>모범 답안과 비교하기</button></div>
    <div class="panel model" id="model" hidden>
      <dl>
        <dt>정의</dt><dd>전파 속성은 이미 트랜잭션이 있을 때 @Transactional 메서드가 그 트랜잭션에 합류할지 새로 시작할지를 정합니다. REQUIRED는 합류하고, REQUIRES_NEW는 기존 트랜잭션을 멈추고 새 물리 트랜잭션을 엽니다.</dd>
        <dt>원리</dt><dd>REQUIRED로 합류한 안쪽에서 런타임 예외가 나면 직접 롤백하지 못하고 rollback-only 표시만 남깁니다. 바깥에서 예외를 잡아도 커밋 시점에 롤백되며 UnexpectedRollbackException이 납니다. REQUIRES_NEW는 별도 커넥션이라 안쪽만 롤백되거나, 먼저 커밋된 안쪽은 바깥이 롤백되어도 남습니다. 또 기본 롤백 규칙은 런타임 예외만이라 체크 예외는 rollbackFor가 없으면 커밋됩니다.</dd>
        <dt>트레이드오프</dt><dd>REQUIRES_NEW는 커넥션을 하나 더 점유해서 남발하면 풀이 고갈되고, 바깥의 미커밋 데이터를 보지 못합니다. 그래서 감사 로그나 실패 이력처럼 반드시 독립 커밋이 필요한 곳에만 씁니다.</dd>
        <dt>경험</dt><dd>(내 경험으로 채우기) 예: 쿠폰 실패를 잡았는데 주문이 UnexpectedRollbackException으로 롤백되던 문제를 쿠폰 사용 결과를 값으로 돌려주도록 바꿔 해결했습니다.</dd>
      </dl>
      <p class="muted">비교 포인트: rollback-only와 UnexpectedRollbackException을 말했나요? REQUIRES_NEW의 커넥션 비용을 말했나요? 체크 예외 규칙을 말했나요?</p>
    </div>
  </section>

  <section class="read" id="verified">
    <p class="eyebrow">검증</p>
    <h2>이 레슨의 주장은 테스트로 확인해요</h2>
    <p>이 레슨에서 말한 동작은 실제 스프링 부트와 PostgreSQL에서, 호출이 끝난 뒤 남은 행으로 코드가 바뀔 때마다 다시 확인해요.</p>
    <ul>
      <li>REQUIRED 안쪽 예외를 바깥이 잡아도 UnexpectedRollbackException, 행 0개</li>
      <li>REQUIRES_NEW 안쪽 예외를 바깥이 잡으면 outer만 남음</li>
      <li>REQUIRES_NEW가 커밋한 뒤 바깥이 실패하면 inner만 남음</li>
      <li>바깥이 DB에 보냈지만 아직 커밋하지 않은 행은 REQUIRES_NEW 안에서 count 0, 바깥 커밋 후 1</li>
      <li>체크 예외는 커밋(행 1개), rollbackFor를 주면 롤백, 런타임 예외는 롤백</li>
    </ul>
    <p><a href={`${testDir}/PropagationTest.java`}>PropagationTest</a></p>
  </section>

  <footer>
    근거: Spring Framework 참조 문서의 Transaction Propagation, Rolling Back a Declarative Transaction. 오류는 <a href={`${repo}/issues`}>GitHub 이슈</a>로 알려 주세요.
  </footer>
</main>
</Base>

<style is:global>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .txs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tx { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; transition: border-color 0.2s, opacity 0.2s; }
  .tx .tag { font-size: 13px; color: var(--muted); }
  .tx b { font-size: 16px; }
  .tx .rows { font-family: var(--mono, monospace); font-size: 13px; min-height: 1.4em; }
  .tx.idle { opacity: 0.4; }
  .tx.open { border-color: var(--accent); background: var(--accent-soft); }
  .tx.paused { border-style: dashed; }
  .tx.commit { border-color: var(--ok); }
  .tx.commit b { color: var(--ok); }
  .tx.rollback { border-color: var(--query); }
  .tx.rollback b, .tx.marked b { color: var(--query); }
  .path-steps { margin: 0; padding-left: 22px; font-size: 14px; display: flex; flex-direction: column; gap: 4px; }
  .path-steps li { color: var(--muted); }
  .path-steps li.done { color: var(--ink); }
  .path-steps li.now { color: var(--accent); font-weight: 700; }
  .step-nav { display: flex; gap: 8px; }
  @media (max-width: 760px) { .txs { grid-template-columns: minmax(0, 1fr); } }
</style>

<script is:inline>
(function () {
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  function pressGroup(el, onPick) {
    el.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-v]'); if (!b) return;
      el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      onPick(b.dataset.v);
    });
  }
  function setPressed(el, v) { el.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.dataset.v === v ? 'true' : 'false'); }); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  /* 0. 예측 */
  var labels = { saved: '주문은 저장된다', unexpected: '주문도 롤백되고 예외가 난다', silent: '주문만 조용히 롤백된다' };
  var pred = { p1: store('prop-p1') };
  function showPred() {
    if (!pred.p1) return;
    document.getElementById('predict-msg').textContent = '내 예측: ' + labels[pred.p1] + '. 정답은 "주문도 롤백되고 예외가 난다"예요. 커밋 시점에 UnexpectedRollbackException이 나요. 2장 첫 번째 시나리오로 따라가 보세요.';
  }
  ['p1'].forEach(function (k) {
    var el = document.getElementById(k);
    if (pred[k]) setPressed(el, pred[k]);
    pressGroup(el, function (v) { pred[k] = v; store('prop-' + k, v); showPred(); });
  });
  showPred();

  /* 2. 시나리오: 각 단계는 A, B 상태 [클래스, 상태 글자, 행] */
  var S = {
    reqCatch: {
      innerTag: '안쪽 메서드 (REQUIRED: A에 합류)',
      steps: [
        { A: ['open', '열림', 'outer'], B: ['idle', '-', ''], t: '바깥 프록시가 트랜잭션 A를 열고, outer 행을 저장해요(아직 커밋 전).' },
        { A: ['open', '열림', 'outer, inner'], B: ['open', 'A에 합류', ''], t: '안쪽 메서드는 REQUIRED라 새 트랜잭션 없이 A에 합류해요. inner 행도 A 안에 저장돼요.' },
        { A: ['marked', 'rollback-only 표시', 'outer, inner'], B: ['rollback', '예외', ''], t: '안쪽에서 런타임 예외. 안쪽 프록시는 A를 직접 롤백할 수 없어서 rollback-only 표시만 남기고 예외를 던져요.' },
        { A: ['marked', 'rollback-only 표시', 'outer, inner'], B: ['idle', '-', ''], t: '바깥 코드가 try-catch로 예외를 잡고 정상 종료해요.' },
        { A: ['rollback', '롤백', ''], B: ['idle', '-', ''], t: '바깥 프록시가 커밋하려는데 rollback-only 표시가 있어요. 실제로는 롤백하고 UnexpectedRollbackException을 던져요.' }
      ],
      result: '남은 행 없음. 호출자는 UnexpectedRollbackException을 받아요. (테스트 requiredFailureMarksRollbackOnly)'
    },
    newCatch: {
      innerTag: '물리 트랜잭션 B (REQUIRES_NEW, 커넥션 2)',
      steps: [
        { A: ['open', '열림', 'outer'], B: ['idle', '-', ''], t: '바깥 프록시가 트랜잭션 A를 열고 outer 행을 저장해요.' },
        { A: ['paused open', '일시 정지', 'outer'], B: ['open', '열림', 'inner'], t: '안쪽은 REQUIRES_NEW라 A를 잠시 멈추고, 커넥션을 하나 더 받아 트랜잭션 B를 열어요. inner 행은 B에 저장돼요.' },
        { A: ['paused open', '일시 정지', 'outer'], B: ['rollback', '롤백', ''], t: '안쪽에서 런타임 예외. B는 안쪽이 시작한 트랜잭션이라 바로 롤백해요. A에는 아무 표시도 남지 않아요.' },
        { A: ['open', '재개', 'outer'], B: ['rollback', '롤백', ''], t: 'A가 다시 이어지고, 바깥 코드가 예외를 잡아요.' },
        { A: ['commit', '커밋', 'outer'], B: ['rollback', '롤백', ''], t: '바깥 프록시가 A를 정상 커밋해요.' }
      ],
      result: 'outer만 남아요. 예외 없이 정상 반환. (테스트 requiresNewFailureRollsBackOnlyInner)'
    },
    newThenOuterFail: {
      innerTag: '물리 트랜잭션 B (REQUIRES_NEW, 커넥션 2)',
      steps: [
        { A: ['open', '열림', ''], B: ['idle', '-', ''], t: '바깥 프록시가 트랜잭션 A를 열어요.' },
        { A: ['paused open', '일시 정지', ''], B: ['open', '열림', 'inner'], t: '안쪽 REQUIRES_NEW가 트랜잭션 B를 열고 inner 행을 저장해요.' },
        { A: ['paused open', '일시 정지', ''], B: ['commit', '커밋', 'inner'], t: '안쪽 메서드가 끝나면서 B가 바로 커밋돼요. 이제 inner는 DB에 확정됐어요.' },
        { A: ['open', '재개', 'outer'], B: ['commit', '커밋', 'inner'], t: 'A가 이어지고 outer 행을 저장해요.' },
        { A: ['rollback', '롤백', ''], B: ['commit', '커밋', 'inner'], t: '바깥에서 런타임 예외. A만 롤백돼요. 이미 커밋된 B는 되돌릴 수 없어요.' }
      ],
      result: 'inner만 남아요. 호출자는 바깥의 예외를 받아요. (테스트 requiresNewCommitSurvivesOuterRollback)'
    },
    visibility: {
      innerTag: '물리 트랜잭션 B (REQUIRES_NEW, 읽기 전용)',
      steps: [
        { A: ['open', '열림', 'outer (flush됨)'], B: ['idle', '-', ''], t: '바깥이 outer를 저장하고 flush해요. INSERT는 DB에 갔지만 A는 아직 커밋 전이에요.' },
        { A: ['paused open', '일시 정지', 'outer (flush됨)'], B: ['open', 'count = 0', ''], t: 'REQUIRES_NEW 트랜잭션 B에서 행 수를 세면 0이에요. B는 다른 커넥션의 다른 트랜잭션이라 A의 미커밋 행을 볼 수 없어요(READ COMMITTED).' },
        { A: ['commit', '커밋', 'outer'], B: ['commit', '종료', ''], t: 'B가 끝나고 A가 커밋돼요. 이제 다른 트랜잭션에서도 1개가 보여요.' }
      ],
      result: 'B 안에서는 0, 바깥 커밋 후에는 1. REQUIRES_NEW는 "같은 작업의 일부"가 아니라 완전히 다른 트랜잭션이에요. (테스트 requiresNewIsSeparateTransaction)'
    }
  };
  var cur = 'reqCatch', i = 0;
  function setTx(id, s) {
    var el = document.getElementById('tx-' + id);
    el.className = 'tx ' + s[0];
    document.getElementById('tx-' + id + '-state').textContent = s[1];
    document.getElementById('tx-' + id + '-rows').textContent = s[2] ? '행: ' + s[2] : '';
  }
  function render() {
    var sc = S[cur], s = sc.steps[i];
    document.getElementById('tx-inner-tag').textContent = sc.innerTag;
    setTx('outer', s.A); setTx('inner', s.B);
    document.getElementById('sim-text').textContent = s.t;
    document.getElementById('sim-steps').innerHTML = sc.steps.map(function (x, k) {
      return '<li class="' + (k < i ? 'done' : k === i ? 'now' : '') + '">' + esc(k <= i ? x.t : '…') + '</li>';
    }).join('');
    document.getElementById('sim-prev').disabled = i === 0;
    document.getElementById('sim-next').disabled = i === sc.steps.length - 1;
    var res = document.getElementById('sim-result');
    if (i === sc.steps.length - 1) { res.hidden = false; res.innerHTML = '<strong>결과:</strong> ' + esc(sc.result); } else res.hidden = true;
  }
  document.getElementById('sim-next').addEventListener('click', function () { if (i < S[cur].steps.length - 1) { i++; render(); } });
  document.getElementById('sim-prev').addEventListener('click', function () { if (i > 0) { i--; render(); } });
  pressGroup(document.getElementById('scenario'), function (v) { cur = v; i = 0; render(); });
  render();

  /* 4. 롤백 규칙 */
  var ex = {
    runtime: '롤백. 저장한 행이 없어요. 호출자는 IllegalStateException을 받아요. (runtimeExceptionRollsBack)',
    checked: '커밋! 호출자는 Exception을 받지만, 저장한 행은 DB에 남아요. (checkedExceptionCommitsByDefault)',
    checkedFor: '롤백. rollbackFor = Exception.class라서 체크 예외에도 되돌려요. (rollbackForMakesCheckedRollback)'
  };
  function showEx(v) { document.getElementById('ex-result').textContent = ex[v]; }
  pressGroup(document.getElementById('ex-kind'), showEx);
  showEx('runtime');

  /* 6. 확인 문제 */
  var quiz = [
    { q: 'REQUIRED로 합류한 안쪽 메서드에서 런타임 예외가 났고, 바깥이 잡아서 정상 종료했다. 결과는?', o: ['바깥 작업은 커밋된다', '커밋 시점에 UnexpectedRollbackException, 전부 롤백'], a: 1, e: '안쪽이 공유 트랜잭션에 rollback-only 표시를 남겨서, 바깥이 커밋하려 할 때 롤백돼요.' },
    { q: 'REQUIRES_NEW 메서드가 커밋한 뒤 바깥 트랜잭션이 롤백되면 안쪽 데이터는?', o: ['남는다', '함께 롤백된다'], a: 0, e: '별도 물리 트랜잭션이라 이미 커밋된 건 되돌릴 수 없어요.' },
    { q: '@Transactional 메서드에서 IOException(체크 예외)이 던져지면 기본 동작은?', o: ['롤백', '커밋'], a: 1, e: '기본 롤백 대상은 RuntimeException과 Error뿐이에요. rollbackFor로 바꿀 수 있어요.' }
  ];
  var qEl = document.getElementById('quiz');
  quiz.forEach(function (item, qi) {
    var box = document.createElement('div'); box.className = 'quiz';
    box.innerHTML = '<p><strong>Q' + (qi + 1) + '.</strong> ' + esc(item.q) + '</p><div class="opts"></div><div class="feedback" hidden></div>';
    var opts = box.querySelector('.opts'), fb = box.querySelector('.feedback');
    item.o.forEach(function (o, oi) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = o; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        opts.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var right = oi === item.a;
        fb.hidden = false; fb.className = 'feedback ' + (right ? 'right' : 'wrong');
        fb.textContent = (right ? '정답이에요. ' : '정답은 "' + item.o[item.a] + '"예요. ') + item.e;
      });
      opts.appendChild(b);
    });
    qEl.appendChild(box);
  });
  var ans = document.getElementById('my-answer'), mbtn = document.getElementById('model-btn');
  var saved = store('prop-answer'); if (saved) ans.value = saved;
  function syncBtn() { mbtn.disabled = ans.value.trim().length < 20; }
  ans.addEventListener('input', function () { store('prop-answer', ans.value); syncBtn(); });
  syncBtn();
  mbtn.addEventListener('click', function () { document.getElementById('model').hidden = false; mbtn.textContent = '모범 답안을 열었어요'; mbtn.disabled = true; });
})();
</script>
