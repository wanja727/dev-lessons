---
/**
 * 찾아보기: 용어 카드를 찾아 짧은 요약을 보고, 그 내용이 있는 레슨의 질문으로 간다.
 * 카드는 src/content/terms/*.yaml에 있다. 요약은 레슨 본문을 옮긴 것이고 자세한 설명은 레슨에 둔다.
 * 찾기는 브라우저에서 한다. 카드가 수백 개를 넘으면 그때 색인을 따로 만든다.
 * 주소의 ?q=로 검색어를 넘길 수 있다 (예: /terms/?q=persist). Retrievo 앱은 ?embed=1을 붙여 iframe으로 연다.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { inline } from '../lib/inline';
import '../styles/site.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessons = await getCollection('lessons');
const pages = await getCollection('lessonPages', (p) => p.data.stage === 'full');
const files = await getCollection('terms');

/** 카드가 가리키는 곳을 레슨 주소와 이름으로 바꾼다. 레슨이나 질문이 없으면 빌드를 멈춘다 */
function place(key: string, lesson: string, at: string) {
  const page = pages.find((p) => p.id === lesson);
  const listed = lessons.find((l) => l.data.page === lesson);
  if (!page || !listed) throw new Error(`찾아보기 카드 '${key}': 레슨 '${lesson}'이 없다`);
  const data = page.data as Record<string, any>;
  if (at === 'practice') {
    if (!data.practice) throw new Error(`찾아보기 카드 '${key}': 레슨 '${lesson}'에 실무에서는 구역이 없다`);
    return { slug: lesson, at, href: `${base}/lessons/${lesson}/#practice`, lesson: listed.data.title, where: '실무에서는', title: data.practice.title ?? '' };
  }
  const q = data.questions.find((x: { id: string }) => x.id === at);
  if (!q) throw new Error(`찾아보기 카드 '${key}': 레슨 '${lesson}'에 ${at}이 없다`);
  return { slug: lesson, at, href: `${base}/lessons/${lesson}/#${at}`, lesson: listed.data.title, where: `질문 ${at.slice(1)}`, title: q.title };
}

const seen = new Map<string, string>();
const cards = files.flatMap((f) => f.data.terms).map((t) => {
  // 이름과 다른 이름이 두 카드에 겹치면 어느 카드를 보여 줄지 모호하다. 빌드를 멈춘다
  for (const n of [t.key, t.name, ...t.aliases].map((n) => n.toLowerCase())) {
    const other = seen.get(n);
    if (other && other !== t.key) throw new Error(`찾아보기 카드 '${t.key}': '${n}'가 카드 '${other}'와 겹친다`);
    seen.set(n, t.key);
  }
  const main = place(t.key, t.lesson, t.at);
  const also = t.also.map((a) => place(t.key, a.lesson, a.at));
  return { ...t, main, also };
}); // 파일에 적은 순서(배우는 순서)대로 둔다

const count = cards.length;
const units = files.map((f) => f.data.course).join(', ');
---
<Base title="찾아보기 | Dev Lessons" description="개발 용어를 찾아 짧은 요약을 보고, 그 내용이 있는 레슨으로 가서 자세히 배워요.">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;700&display=swap" />
  <main class="page">
    <a class="back" href={`${base}/`}>← 레슨 목록</a>
    <header class="page-head">
      <p class="eyebrow">Dev Lessons</p>
      <h1>찾아보기</h1>
      <p class="lede">궁금한 용어를 찾으면 짧게 알려 드려요. 더 알고 싶으면 그 내용이 있는 레슨의 질문으로 바로 가요. 지금은 {units} 용어 {count}개가 있어요.</p>
    </header>

    <div class="search" role="search">
      <label class="search-field">
        <span class="sr">용어 찾기</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <input id="q" type="search" placeholder="예: persist, 변경 감지, N+1" autocomplete="off" spellcheck="false" />
      </label>
      <p class="status" id="status" aria-live="polite"></p>
    </div>

    <ol class="terms" id="terms">
      {cards.map((c, i) => (
        <li class="card term" id={c.key} data-i={i} data-names={JSON.stringify([c.name, ...c.aliases])} data-summary={c.summary}>
          <div class="head">
            <h2 class="name">{c.name}</h2>
            {c.status === 'draft' && <span class="pill">검수 전</span>}
          </div>
          {c.aliases.length > 0 && <p class="aliases">{c.aliases.join(', ')}</p>}
          <p class="summary" set:html={inline(c.summary)} />
          <a class="go" href={c.main.href} data-lesson={c.main.slug} data-at={c.main.at}>
            <span class="text">
              <span class="where">{c.main.lesson} {c.main.where}</span>
              {c.main.title && <span class="qtitle">{c.main.title}</span>}
            </span>
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          {c.also.length > 0 && (
            <p class="also">
              <span>함께 보기</span>
              {c.also.map((a) => <a href={a.href} data-lesson={a.slug} data-at={a.at}>{a.lesson} {a.where}</a>)}
            </p>
          )}
        </li>
      ))}
    </ol>
    <p class="empty" id="empty" hidden>
      <span id="empty-q"></span>에 맞는 용어가 아직 없어요. 지금은 {units} 레슨의 용어만 있어요.
    </p>
  </main>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('terms') as HTMLOListElement;
  const status = document.getElementById('status') as HTMLParagraphElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;
  const emptyQ = document.getElementById('empty-q') as HTMLSpanElement;
  const items = [...list.querySelectorAll<HTMLLIElement>('li.term')];

  // 비교할 때는 대소문자, 띄어쓰기, 괄호와 점 같은 기호를 무시한다. "em.persist()"를 "persist"로 찾을 수 있게
  const norm = (s: string) => s.toLowerCase().replace(/[^0-9a-z가-힣+]/g, '');
  const index = items.map((li) => ({
    li,
    i: Number(li.dataset.i),
    names: (JSON.parse(li.dataset.names || '[]') as string[]).map(norm).filter(Boolean),
    summary: norm(li.dataset.summary || ''),
  }));

  function score(e: (typeof index)[number], q: string, words: string[]): number {
    let best = 0;
    for (const n of e.names) {
      if (n === q) best = Math.max(best, 100);
      else if (n.startsWith(q)) best = Math.max(best, 60);
      else if (n.includes(q)) best = Math.max(best, 40);
    }
    if (best) return best;
    if (e.summary.includes(q)) return 10;
    // 여러 낱말이면 낱말마다 이름이나 요약 어딘가에 있으면 맞는 것으로 본다
    if (words.length > 1 && words.every((w) => e.names.some((n) => n.includes(w)) || e.summary.includes(w))) return 5;
    return 0;
  }

  function run(raw: string) {
    const q = norm(raw);
    const words = raw.split(/\s+/).map(norm).filter(Boolean);
    const ranked = index
      .map((e) => ({ e, s: q ? score(e, q, words) : 1 }))
      .sort((a, b) => b.s - a.s || a.e.i - b.e.i);
    let shown = 0;
    for (const { e, s } of ranked) {
      e.li.hidden = s === 0;
      if (s > 0) shown++;
      list.appendChild(e.li);
    }
    empty.hidden = shown > 0;
    emptyQ.textContent = `'${raw.trim()}'`;
    status.textContent = q && shown > 0 ? `${shown}개 찾았어요` : '';
  }

  // 검색어를 주소에 남겨 두면 그 결과를 링크로 나눌 수 있다. embed 같은 다른 값은 그대로 둔다
  function remember(raw: string) {
    const url = new URL(location.href);
    if (raw.trim()) url.searchParams.set('q', raw.trim());
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  const initial = new URLSearchParams(location.search).get('q') || '';
  input.value = initial;
  run(initial);
  input.addEventListener('input', () => {
    run(input.value);
    remember(input.value);
  });
  if (!document.documentElement.classList.contains('embed') && !location.hash) input.focus();

  // Retrievo 앱 안(iframe)에서는 앱에 있는 레슨의 링크를 앱의 레슨 화면으로 보낸다.
  // 앱이 먼저 자기 레슨 키 목록(lessons)을 보내 준다. 목록에 있는 레슨이면 링크를 막고 레슨 키와 구역을 알린다(open-lesson).
  // 목록에 없거나 목록이 아직 없으면 막지 않는다. 그러면 링크가 새 탭으로 열린다 (Base가 target을 _blank로 둔다)
  if (document.documentElement.classList.contains('embed') && window.parent !== window) {
    let appLessons: Set<string> | null = null;
    window.addEventListener('message', (e) => {
      if (e.source !== window.parent) return;
      const data = e.data as { source?: unknown; type?: unknown; keys?: unknown } | null;
      if (!data || data.source !== 'retrievo' || data.type !== 'lessons' || !Array.isArray(data.keys)) return;
      appLessons = new Set(data.keys.filter((k): k is string => typeof k === 'string'));
    });
    list.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lesson]');
      if (!a || !appLessons || !appLessons.has(a.dataset.lesson || '') || e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      window.parent.postMessage({ source: 'dev-lessons', type: 'open-lesson', lesson: a.dataset.lesson, at: a.dataset.at }, '*');
    });
    // 준비됐다고 알리면 앱이 레슨 키 목록을 답으로 보낸다. 앱이 아직 듣기 전이면 놓치므로 목록이 올 때까지 몇 번 다시 알린다
    let tries = 0;
    const ready = () => {
      if (appLessons || tries++ >= 20) return;
      window.parent.postMessage({ source: 'dev-lessons', type: 'terms-ready' }, '*');
      setTimeout(ready, 500);
    };
    ready();
  }
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* 찾는 칸은 목록을 내려도 위에 붙어 있다. 흰 면이라 아래 카드가 비치지 않는다 */
  .search { position: sticky; top: 0; z-index: 1; margin-top: 20px; padding: 12px 0 2px; background: #ffffff; }
  .status { margin: 6px 0 0 8px; min-height: 1.6em; font-size: 13px; color: var(--soft); }
  .terms { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .term { display: flex; flex-direction: column; gap: 8px; padding: 20px 20px 18px; scroll-margin-top: 100px; }
  .term:target { border-color: var(--accent-line); }
  /* 카드의 display: flex가 hidden 속성을 이기지 않게 한다. 찾기에 맞지 않는 카드를 숨긴다 */
  .term[hidden] { display: none; }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .name { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .aliases { margin: -4px 0 0; font-family: var(--font-mono); font-size: 12.5px; color: var(--faint); overflow-wrap: anywhere; }
  .summary { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink-2); }
  .summary :global(code) { font-family: var(--font-mono); font-size: 0.88em; padding: 1px 5px; border-radius: 6px; background: var(--code-bg); overflow-wrap: anywhere; }
  /* 레슨으로 가는 길: 옅은 면 하나. 카드 안에서 누를 수 있는 곳이 여기라는 것을 보여 준다 */
  .go {
    display: flex; align-items: center; gap: 12px; margin-top: 4px; padding: 12px 14px;
    border-radius: 14px; background: var(--tint); color: inherit; text-decoration: none;
  }
  .go:hover { background: var(--accent-soft); }
  .go:hover .arrow { color: var(--accent-ink); }
  .go .text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
  .go .where { font-size: 13px; font-weight: 600; color: var(--accent-ink); }
  .go .qtitle { font-size: 14px; color: var(--sub); }
  .also { display: flex; flex-wrap: wrap; gap: 2px 12px; margin: 0; padding: 0 4px; font-size: 13px; color: var(--soft); }
  .also a { color: var(--accent-ink); text-decoration: none; }
  .also a:hover { text-decoration: underline; }
  .empty { margin: 8px 0 0; padding: 0 8px; font-size: 15px; color: var(--sub); }
  /* 앱 안에서는 앱이 제목(찾아보기)을 보여 주므로 페이지의 제목을 숨긴다 */
  :global(html.embed) .page-head :is(.eyebrow, h1) { display: none; }
  :global(html.embed) .search { margin-top: 12px; }
</style>
