---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/site.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/wanja727/dev-lessons';
// 배우는 순서대로. 단계마다 묶어서 보여준다
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const stageNotes: Record<string, string> = {
  '기초': '처음이라면 여기서 시작하세요. 자바와 SQL 기초만 알면 돼요.',
  '동시성': '스레드가 여럿일 때 생기는 일. 기초와 별개로 먼저 봐도 돼요.',
  '트랜잭션과 JPA': '스프링에서 DB를 다루는 핵심. 기초 4개를 본 뒤에 보세요.',
  'DB와 운영': '동시에 고치는 데이터, 성능, 대량 작업.',
  '실무 시스템': '커머스와 핀테크 서비스에서 만나는 설계 문제. 앞 단계를 본 뒤에 보세요.',
};
const stages = [...new Set(lessons.map((l) => l.data.stage))].map((stage) => ({
  stage,
  note: stageNotes[stage],
  items: lessons.filter((l) => l.data.stage === stage),
}));
const fileName = (p: string) => p.split('/').pop();
---
<Base title="Dev Lessons" description="백엔드 개발 개념을 직접 조작하며 배우는 레슨. 레슨의 주장은 테스트로 검증합니다.">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;700&display=swap" />
  <main class="page">
    <header class="page-head">
      <p class="eyebrow">Dev Lessons</p>
      <h1>직접 눌러 보고, 테스트로 확인하는 개발 개념</h1>
      <p class="lede">백엔드 개발자에게 필요한 개념을 처음 배우는 사람도 따라올 수 있게 만든 대화형 레슨이에요. 레슨에 적힌 동작(예: 쿼리가 몇 번 나가는지)은 저장소의 테스트로 증명하고, 코드가 바뀔 때마다 CI에서 다시 확인해요.</p>
    </header>

    <!-- 용어를 바로 찾을 수 있게 첫 화면에 찾는 칸을 둔다. 결과는 찾아보기 페이지에서 보여 준다 -->
    <form class="find" action={`${base}/terms/`} method="get" role="search">
      <label class="search-field">
        <span class="sr">용어 찾기</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <input name="q" type="search" placeholder="용어 찾아보기 (예: persist, N+1)" autocomplete="off" spellcheck="false" />
      </label>
    </form>

    {stages.map((s, si) => (
      <section class="stage" aria-labelledby={`stage-${si}`}>
        <h2 class="group-title" id={`stage-${si}`}>{si + 1}단계 {s.stage}</h2>
        {s.note && <p class="group-note">{s.note}</p>}
        <ol class="lessons">
          {s.items.map((l) => (
            <li>
              <a class="card lesson" href={`${base}/lessons/${l.data.page}/`}>
                <span class="text">
                  <span class="title">{l.data.title}</span>
                  <span class="meta"><span>{l.data.unit}</span><span>약 {l.data.minutes}분</span></span>
                  <span class="summary">{l.data.summary}</span>
                </span>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <p class="verified">
                검증 테스트{' '}
                {l.data.verifiedBy.map((p) => (
                  <a href={`${repo}/blob/main/${p}`}>{fileName(p)}</a>
                ))}
              </p>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <footer>
      <a href={repo}>GitHub 저장소</a>
      <span>오류를 발견하면 이슈로 알려 주세요.</span>
    </footer>
  </main>
</Base>

<style>
  .find { margin-top: 24px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .stage { display: flex; flex-direction: column; gap: 6px; margin-top: 36px; }
  .lessons { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .lesson { display: flex; align-items: center; gap: 12px; padding: 16px 18px; }
  .text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .title { font-size: 16px; font-weight: 600; letter-spacing: -0.015em; }
  .meta { display: flex; gap: 10px; font-size: 13px; color: var(--soft); }
  .summary { margin-top: 4px; font-size: 14px; line-height: 1.6; color: var(--sub); }
  .verified { margin: 6px 0 0 18px; font-size: 12.5px; color: var(--faint); overflow-wrap: anywhere; }
  .verified a { margin-right: 8px; font-family: var(--font-mono); color: var(--muted); text-decoration: none; }
  .verified a:hover { color: var(--accent-ink); text-decoration: underline; }
  footer { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 48px; padding: 0 4px; font-size: 13px; color: var(--soft); }
  footer a { color: var(--accent-ink); }
</style>
